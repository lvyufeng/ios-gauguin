+/* Only a serialized request can wait. Display may poll/complete the escrow
+ * during this interval, but cannot free a public handle or issue another job.
+ * Follow HakiOS's 200 us unlocked polling interval; hardware reads and all
+ * runtime transitions remain under gLock. This adds no unchecked GPU access. */
+static void gpuWaitUnlocked(void)
+{
+    if(gapi_pending.token&&!gapi_frozen)gapi_pending.paused_at=mach_absolute_time();
+    IOLockUnlock(gLock);
+    delay_for_interval(200,NSEC_PER_USEC);
+    IOLockLock(gLock);
+    if(gapi_pending.token&&!gapi_frozen){
+        uint64_t now=mach_absolute_time();
+        if(now<gapi_pending.paused_at)gapi_valid=false;
+        else gapi_add(&gapi_pending.unlocked_ticks,now-gapi_pending.paused_at);
+        gapi_pending.paused_at=0;
     }
 }

