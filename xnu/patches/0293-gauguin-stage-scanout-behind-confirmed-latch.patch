+void
+AppleCLCD::flip382AdvanceLocked(uint32_t scan)
+{
+    auto &flip = fFlip382;
+    if (flip.closed || flip.stage == sweet_fb_flip382::Quarantined) return;
+    if (fPowerOff || fHeldStopped) {
+        flip.stage = sweet_fb_flip382::Quarantined;
+        IOLog("SWEET F382 STOP: display-inactive front=%u next=%u\n",flip.front,flip.next);
+        return;
+    }
+    if (flip.stage == sweet_fb_flip382::Pending) {
+        uint64_t age = 0;
+        absolutetime_to_nanoseconds(mach_absolute_time() - flip.issueTick, &age);
+        const unsigned result = age <= UINT64_C(45000000) ?
+            sweet_frame382_latch(flip.next, flip.scan) : F382_UNCERTAIN;
+        if (result == F382_WAIT) return;
+        if (result != F382_CONFIRMED) {
+            flip.stage = sweet_fb_flip382::Quarantined;
+            IOLog("SWEET F382 STOP: uncertain-latch front=%u next=%u scan=%u\n",flip.front,flip.next,scan);
+            return;
+        }
+        flip.front = flip.next;
+        flip.stage = sweet_fb_flip382::Idle;
+        IOLog("SWEET F382 L %llu %u %u %llu\n",flip.attempt,flip.scan+1,flip.front,mach_absolute_time());
+        if (flip.receipt.owner && fFrameInfo375Size < F375_INFO_QUEUE) {
+            flip.receipt.scan = flip.scan + 1;
+            fFrameInfo375Pending[(fFrameInfo375Head+fFrameInfo375Size)%F375_INFO_QUEUE] = flip.receipt;
+            ++fFrameInfo375Size;
+        }
+        flip.receipt = {};
+        flip.closed = flip.front == F382_FRONT;
+        return;
+    }
+    if (fHeldActive || fCalibrating || flip.stage == sweet_fb_flip382::Copying) return;
+    if (sweet_frame382_ending()) {
+        if (flip.front == F382_FRONT) {
+            flip.closed = true;
+            return;
+        }
+        flip.next = F382_FRONT;
+        flip.receipt = {};
+        flip.attempt = 0;
+        flip.stage = sweet_fb_flip382::Ready;
+    }
+    if (flip.stage != sweet_fb_flip382::Ready) return;
+    const unsigned result = sweet_frame382_issue(flip.front, flip.next, &flip.scan);
+    if (result == F382_TOUCHED) {
+        flip.issueTick = mach_absolute_time();
+        flip.stage = sweet_fb_flip382::Pending;
+        IOLog("SWEET F382 I %llu %u %u %llu\n",flip.attempt,flip.scan,flip.next,flip.issueTick);
+    } else if (result != F382_WAIT) {
+        flip.stage = sweet_fb_flip382::Quarantined;
+        IOLog("SWEET F382 STOP: uncertain-request front=%u next=%u scan=%u\n",flip.front,flip.next,scan);
+    }
+}
