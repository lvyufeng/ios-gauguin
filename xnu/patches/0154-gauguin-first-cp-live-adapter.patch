+static vm_offset_t ggq_address(uint32_t reg,bool write)
+{
+    if(!ggq_register_allowed(reg,write))return 0;
+    if(reg<0x1000)return ggx_core?ggx_core+4*reg:0;
+    if(reg==0x1f888||reg==0x1f889||reg==0x1f8c3)return gmb_reset?gmb_reset+4*reg-0x7c000:0;
+    if(!write&&(reg==0x23b0c||reg==0x23b13))return gfw_map[GMF_AO]?gfw_map[GMF_AO]+4*reg-0x8c000:0;
+    return 0;
+}
+static bool ggq_board_read(void *cookie,uint32_t reg,uint32_t *out)
+{(void)cookie;vm_offset_t va=ggq_address(reg,false);if(!va||!out)return false;*out=gfw_load32(va);return true;}
+static bool ggq_board_write(void *cookie,uint32_t reg,uint32_t value)
+{(void)cookie;vm_offset_t va=ggq_address(reg,true);if(!va)return false;gfw_store32(va,value);return true;}
+static vm_offset_t ggq_memory_address(enum ggq_memory memory,uint32_t off,bool write)
