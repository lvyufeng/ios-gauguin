+static bool overlap(const void *a,size_t an,const void *b,size_t bn)
+{return (uintptr_t)a<(uintptr_t)b+bn&&(uintptr_t)b<(uintptr_t)a+an;}
+static const struct draw171_native_blob *native_blob(unsigned id)
+{return id<24?&draw171_rings[id]:id<GGT_BLOBS?&draw171_programs[id-24]:NULL;}
+bool ggt_blob_get(unsigned id,struct ggt_blob *out)
+{
+    const struct draw171_native_blob *n=native_blob(id);
+    if(!n||!span(out,sizeof(*out)))return false;
+    struct ggt_blob b={0};
+    if(n->words){
+        if(!n->data||n->iova<DRAW171_RING_BASE+4096u||n->iova%128u||
+           !n->gpu_serialized_extent||n->gpu_serialized_extent%128u||
+           n->words>n->cpu_requested_capacity/4u||n->words>n->gpu_serialized_extent/4u||
+           n->iova-DRAW171_RING_BASE>DRAW171_RING_BYTES||
+           n->gpu_serialized_extent>DRAW171_RING_BYTES-(n->iova-DRAW171_RING_BASE))return false;
+        b=(struct ggt_blob){n->iova-DRAW171_RING_BASE,n->gpu_serialized_extent/4u,n->words};
