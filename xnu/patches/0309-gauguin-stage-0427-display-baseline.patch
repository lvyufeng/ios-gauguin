+    nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &cpu402.sample_period);
+    const struct cpu402_point *p = &cpu402.point;
+    printf("SWEET CPU402 MAP: admitted=1 enable=%08x original=%u:%08x:%08x "
