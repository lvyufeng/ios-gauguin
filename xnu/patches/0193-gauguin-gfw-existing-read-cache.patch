+/* Retain the last existing guard read. Do not read hardware on a failure. */
+struct gfw_read_sample {
+    uint32_t kind,space,offset,ok;
+    uint64_t value;
+};
+static struct gfw_read_sample gfw_read_sample;
+static bool gfw_observe32(void *cookie,uint32_t off,uint32_t *out)
+{
+    bool ok=gmb_read32(cookie,off,out);
+    gfw_read_sample=(struct gfw_read_sample){1,0,off,ok,ok&&out?*out:0};
+    return ok;
+}
+static bool gfw_observe64(void *cookie,uint32_t off,uint64_t *out)
+{
+    bool ok=gmb_read64(cookie,off,out);
+    gfw_read_sample=(struct gfw_read_sample){2,0,off,ok,ok&&out?*out:0};
+    return ok;
+}
+static uint32_t gfw_observe_load(uint32_t space,uint32_t off,vm_offset_t address)
+{
+    uint32_t value=gfw_load32(address);
+    gfw_read_sample=(struct gfw_read_sample){3,space,off,1,value};
+    return value;
+}
