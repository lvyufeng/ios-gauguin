+    gglb_entry=gglb_phase_entry=gglb_last_now=mach_absolute_time();gglb_phase=GGL_IDLE;gglb_sealed=0;
+    clock_interval_to_deadline(4,NSEC_PER_SEC,&gglb_deadline);gglb_phase_end=gglb_deadline;
+    memset(&gglb_diagnostic,0,sizeof(gglb_diagnostic));gglb_result=GGL_GUARD;
+    memset(gglb_before_mask,0,sizeof(gglb_before_mask));memset(gglb_after_mask,0,sizeof(gglb_after_mask));
+    gglb_aux_mask=gglb_before_control=gglb_after_control=gglb_before_hi=gglb_after_hi=gglb_before_tail=gglb_after_tail=0;
+    memset(gglb_before,0,sizeof(gglb_before));memset(gglb_after,0,sizeof(gglb_after));
+    if(!gpzb_flags()||!gmb_thread())gglb_reject(GGL_IDLE,LGD_CONFIG);
+    else if(!gauguin_wdt_lease_check_budget(8u*GAUGUIN_WDT_CLOCK_HZ))gglb_reject(GGL_IDLE,LGD_ENTRY_BUDGET);
+    else{
+        const struct ggl_ops ops={NULL,gglb_guard,gglb_seal,gglb_read,gglb_write,gmb_barrier,ggq_board_delay,gglb_memory_read,gglb_memory_write,gglb_quarantine};
+        gglb_result=ggl_start_once(&gglb_context,&ops,&ggb_data_plan,&gglb_work);
+    }
+    if(gglb_result!=GGL_OK||!gglb_guard(NULL,GGL_FINAL)){
+        if(gglb_result==GGL_OK)gglb_result=GGL_GUARD;
+        if(sweet_gpu_clear_state()!=GMB_QUARANTINED)gglb_quarantine(NULL);
+        gglb_records(false);return gglb_result;
+    }
+    *out=gglb_work;__atomic_store_n(&gglb_lifecycle,GMB_READY,__ATOMIC_RELEASE);gglb_records(true);return GGL_OK;
+}
