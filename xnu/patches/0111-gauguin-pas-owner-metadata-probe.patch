--- /dev/null
+++ b/bsd/dev/gauguin_pas_probe.c
@@ -0,0 +1,184 @@
+/* Read-only LowPASReservation handoff check. sweetpasprobe=1, default off.
+ * Does not map/access the reserved buffer, load firmware, or invoke PAS/SMC.
+ * pmap_cache_attributes inspects pmap metadata, not the named physical page.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm64/boot.h>
+#include <IOKit/IOLib.h>
+
+_Static_assert(PAGE_SHIFT == 14, "Low-PAS contract requires 16KiB CPU pages");
+#define PSR_PAGE UINT64_C(0x4000)
+#define PSR_REGION UINT64_C(0x100000)
+#define PSR_TAIL UINT64_C(0x200000)
+#define PSR_WIMG UINT32_C(0xd0000006)
+#define PSR_SIGNATURE UINT32_C(0x50415331)
+struct psr_range { uint64_t pa, bytes; };
+struct psr_owner {
+    struct psr_range selected, input, fdt, shim;
+    uint64_t tail;
+};
+
+static uint32_t psr_u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+        ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static uint64_t psr_u64(const uint8_t *p)
+{
+    return psr_u32(p) | ((uint64_t)psr_u32(p + 4) << 32);
+}
+static bool psr_valid(struct psr_range r)
+{
+    return r.bytes && r.pa <= UINT64_MAX - r.bytes;
+}
+static bool psr_overlap(struct psr_range a, struct psr_range b)
+{
+    return a.pa < b.pa + b.bytes && b.pa < a.pa + a.bytes;
+}
+/* Only loader-owned ADT metadata and actual managed geometry are consumed.
+ * All physical addresses remain integers. Output is untouched on failure. */
+static bool psr_validate(const uint8_t *record, unsigned record_bytes,
+    const uint8_t *tuple, unsigned tuple_bytes, struct psr_range managed,
+    struct psr_owner *out)
+{
+    if (!record || !tuple || !out || record_bytes != 128 || tuple_bytes != 24 ||
+        !psr_valid(managed) || (managed.pa & (PSR_PAGE - 1)) ||
+        (managed.bytes & (PSR_PAGE - 1))) return false;
+    const char magic[8] = {'L','P','A','S','O','W','N','1'};
+    for (unsigned i = 0; i < 8; ++i) if (record[i] != (uint8_t)magic[i]) return false;
+    if (psr_u32(record + 8) != 1 || psr_u32(record + 12) != 1 ||
+        psr_u64(record + 24) != PSR_TAIL || psr_u64(record + 32) != PSR_REGION ||
+        psr_u64(record + 40) != PSR_REGION || psr_u64(record + 56)) return false;
+    struct psr_owner o = {
+        {psr_u64(record + 64), psr_u64(record + 72)},
+        {psr_u64(record + 80), psr_u64(record + 88)},
+        {psr_u64(record + 96), psr_u64(record + 104)},
+        {psr_u64(record + 112), psr_u64(record + 120)}, psr_u64(record + 16)
+    };
+    if (!psr_valid(o.selected) || !psr_valid(o.input) || !psr_valid(o.fdt) ||
+        !psr_valid(o.shim) || o.selected.bytes != PSR_REGION ||
+        o.selected.pa + o.selected.bytes > UINT64_C(0x100000000) ||
+        (o.selected.pa & (PSR_REGION - 1)) || (o.input.pa & 7) ||
+        o.input.bytes > UINT64_C(0x20000000) || o.input.bytes <= PSR_TAIL ||
+        o.input.bytes != psr_u64(record + 48) || (o.tail & (PSR_PAGE - 1)) ||
+        o.tail != o.input.bytes - PSR_TAIL || o.fdt.bytes < 40 ||
+        o.fdt.bytes > PSR_REGION || o.shim.bytes > PSR_REGION ||
+        psr_overlap(o.input, managed) || psr_overlap(o.input, o.fdt) ||
+        psr_overlap(o.input, o.shim) || psr_overlap(o.fdt, o.shim)) return false;
+    uint64_t tail_pa = o.input.pa + o.tail;
+    if (tail_pa > UINT64_MAX - (PSR_REGION - 1) ||
+        o.selected.pa != ((tail_pa + PSR_REGION - 1) & ~(PSR_REGION - 1)) ||
+        o.selected.pa + o.selected.bytes > o.input.pa + o.input.bytes ||
+        psr_u64(tuple) != o.selected.pa || psr_u64(tuple + 8) != o.selected.bytes ||
+        psr_u32(tuple + 16) != PSR_WIMG || psr_u32(tuple + 20) != PSR_SIGNATURE)
+        return false;
+    *out = o;
+    return true;
+}
+
+/* Internal pmap APIs: canonical declarations in osfmk/vm/pmap.h and
+ * osfmk/arm/pmap/pmap.h are hidden from the BSD exported header view. */
+extern boolean_t pmap_valid_page(ppnum_t);
+extern unsigned int pmap_cache_attributes(ppnum_t);
+extern unsigned long gPhysBase, real_phys_size;
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_terminate_self(void);
+extern int get_preemption_level(void);
+extern void sweet_log_mark_sync(const char *);
+extern void sweet_log_flush_now(void);
+void sweet_pas_probe_init(void);
+static unsigned psr_started;
+static void psr_record(const char *line)
+{
+    printf("%s\n", line);
+    sweet_log_mark_sync(line);
+    sweet_log_flush_now();
+}
+static void psr_run(void)
+{
+    DTEntry chosen, defaults;
+    const void *owner = NULL, *tuple = NULL, *pending = NULL;
+    unsigned owner_bytes = 0, tuple_bytes = 0, pending_bytes = 0;
+    const boot_args *args = PE_state.bootArgs;
+    struct psr_owner o;
+    if (!args || args->Version != kBootArgsVersion2 || args->physBase != gPhysBase ||
+        !real_phys_size || args->memSize > real_phys_size ||
+        SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTLookupEntry(NULL, "/defaults", &defaults) != kSuccess ||
+        SecureDTGetProperty(chosen, "LowPASReservation", &owner, &owner_bytes) != kSuccess ||
+        SecureDTGetProperty(defaults, "pmap-io-ranges", &tuple, &tuple_bytes) != kSuccess ||
+        SecureDTGetProperty(chosen, "LowPASRequest", &pending, &pending_bytes) == kSuccess ||
+        SecureDTGetProperty(defaults, "LowPASIOPending", &pending, &pending_bytes) == kSuccess ||
+        !psr_validate(owner, owner_bytes, tuple, tuple_bytes,
+            (struct psr_range){args->physBase, real_phys_size}, &o)) {
+        psr_record("SWEET PAS PROBE: missing/invalid ownership metadata; stopped");
+        return;
+    }
+    char line[224];
+    snprintf(line, sizeof(line), "SWEET PAS PROBE: owner pa=%016llx bytes=%llx input=%016llx+%llx tail=%llx",
+        (unsigned long long)o.selected.pa, (unsigned long long)o.selected.bytes,
+        (unsigned long long)o.input.pa, (unsigned long long)o.input.bytes,
+        (unsigned long long)o.tail);
+    psr_record(line);
+    snprintf(line, sizeof(line), "SWEET PAS PROBE: provenance fdt=%016llx+%llx shim=%016llx+%llx",
+        (unsigned long long)o.fdt.pa, (unsigned long long)o.fdt.bytes,
+        (unsigned long long)o.shim.pa, (unsigned long long)o.shim.bytes);
+    psr_record(line);
+    unsigned pages = 0;
+    for (uint64_t pa = o.selected.pa; pa < o.selected.pa + o.selected.bytes; pa += PSR_PAGE) {
+        ppnum_t pn = (ppnum_t)(pa >> PAGE_SHIFT);
+        bool managed = pmap_valid_page(pn);
+        unsigned wimg = pmap_cache_attributes(pn);
+        if (managed || wimg != PSR_WIMG) {
+            snprintf(line, sizeof(line), "SWEET PAS PROBE: pmap mismatch pa=%016llx managed=%u wimg=%08x; stopped",
+                (unsigned long long)pa, managed ? 1u : 0u, wimg);
+            psr_record(line);
+            return;
+        }
+        ++pages;
+    }
+    snprintf(line, sizeof(line), "SWEET PAS PROBE: complete unmanaged_pages=%u wimg=%08x; metadata only, buffer/PAS/GPU untested",
+        pages, PSR_WIMG);
+    psr_record(line);
+}
+static bool psr_context(void)
+{
+    return ml_get_interrupts_enabled() && !ml_at_interrupt_context() && !get_preemption_level();
+}
+static void psr_worker(void *argument, wait_result_t result)
+{
+    (void)argument; (void)result;
+    if (!psr_context()) {
+        printf("SWEET PAS PROBE: invalid worker context; stopped\n");
+        thread_terminate_self();
+        return;
+    }
+    for (unsigned i = 0; i < 45; ++i) IOSleep(1000);
+    if (!psr_context()) {
+        printf("SWEET PAS PROBE: invalid context after delay; stopped\n");
+        thread_terminate_self();
+        return;
+    }
+    psr_run();
+    thread_terminate_self();
+}
+void sweet_pas_probe_init(void)
+{
+    int enabled = 0;
+    thread_t thread;
+    (void)PE_parse_boot_argn("sweetpasprobe", &enabled, sizeof(enabled));
+    if (enabled != 1 || __atomic_exchange_n(&psr_started, 1, __ATOMIC_ACQ_REL)) return;
+    kern_return_t result = kernel_thread_start(psr_worker, NULL, &thread);
+    if (result == KERN_SUCCESS) thread_deallocate(thread);
+    else printf("SWEET PAS PROBE: worker creation failed=%d; no inline fallback\n", result);
+}
+#endif /* GAUGUIN */
