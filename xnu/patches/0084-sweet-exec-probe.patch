+
+/* declared (not exported) by osfmk/arm64/pmap; sweet_ufs.c does the same */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+
+void sweet_wdt_thread_start(void);
+void sweet_pon_dump(void);
+
+/*
+ * PMIC PON reset reason (read-only SPMI through sweet_spmi.c): PMK8350 PON at
+ * SPMI slave 0, peripheral 0x08, reg base 0x1300 (gauge DT "pony@1300").
+ * POFF_REASON1/2 (0x1308/0x1309) say what the last power-off was and
+ * WARM_RESET_REASON1/2 (0x1311/0x1312) what the last warm reset was - the
+ * bootloader prints these as "poweroff reason"/"warm reset" and they name a
+ * watchdog/kpdp/PMIC source, unlike the SoC's generic restart_reason.
+ */
+extern "C" int sweet_spmi_init(void);
+extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+void
+sweet_pon_dump(void)
+{
+	static const struct {
+		const char *name;
+		unsigned reg;
+	} regs[] = {
+		{ "poff1", 0x1308 }, { "poff2", 0x1309 },
+		{ "warm1", 0x1311 }, { "warm2", 0x1312 },
+	};
+	uint8_t value;
+
+	if (sweet_spmi_init() != 0) {
+		IOLog("SWEET PON: SPMI unavailable\n");
+		return;
+	}
+	/* gauge DT: the PON lives on pmic@6 (PMK8350, SPMI slave 6) - the other
+	 * PMICs (pm6150l = 4, pm6350 = 0) have no PON node. */
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		if (sweet_spmi_read(6, regs[i].reg, &value) == 0) {
+			IOLog("SWEET PON: %s=%02x\n", regs[i].name, value);
+		} else {
+			IOLog("SWEET PON: %s read failed\n", regs[i].name);
+		}
+	}
+}
+
+/*
+ * Watchdog sampler: once a second, read the APSS watchdog (0x17c10000,
+ * qcom,apss-wdt-sm6350 in the gauge DT) and log only when something changes,
+ * so the last lines of the persistent log say whether the block was armed
+ * (WDT0_EN, 0x08), whether the timers moved (BARK 0x10 / BITE 0x14) or the
+ * status counter (WDT0_STS, 0x0c) stalled - i.e. whether a watchdog can be the
+ * thing that resets the phone minutes into userland.
+ */
+#define SWEET_APSS_WDT_PA       0x17c10000ULL
+#define SWEET_APSS_WDT_SIZE     0x1000
+#define SWEET_WDT_BURST         10      /* samples per boot (1 s apart) */
+
+static thread_call_t sweet_wdt_call;
+static unsigned sweet_wdt_ticks_total;
+static unsigned sweet_wdt_burst;
+
+extern "C" void sweet_dump_tick(void);
+extern "C" void sweet_pstore_tick(void) __attribute__((weak));
+
+static void
+sweet_wdt_sample(thread_call_param_t, thread_call_param_t)
+{
+	static volatile uint32_t *wdt;
+	static uint32_t last[6];
+	static int announced;
+
+	if (wdt == NULL) {
+		wdt = (volatile uint32_t *)ml_io_map(SWEET_APSS_WDT_PA, SWEET_APSS_WDT_SIZE);
+		if (wdt == NULL) {
+			IOLog("SWEET WDT: cannot map 0x%llx, not sampling\n", SWEET_APSS_WDT_PA);
+			return;
+		}
+	}
+	uint32_t now[6];
+	for (int i = 0; i < 6; i++) {
+		now[i] = wdt[i];        /* CTL, RST, EN, STS, BARK, BITE */
+	}
+	if (!announced) {
+		announced = 1;
+		IOLog("SWEET WDT: ctl=%x rst=%x en=%x sts=%x bark=%x bite=%x\n",
+		    now[0], now[1], now[2], now[3], now[4], now[5]);
+	}
+	if (__builtin_memcmp(now, last, sizeof(now)) != 0) {
+		IOLog("SWEET WDT: ctl=%x rst=%x en=%x sts=%x bark=%x bite=%x\n",
+		    now[0], now[1], now[2], now[3], now[4], now[5]);
+		__builtin_memcpy(last, now, sizeof(now));
+	}
+
+	/*
+	 * Heartbeat: one line a second, with a run counter and whether the
+	 * system callout/preemption machinery is still turning. The persistent
+	 * log then ends with the heartbeat itself, so the next boot says how long
+	 * userland really lived, and a gap in the seconds means the SoC stopped
+	 * before resetting instead of being reset while healthy.
+	 */
+	static unsigned ticks;
+	static uint64_t last_uptime;
+	uint64_t uptime = mach_absolute_time();
+	sweet_wdt_ticks_total++;
+
+	if (uptime != last_uptime) {
+		last_uptime = uptime;
+		sweet_dump_tick();
+		if (sweet_pstore_tick) {
+			sweet_pstore_tick();
+		}
+		if ((++ticks & 1) == 0 || ticks < 6) {
+			extern uint32_t sweet_timer_intrs, sweet_timer_expiries, sweet_callout_runs;
+			IOLog("SWEET HB: %u wdt=%u tick=%u exp=%u call=%u\n", ticks,
+			    sweet_wdt_ticks_total, sweet_timer_intrs, sweet_timer_expiries,
+			    sweet_callout_runs);
+		}
+	}
+	/*
+	 * thread_call_callbacks() moves an entered call_out back to the call
+	 * queue before the callback runs, so re-entering here is enough: with
+	 * DELAY_ABS it runs again one second from now.
+	 */
+	/*
+	 * Re-entering a thread call from inside its own callback does not
+	 * reschedule it on this kernel (observed: exactly one heartbeat per boot
+	 * with both the 1 s and the 10 s argument), so the sampler runs as a
+	 * short, self-terminating burst instead - N samples one second apart,
+	 * then stop. Bump the count while bisecting.
+	 */
+	if (sweet_wdt_burst < SWEET_WDT_BURST) {
+		sweet_wdt_burst++;
+		thread_call_enter_delayed(sweet_wdt_call, mach_absolute_time() + 1000000000ULL);
+	}
+}
+
+static void sweet_wdt_schedule(void);
+
+void
+sweet_wdt_thread_start(void)
+{
+	if (sweet_wdt_call != NULL) {
+		return;
+	}
+	sweet_wdt_call = thread_call_allocate(sweet_wdt_sample, NULL);
+	sweet_wdt_schedule();
+}
+
+/* Re-arm one second out, from inside the callback as well as at start. */
+static void
+sweet_wdt_schedule(void)
+{
+	if (sweet_wdt_call != NULL) {
+		thread_call_enter_delayed(sweet_wdt_call, mach_absolute_time() + 1000000000ULL);
+	}
+}
 
