+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Block trace for named processes (boot-arg sweetblock=Name): records, for each
+ * block of that process, the continuation it parks on and the waitq type.
+ * SpringBoard never reaches ipc_mqueue_receive (NOTES 19:10), so the block has
+ * to be observed at thread_block() instead of at the IPC layer.
+ *
+ * The process name is taken from the BSD proc through a helper that lives in
+ * bsd/kern/kern_proc.c, because including <sys/proc.h> here clashes with the
+ * osfmk typedefs.
+ */
+/*
+ * SWEET block ring: scalars only, no console I/O (printing here hung the boot,
+ * NOTES 20:50). thread_block_reason() stores (tid, continuation, waitq type,
+ * event) into a lock-free ring; the dump path empties it later.
+ */
+#define SWEET_BLOCK_RING 256
+struct sweet_block_rec {
+	uint64_t tid;
+	uint64_t cont;
+	uint64_t ev;
+	uint32_t wqt;
+	uint32_t seq;
+};
+static struct sweet_block_rec sweet_block_ring[SWEET_BLOCK_RING];
+static volatile uint32_t sweet_block_head;
+
+void
+sweet_block_trace(thread_t th)
+{
+	/*
+	 * One store per field, no locks, no printing. If two threads race the
+	 * record is merely overwritten - this is a debug ring, not a journal.
+	 */
+	uint32_t i = __atomic_fetch_add(&sweet_block_head, 1, __ATOMIC_RELAXED);
+	struct sweet_block_rec *r = &sweet_block_ring[i % SWEET_BLOCK_RING];
+	r->tid = th->thread_id;
+	r->cont = (uint64_t)(uintptr_t)th->continuation;
+	r->ev = th->wait_event;
+	r->wqt = (th->waitq.wq_q != NULL) ?
+	    (uint32_t)th->waitq.wq_q->waitq_type : 0;
+	r->seq = i;
+}
+
+/* Called from the dump path: print the ring, newest last. */
+void
+sweet_block_ring_dump(void)
+{
+	uint32_t head = sweet_block_head;
+	uint32_t n = head < SWEET_BLOCK_RING ? head : SWEET_BLOCK_RING;
+	printf("SWEET BLOCKRING: %u blocks total, showing %u\n", head, n);
+	for (uint32_t k = 0; k < n; k++) {
+		struct sweet_block_rec *r = &sweet_block_ring[k % SWEET_BLOCK_RING];
+		printf("SWEET BLOCKRING: seq=%u tid=%llu cont=%llx wqt=%u ev=%llx\n",
+		    r->seq, (unsigned long long)r->tid,
+		    (unsigned long long)r->cont, r->wqt,
+		    (unsigned long long)r->ev);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET bring-up probe, minimal and safe: named processes are reported once at
+ * exec with their thread count. Walking the thread list from the exec path
+ * hung the boot twice (NOTES 15:28, 15:52) - the exec thread owns that queue
+ * while it runs, so only scalars are read here.
+ */
+static char sweet_dump_names[64];
+static bool sweet_dump_parsed;
+static unsigned sweet_dump_count;
+
+#define SWEET_TRACK_MAX 4
+struct sweet_track {
+	task_t task;                 /* pending sample, TASK_NULL when free */
+	char name[48];
+	unsigned round;              /* samples taken so far */
+	unsigned wait;               /* execs to skip before the next sample */
+};
+static struct sweet_track sweet_track[SWEET_TRACK_MAX];
+static task_t sweet_later_task = TASK_NULL;   /* unused, kept for clarity */
+static char sweet_later_name[48];
+static unsigned sweet_dump_round;
+static unsigned sweet_dump_wait_execs;
+static unsigned sweet_dump_now_tick;
+static unsigned sweet_dump_target_tick;
+
+/* Print one task's threads (scalars only; no task lock is taken). */
+static void
+sweet_dump_walk(task_t task, const char *why)
+{
+	thread_t th;
+	unsigned n = 0;
+
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (n++ >= 64) {
+			break;
+		}
+		/*
+		 * The waitq type says what the thread is waiting *on*: WQT_QUEUE is
+		 * a global event queue (its eventmask names the events), WQT_PORT a
+		 * port, WQT_TURNSTILE a lock owner.
+		 */
+		unsigned wqt = 0;
+		unsigned long long mask = 0;
+		const char *kind = "?";
+		if (th->waitq.wq_q != NULL) {
+			wqt = (unsigned)th->waitq.wq_q->waitq_type;
+			mask = (unsigned long long)th->waitq.wq_q->waitq_eventmask;
+			/*
+			 * WQT_PORT is a port message queue: the wq pointer lives inside
+			 * the ipc_port_t being received from. For a port wait the waitq
+			 * address - (offsetof(ipc_port_t, ip_messages)) is the port
+			 * object, whose port_name we can show, so the log names the port
+			 * the main thread is blocked on instead of a raw pointer.
+			 */
+			kind = wqt == 3 ? "PORT" : wqt == 1 ? "QUEUE" : wqt == 2 ? "TURNSTILE" : "OTHER";
+		}
+		/*
+		 * For a port wait the waitq sits inside the ipc_port_t, so the port
+		 * object is at a fixed offset from it. Its receive name and kobject
+		 * identify the service the thread is blocked on.
+		 */
+		bool have_port = false;
+		/*
+		 * For a port wait the waitq sits inside the ipc_port_t. Only the
+		 * *count* of enqueued waiters is printed: ip_kobject is PAC-signed and
+		 * ip_receiver_name is a name in the receiver's space, so neither can
+		 * be dereferenced from here.
+		 */
+		unsigned msgs = 0, qlimit = 0, port_active = 0, port_msgs_hint = 0;
+		if (wqt == 3 && th->waitq.wq_q != NULL) {
+			ipc_port_t port = (ipc_port_t)((char *)th->waitq.wq_q -
+			    offsetof(struct ipc_port, ip_messages));
+			msgs = (unsigned)port->ip_messages.imq_msgcount;
+			qlimit = (unsigned)port->ip_messages.imq_qlimit;
+			/* Is the port the thread waits on still alive? */
+			port_active = ip_active(port) ? 1 : 0;
+			port_msgs_hint = (unsigned)port->ip_messages.imq_seqno;
+			have_port = true;
+		}
+		printf("SWEET THREADS: %s tid=%llu run=%d state=%x susp=%d ev=%llu wq=%s mask=%llx%s msgs=%u/%u active=%u seq=%u\n",
+		    why, (unsigned long long)th->thread_id,
+		    (th->state & TH_RUN) ? 1 : 0, th->state, (int)th->suspend_count,
+		    (unsigned long long)th->wait_event, kind, mask,
+		    have_port ? " PORT" : "", msgs, qlimit, port_active, port_msgs_hint);
+	}
+	if (n == 0) {
+		printf("SWEET THREADS: %s has no threads\n", why);
+	}
+}
+
+/* Called once per second from the watchdog thread (known-good context). */
+void
+sweet_dump_tick(void)
+{
+	sweet_dump_now_tick++;
+	if (sweet_later_task == TASK_NULL || sweet_dump_target_tick == 0 ||
+	    sweet_dump_now_tick < sweet_dump_target_tick) {
+		return;
+	}
+	sweet_dump_target_tick = 0;
+	task_t task = sweet_later_task;
+	sweet_later_task = TASK_NULL;
+	printf("SWEET THREADS: %s now, threads=%d\n", sweet_later_name,
+	    task->thread_count);
+	sweet_dump_walk(task, sweet_later_name);
+	task_deallocate(task);
+}
+
+/*
+ * The other half of sweetblock (NOTES 2026-10-22 19:34): a process that blocks
+ * inside its own exec never shows up in the thread_block trace under its
+ * SpringBoard name, because it still runs under the exec'd-away name
+ * (xpcproxy/launchd). Observe the block through the task instead of the name:
+ * at the exec of a sweetblock=Name process, arm the *task* - the next thread of
+ * that task to assert_wait is the one to report, whatever name it has.
+ *
+ * Armed from kern_exec.c right after the image activation, before the exec
+ * syscall returns; a thread call 100 ms later disarms everything, so only the
+ * exec path itself (and a hair after it) is sampled - one atomic, no lock.
+ */
+static unsigned sweet_armed;            /* 1 = armed (see sweet_fast_exec_arm) */
+static unsigned sweet_armed_lines;
+static unsigned long long sweet_armed_tid;
+static char sweet_armed_name[48];
+static thread_call_t sweet_disarm_call;
+
+static void
+sweet_fast_disarm_cb(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	sweet_armed = 0;
+}
+
+void
+sweet_fast_exec_arm(task_t task, const char *name)
+{
+	if (sweet_armed_name[0] != '\0' || task == TASK_NULL) {
+		return;   /* armed already */
+	}
+	if (!PE_parse_boot_argn("sweetfast", sweet_armed_name,
+	    sizeof(sweet_armed_name))) {
+		return;
+	}
+	if (strncmp(name, sweet_armed_name, sizeof(sweet_armed_name)) != 0) {
+		sweet_armed_name[0] = '\0';
+		return;
+	}
+	strlcpy(sweet_armed_name, name, sizeof(sweet_armed_name));
+	OSCompareAndSwap(0, (uint32_t)(uintptr_t)VM_KERNEL_ADDRPERM((vm_offset_t)(uintptr_t)task), &sweet_armed);
+}
+
+/* Called from the top of thread_block() (osfmk/kern/sched_prim.c). */
+void
+sweet_fast_exec_block(thread_t th)
+{
+	uint32_t armed = sweet_armed;
+	if (armed == 0 || armed != (uint32_t)VM_KERNEL_ADDRPERM((vm_offset_t)(uintptr_t)get_threadtask(th))) {
+		return;
+	}
+	sweet_armed = 0;
+	{
+		/* Stage trace (sweetstage=): the exec block itself was reached. */
+		extern void sweet_stage(uint32_t, uint32_t);
+		sweet_stage(0x3000, (uint32_t)th->thread_id);
+	}
+	if (sweet_disarm_call == NULL) {
+		sweet_disarm_call = thread_call_allocate(sweet_fast_disarm_cb, NULL);
+	}
+	if (sweet_disarm_call != NULL) {
+		thread_call_enter_delayed(sweet_disarm_call, mach_absolute_time() + 1000000000ULL);
+	}
+	if (sweet_armed_lines >= 20) {
+		return;
+	}
+	sweet_armed_lines++;
+	unsigned wqt = 0;
+	if (th->waitq.wq_q != NULL) {
+		wqt = (unsigned)th->waitq.wq_q->waitq_type;
+	}
+	/*
+	 * Caller chain (innermost first; __builtin_return_address needs constant
+	 * levels, and deep frames may be worthless without frame pointers, so
+	 * each is only read while the previous one was non-zero).
+	 */
+	void *ra0 = __builtin_return_address(0);
+	void *ra1 = ra0 ? __builtin_return_address(1) : NULL;
+	void *ra2 = ra1 ? __builtin_return_address(2) : NULL;
+	void *ra3 = ra2 ? __builtin_return_address(3) : NULL;
+	printf("SWEET FASTBLOCK: %s tid=%llu state=%x wqt=%u ev=%llu ra0=%p ra1=%p ra2=%p ra3=%p\n",
+	    sweet_armed_name, (unsigned long long)th->thread_id, th->state, wqt,
+	    (unsigned long long)th->wait_event, ra0, ra1, ra2, ra3);
+}
+
+/*
+ * Called from kern_exec.c right after the arm: the exec syscall normally does
+ * not block again, but the thread call is unarmed if it is missing.
+ */
+void
+sweet_fast_exec_later(void)
+{
+	if (sweet_disarm_call == NULL) {
+		sweet_disarm_call = thread_call_allocate(sweet_fast_disarm_cb, NULL);
+	}
+	if (sweet_disarm_call != NULL) {
+		thread_call_enter_delayed(sweet_disarm_call, mach_absolute_time() + 1000000000ULL);
+	}
+}
+
+/*
+ * Trace of every posix_spawn START_SUSPENDED hook: the launcher suspends the
+ * new task and resumes it through proc_track_child(psa, pid). If the resume
+ * never matches the track entry, the process stays suspended for good - the
+ * one mechanism that fits "thread in TH_WAIT that never blocks" (NOTES
+ * 2026-10-22 19:34). Boot-arg sweetpsx=1.
+ */
+static bool sweet_psx_parsed;
+static unsigned sweet_psx_on;
+
+static void
+sweet_psx_parse(void)
+{
+	if (sweet_psx_parsed) {
+		return;
+	}
+	sweet_psx_parsed = true;
+	if (!PE_parse_boot_argn("sweetpsx", &sweet_psx_on, sizeof(sweet_psx_on))) {
+		sweet_psx_on = 0;
+	}
+}
+
+void
+sweet_psx_track(task_t task, const char *name, int pid, int flags)
+{
+	sweet_psx_parse();
+	if (!sweet_psx_on) {
+		return;
+	}
+	printf("SWEET PSX: exec %s flags=%x spawn=%d threads=%d\n",
+	    name, flags, pid,
+	    task == TASK_NULL ? -1 : task->thread_count);
+}
+
+void
+sweet_dump_threads_soon(task_t task, const char *name)
+{
+	if (!sweet_dump_parsed) {
+		sweet_dump_parsed = true;
+		if (!PE_parse_boot_argn("sweetdump", sweet_dump_names,
+		    sizeof(sweet_dump_names))) {
+			sweet_dump_names[0] = '\0';
+		}
+	}
+	if (sweet_dump_names[0] == '\0' || task == TASK_NULL) {
+		return;
+	}
+	/* Pace and run every tracked target. */
+	for (int i = 0; i < SWEET_TRACK_MAX; i++) {
+		struct sweet_track *t = &sweet_track[i];
+		if (t->task == TASK_NULL) {
+			continue;
+		}
+		if (t->wait > 0) {
+			t->wait--;
+			continue;
+		}
+		task_t pending = t->task;
+		t->round++;
+		printf("SWEET THREADS: %s sample %u, threads=%d (at %s exec)\n",
+		    t->name, t->round, pending->thread_count, name);
+		sweet_dump_walk(pending, t->name);
+		if (t->round < 3) {
+			t->wait = t->round == 1 ? 20 : 120;
+		} else {
+			task_deallocate(pending);
+			t->task = TASK_NULL;
+		}
+	}
+	sweet_dump_count++;
+	printf("SWEET THREADS: %s exec, threads=%d\n", name, task->thread_count);
+	/*
+	 * The interesting state is seconds later. A thread call queued here did
+	 * not fire (NOTES 16:21), so the dump is driven from the watchdog's 1 Hz
+	 * sample instead: osfmk/kern/task.c exposes sweet_dump_tick(), which the
+	 * SweetWatchdog thread calls, and that path is a normal blocking-context
+	 * thread call that is known to work.
+	 */
+	/* Only exact names in the list (a prefix match caught "launchd" for
+	 * "ld" style entries and wasted the sample slots). */
+	{
+		const char *cand = sweet_dump_names;
+		bool hit = false;
+		while (*cand) {
+			const char *end = strchr(cand, ',');
+			size_t len = end ? (size_t)(end - cand) : strlen(cand);
+			if (len == strlen(name) && strncmp(cand, name, len) == 0) {
+				hit = true;
+				break;
+			}
+			if (!end) {
+				break;
+			}
+			cand = end + 1;
+		}
+		if (!hit) {
+			return;
+		}
+	}
+	for (int i = 0; i < SWEET_TRACK_MAX; i++) {
+		struct sweet_track *t = &sweet_track[i];
+		if (t->task != TASK_NULL) {
+			continue;
+		}
+		task_reference(task);
+		t->task = task;
+		strlcpy(t->name, name, sizeof(t->name));
+		t->round = 0;
+		t->wait = 0;
+		printf("SWEET THREADS: tracking %s\n", name);
+		{
+			/* Empty the ring that collected blocks before this exec. */
+			extern void sweet_block_ring_dump(void);
+			sweet_block_ring_dump();
+		}
+		break;
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
