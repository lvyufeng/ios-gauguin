+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* SWEET_EAGL_DENIED_GET8_BEGIN */
+static void
+sweet_eagl_log_denied_get8(proc_t p, const struct memorystatus_control_args *args)
+{
+	memorystatus_memlimit_properties_t limits;
+	if (args->command != MEMORYSTATUS_CMD_GET_MEMLIMIT_PROPERTIES ||
+	    args->pid != proc_pid(p) || args->flags != 0 || args->buffer == USER_ADDR_NULL ||
+	    args->buffersize != sizeof(limits) || !sweet_eagl_diagnostic_caller(p)) {
+		return;
+	}
+	/* Same kernel snapshot as GET8. The caller still receives EPERM. */
+	memorystatus_get_memlimit_properties_internal(p, &limits);
+	printf("SWEET EAGL MEMLIMIT: pid=%d active_mb=%d active_attr=%u inactive_mb=%d inactive_attr=%u\n",
+	    proc_pid(p), limits.memlimit_active, limits.memlimit_active_attr,
+	    limits.memlimit_inactive, limits.memlimit_inactive_attr);
+}
+/* SWEET_EAGL_DENIED_GET8_END */
+#endif
+
 int
 memorystatus_control(struct proc *p, struct memorystatus_control_args *args, int *ret)
 {
