+void
+AppleCLCD::attachReadyEvent()
+{
+    IOLock *lock = __atomic_load_n(&gReadyLock, __ATOMIC_ACQUIRE);
+    if (!lock) {
+        IOLock *created = IOLockAlloc();
+        if (!created) return;
+        if (__atomic_compare_exchange_n(&gReadyLock, &lock, created, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+            lock = created;
+        else
+            IOLockFree(created);
+    }
+    auto *event = IOInterruptEventSource::interruptEventSource(this, &AppleCLCD::readyEventFired);
+    if (!event) return;
+    if (fWorkLoop->addEventSource(event) != kIOReturnSuccess) {
+        event->release();
+        return;
+    }
+    event->enable();
+    IOLockLock(lock);
+    if (!gReadySource) gReadySource = fReadyEvent = event;
+    IOLockUnlock(lock);
+    if (!fReadyEvent) {
+        fWorkLoop->removeEventSource(event);
+        event->release();
+    }
+}
+
+void
+AppleCLCD::stop(IOService *provider)
+{
+    IOInterruptEventSource *event = nullptr;
+    if (fLock) {
+        IOLockLock(fLock);
+        event = fReadyEvent;
+        clearReadyTicketLocked();
+        fReadyEvent = nullptr;
+        IOLockUnlock(fLock);
+    }
+    if (event) {
+        IOLock *lock = __atomic_load_n(&gReadyLock, __ATOMIC_ACQUIRE);
+        IOLockLock(lock);
+        gReadySource = nullptr;
+        gReadySignal = {};
+        IOLockUnlock(lock);
+        fWorkLoop->removeEventSource(event);
+        event->release();
+    }
+    IOMobileFramebuffer::stop(provider);
+}
+
+void
+AppleCLCD::clearReadyTicketLocked()
