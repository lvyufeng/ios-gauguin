+{return alive_time(c)&&c->ops.read_reg(c->ops.cookie,r,v)&&alive_time(c);}
+static bool poll_mr(struct ggr_context *c,enum ggr_memory m,uint32_t off,uint32_t *v)
+{return alive_time(c)&&c->ops.read_memory(c->ops.cookie,m,off,v)&&alive_time(c);}
+static bool poll_barrier(struct ggr_context *c)
