+static bool current(struct gss_session *s)
+{
+    if (!s->owner->current(s->owner->cookie, s->generation)) {
+        s->report.ownership_lost = true;
+        return false;
+    }
+    return true;
+}
+static int rd(struct gss_session *s, enum gss_space space, uint32_t off, uint32_t *v)
+{
+    if (!current(s)) return GSS_OWNERSHIP;
+    *v = s->owner->read32(s->owner->cookie, s->generation, space, off);
+    return current(s) ? GSS_OK : GSS_OWNERSHIP;
+}
+static int wr(struct gss_session *s, uint32_t off, uint32_t v)
+{
+    if (!current(s)) return GSS_OWNERSHIP;
+    s->owner->write32(s->owner->cookie, s->generation, GSS_SE, off, v);
+    if (!current(s)) return GSS_OWNERSHIP;
+    s->owner->barrier(s->owner->cookie, s->generation);
+    return current(s) ? GSS_OK : GSS_OWNERSHIP;
+}
+static int idle(struct gss_session *s)
+{
+    uint32_t status, tx, rx;
+    if (rd(s, GSS_SE, STATUS, &status) || rd(s, GSS_SE, TX_STATUS, &tx) ||
+        rd(s, GSS_SE, RX_STATUS, &rx)) return GSS_OWNERSHIP;
+    return (status & 0x1001) || (tx & 0x0fffffff) || (rx & 0x01ffffff) ?
+        GSS_BUSY : GSS_OK;
