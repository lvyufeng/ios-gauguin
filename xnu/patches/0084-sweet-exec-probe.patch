diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
index 67c5f79..02add39 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -109,6 +109,7 @@
 #include <kern/kern_types.h>
 #include <kern/mach_param.h>
 #include <kern/misc_protos.h>
+#include <ipc/ipc_port.h>
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <kern/coalition.h>
@@ -2510,6 +2511,194 @@ task_clear_corpse(task_t task)
 	task_unlock(task);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET bring-up probe, minimal and safe: named processes are reported once at
+ * exec with their thread count. Walking the thread list from the exec path
+ * hung the boot twice (NOTES 15:28, 15:52) - the exec thread owns that queue
+ * while it runs, so only scalars are read here.
+ */
+static char sweet_dump_names[64];
+static bool sweet_dump_parsed;
+static unsigned sweet_dump_count;
+
+#define SWEET_TRACK_MAX 4
+struct sweet_track {
+	task_t task;                 /* pending sample, TASK_NULL when free */
+	char name[48];
+	unsigned round;              /* samples taken so far */
+	unsigned wait;               /* execs to skip before the next sample */
+};
+static struct sweet_track sweet_track[SWEET_TRACK_MAX];
+static task_t sweet_later_task = TASK_NULL;   /* unused, kept for clarity */
+static char sweet_later_name[48];
+static unsigned sweet_dump_round;
+static unsigned sweet_dump_wait_execs;
+static unsigned sweet_dump_now_tick;
+static unsigned sweet_dump_target_tick;
+
+/* Print one task's threads (scalars only; no task lock is taken). */
+static void
+sweet_dump_walk(task_t task, const char *why)
+{
+	thread_t th;
+	unsigned n = 0;
+
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (n++ >= 64) {
+			break;
+		}
+		/*
+		 * The waitq type says what the thread is waiting *on*: WQT_QUEUE is
+		 * a global event queue (its eventmask names the events), WQT_PORT a
+		 * port, WQT_TURNSTILE a lock owner.
+		 */
+		unsigned wqt = 0;
+		unsigned long long mask = 0;
+		const char *kind = "?";
+		if (th->waitq.wq_q != NULL) {
+			wqt = (unsigned)th->waitq.wq_q->waitq_type;
+			mask = (unsigned long long)th->waitq.wq_q->waitq_eventmask;
+			/*
+			 * WQT_PORT is a port message queue: the wq pointer lives inside
+			 * the ipc_port_t being received from. For a port wait the waitq
+			 * address - (offsetof(ipc_port_t, ip_messages)) is the port
+			 * object, whose port_name we can show, so the log names the port
+			 * the main thread is blocked on instead of a raw pointer.
+			 */
+			kind = wqt == 3 ? "PORT" : wqt == 1 ? "QUEUE" : wqt == 2 ? "TURNSTILE" : "OTHER";
+		}
+		/*
+		 * For a port wait the waitq sits inside the ipc_port_t, so the port
+		 * object is at a fixed offset from it. Its receive name and kobject
+		 * identify the service the thread is blocked on.
+		 */
+		bool have_port = false;
+		/*
+		 * For a port wait the waitq sits inside the ipc_port_t. Only the
+		 * *count* of enqueued waiters is printed: ip_kobject is PAC-signed and
+		 * ip_receiver_name is a name in the receiver's space, so neither can
+		 * be dereferenced from here.
+		 */
+		unsigned msgs = 0, qlimit = 0;
+		if (wqt == 3 && th->waitq.wq_q != NULL) {
+			ipc_port_t port = (ipc_port_t)((char *)th->waitq.wq_q -
+			    offsetof(struct ipc_port, ip_messages));
+			msgs = (unsigned)port->ip_messages.imq_msgcount;
+			qlimit = (unsigned)port->ip_messages.imq_qlimit;
+			have_port = true;
+		}
+		printf("SWEET THREADS: %s tid=%llu run=%d state=%x ev=%llu wq=%s mask=%llx%s msgs=%u/%u\n",
+		    why, (unsigned long long)th->thread_id,
+		    (th->state & TH_RUN) ? 1 : 0, th->state,
+		    (unsigned long long)th->wait_event, kind, mask,
+		    have_port ? " PORT" : "", msgs, qlimit);
+	}
+	if (n == 0) {
+		printf("SWEET THREADS: %s has no threads\n", why);
+	}
+}
+
+/* Called once per second from the watchdog thread (known-good context). */
+void
+sweet_dump_tick(void)
+{
+	sweet_dump_now_tick++;
+	if (sweet_later_task == TASK_NULL || sweet_dump_target_tick == 0 ||
+	    sweet_dump_now_tick < sweet_dump_target_tick) {
+		return;
+	}
+	sweet_dump_target_tick = 0;
+	task_t task = sweet_later_task;
+	sweet_later_task = TASK_NULL;
+	printf("SWEET THREADS: %s now, threads=%d\n", sweet_later_name,
+	    task->thread_count);
+	sweet_dump_walk(task, sweet_later_name);
+	task_deallocate(task);
+}
+
+void
+sweet_dump_threads_soon(task_t task, const char *name)
+{
+	if (!sweet_dump_parsed) {
+		sweet_dump_parsed = true;
+		if (!PE_parse_boot_argn("sweetdump", sweet_dump_names,
+		    sizeof(sweet_dump_names))) {
+			sweet_dump_names[0] = '\0';
+		}
+	}
+	if (sweet_dump_names[0] == '\0' || task == TASK_NULL) {
+		return;
+	}
+	/* Pace and run every tracked target. */
+	for (int i = 0; i < SWEET_TRACK_MAX; i++) {
+		struct sweet_track *t = &sweet_track[i];
+		if (t->task == TASK_NULL) {
+			continue;
+		}
+		if (t->wait > 0) {
+			t->wait--;
+			continue;
+		}
+		task_t pending = t->task;
+		t->round++;
+		printf("SWEET THREADS: %s sample %u, threads=%d (at %s exec)\n",
+		    t->name, t->round, pending->thread_count, name);
+		sweet_dump_walk(pending, t->name);
+		if (t->round < 3) {
+			t->wait = t->round == 1 ? 20 : 120;
+		} else {
+			task_deallocate(pending);
+			t->task = TASK_NULL;
+		}
+	}
+	sweet_dump_count++;
+	printf("SWEET THREADS: %s exec, threads=%d\n", name, task->thread_count);
+	/*
+	 * The interesting state is seconds later. A thread call queued here did
+	 * not fire (NOTES 16:21), so the dump is driven from the watchdog's 1 Hz
+	 * sample instead: osfmk/kern/task.c exposes sweet_dump_tick(), which the
+	 * SweetWatchdog thread calls, and that path is a normal blocking-context
+	 * thread call that is known to work.
+	 */
+	/* Only exact names in the list (a prefix match caught "launchd" for
+	 * "ld" style entries and wasted the sample slots). */
+	{
+		const char *cand = sweet_dump_names;
+		bool hit = false;
+		while (*cand) {
+			const char *end = strchr(cand, ',');
+			size_t len = end ? (size_t)(end - cand) : strlen(cand);
+			if (len == strlen(name) && strncmp(cand, name, len) == 0) {
+				hit = true;
+				break;
+			}
+			if (!end) {
+				break;
+			}
+			cand = end + 1;
+		}
+		if (!hit) {
+			return;
+		}
+	}
+	for (int i = 0; i < SWEET_TRACK_MAX; i++) {
+		struct sweet_track *t = &sweet_track[i];
+		if (t->task != TASK_NULL) {
+			continue;
+		}
+		task_reference(task);
+		t->task = task;
+		strlcpy(t->name, name, sizeof(t->name));
+		t->round = 0;
+		t->wait = 0;
+		printf("SWEET THREADS: tracking %s\n", name);
+		break;
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+
 /*
  *	task_port_no_senders
  *
