+/* Fixed native IB fetch + no-IRQ end-of-pipeline timestamp completion. */
+#include <string.h>
+#include "gauguin_gpu_eop.h"
+static bool span(const void *p,size_t n)
+{return p&&n&&(uintptr_t)p<=UINTPTR_MAX-(n-1);}
+static bool overlap(const void *a,size_t an,const void *b,size_t bn)
+{uintptr_t x=(uintptr_t)a,y=(uintptr_t)b;return x<=y?y-x<an:x-y<bn;}
+bool gge_command_build(const struct ggd_plan *p,struct gge_command *out)
+{
+    if(!span(p,sizeof(*p))||!span(out,sizeof(*out))||overlap(p,sizeof(*p),out,sizeof(*out))||
+       !ggd_plan_valid(p))return false;
+    const struct ggp_region *r=&p->bootstrap.region[GGP_RING];
+    if(r->mapped!=32768||r->reserved!=32768||r->privileged||!r->readonly||r->executable||
+       GGE_IB_OFFSET<4*GGE_END_DWORD||GGE_IB_OFFSET+4*GGE_IB_WORDS>r->mapped)return false;
+    struct ggd_write_command write;if(!ggd_write_command_build(p,&write))return false;
+    struct gge_command c={0};memcpy(c.ib,write.word,sizeof(c.ib));
+    c.ib[3]=GGE_FIRST_VALUE;c.ib[7]=GGE_LAST_VALUE;
+    /* Pinned normal user IB loop: cp_mem_packet(PFE,2,1), cp_gpuaddr64,
+     * (size>>2)&0xfffff. No IB_PRIV or protected-mode override. */
+    c.word[0]=GGE_IB_HEADER;c.word[1]=r->iova+GGE_IB_OFFSET;c.word[3]=GGE_IB_WORDS;
+    /* Actual pinned no-context/noninternal EOP branch: CACHE_FLUSH_TS4,
+     * cp_mem_packet(EVENT_WRITE,3,1), cp_gpuaddr64, timestamp. No IRQ bit31. */
+    c.word[4]=GGE_EOP_HEADER;c.word[5]=GGE_EOP_EVENT;
+    c.word[6]=p->data.iova+GGE_EOP_OFFSET;c.word[8]=GGE_EOP_VALUE;
+    c.word[9]=0x70620002u;c.word[10]=p->bootstrap.region[GGP_SCRATCH].iova;
+    *out=c;return true;
+}
+struct gge_prefix {uint32_t word[GGE_START_DWORD];};
+bool gge_register_allowed(uint32_t reg,bool write)
+{
+    if(write)return reg==0x807||reg==0x1f8c3;
+    return reg==0x807||reg==0x201||reg==0x823||reg==0x23b13||
+        reg==0x23b0c||reg==0x1f888||reg==0x1f889;
+}
+static bool guard(struct gge_context *c)
+{return c->ops.guard(c->ops.cookie,(enum gge_phase)c->phase);}
+static enum gge_result sample(struct gge_context *c,bool mem,uint32_t reg,uint32_t expected,uint32_t actual)
+{c->diagnostic=(struct gge_diagnostic){1,mem,reg,expected,actual};return mem?GGE_MEMORY_ERROR:GGE_DIRTY_STATE;}
+static enum gge_result rd(struct gge_context *c,uint32_t reg,uint32_t *v)
+{
+    if(!guard(c))return GGE_GUARD;
+    ++c->work.reads;if(!c->ops.read32(c->ops.cookie,reg,v))return GGE_IO;
+    c->diagnostic=(struct gge_diagnostic){1,0,reg,0,*v};
+    return guard(c)?GGE_OK:GGE_GUARD;
+}
+static enum gge_result wr(struct gge_context *c,uint32_t reg,uint32_t v)
+{
+    if(!guard(c))return GGE_GUARD;
+    if(reg==0x807)c->work.submit_attempted=1;
+    if(reg==0x1f8c3){if(v)c->work.keepalive_set_attempted=1;else c->work.keepalive_clear_attempted=1;}
+    ++c->work.writes;if(!c->ops.write32(c->ops.cookie,reg,v))return GGE_IO;
+    return guard(c)?GGE_OK:GGE_GUARD;
+}
+static enum gge_result mr(struct gge_context *c,enum gge_memory mem,uint32_t off,uint32_t *v)
+{
+    if(!guard(c))return GGE_GUARD;
+    if(!c->ops.read_memory(c->ops.cookie,mem,off,v))return GGE_IO;
+    c->diagnostic=(struct gge_diagnostic){1,1,(mem==GGE_SCRATCH?0x10000u:mem==GGE_DATA?0x20000u:mem==GGE_IB?0x30000u:0u)+off,0,*v};
+    return guard(c)?GGE_OK:GGE_GUARD;
+}
+static enum gge_result barrier(struct gge_context *c)
+{
+    if(!guard(c))return GGE_GUARD;
+    if(!c->ops.barrier(c->ops.cookie))return GGE_IO;
+    return guard(c)?GGE_OK:GGE_GUARD;
+}
+static enum gge_result delay(struct gge_context *c)
+{
+    if(!guard(c))return GGE_GUARD;
+    if(!c->ops.delay_us(c->ops.cookie,10))return GGE_IO;
+    return guard(c)?GGE_OK:GGE_GUARD;
+}
+#define TRY(x) do{enum gge_result result=(x);if(result)return result;}while(0)
+static enum gge_result counter(struct gge_context *c,uint64_t *v)
+{
+    uint32_t h,l,h1;TRY(rd(c,0x1f889,&h));TRY(rd(c,0x1f888,&l));TRY(rd(c,0x1f889,&h1));
+    if(h!=h1)TRY(rd(c,0x1f888,&l));*v=((uint64_t)h1<<32)|l;return GGE_OK;
+}
+static enum gge_result faults(struct gge_context *c)
+{
+    TRY(rd(c,0x201,&c->work.rbbm_status));TRY(rd(c,0x823,&c->work.cp_status));
+    return (c->work.rbbm_status&GGQ_RBBM_ERRORS)||(c->work.cp_status&GGQ_CP_ERRORS)?GGE_FAULT:GGE_OK;
+}
+static enum gge_result capture(struct gge_context *c,const struct gge_prefix *prefix)
+{
+    TRY(faults(c));TRY(rd(c,0x807,&c->work.initial_wptr));
+    if(c->work.initial_wptr!=GGE_START_DWORD)return sample(c,false,0x807,GGE_START_DWORD,c->work.initial_wptr);
+    TRY(mr(c,GGE_SCRATCH,0,&c->work.initial_shadow));
+    if(c->work.initial_shadow!=GGE_START_DWORD)return sample(c,true,0x10000,GGE_START_DWORD,c->work.initial_shadow);
+    TRY(rd(c,0x23b0c,&c->work.initial_busy));
+    if(c->work.initial_busy&(1u<<23))return GGE_FAULT;
+    for(unsigned i=0;i<GGE_END_DWORD;i++){
+        uint32_t v,expected=i<GGE_START_DWORD?prefix->word[i]:0xaaaaaaaau;
+        TRY(mr(c,GGE_RING,4*i,&v));
+        if(v!=expected)return sample(c,true,4*i,expected,v);
+        if(i<GGE_START_DWORD)++c->work.prefix_checked;else ++c->work.clean_checked;
+    }
+    for(unsigned i=0;i<GGE_IB_WORDS;i++){
+        uint32_t v;TRY(mr(c,GGE_IB,4*i,&v));
+        if(v!=0xaaaaaaaau)return sample(c,true,0x30000u+4*i,0xaaaaaaaau,v);
+        ++c->work.ib_clean_checked;
+    }
+    for(unsigned i=0;i<GGD_DATA_BYTES/4;i++){
+        uint32_t v;TRY(mr(c,GGE_DATA,4*i,&v));
+        if(v!=GGE_DATA_SEED)return sample(c,true,0x20000u+4*i,GGE_DATA_SEED,v);
+        ++c->work.data_before_checked;
+    }
