+    TRY(compare_nc(c,GGL_RING,4*GGL_START_DWORD,GGL_COMMAND_WORDS,NULL,0xaaaaaaaau,&c->work.clean_checked));
+    TRY(compare_nc(c,GGL_IB,0,GGL_IB_WORDS,NULL,0xaaaaaaaau,&c->work.ib_clean_checked));
+    TRY(compare_nc(c,GGL_RESTORE,0,GGL_RESTORE_WORDS,NULL,0xaaaaaaaau,&c->work.restore_clean_checked));
