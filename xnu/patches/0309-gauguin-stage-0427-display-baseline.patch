+    }
+    cpu402.next_sample = tick + cpu402.sample_period;
+    const uint64_t sampled = mach_absolute_time();
+    const uint32_t cycles = cpu402_read((void *)cpu402.perf, CPU402_CYCLES);
+    const uint64_t after = mach_absolute_time();
+    scan402_record(CPU402_SAMPLE, sampled, after, index, cycles, hottest);
