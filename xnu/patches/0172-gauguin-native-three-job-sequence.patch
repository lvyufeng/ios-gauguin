+static bool overlap(const void *a,size_t an,const void *b,size_t bn)
+{return (uintptr_t)a<(uintptr_t)b+bn&&(uintptr_t)b<(uintptr_t)a+an;}
+static const struct sequence172_native_blob *native_blob(unsigned job,unsigned id)
+{return job<GGJ_JOBS&&id<GGJ_BLOBS?&sequence172_blobs[job][id]:NULL;}
+bool ggj_blob_get(unsigned job,unsigned id,struct ggj_blob *out)
+{
+    const struct sequence172_native_blob *n=native_blob(job,id);
+    if(!n||!span(out,sizeof(*out)))return false;
+    struct ggj_blob b={0};
+    if(n->words){
+        if(!n->data||n->iova<SEQUENCE172_RING_BASE+4096u||n->iova%128u||
+           !n->gpu_serialized_extent||n->gpu_serialized_extent%128u||
+           n->words>n->cpu_requested_capacity/4u||n->words>n->gpu_serialized_extent/4u||
+           n->iova-SEQUENCE172_RING_BASE>SEQUENCE172_RING_BYTES||
+           n->gpu_serialized_extent>SEQUENCE172_RING_BYTES-(n->iova-SEQUENCE172_RING_BASE))return false;
+        b=(struct ggj_blob){n->iova-SEQUENCE172_RING_BASE,n->gpu_serialized_extent/4u,n->words};
+    }else if(n->iova||n->gpu_serialized_extent||n->data||n->cpu_requested_capacity)return false;
