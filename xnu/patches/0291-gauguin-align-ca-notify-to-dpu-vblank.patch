+/* Observed DPU phase and notification timing for the 60 Hz trial.
+ * Limits use the qualified 19.2 MHz absolute clock. */
+#ifndef GAUGUIN_FRAME380_PHASE_H
+#define GAUGUIN_FRAME380_PHASE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+    F380_HISTORY = 20,
+    F380_MAX_BRACKET = 57600,        /* 3 ms */
+    F380_MIN_SAMPLE_PERIOD = 259200, /* 13.5 ms */
+    F380_MAX_SAMPLE_PERIOD = 379200, /* 19.75 ms */
+    F380_MIN_PERIOD = 312000,        /* 16.25 ms */
+    F380_MAX_PERIOD = 328320,        /* 17.1 ms */
+    F380_LEAD = 76800,               /* 4 ms */
+    F380_MIN_NOTIFY_GAP = 230400,    /* 12 ms */
+    F380_MAX_AGE = 768000,           /* 40 ms */
+    F380_FALLBACK = 768000,          /* 40 ms after a missed notification */
+    F380_MAX_CONSECUTIVE_MISSES = 3,
+    F380_MAX_WAKE_AHEAD = 460800,    /* 24 ms */
+    F380_FIRST_SAMPLE = 1,
+    F380_SAMPLE_STEP = 128,
+    F380_SAMPLES = 24
+};
+
+struct f380_prediction {
+    uint64_t edge, observed, period;
+    uint32_t frame; /* last observed scan, not the predicted scan */
+};
+
+struct f380_fit {
+    uint64_t midpoints[F380_HISTORY], previous;
+    uint32_t frame;
+    unsigned count, next;
+};
+
+struct f380_wake {
+    uint64_t wake, edge, observed;
+    uint32_t scan, source;
+};
+
+struct f380_sent {
+    uint64_t tick;
+    uint32_t scan;
+    bool has_scan;
+};
+
+static inline bool
+f380_fit_add(struct f380_fit *fit, uint32_t frame, uint64_t lo, uint64_t hi,
+    struct f380_prediction *out)
+{
+    if (!lo || lo >= hi || hi - lo > F380_MAX_BRACKET) {
+        fit->count = fit->next = 0;
+        return false;
+    }
+    const uint64_t point = lo + (hi - lo) / 2;
+    if (fit->count && (frame - fit->frame != 1 || point <= fit->previous ||
+        point - fit->previous < F380_MIN_SAMPLE_PERIOD ||
+        point - fit->previous > F380_MAX_SAMPLE_PERIOD)) {
+        fit->count = fit->next = 0;
+    }
+    fit->midpoints[fit->next] = point;
+    fit->next = (fit->next + 1) % F380_HISTORY;
+    fit->previous = point;
+    fit->frame = frame;
+    if (fit->count < F380_HISTORY) ++fit->count;
+    if (fit->count < F380_HISTORY) return false;
+
+    /* Fit x=0..19 relative to the first midpoint to bound products.
+     * sum(x)=190 and 20*sum(x*x)-sum(x)^2=13300. */
+    const uint64_t origin = fit->midpoints[fit->next];
+    uint64_t sum = 0, weighted = 0;
+    for (unsigned i = 0; i < F380_HISTORY; ++i) {
+        const uint64_t offset = fit->midpoints[(fit->next + i) % F380_HISTORY] - origin;
+        sum += offset;
+        weighted += i * offset;
+    }
+    const uint64_t covariance = 20 * weighted - 190 * sum;
+    const uint64_t period = (covariance + 6650) / 13300;
+    const uint64_t next = (sum * 13300 + covariance * 210 + 133000) / 266000;
+    if (period < F380_MIN_PERIOD || period > F380_MAX_PERIOD ||
+        origin > UINT64_MAX - next || origin + next <= hi) return false;
+    out->edge = origin + next;
+    out->observed = hi;
+    out->period = period;
+    out->frame = frame;
+    return true;
+}
+
+static inline bool
+f380_fresh(const struct f380_prediction *p, uint64_t now)
+{
+    return p->observed && now >= p->observed && now - p->observed <= F380_MAX_AGE &&
+        p->edge > p->observed && p->period >= F380_MIN_PERIOD && p->period <= F380_MAX_PERIOD;
+}
+
+static inline bool
+f380_newer(uint32_t scan, uint32_t previous)
+{
+    const uint32_t delta = scan - previous;
+    return delta && delta < (UINT32_C(1) << 31);
+}
+
+static inline bool
+f380_can_send(const struct f380_sent *sent, uint64_t now)
+{
+    return !sent->tick || (now >= sent->tick && now - sent->tick >= F380_MIN_NOTIFY_GAP);
+}
+
+static inline bool
+f380_pick(const struct f380_prediction *p, const struct f380_sent *sent, uint64_t now,
+    struct f380_wake *out)
+{
+    if (!f380_fresh(p, now)) return false;
+    for (unsigned i = 0; i < 4; ++i) {
+        const uint64_t advance = i * p->period;
+        if (p->edge > UINT64_MAX - advance) return false;
+        const uint64_t edge = p->edge + advance;
+        if (edge < F380_LEAD) continue;
+        const uint64_t wake = edge - F380_LEAD;
+        const uint32_t scan = p->frame + 1 + i;
+        if (wake < now || !f380_can_send(sent, wake) ||
+            (sent->has_scan && !f380_newer(scan, sent->scan))) continue;
+        if (wake - now > F380_MAX_WAKE_AHEAD || wake - p->observed > F380_MAX_AGE)
+            return false;
+        out->wake = wake;
+        out->edge = edge;
+        out->observed = p->observed;
+        out->scan = scan;
+        out->source = p->frame;
+        return true;
+    }
+    return false;
+}
+
+static inline bool
+f380_due(const struct f380_prediction *p, const struct f380_sent *sent,
+    const struct f380_wake *wake, uint64_t now)
+{
+    return f380_fresh(p, now) && wake->wake && now >= wake->wake && now < wake->edge &&
+        now >= wake->observed && now - wake->observed <= F380_MAX_AGE &&
+        f380_newer(wake->scan, p->frame) &&
+        (!sent->has_scan || f380_newer(wake->scan, sent->scan)) && f380_can_send(sent, now);
+}
+
+enum f380_notice { F380_SOFTWARE, F380_ALIGNED, F380_MISSED };
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+bool sweet_frame380_prediction(uint64_t, struct f380_prediction *);
+void sweet_frame380_notice(enum f380_notice, uint64_t, const struct f380_wake *);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
