+    {CLK_SEL, 7}, {M_CLK, 0xfff1},
+    {TX_PACK0, 0xfffff}, {TX_PACK1, 0xfffff}, {RX_PACK0, 0xfffff}, {RX_PACK1, 0xfffff},
