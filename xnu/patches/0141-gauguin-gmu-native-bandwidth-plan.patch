diff --git a/bsd/dev/gauguin_gmu_firmware.c b/bsd/dev/gauguin_gmu_firmware.c
--- a/bsd/dev/gauguin_gmu_firmware.c
+++ b/bsd/dev/gauguin_gmu_firmware.c
@@ -370,6 +370,75 @@
     table.word[38]=200000;
     *out=table;return true;
 }
+static const char bw_names[4][9]={"MC0","SH0","ACV","SN10"};
+static const uint32_t bw_addr[]={0x50000,0x50004,0x50080,0x50054};
+static const uint32_t bw_unit[]={2050000,3650000,1,530000};
+static const uint16_t bw_width[]={16,32,0,8};
+static const uint8_t bw_vcd[]={0,1,11,3};
+bool gmf_bw_plan_valid(const struct gmf_bw_plan *p)
+{
+    if(!span(p,sizeof(*p)))return false;
+    for(unsigned i=0;i<GMF_BW_RESOURCES;i++)if(p->db[i].address!=bw_addr[i]||
+        p->db[i].unit!=bw_unit[i]||p->db[i].width!=bw_width[i]||
+        p->db[i].vcd!=bw_vcd[i]||p->db[i].reserved)return false;
+    return true;
+}
+bool gmf_bw_plan_build(const struct ndb_entry *entries,struct gmf_bw_plan *out)
+{
+    if(!span(entries,GMF_BW_RESOURCES*sizeof(*entries))||!span(out,sizeof(*out))||
+       overlap(entries,GMF_BW_RESOURCES*sizeof(*entries),out,sizeof(*out)))return false;
+    struct gmf_bw_plan p={0};
+    for(unsigned i=0;i<GMF_BW_RESOURCES;i++){
+        struct gbcm_db db;
+        if(memcmp(entries[i].name,bw_names[i],sizeof(bw_names[i]))||
+           gbcm_decode(&entries[i],&db)!=GBCM_OK)return false;
+        /* Copy fields, never an uninitialized generic decoder padding byte. */
+        p.db[i].address=db.address;p.db[i].unit=db.unit;p.db[i].width=db.width;
+        p.db[i].bank_version=db.bank_version;p.db[i].vcd=db.vcd;p.db[i].reserved=db.reserved;
+    }
+    if(!gmf_bw_plan_valid(&p))return false;*out=p;return true;
+}
+static uint64_t bw_div(uint64_t n,uint32_t base)
+{return n&&n<base?1:n/base;}
+static uint32_t bw_command(uint64_t vote)
+{
+    /* Every captured command has a distinct VCD and is its group's last
+     * command. Native marks valid only for nonzero votes and caps14 bits. */
+    return 0x40000000u|(vote?0x20000000u:0u)|(uint32_t)(vote>0x3fffu?0x3fffu:vote);
+}
+bool gmf_bw_table_build(const struct gmf_bw_plan *plan,uint32_t sequence,
+    struct gmf_bw_table *out)
+{
+    if(!span(plan,sizeof(*plan))||!span(out,sizeof(*out))||
+       overlap(plan,sizeof(*plan),out,sizeof(*out))||!sequence||sequence>4095||
+       !gmf_bw_plan_valid(plan))return false;
+    /* Exact live DT vectors-KBps converted by native KBTOB(*1000); AB0.
+     * Preserve1804800, not a rounded1800000. GPU->DDR passes LLCC16 and
+     * EBI4; GPU->CNOC passes GEMNOC8 with the SN10 BCM. */
+    static const uint32_t kbps[]={0,400000,800000,1200000,1804800,2188000,
+        2724000,3072000,4068000,5412000,6220000,7216000,8371200};
+    struct gmf_bw_table table={0};
+    table.word[0]=(sequence<<20)|(GMF_BW_WORDS<<8)|3u;
+    table.word[1]=13;table.word[2]=1;table.word[3]=3;
+    /* Native zero-initialized TCS records never set wait in query generation.
+     * Its build_rpmh_bw_votes therefore yields both wait masks0. */
+    table.word[6]=plan->db[3].address;
+    table.word[12]=bw_command(0);
+    table.word[18]=bw_command(bw_div(bw_div(UINT64_C(100000)*plan->db[3].width,8),plan->db[3].unit));
+    for(unsigned i=0;i<3;i++)table.word[24+i]=plan->db[i].address;
+    for(unsigned i=0;i<13;i++){
+        uint64_t ib=(uint64_t)kbps[i]*1000;
+        uint64_t mc=bw_div(bw_div(ib*plan->db[0].width,4),plan->db[0].unit);
+        uint64_t sh=bw_div(bw_div(ib*plan->db[1].width,16),plan->db[1].unit);
+        /* Native EBI lists MC0 before width0 ACV, retaining MC0's normalized
+         * intermediate in bcm_query_bus_req. Exact native oracle confirms
+         * ACV APPS8 for these nonzero rows and0 for the off row. */
+        table.word[32+8*i]=bw_command(mc);
+        table.word[33+8*i]=bw_command(sh);
+        table.word[34+8*i]=bw_command(mc?8:0);
+    }
+    *out=table;return true;
+}
