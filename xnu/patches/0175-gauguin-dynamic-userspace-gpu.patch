+/* Shared exact-shape/range checks are also used by the actual IOUserClient. */
+size_t ggr_request_size(uint32_t selector);
+bool ggr_command_range(const struct ggr_submit_cmd *, uint64_t buffer_bytes);
+bool ggr_user_span(uint64_t address, uint64_t bytes);
+bool ggr_timeout_valid(const struct ggr_timespec *);
+
+enum ggr_memory { GGR_RING, GGR_SHADOW, GGR_COMPLETION };
+enum ggr_state { GGR_COLD, GGR_READY, GGR_BUSY, GGR_FAILED };
+enum ggr_error { GGR_OK, GGR_ARGUMENT, GGR_UNAVAILABLE, GGR_IO, GGR_TIMEOUT };
+struct ggr_ops {
+    void *cookie;
+    bool (*healthy)(void *);
+    uint64_t (*nanoseconds)(void *);
+    bool (*read_reg)(void *,uint32_t,uint32_t *);
+    bool (*write_reg)(void *,uint32_t,uint32_t);
+    bool (*read_memory)(void *,enum ggr_memory,uint32_t,uint32_t *);
