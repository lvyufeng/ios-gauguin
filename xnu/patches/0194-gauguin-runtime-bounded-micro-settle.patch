+        IODelay(10);
+        if(ggrb_ns(NULL)>=end||mach_absolute_time()>=ggrb_end||
+           !gauguin_wdt_lease_check_budget(GMB_MIN)||
+           sweet_gmu_board_state()!=GMB_READY)break;
+        ++gfw_micro_sample.polls;
+        if(!gfw_observe32(NULL,0x6000,&current))break;
+        gfw_micro_sample.current=current;
+        if(ggrb_ns(NULL)>=end||mach_absolute_time()>=ggrb_end)break;
+        if((current&mask)==(expected&mask)){
+            recovered=true;++gfw_micro_sample.recovered;break;
+        }
+        if((current&mask)!=0x2270u)break;
+    }
+    uint64_t elapsed=(ggrb_ns(NULL)-start)/1000;
+    gfw_micro_sample.elapsed_us=elapsed>UINT32_MAX?UINT32_MAX:(uint32_t)elapsed;
+    return recovered;
+}
