 	if (!kauth_cred_issuser(kauth_cred_get()) && !IOCurrentTaskHasEntitlement(MEMORYSTATUS_ENTITLEMENT) && !skip_auth_check) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		sweet_eagl_log_denied_get8(p, args);
+#endif
 		error = EPERM;
 		goto out;
 	}
