+    c->diagnostic=(struct ggt_diagnostic){1,1,(mem==GGT_SCRATCH?0x10000u:mem==GGT_DATA?0x20000u:0u)+off,0,*v};
+    return guard(c)?GGT_OK:GGT_GUARD;
+}
+static enum ggt_result barrier(struct ggt_context *c)
+{
