diff --git a/bsd/dev/gauguin_scanout345.h b/bsd/dev/gauguin_scanout345.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_scanout345.h
@@ -0,0 +1,74 @@
+#ifndef GAUGUIN_SCANOUT345_H
+#define GAUGUIN_SCANOUT345_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum scan345_gate {
+    SCAN345_OK, SCAN345_DISPLAY, SCAN345_GCC_OFF, SCAN345_AHB_OFF, SCAN345_MDP_OFF,
+    SCAN345_REVISION, SCAN345_VIDEO, SCAN345_COUNTERS, SCAN345_GEOMETRY, SCAN345_CHANGED
+};
+
+enum {
+    SCAN345_GCC = 1, SCAN345_DISP = 2, SCAN345_REV = 4, SCAN345_INTF = 8, SCAN345_TIMING = 16
+};
+
+struct scan345_status {
+    uint32_t seen, display, gcc, ahb, mdp, revision, live, enable, count, hsync, period, start, end;
+};
+
+struct scan345_geometry {
+    uint32_t htotal, vtotal, first, last, start, end;
+};
+
+static inline bool
+scan345_branch_on(uint32_t value)
+{
+    /* Branch 2 reports the actual halt state in bit 31. Bit 0 is a
+     * software vote, including on the HW-gated GCC display branch. */
+    return (value & UINT32_C(0x80000000)) == 0;
+}
+
+static inline bool
+scan345_timing(const struct scan345_status *status, struct scan345_geometry *geometry)
+{
+    const uint32_t horizontal = status->hsync >> 16;
+    if (horizontal < 128 || status->end < status->start ||
+        status->end >= status->period || status->period % horizontal ||
+        status->end - status->start + 1 != 2400u * horizontal)
+        return false;
+    const uint32_t vertical = status->period / horizontal;
+    if (vertical <= 2400 || vertical > 6000) return false;
+    const uint32_t first = status->start / horizontal;
+    if (first + 2399 >= vertical) return false;
+    *geometry = (struct scan345_geometry){
+        horizontal, vertical, first, first + 2399, status->start, status->end
+    };
+    return true;
+}
+
+static inline bool
+scan345_same_timing(const struct scan345_geometry *a, const struct scan345_geometry *b)
+{
+    return a->htotal == b->htotal && a->vtotal == b->vtotal &&
+        a->start == b->start && a->end == b->end;
+}
+
+static inline bool
+scan345_edge_60(uint64_t interval_ns, uint64_t bracket_ns, uint32_t line, uint32_t vtotal)
+{
+    /* At the frame counter boundary the current line must have wrapped.
+     * Use a bounded observation of the early part of the new interval. */
+    return interval_ns >= 14300000 && interval_ns <= 19000000 &&
+        bracket_ns <= 3200000 && line < vtotal / 4;
+}
+
+static inline bool
+scan345_crc_line(const struct scan345_geometry *geometry, uint32_t line)
+{
+    /* Two stable reads of the latched CRC, well before end of active video.
+     * Leave enough room for both samples at either 2400 or 4910 total lines. */
+    return line >= geometry->first + 128 && line < geometry->first + 1536;
+}
+
+#endif
