+static bool table_has(const struct ggc_reg *a,size_t n,uint32_t reg,bool write)
+{for(size_t i=0;i<n;i++)if(a[i].reg==reg&&(write||a[i].mask))return true;return false;}
+bool ggc_register_allowed(uint32_t reg,bool write)
+{
+    if(table_has(addresses,COUNT(addresses),reg,write)||table_has(gmu_hwcg,COUNT(gmu_hwcg),reg,write)||
+       table_has(hwcg,COUNT(hwcg),reg,write)||table_has(config,COUNT(config),reg,write)||
+       table_has(protect,COUNT(protect),reg,write))return true;
+    if(write)return reg==0x3c45u||reg==0xaeu||reg==0x1a880u;
+    if(reg==0xaeu||reg==0x1a880u)return true;
+    for(size_t i=0;i<COUNT(restore);i++)if(restore[i]==reg)return true;
+    return false;
+}
