+enum ggq_result sweet_gpu_cp_once(struct ggq_receipt *out)
+{
+    if(!out)return GGQ_ARGUMENT;unsigned expected=GMB_IDLE;
+    if(!__atomic_compare_exchange_n(&ggq_board_lifecycle,&expected,GMB_RUNNING,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED))return GGQ_ALREADY;
+    ggq_entry=ggq_phase_entry=mach_absolute_time();clock_interval_to_deadline(4,NSEC_PER_SEC,&ggq_deadline);
+    ggq_phase_deadline=ggq_deadline;memset(&ggq_guard_diagnostic,0,sizeof(ggq_guard_diagnostic));ggq_result=GGQ_GUARD;
