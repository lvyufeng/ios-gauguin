+#ifndef GAUGUIN_COPY377_H
+#define GAUGUIN_COPY377_H
+
+#include "gauguin_blank352.h"
+
+enum {
+    SCAN377_BLOCK_BYTES = 288,
+    SCAN377_PREFETCHED_BLOCKS = 13,
+    SCAN377_TAIL_BLOCKS = 2,
+    SCAN377_PREFETCH_NEAR = 512,
+    SCAN377_PREFETCH_FAR = 640
+};
+
+static_assert((SCAN377_PREFETCHED_BLOCKS + SCAN377_TAIL_BLOCKS) *
+    SCAN377_BLOCK_BYTES == SCAN352_PANEL_STRIDE, "copy covers one complete row");
+static_assert((SCAN377_PREFETCHED_BLOCKS - 1) * SCAN377_BLOCK_BYTES +
+    SCAN377_PREFETCH_FAR + 64 <= SCAN352_PANEL_STRIDE, "prefetch stays in the source row");
+
+#define SCAN377_BLOCK \
+"ldp x8, x9, [%[s], #0]\n" \
+"ldp x10, x11, [%[s], #16]\n" \
+"ldp x12, x13, [%[s], #32]\n" \
+"ldp x14, x15, [%[s], #48]\n" \
+"stnp x8, x9, [%[d], #0]\n" \
+"stnp x10, x11, [%[d], #16]\n" \
+"stnp x12, x13, [%[d], #32]\n" \
+"stnp x14, x15, [%[d], #48]\n" \
+"ldp x8, x9, [%[s], #64]\n" \
+"ldp x10, x11, [%[s], #80]\n" \
+"ldp x12, x13, [%[s], #96]\n" \
+"ldp x14, x15, [%[s], #112]\n" \
+"stnp x8, x9, [%[d], #64]\n" \
+"stnp x10, x11, [%[d], #80]\n" \
+"stnp x12, x13, [%[d], #96]\n" \
+"stnp x14, x15, [%[d], #112]\n" \
+"ldp x8, x9, [%[s], #128]\n" \
+"ldp x10, x11, [%[s], #144]\n" \
+"ldp x12, x13, [%[s], #160]\n" \
+"ldp x14, x15, [%[s], #176]\n" \
+"stnp x8, x9, [%[d], #128]\n" \
+"stnp x10, x11, [%[d], #144]\n" \
+"stnp x12, x13, [%[d], #160]\n" \
+"stnp x14, x15, [%[d], #176]\n" \
+"ldp x8, x9, [%[s], #192]\n" \
+"ldp x10, x11, [%[s], #208]\n" \
+"ldp x12, x13, [%[s], #224]\n" \
+"ldp x14, x15, [%[s], #240]\n" \
+"stnp x8, x9, [%[d], #192]\n" \
+"stnp x10, x11, [%[d], #208]\n" \
+"stnp x12, x13, [%[d], #224]\n" \
+"stnp x14, x15, [%[d], #240]\n" \
+"ldp x8, x9, [%[s], #256]\n" \
+"ldp x10, x11, [%[s], #272]\n" \
+"stnp x8, x9, [%[d], #256]\n" \
+"stnp x10, x11, [%[d], #272]\n" \
+"add %[s], %[s], #288\n" \
+"add %[d], %[d], #288\n"
+
+static inline void
+scan377_copy_row(void *dst, const void *src)
+{
+#if defined(__aarch64__)
+    size_t remaining = SCAN377_PREFETCHED_BLOCKS;
+    /* Schedule source fetches ahead of the interleaved integer loads and
+     * write-combined stores. A separate two-block tail bounds the hints
+     * to the current row, including in the last row of the surface. */
+    __asm__ volatile(
+        "1:\n"
+        "prfm pldl1keep, [%[s], #%c[near]]\n"
+        "prfm pldl1keep, [%[s], #%c[far]]\n"
+        SCAN377_BLOCK
+        "subs %[n], %[n], #1\n"
+        "b.ne 1b\n"
+        "mov %[n], #%c[tail]\n"
+        "2:\n"
+        SCAN377_BLOCK
+        "subs %[n], %[n], #1\n"
+        "b.ne 2b\n"
+        : [d] "+&r"(dst), [s] "+&r"(src), [n] "+&r"(remaining)
+        : [near] "i"(SCAN377_PREFETCH_NEAR), [far] "i"(SCAN377_PREFETCH_FAR),
+          [tail] "i"(SCAN377_TAIL_BLOCKS)
+        : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "cc", "memory");
+#else
+    __builtin_memcpy(dst, src, SCAN352_PANEL_STRIDE);
+#endif
+}
+
+#undef SCAN377_BLOCK
+
+#endif
