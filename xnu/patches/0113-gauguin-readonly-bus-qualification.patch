+++ b/bsd/dev/gauguin_bcm_plan.c
@@ -0,0 +1,101 @@
+#include "gauguin_bcm_plan.h"
+#include "cmd_db_snapshot.h"
+#include <string.h>
+
+/* All six rows are VERIFIED metadata (see header). */
+const struct gbcm_board_row gbcm_board[GBCM_COUNT] = {
+    {"MC0", 0x50000, 2050000, 16,  0},
+    {"SH0", 0x50004, 3650000, 32,  1},
+    {"SN0", 0x5002c,  530000, 16,  3},
+    {"SN6", 0x50044,  530000, 16,  3},
+    {"CE0", 0x5006c,    7935,  8,  6},
+    {"ACV", 0x50080,       1,  0, 11},
+};
+_Static_assert(GBCM_COUNT == 6, "board table and plan are six rows");
+
+static uint32_t le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+        (uint32_t)p[3] << 24;
+}
+
+enum gbcm_result
+gbcm_decode(const struct ndb_entry *entry, struct gbcm_db *out)
+{
+    struct gbcm_db db;
+    if (!entry || !out) {
+        return GBCM_ARGUMENT;
+    }
+    if (entry->aux_length != GBCM_AUX_BYTES) {
+        return GBCM_MALFORMED;
+    }
+    memset(&db, 0, sizeof(db));
+    db.address = entry->address;
+    db.unit = le32(entry->aux);
+    db.width = (uint16_t)((uint16_t)entry->aux[4] | (uint16_t)entry->aux[5] << 8);
+    db.bank_version = entry->bank_version; /* observed, not a version gate */
+    db.vcd = entry->aux[6];
+    db.reserved = entry->aux[7];
+    if (db.reserved) {
+        return GBCM_MALFORMED;
+    }
+    if (entry->owner_slave != 5 || (db.address >> 16) != 5 ||
+        !db.address || (db.address & 3u)) {
+        return GBCM_NOT_BCM;
+    }
+    if (!db.unit || db.vcd >= GBCM_MAX_VCD) {
+        return GBCM_MALFORMED;
+    }
+    *out = db;
+    return GBCM_OK;
+}
+
+static int name_matches(const char *stored, const char *name)
+{
+    /* Exact zero-padded 8-byte key, like the native cmd-db lookup. */
+    char key[8] = {0};
+    memcpy(key, name, strlen(name));
+    return !memcmp(stored, key, sizeof(key));
+}
+
+enum gbcm_result
+gbcm_build(const struct ndb_entry *entries, size_t count, struct gbcm_plan *out)
+{
+    struct gbcm_plan plan;
+    if (!entries || !out || count != GBCM_COUNT) {
+        return GBCM_ARGUMENT;
+    }
+    memset(&plan, 0, sizeof(plan));
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        const struct gbcm_board_row *row = &gbcm_board[i];
+        enum gbcm_result rc = gbcm_decode(&entries[i], &plan.db[i]);
+        if (rc != GBCM_OK) {
+            return rc;
+        }
+        if (!name_matches(entries[i].name, row->name) ||
+            plan.db[i].address != row->address || plan.db[i].unit != row->unit ||
+            plan.db[i].width != row->width || plan.db[i].vcd != row->vcd) {
+            return GBCM_MISMATCH;
+        }
+        for (unsigned j = 0; j < i; ++j) {
+            if (!memcmp(entries[j].name, entries[i].name, sizeof(entries[i].name))) {
+                return GBCM_ARGUMENT;
+            }
+        }
+    }
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        int last = i + 1 == GBCM_COUNT ||
+            plan.db[i + 1].vcd != plan.db[i].vcd;
+        uint32_t x = i == GBCM_ACV ? 0 : GBCM_VOTE_MAX;
+        uint32_t y = i == GBCM_ACV ? GBCM_ACV_APPS : GBCM_VOTE_MAX;
+        plan.cmd[i].address = plan.db[i].address;
+        plan.cmd[i].data = (last ? GBCM_COMMIT : 0) | GBCM_VALID |
+            x << 14 | y;
+        plan.cmd[i].wait = (uint8_t)last;
+        if (last) {
+            plan.wait_mask |= 1u << i;
+        }
+    }
+    *out = plan;
+    return GBCM_OK;
+}
