+       offset>GGP_ARENA_END||bytes>GGP_ARENA_END-offset)return false;
+    for(unsigned chunk=0;chunk<bytes;chunk+=4096){
+        if(!ggb_guard(NULL))return false;
+        volatile uint32_t *dst=(volatile uint32_t *)(gmb_ram+offset-GMB_PAGE+chunk);
+        for(unsigned i=0;i<1024;i++){
+            uint32_t expected=source?source[chunk/4+i]:0;
+            if(check){if(dst[i]!=expected)return false;}else dst[i]=expected;
+        }
