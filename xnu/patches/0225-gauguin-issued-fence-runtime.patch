+enum ggr_error ggr_poll(struct ggr_context *c)
+{
+    if(!c||c->state!=GGR_BUSY)return GGR_UNAVAILABLE;
+    if(c->completed==UINT32_MAX||c->submitted!=c->completed+1||
+       c->pending_wptr>=8192||!c->pending_deadline_ns){
+        ggr_fail(c,GGR_IO);return GGR_IO;
+    }
+    /* The read itself has a fresh bounded guard. A caller that comes back
+     * after the pending deadline may still observe a fence already complete;
+     * the original deadline limits only a fence that remains pending. */
+    uint64_t now=c->ops.nanoseconds(c->ops.cookie);
+    if(now>UINT64_MAX-UINT64_C(2000000000)){
+        ggr_fail(c,GGR_UNAVAILABLE);return GGR_UNAVAILABLE;
+    }
+    c->operation_end_ns=now+UINT64_C(2000000000);
+    uint32_t control,shadow,busy;
+    ++c->polls;
+    if(!alive(c)||!poll_faults(c)||!poll_barrier(c)||
+       !poll_mr(c,GGR_COMPLETION,0,&control)||!poll_mr(c,GGR_SHADOW,0,&shadow)||
+       !poll_rd(c,0x23b0c,&busy)||!alive(c))goto io;
+    if(busy==UINT32_MAX||shadow>=8192||
+       control<c->completed||control>c->submitted)goto io;
+    if(control==c->submitted&&shadow==c->pending_wptr&&!(busy&(1u<<23))) {
+        c->wptr=c->pending_wptr;
+        c->completed=c->submitted;
+        c->pending_wptr=0;
+        c->pending_deadline_ns=0;
+        c->state=GGR_READY;
+        return GGR_OK;
+    }
+    if(c->ops.nanoseconds(c->ops.cookie)>=c->pending_deadline_ns)goto timeout;
+    return GGR_PENDING;
+timeout:ggr_fail(c,GGR_TIMEOUT);return GGR_TIMEOUT;
+io:ggr_fail(c,GGR_IO);return GGR_IO;
+}
+
+enum ggr_error ggr_wait(struct ggr_context *c,uint32_t fence)
+{
+    if(!c||!fence||fence>c->submitted)return GGR_ARGUMENT;
+    if(fence<=c->completed&&c->state==GGR_READY)return GGR_OK;
+    if(c->state!=GGR_BUSY||fence!=c->submitted)return GGR_UNAVAILABLE;
+    for(uint32_t i=0;i<200000;i++) {
+        enum ggr_error result=ggr_poll(c);
+        if(result!=GGR_PENDING)return result;
+        if(!delay(c))break;
+    }
+    ggr_fail(c,GGR_TIMEOUT);
+    return GGR_TIMEOUT;
+}
+
+enum ggr_error ggr_submit(struct ggr_context *c,const uint64_t *addresses,const uint32_t *words,uint32_t count,uint32_t *fence)
+{
+    if(!fence)return GGR_ARGUMENT;
+    uint32_t issued=0;
+    enum ggr_error result=ggr_issue(c,addresses,words,count,&issued);
+    if(result!=GGR_OK)return result;
+    result=ggr_wait(c,issued);
+    if(result==GGR_OK)*fence=issued;
+    return result;
+}
