diff --git a/bsd/dev/gauguin_gmu_smmu.c b/bsd/dev/gauguin_gmu_smmu.c
--- a/bsd/dev/gauguin_gmu_smmu.c
+++ b/bsd/dev/gauguin_gmu_smmu.c
@@ -242,10 +242,15 @@
     r=poll(c,base+0x8f0,1,0,10,5);if(r)return r;
     if(!r64(c,base+0x50,&par))return GSM_IO;
     ++c->work.translations;
-    if(par==UINT64_MAX)return GSM_TRANSLATION;
-    if(expected==UINT64_MAX){unsigned fault=(unsigned)(par>>1)&63;
-        return (par&1)&&fault>=4&&fault<=7?GSM_OK:GSM_TRANSLATION;}
-    return !(par&1)&&(par&UINT64_C(0x0000fffffffff000))==expected?GSM_OK:GSM_TRANSLATION;
+    bool accepted=false;
+    if(par!=UINT64_MAX){
+        if(expected==UINT64_MAX){unsigned fault=(unsigned)(par>>1)&63;
+            accepted=(par&1)&&fault>=4&&fault<=7;
+        }else accepted=!(par&1)&&(par&UINT64_C(0x0000fffffffff000))==expected;
+    }
+    if(accepted)return GSM_OK;
+    c->translation=(struct gsm_atos_sample){expected,par,1,4+n,c->work.bank[n],va,c->work.mapped_pages};
+    return GSM_TRANSLATION;
