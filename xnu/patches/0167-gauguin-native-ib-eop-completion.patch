+        TRY(mr(c,GGE_RING,4*i,&v));
+        if(v!=expected)return sample(c,true,4*i,expected,v);
+        ++c->work.ring_after_checked;
+    }
+    for(unsigned i=0;i<GGE_IB_WORDS;i++){
+        uint32_t v;TRY(mr(c,GGE_IB,4*i,&v));
+        if(v!=c->command.ib[i])return sample(c,true,0x30000u+4*i,c->command.ib[i],v);
+        ++c->work.ib_after_checked;
+    }
+    return faults(c);
+}
+static enum gge_result execute(struct gge_context *c,const struct ggd_plan *p,const struct gge_prefix *prefix)
+{
+    c->phase=GGE_SEAL;if(!guard(c))return GGE_GUARD;
+    if(!c->ops.seal(c->ops.cookie,p->bootstrap.owner_pa))return GGE_OWNER;
