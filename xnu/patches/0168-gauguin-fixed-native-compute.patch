+/* Same bounded private NC batching policy as native first CP: all MMIO
+ * remains individually guarded, and each <=64word NC pass is surrounded by
+ * full live guards. Per-word callbacks still whitelist every exact range. */
+static enum ggk_result compare_nc(struct ggk_context *c,enum ggk_memory mem,
+    unsigned off,unsigned words,const uint32_t *expected,uint32_t seed,uint32_t *count)
+{
+    for(unsigned base=0;base<words;base+=GGK_BATCH_WORDS){
+        unsigned n=words-base;if(n>GGK_BATCH_WORDS)n=GGK_BATCH_WORDS;
+        if(!guard(c))return GGK_GUARD;
+        for(unsigned i=0;i<n;i++){
+            unsigned index=base+i,offset=off+4*index;
+            uint32_t want=expected?expected[index]:seed,value;
+            if(mem==GGK_DATA&&c->phase==GGK_VERIFY)
+                want=index==0?GGK_EOP_VALUE:index<GGK_OUTPUT_WORDS?index:GGK_DATA_SEED;
+            if(!c->ops.read_memory(c->ops.cookie,mem,offset,&value))return GGK_IO;
+            if(value!=want){
+                uint32_t tag=mem==GGK_DATA?0x20000u:mem==GGK_IB?0x30000u:
+                    mem==GGK_PROGRAM?0x40000u:mem==GGK_IBO?0x50000u:0u;
+                return sample(c,true,tag+offset,want,value);
+            }
+            ++*count;
+            if(mem==GGK_DATA&&c->phase==GGK_VERIFY){
+                if(!index)++c->work.eop_checked;
+                else if(index<GGK_OUTPUT_WORDS)++c->work.invocations_checked;
+                else ++c->work.unchanged_checked;
+            }
+        }
+        if(c->work.max_nc_batch_words<n)c->work.max_nc_batch_words=n;
+        if(!guard(c))return GGK_GUARD;
+    }
+    return GGK_OK;
+}
+static enum ggk_result copy_nc(struct ggk_context *c,enum ggk_memory mem,
+    unsigned off,unsigned words,const uint32_t *values,uint32_t *count)
+{
+    for(unsigned base=0;base<words;base+=GGK_BATCH_WORDS){
+        unsigned n=words-base;if(n>GGK_BATCH_WORDS)n=GGK_BATCH_WORDS;
+        if(!guard(c))return GGK_GUARD;
+        for(unsigned i=0;i<n;i++){
+            ++*count;if(!c->ops.write_memory(c->ops.cookie,mem,off+4*(base+i),values[base+i]))return GGK_IO;
+        }
+        if(c->work.max_nc_batch_words<n)c->work.max_nc_batch_words=n;
+        if(!guard(c))return GGK_GUARD;
+    }
+    return GGK_OK;
+}
+static enum ggk_result capture(struct ggk_context *c,const struct ggk_prefix *prefix)
