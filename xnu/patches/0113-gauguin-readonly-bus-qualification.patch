+++ b/bsd/dev/gauguin_bus_probe.c
@@ -0,0 +1,576 @@
+/*
+ * Gauguin BCM qualification worker: sweetbusprobe=1 (exact value 1), default
+ * off, one kernel thread, one attempt per boot. After a 45 second delay it
+ * takes ONE read-only snapshot of the reserved cmd-db (80860000+20000), builds
+ * the reviewed six-command BOOT plan from CPU-owned copies only, and then, only
+ * if all six board rows validated, takes ONE read-only apps DRV2 snapshot
+ * (18220000+4000). PLAN ONLY: no RPMh/RSC/BCM/PDC/RESP/IRQ_CLEAR register is
+ * written, no SMC, PAS, clock vote, power or GPU action happens, and nothing is
+ * submitted. The sweep is not a claim of current bandwidth or GPU readiness.
+ *
+ * Board facts: /reserved-memory/memory@80860000 (qcom,cmd-db, no-map) and
+ * /soc/rsc@18200000 drv-2=18220000+10000, tcs-offset d00 (board-parent-review).
+ * RSC offsets follow pinned drivers/soc/qcom/rpmh-rsc.c:30-74,112-116.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLib.h>
+#include <libkern/crypto/sha2.h>
+#include "cmd_db_snapshot.h"
+#include "gauguin_bcm_plan.h"
+
+/* Canonical MACH/PEXPERT-private declarations, hidden from the BSD header view
+ * (as in the existing gauguin probes). */
+extern vm_offset_t ml_io_map_with_prot(vm_offset_t phys_addr, vm_size_t size, vm_prot_t prot);
+extern vm_offset_t ml_vtophys(vm_offset_t vaddr);
+extern boolean_t pmap_valid_page(ppnum_t);
+extern unsigned int pmap_cache_attributes(ppnum_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_terminate_self(void);
+extern int get_preemption_level(void);
+extern void sweet_log_mark_sync(const char *);
+extern void sweet_log_flush_now(void);
+
+void sweet_bus_probe_init(void);
+
+_Static_assert(PAGE_SHIFT == 14, "CMDDB/RSC pmap precheck assumes 16KiB pages");
+
+#define BUS_CMDB_PA        0x80860000u
+#define BUS_CMDB_BYTES     0x20000u
+#define BUS_CMDB_PAGES     (BUS_CMDB_BYTES / PAGE_SIZE)
+#define BUS_RSC_PA         0x18220000u
+#define BUS_RSC_BYTES      0x4000u
+#define BUS_RSC_PAGES      (BUS_RSC_BYTES / PAGE_SIZE)
+#define BUS_WIMG_IO        0x7u
+#define BUS_WIMG_MASK      0xffu
+
+/* DRV2 whitelist: frame +0xc configuration (never ID/solver at +0/+4), the
+ * global IRQ pair at d00, then only the eight fixed normal TCS blocks (stride
+ * 2a0) and their ENABLED commands. */
+#define BUS_RSC_CONFIG     0x0cu
+#define BUS_RSC_IRQ_BASE   0xd00u
+#define BUS_RSC_TCS_BASE   0xd00u
+#define BUS_RSC_TCS_STRIDE 0x2a0u
+#define BUS_RSC_TCS_COUNT  8u
+#define BUS_RSC_CMD_STRIDE 0x14u
+#define BUS_RSC_CMD_COUNT  16u
+#define BUS_RSC_CMD_BASE   0x30u
+#define BUS_RSC_WAIT       0x10u
+#define BUS_RSC_CONTROL    0x14u
+#define BUS_RSC_STATUS     0x18u
+#define BUS_RSC_ENABLE     0x1cu
+#define BUS_RSC_NCPT_MASK  0x1fu
+#define BUS_RSC_NCPT_SHIFT 27
+#define BUS_RSC_COUNT_SHIFT 12
+#define BUS_RSC_COUNT_MASK 0x3fu
+#define BUS_RSC_MIN_COUNT  8u
+#define BUS_RSC_MIN_NCPT   1u
+#define BUS_RSC_MAX_NCPT   16u
+#define BUS_RSC_MIN_PLAN   6u
+#define BUS_RSC_MAX_END    0x4000u
+#define BUS_RSC_CANDIDATES 2u
+
+#define BUS_RAW_BYTES  BUS_CMDB_BYTES
+#define BUS_RAW_CHUNK  64u
+#define BUS_RAW_LINES  (BUS_RAW_BYTES / BUS_RAW_CHUNK)
+#define BUS_LINE_BYTES 192u
+
+struct bus_rsc_cmd {
+    uint32_t msgid, address, data, status;
+};
+struct bus_rsc_tcs {
+    uint32_t wait, control, status, enable;
+    struct bus_rsc_cmd cmd[BUS_RSC_CMD_COUNT];
+};
+struct bus_rsc_snapshot {
+    uint32_t config, irq_enable, irq_status;
+    struct bus_rsc_tcs tcs[BUS_RSC_TCS_COUNT];
+};
+/* VALUE storage allocated once before mapping and retained until reboot. */
+struct bus_work {
+    uint8_t raw[2][BUS_RAW_BYTES];
+    struct bus_rsc_snapshot rsc[2];
+    struct gbcm_plan plan;
+};
+
+static const char *const bus_arc_names[] = {"cx.lvl", "mx.lvl", "gfx.lvl", "xo.lvl"};
+
+static unsigned bus_started;
+static struct bus_work *bus_work;
+
+/* ONE read path for every CMDDB/RSC word: aligned volatile u32 load, oshld. */
+static uint32_t
+bus_mmio_read(vm_offset_t base, uint32_t offset)
+{
+    uint32_t value = *(volatile uint32_t *)(base + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+static bool
+bus_context(void)
+{
+    return ml_get_interrupts_enabled() && !ml_at_interrupt_context() &&
+        get_preemption_level() == 0;
+}
+
+static void
+bus_record(const char *line)
+{
+    printf("%s\n", line);
+    sweet_log_mark_sync(line);
+    sweet_log_flush_now();
+}
+
+/* Bounded sector: unmanaged (not pmap-managed) and Device IO cache type. */
+static bool
+bus_premap(vm_offset_t pa, size_t bytes)
+{
+    char line[BUS_LINE_BYTES];
+    unsigned pages = (unsigned)(bytes / PAGE_SIZE);
+    for (unsigned i = 0; i < pages; ++i) {
+        vm_offset_t page = pa + (vm_offset_t)i * PAGE_SIZE;
+        ppnum_t pn = (ppnum_t)(page >> PAGE_SHIFT);
+        boolean_t managed = pmap_valid_page(pn);
+        unsigned wimg = pmap_cache_attributes(pn);
+        if (managed || (wimg & BUS_WIMG_MASK) != BUS_WIMG_IO) {
+            snprintf(line, sizeof(line),
+                "SWEET BUS: pmap mismatch pa=%08x managed=%u wimg=%08x; stopped",
+                (uint32_t)page, managed ? 1u : 0u, wimg);
+            bus_record(line);
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool
+bus_readonly_map(vm_offset_t pa, size_t bytes, vm_offset_t *mapped)
+{
+    char line[BUS_LINE_BYTES];
+    vm_offset_t va = ml_io_map_with_prot(pa, bytes, VM_PROT_READ);
+
+    if (!va) {
+        snprintf(line, sizeof(line), "SWEET BUS: map failed pa=%08x size=%05x; stopped",
+            (uint32_t)pa, (unsigned)bytes);
+        bus_record(line);
+        return false;
+    }
+    if (ml_vtophys(va) != pa || ml_vtophys(va + bytes - 1) != pa + bytes - 1) {
+        snprintf(line, sizeof(line), "SWEET BUS: translation mismatch pa=%08x size=%05x; stopped",
+            (uint32_t)pa, (unsigned)bytes);
+        bus_record(line);
+        return false;
+    }
+    *mapped = va;
+    return true;
+}
+
+static void
+bus_sha256(const uint8_t *bytes, size_t length, char hex[SHA256_DIGEST_STRING_LENGTH])
+{
+    static const char digits[] = "0123456789abcdef";
+    uint8_t digest[SHA256_DIGEST_LENGTH];
+    SHA256_CTX ctx;
+
+    SHA256_Init(&ctx);
+    SHA256_Update(&ctx, bytes, length);
+    SHA256_Final(digest, &ctx);
+    for (unsigned i = 0; i < SHA256_DIGEST_LENGTH; ++i) {
+        hex[2u * i] = digits[digest[i] >> 4];
+        hex[2u * i + 1u] = digits[digest[i] & 15u];
+    }
+    hex[2u * SHA256_DIGEST_LENGTH] = '\0';
+}
+
+/* Exactly 2048 printf lines of 64 bytes; offsets 00000..1ffc0. */
+static void
+bus_dump_raw(const uint8_t *raw)
+{
+    static const char digits[] = "0123456789abcdef";
+    char line[BUS_LINE_BYTES];
+    char data[2u * BUS_RAW_CHUNK + 1u];
+
+    bus_record("SWEET BUS: marking before capture");
+    for (unsigned off = 0; off < BUS_RAW_BYTES; off += BUS_RAW_CHUNK) {
+        for (unsigned i = 0; i < BUS_RAW_CHUNK; ++i) {
+            uint8_t byte = raw[off + i];
+            data[2u * i] = digits[byte >> 4];
+            data[2u * i + 1u] = digits[byte & 15u];
+        }
+        data[2u * BUS_RAW_CHUNK] = '\0';
+        snprintf(line, sizeof(line), "SWEET CMDB RAW: offset=%05x data=%s", off, data);
+        printf("%s\n", line);
+    }
+}
+
+/* Every CMDDB word is read unconditionally on EACH pass and stored as explicit
+ * little-endian bytes in normal memory. Zero is data: no holes, no shortcuts.
+ * Exactly 2 x 32768 MMIO loads per run; the copies must be byte-identical. */
+static bool
+bus_dump_cmddb(vm_offset_t mapping, struct bus_work *work)
+{
+    char sha[SHA256_DIGEST_STRING_LENGTH];
+    char line[BUS_LINE_BYTES];
+
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        for (uint32_t off = 0; off < BUS_CMDB_BYTES; off += 4) {
+            uint32_t word = bus_mmio_read(mapping, off);
+            work->raw[pass][off] = (uint8_t)word;
+            work->raw[pass][off + 1] = (uint8_t)(word >> 8);
+            work->raw[pass][off + 2] = (uint8_t)(word >> 16);
+            work->raw[pass][off + 3] = (uint8_t)(word >> 24);
+        }
+    }
+    if (memcmp(work->raw[0], work->raw[1], BUS_RAW_BYTES) != 0) {
+        bus_record("SWEET BUS: CMDDB copies differ; stopped");
+        return false;
+    }
+    snprintf(line, sizeof(line), "SWEET BUS: CMDDB stable reads=%u",
+        (unsigned)(2u * (BUS_CMDB_BYTES / 4u)));
+    bus_record(line);
+    bus_sha256(work->raw[0], BUS_RAW_BYTES, sha);
+    snprintf(line, sizeof(line), "SWEET CMDB BEGIN: bytes=%u sha256=%s",
+        (unsigned)BUS_RAW_BYTES, sha);
+    bus_record(line);
+    bus_dump_raw(work->raw[0]);
+    snprintf(line, sizeof(line), "SWEET CMDB END: bytes=%u sha256=%s",
+        (unsigned)BUS_RAW_BYTES, sha);
+    bus_record(line);
+    return true;
+}
+
+static bool
+bus_parse_metadata(struct bus_work *work)
+{
+    char line[BUS_LINE_BYTES];
+    struct ndb_entry entries[GBCM_COUNT];
+    struct ndb_arc_levels levels;
+
+    work->plan = (struct gbcm_plan){0};
+
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        const char *name = gbcm_board[i].name;
+        if (ndb_lookup(work->raw[0], BUS_RAW_BYTES, name, strlen(name), &entries[i]) != NDB_OK) {
+            snprintf(line, sizeof(line), "SWEET BUS: CMDDB metadata %s invalid; stopped", name);
+            bus_record(line);
+            return false;
+        }
+    }
+    if (gbcm_build(entries, GBCM_COUNT, &work->plan) != GBCM_OK) {
+        bus_record("SWEET BUS: CMDDB board plan invalid; stopped");
+        return false;
+    }
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        const struct gbcm_db *db = &work->plan.db[i];
+        snprintf(line, sizeof(line),
+            "SWEET BUS: BCM %s addr=%05x owner=%u bankver=%04x unit=%u width=%u vcd=%u",
+            entries[i].name, db->address, entries[i].owner_slave, db->bank_version,
+            db->unit, db->width, db->vcd);
+        bus_record(line);
+    }
+    for (unsigned i = 0; i < sizeof(bus_arc_names) / sizeof(bus_arc_names[0]); ++i) {
+        struct ndb_entry entry;
+        if (ndb_lookup(work->raw[0], BUS_RAW_BYTES, bus_arc_names[i],
+            strlen(bus_arc_names[i]), &entry) != NDB_OK ||
+            ndb_decode_arc(&entry, &levels) != NDB_OK) {
+            snprintf(line, sizeof(line), "SWEET BUS: ARC %s invalid; stopped", bus_arc_names[i]);
+            bus_record(line);
+            return false;
+        }
+        snprintf(line, sizeof(line), "SWEET BUS: ARC %s addr=%05x owner=%u levels=%u",
+            bus_arc_names[i], entry.address, entry.owner_slave, levels.count);
+        bus_record(line);
+        for (unsigned j = 0; j < levels.count; j += 8u) {
+            size_t used = (size_t)snprintf(line, sizeof(line), "SWEET BUS: ARC %s lv:", bus_arc_names[i]);
+            for (unsigned k = j; k < levels.count && k < j + 8u && used + 6u < sizeof(line); ++k) {
+                used += (size_t)snprintf(line + used, sizeof(line) - used, " %u", levels.value[k]);
+            }
+            bus_record(line);
+        }
+    }
+    return true;
+}
+
+/* PLAN ONLY: bytes actually swept by the planner, plus TCS requirements. */
+static void
+bus_report_plan(const struct bus_work *work)
+{
+    char line[BUS_LINE_BYTES];
+
+    snprintf(line, sizeof(line), "SWEET BUS: PLAN ONLY cmds=%u waitmask=%08x",
+        (unsigned)GBCM_COUNT, work->plan.wait_mask);
+    bus_record(line);
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        const struct gbcm_command *cmd = &work->plan.cmd[i];
+        snprintf(line, sizeof(line), "SWEET BUS: PLAN ONLY cmd%u addr=%05x data=%08x commit=%u wait=%u",
+            i, cmd->address, cmd->data,
+            (cmd->data & GBCM_COMMIT) ? 1u : 0u, cmd->wait);
+        bus_record(line);
+    }
+}
+
+static void
+bus_report_rsc(const struct bus_rsc_snapshot *rsc, unsigned ncpt, uint32_t end)
+{
+    char line[BUS_LINE_BYTES];
+    unsigned candidates = 0;
+
+    snprintf(line, sizeof(line), "SWEET BUS: RSC DRV2 config=%08x count=%u ncpt=%u end=%04x",
+        rsc->config, (unsigned)((rsc->config >> BUS_RSC_COUNT_SHIFT) & BUS_RSC_COUNT_MASK),
+        ncpt, end);
+    bus_record(line);
+    snprintf(line, sizeof(line), "SWEET BUS: RSC DRV2 irq_enable=%08x irq_status=%08x",
+        rsc->irq_enable, rsc->irq_status);
+    bus_record(line);
+    for (unsigned t = 0; t < BUS_RSC_TCS_COUNT; ++t) {
+        const struct bus_rsc_tcs *tcs = &rsc->tcs[t];
+        snprintf(line, sizeof(line), "SWEET BUS: RSC TCS%u wait=%08x control=%08x status=%08x enable=%08x",
+            t, tcs->wait, tcs->control, tcs->status, tcs->enable);
+        bus_record(line);
+        for (unsigned c = 0; c < ncpt; ++c) {
+            if (!(tcs->enable & (1u << c))) {
+                continue;
+            }
+            snprintf(line, sizeof(line), "SWEET BUS: RSC TCS%u cmd%u msgid=%08x addr=%08x data=%08x status=%08x",
+                t, c, tcs->cmd[c].msgid, tcs->cmd[c].address,
+                tcs->cmd[c].data, tcs->cmd[c].status);
+            bus_record(line);
+        }
+        /* Candidate slot ONLY: ACTIVE0..1 with idle status (neither 0 nor all
+         * ones), CONTROL/ENABLE/WAIT zero and no pending own IRQ bit. This is
+         * not a lease, ownership or current-bandwidth proof. */
+        if (t < BUS_RSC_CANDIDATES && tcs->status != 0 && tcs->status != 0xffffffffu &&
+            tcs->control == 0 && tcs->enable == 0 && tcs->wait == 0 &&
+            (rsc->irq_status & (1u << t)) == 0) {
+            ++candidates;
+        }
+    }
+    snprintf(line, sizeof(line),
+        "SWEET BUS: RSC observations ncpt=%u candidate_active_idle=%u; not an ownership/current-vote proof",
+        ncpt, candidates);
+    bus_record(line);
+    /* Six commands need capacity AND at least one idle ACTIVE candidate. */
+    if (ncpt < BUS_RSC_MIN_PLAN || candidates == 0) {
+        bus_record("SWEET BUS: RSC not ready for 6-command transport");
+    }
+}
+
+/* Validates DRV2 geometry from the configuration word alone. */
+static bool
+bus_rsc_geometry(uint32_t config, unsigned *ncpt)
+{
+    char line[BUS_LINE_BYTES];
+    unsigned count = (config >> BUS_RSC_COUNT_SHIFT) & BUS_RSC_COUNT_MASK;
+    unsigned commands = (config >> BUS_RSC_NCPT_SHIFT) & BUS_RSC_NCPT_MASK;
+    uint32_t end;
+
+    if (count < BUS_RSC_MIN_COUNT || commands < BUS_RSC_MIN_NCPT ||
+        commands > BUS_RSC_MAX_NCPT) {
+        snprintf(line, sizeof(line), "SWEET BUS: RSC geometry config=%08x; stopped", config);
+        bus_record(line);
+        return false;
+    }
+    end = BUS_RSC_TCS_BASE + (BUS_RSC_TCS_COUNT - 1u) * BUS_RSC_TCS_STRIDE +
+        BUS_RSC_CMD_BASE + (commands - 1u) * BUS_RSC_CMD_STRIDE + 0x10u;
+    if (end > BUS_RSC_MAX_END) {
+        bus_record("SWEET BUS: RSC read end beyond 4000; stopped");
+        return false;
+    }
+    *ncpt = commands;
+    return true;
+}
+
+/* One DRV2 snapshot through the whitelist into a zeroed normal struct. The
+ * configuration word is re-read first and must equal the first snapshot
+ * (validated geometry) before any TCS word is read; the enable words then
+ * decide which commands are read by their real index c. Both snapshots must
+ * match, including configuration and enable masks, before results are used. */
+static bool
+bus_capture_rsc(vm_offset_t mapping, uint32_t validated_config,
+    struct bus_rsc_snapshot *out, unsigned ncpt)
+{
+    char line[BUS_LINE_BYTES];
+
+    memset(out, 0, sizeof(*out));
+    out->config = bus_mmio_read(mapping, BUS_RSC_CONFIG);
+    if (out->config != validated_config) {
+        snprintf(line, sizeof(line),
+            "SWEET BUS: RSC configuration changed %08x!=%08x; stopped",
+            out->config, validated_config);
+        bus_record(line);
+        return false;
+    }
+    out->irq_enable = bus_mmio_read(mapping, BUS_RSC_IRQ_BASE);
+    out->irq_status = bus_mmio_read(mapping, BUS_RSC_IRQ_BASE + 4u);
+    for (unsigned t = 0; t < BUS_RSC_TCS_COUNT; ++t) {
+        uint32_t base = BUS_RSC_TCS_BASE + t * BUS_RSC_TCS_STRIDE;
+        struct bus_rsc_tcs *tcs = &out->tcs[t];
+        tcs->wait = bus_mmio_read(mapping, base + BUS_RSC_WAIT);
+        tcs->control = bus_mmio_read(mapping, base + BUS_RSC_CONTROL);
+        tcs->status = bus_mmio_read(mapping, base + BUS_RSC_STATUS);
+        tcs->enable = bus_mmio_read(mapping, base + BUS_RSC_ENABLE);
+        if (tcs->enable >> ncpt) {
+            snprintf(line, sizeof(line), "SWEET BUS: RSC TCS%u enable %08x beyond ncpt=%u; stopped",
+                t, tcs->enable, ncpt);
+            bus_record(line);
+            return false;
+        }
+    }
+    for (unsigned t = 0; t < BUS_RSC_TCS_COUNT; ++t) {
+        struct bus_rsc_tcs *tcs = &out->tcs[t];
+        uint32_t base = BUS_RSC_TCS_BASE + t * BUS_RSC_TCS_STRIDE;
+        for (unsigned c = 0; c < ncpt; ++c) {
+            uint32_t at = base + BUS_RSC_CMD_BASE + c * BUS_RSC_CMD_STRIDE;
+            if (!(tcs->enable & (1u << c))) {
+                continue;
+            }
+            tcs->cmd[c].msgid = bus_mmio_read(mapping, at);
+            tcs->cmd[c].address = bus_mmio_read(mapping, at + 4u);
+            tcs->cmd[c].data = bus_mmio_read(mapping, at + 8u);
+            tcs->cmd[c].status = bus_mmio_read(mapping, at + 12u);
+        }
+    }
+    return true;
+}
+
+static void
+bus_run(void)
+{
+    char line[BUS_LINE_BYTES];
+    vm_offset_t cmdb;
+    vm_offset_t rsc;
+    struct bus_work *work = bus_work;
+    unsigned ncpt = 0;
+    uint32_t config;
+
+    if (!bus_context()) {
+        bus_record("SWEET BUS: invalid context; stopped");
+        return;
+    }
+    bus_record("SWEET BUS: begin pmap check CMDDB pa=80860000 bytes=20000");
+    if (!bus_premap(BUS_CMDB_PA, BUS_CMDB_BYTES)) {
+        return;
+    }
+    bus_record("SWEET BUS: pmap OK CMDDB pages=8");
+    bus_record("SWEET BUS: begin map CMDDB pa=80860000 bytes=20000 prot=readonly");
+    if (!bus_readonly_map(BUS_CMDB_PA, BUS_CMDB_BYTES, &cmdb)) {
+        return;
+    }
+    bus_record("SWEET BUS: mapping OK CMDDB readonly; first read next");
+    if (!bus_dump_cmddb(cmdb, work)) {
+        return;
+    }
+    if (!bus_parse_metadata(work)) {
+        return;
+    }
+    bus_report_plan(work);
+    bus_record("SWEET BUS: begin pmap check RSC DRV2 pa=18220000 bytes=4000");
+    if (!bus_premap(BUS_RSC_PA, BUS_RSC_BYTES)) {
+        return;
+    }
+    bus_record("SWEET BUS: pmap OK RSC pages=1");
+    bus_record("SWEET BUS: begin map RSC DRV2 pa=18220000 bytes=4000 prot=readonly");
+    if (!bus_readonly_map(BUS_RSC_PA, BUS_RSC_BYTES, &rsc)) {
+        return;
+    }
+    bus_record("SWEET BUS: mapping OK RSC readonly; first read next");
+    config = bus_mmio_read(rsc, BUS_RSC_CONFIG);
+    if (!bus_rsc_geometry(config, &ncpt)) {
+        return;
+    }
+    snprintf(line, sizeof(line), "SWEET BUS: RSC geometry OK config=%08x ncpt=%u end=%04x",
+        config, ncpt,
+        BUS_RSC_TCS_BASE + (BUS_RSC_TCS_COUNT - 1u) * BUS_RSC_TCS_STRIDE +
+            BUS_RSC_CMD_BASE + (ncpt - 1u) * BUS_RSC_CMD_STRIDE + 0x10u);
+    bus_record(line);
+    /* Both VALUE snapshots start zeroed; each capture re-zeroes its own. */
+    memset(&work->rsc[0], 0, sizeof(work->rsc[0]));
+    memset(&work->rsc[1], 0, sizeof(work->rsc[1]));
+    if (!bus_capture_rsc(rsc, config, &work->rsc[0], ncpt)) {
+        return;
+    }
+    if (!bus_capture_rsc(rsc, config, &work->rsc[1], ncpt)) {
+        return;
+    }
+    if (memcmp(&work->rsc[0], &work->rsc[1], sizeof(work->rsc[0])) != 0) {
+        bus_record("SWEET BUS: RSC snapshots differ; stopped");
+        return;
+    }
+    bus_record("SWEET BUS: RSC stable captures=2");
+    bus_report_rsc(&work->rsc[0], ncpt,
+        BUS_RSC_TCS_BASE + (BUS_RSC_TCS_COUNT - 1u) * BUS_RSC_TCS_STRIDE +
+            BUS_RSC_CMD_BASE + (ncpt - 1u) * BUS_RSC_CMD_STRIDE + 0x10u);
+    bus_record("SWEET BUS: PLAN ONLY; no bandwidth submitted, no GPU execution; observation only");
+}
+
+static void
+bus_worker(void *argument, wait_result_t result)
+{
+    (void)argument;
+    (void)result;
+    int mode = 0;
+
+    if (!bus_context()) {
+        printf("SWEET BUS: invalid worker context; stopped\n");
+        thread_terminate_self();
+        return;
+    }
+    (void)PE_parse_boot_argn("sweettouchmode", &mode, sizeof(mode));
+    if (mode != 0) {
+        printf("SWEET BUS: sweettouchmode=%d conflicts; stopped\n", mode);
+        thread_terminate_self();
+        return;
+    }
+    bus_record("SWEET BUS: worker delay=45s");
+    for (unsigned i = 0; i < 45; ++i) {
+        IOSleep(1000);
+    }
+    if (!bus_context()) {
+        printf("SWEET BUS: invalid context after delay; stopped\n");
+        thread_terminate_self();
+        return;
+    }
+    if (!bus_work) {
+        bus_work = (struct bus_work *)IOMalloc(sizeof(*bus_work));
+        if (!bus_work) {
+            printf("SWEET BUS: allocation failed; stopped\n");
+            thread_terminate_self();
+            return;
+        }
+        memset(bus_work, 0, sizeof(*bus_work));
+        bus_record("SWEET BUS: allocation OK; retained until reboot");
+    }
+    bus_run();
+    thread_terminate_self();
+}
+
+void
+sweet_bus_probe_init(void)
+{
+    int enabled = 0;
+    thread_t thread;
+
+    (void)PE_parse_boot_argn("sweetbusprobe", &enabled, sizeof(enabled));
+    if (enabled != 1) {
+        return;
+    }
+    if (__atomic_exchange_n(&bus_started, 1, __ATOMIC_ACQ_REL)) {
+        return;
+    }
+    kern_return_t result = kernel_thread_start(bus_worker, NULL, &thread);
+    if (result == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    } else {
+        printf("SWEET BUS: worker creation failed=%d; no inline fallback\n", result);
+    }
+}
