+static bool guard(struct ggk_context *c)
+{return c->ops.guard(c->ops.cookie,(enum ggk_phase)c->phase);}
+static enum ggk_result sample(struct ggk_context *c,bool mem,uint32_t reg,uint32_t expected,uint32_t actual)
+{c->diagnostic=(struct ggk_diagnostic){1,mem,reg,expected,actual};return mem?GGK_MEMORY_ERROR:GGK_DIRTY_STATE;}
+static enum ggk_result rd(struct ggk_context *c,uint32_t reg,uint32_t *v)
+{
