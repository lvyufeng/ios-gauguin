+#if defined(GAUGUIN)
+/* Observe the exact existing ABI bytes; mapping, output and lifetime are unchanged. */
+static void
+sweet_surface_log_result(uint32_t id, bool existing, const uint8_t *out,
+    const IOExternalMethodArguments *args)
+{
+	if (OSAddAtomic(1, &sweet_surface_abi_results) >= 64) {
+		return;
+	}
+	uint64_t pixels, state, timestamps;
+	memcpy(&pixels, out + 0x00, sizeof(pixels));
+	memcpy(&state, out + 0x08, sizeof(state));
+	memcpy(&timestamps, out + 0x10, sizeof(timestamps));
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF ABI: %s pid=%d id=%u existing=%u data=%llx state=%llx timestamps=%llx out=%u desc=%u\n",
+	    name, proc_pid(current_proc()), id, (unsigned)existing,
+	    (unsigned long long)pixels, (unsigned long long)state,
+	    (unsigned long long)timestamps, args->structureOutputSize,
+	    (unsigned)(args->structureOutputDescriptor != NULL));
+}
+
+static void
+sweet_surface_log_ignored(uint32_t selector, const IOExternalMethodArguments *args,
+    uint64_t arg0)
+{
+	if (selector >= 48 || OSAddAtomic(1, &sweet_surface_abi_ignored[selector]) >= 2) {
+		return;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET SURF ABI: %s pid=%d ignored=%u in=%u/%u out=%u/%u desc=%u arg0=%llx\n",
+	    name, proc_pid(current_proc()), selector, args->scalarInputCount,
+	    args->structureInputSize, args->scalarOutputCount, args->structureOutputSize,
+	    (unsigned)(args->structureOutputDescriptor != NULL), (unsigned long long)arg0);
+}
+#endif
