+static bool scan_count_probe(const struct scan345_status *status, const struct scan345_geometry *geometry)
+{
+    const bool ready = scan345_counter_can_arm(status, &scan.counter_candidate, geometry);
+    scan.counter_candidate = *geometry;
+    if (status->enable != 1 || status->count != 0) scan.counter_candidate.vtotal = 0;
+    if (!ready || mach_absolute_time() >= scan.startup_end) return true;
+    const uint32_t preimage = scan_intf[F345_COUNT_EN / 4];
+    if (preimage != 0) {
+        scan.counter_candidate.vtotal = 0;
+        return true;
+    }
+
+    scan.counter_attempted = true;
+    scan_intf_write(F345_COUNT_EN, F346_COUNT_ON);
+    const uint32_t readback = scan_intf[F345_COUNT_EN / 4];
+    printf("SWEET F346 COUNTER: arm poll=%u preimage=%x readback=%x\n",
+        scan.polls, preimage, readback);
+    return readback == F346_COUNT_ON;
 }

