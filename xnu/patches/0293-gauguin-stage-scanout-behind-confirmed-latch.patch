+void
+AppleCLCD::flip382Finish(const struct sweet_fb_frame *frame, uint64_t attempt, uint64_t staged)
+{
+    IOLockLock(fLock);
+    auto &flip = fFlip382;
+    if (flip.stage == sweet_fb_flip382::Copying && flip.attempt == attempt) {
+        flip.stage = staged ? sweet_fb_flip382::Ready : sweet_fb_flip382::Idle;
+        if (staged) IOLog("SWEET F382 P %llu %u %llu\n",attempt,flip.next,staged);
+        const uint64_t target = requestedPresentation375(frame->record);
+        uint64_t separation = 0;
+        if (target && staged)
+            absolutetime_to_nanoseconds(staged > target ? staged - target : target - staged, &separation);
+        flip.receipt = frame->frameInfoOwner && target && staged && separation <= UINT64_C(2000000000) ?
+            f375_copy{target,staged,get32(frame->record,0x50),0,frame->frameInfoOwner} : f375_copy{};
+    }
+    IOLockUnlock(fLock);
+}
