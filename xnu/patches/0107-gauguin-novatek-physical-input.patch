+    uint32_t file_bytes, header_bytes, needed_file_bytes, total_write_bytes;
+    uint32_t table_entries, reserved_entries;
+    uint8_t version;
+    size_t part_count;
+    struct nfw_partition parts[NFW_MAX_PARTITIONS];
