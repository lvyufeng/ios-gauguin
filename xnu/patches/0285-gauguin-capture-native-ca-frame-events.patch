+static uint32_t f374_gate = F374_CLOSED, f374_count;
+static bool f374_configured, f374_exported;
+static uint64_t f374_receiver, f374_start, f374_end;
+static struct f374_event f374_events[F374_EVENT_CAP];
+static uint64_t f374_threads[F372_THREAD_CAP];
+
+void
+sweet_ca374_arm(uint64_t receiver, uint64_t start, uint64_t end)
+{
+	if (!f374_configured || !(kdebug_enable & KDEBUG_ENABLE_TRACE) ||
+	    !kdebug_debugid_explicitly_enabled(0x31ca002c) || !receiver ||
+	    !start || end <= start || end - start > UINT32_MAX || f374_start) {
+		return;
+	}
+	f374_receiver = receiver;
+	f374_start = start;
+	f374_end = end;
+	__atomic_store_n(&f374_gate, 0, __ATOMIC_RELEASE);
+}
+
+/* Mirror only the selected existing userspace trace events during F344. */
+static void
+f374_observe(struct proc *p, const struct kdebug_trace64_args *uap)
+{
+	const unsigned kind = f374_kind(uap->code);
+	if (!kind) return;
+	uint32_t gate = __atomic_load_n(&f374_gate, __ATOMIC_ACQUIRE);
+	while (!(gate & F374_CLOSED)) {
+		if (__atomic_compare_exchange_n(&f374_gate, &gate, gate + 1, true,
+		    __ATOMIC_ACQUIRE, __ATOMIC_ACQUIRE)) {
+			break;
+		}
+	}
+	if (gate & F374_CLOSED) return;
+	const uint64_t tick = mach_absolute_time();
+	if (tick >= f374_start && tick < f374_end) {
+		const audit_token_t *token = task_get_audit_token(proc_task(p));
+		const uint64_t receiver = ((uint64_t)token->val[7] << 32) | token->val[5];
+		if (receiver == f374_receiver) {
+			const uint32_t index = __atomic_fetch_add(&f374_count, 1, __ATOMIC_RELAXED);
+			if (index < F374_EVENT_CAP) {
+				f374_events[index] = (struct f374_event){tick,
+				    thread_tid(current_thread()), uap->arg1, uap->arg2,
+				    uap->arg3, uap->arg4, kind};
+			}
+		}
+	}
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+}
+
+static void
+f374_block(unsigned ordinal, unsigned count, const uint8_t *packed, unsigned used)
+{
+	char encoded[4 * ((F374_BLOCK * F374_MAX_ROW + 2) / 3) + 1];
+	char line[sizeof(encoded) + 64];
+	f372_base64(packed, used, encoded);
+	const int length = snprintf(line, sizeof(line), "\nSWEET F374 B %u %u %s\n",
+	    ordinal, count, encoded);
+	if (length > 0 && (size_t)length < sizeof(line)) sweet_log_append(line, length);
+}
+
+void
+sweet_ca374_drain(void)
+{
+	if (f374_exported) return;
+	if (!f374_start) {
+		f374_exported = true;
+		printf("SWEET F374: unavailable active=%u\n", (unsigned)f374_configured);
+		return;
+	}
+	__atomic_fetch_or(&f374_gate, F374_CLOSED, __ATOMIC_ACQ_REL);
+	if (__atomic_load_n(&f374_gate, __ATOMIC_ACQUIRE) != F374_CLOSED) return;
+	f374_exported = true;
+	const unsigned captured = __atomic_load_n(&f374_count, __ATOMIC_RELAXED);
+	const bool live = (kdebug_enable & KDEBUG_ENABLE_TRACE) &&
+	    kdebug_debugid_explicitly_enabled(0x31ca002c);
+	printf("SWEET F374 H: version=1 active=%u start=%llu end=%llu captured=%u\n",
+	    (unsigned)live, (unsigned long long)f374_start, (unsigned long long)f374_end, captured);
+	unsigned threads = 0, total = 0, emitted = 0, used = 0, count = 0;
+	uint8_t packed[F374_BLOCK * F374_MAX_ROW];
+	for (unsigned index = 0; index < captured && index < F374_EVENT_CAP; ++index) {
+		const struct f374_event *event = &f374_events[index];
+		unsigned thread = 0;
+		while (thread < threads && f374_threads[thread] != event->thread) ++thread;
+		if (thread == F372_THREAD_CAP) break;
+		const unsigned size = f374_pack(packed + used, f374_start, f374_end, event, (uint8_t)thread);
+		if (!size || total + size > F374_WIRE_CAP) break;
+		if (thread == threads) {
+			f374_threads[threads++] = event->thread;
+			printf("SWEET F374 T %u %llx\n", thread, (unsigned long long)event->thread);
+		}
+		total += size;
+		used += size;
+		++count;
+		++emitted;
+		if (count == F374_BLOCK) {
+			f374_block(emitted - count, count, packed, used);
+			count = used = 0;
+		}
+	}
+	if (count) f374_block(emitted - count, count, packed, used);
+	printf("SWEET F374 F: rows=%u threads=%u bytes=%u lost=%u\n",
+	    emitted, threads, total, captured - emitted);
+}
+#endif
