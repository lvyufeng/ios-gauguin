+    c->diagnostic=(struct ggt_diagnostic){1,0,reg,0,*v};
+    return guard(c)?GGT_OK:GGT_GUARD;
+}
+static enum ggt_result wr(struct ggt_context *c,uint32_t reg,uint32_t v)
+{
+    if(!guard(c))return GGT_GUARD;
+    if(reg==0x807)c->work.submit_attempted=1;
+    if(reg==0x1f8c3){if(v)c->work.keepalive_set_attempted=1;else c->work.keepalive_clear_attempted=1;}
+    ++c->work.writes;if(!c->ops.write32(c->ops.cookie,reg,v))return GGT_IO;
+    return guard(c)?GGT_OK:GGT_GUARD;
+}
+static enum ggt_result mr(struct ggt_context *c,enum ggt_memory mem,uint32_t off,uint32_t *v)
+{
+    if(!guard(c))return GGT_GUARD;
