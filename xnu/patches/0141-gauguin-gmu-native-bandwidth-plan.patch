+bool sweet_bus_bw_entries(struct ndb_entry *out)
+{
+    if(!out||!bus_context()||!__atomic_load_n(&bus_plan_ready,__ATOMIC_ACQUIRE)||!bus_work||
+       memcmp(bus_work->raw[0],bus_work->raw[1],BUS_RAW_BYTES))return false;
+    static const char *const names[]={"MC0","SH0","ACV","SN10"};
+    struct ndb_entry entries[4];
+    for(unsigned i=0;i<4;i++)if(ndb_lookup(bus_work->raw[0],BUS_RAW_BYTES,names[i],
+        strlen(names[i]),&entries[i])!=NDB_OK)return false;
+    memcpy(out,entries,sizeof(entries));return true;
+}
