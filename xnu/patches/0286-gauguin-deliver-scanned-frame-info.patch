+/* Values used by the 20H392 IOMobileFramebuffer FrameInfo decoder. */
+static inline void
+f375_values(uint64_t values[F375_INFO_ARGS], uint32_t swap, uint64_t actual, uint64_t target)
+{
+    values[0] = UINT32_C(0x80000000) | F375_INFO_MASK;
+    values[1] = swap;
+    values[2] = (uint32_t)actual;
+    values[3] = (uint32_t)(actual >> 32);
+    values[4] = (uint32_t)target;
+    values[5] = (uint32_t)(target >> 32);
+}
+
+struct f375_copy {
+    uint64_t target, copied;
+    uint32_t swap, scan, owner;
+};
+
+static inline bool
+f375_scan_after_copy(const struct f375_copy *copy, uint32_t scan, uint64_t lo, uint64_t hi)
+{
+    return copy->swap && copy->owner && copy->target && copy->copied &&
+        scan == copy->scan && lo && lo < hi && copy->copied < hi;
+}
