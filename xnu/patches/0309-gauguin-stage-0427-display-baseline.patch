+static uint32_t cpu402_read(void *cookie, unsigned offset)
+{
+    const volatile uint32_t *regs = cookie;
+    const uint32_t value = regs[offset / sizeof(uint32_t)];
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
