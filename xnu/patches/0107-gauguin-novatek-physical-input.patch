+++ b/bsd/dev/gauguin_nvt/nvt_protocol.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: MIT
+ * Pure protocol candidate for observed gauguin trim 0c0000726603.
+ * Protocol facts: LineageOS/android_kernel_xiaomi_gauguin
+ * 19b63c8192b1c9b7c4d931d7d3be92024bc2d778, nt36672c/nt36xxx*.
+ * No MMIO, GPIO, firmware upload, allocation or kernel/HID calls.
+ */
+#ifndef GAUGGUIN_NVT_PROTOCOL_H
+#define GAUGGUIN_NVT_PROTOCOL_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define NVT_EVENT_BASE 0x22d00u
+#define NVT_MAX_CONTACTS 10u
+#define NVT_MAX_X 1080u
+#define NVT_MAX_Y 2400u
+#define NVT_POINT_PAYLOAD 65u
+#define NVT_MAX_WIRE 67u
+
+enum nvt_status {
+    NVT_OK = 0,
+    NVT_ERR_ARGUMENT = -1,
+    NVT_ERR_LENGTH = -2,
+    NVT_ERR_IDENTITY = -3,
+    NVT_ERR_FW_CHECKSUM = -4,
+    NVT_ERR_GEOMETRY = -5,
+    NVT_ERR_CONTACT_ID = -6,
+    NVT_ERR_COORDINATE = -7,
+    NVT_ERR_DUPLICATE_ID = -8
+};
+enum nvt_read_kind { NVT_READ_FWINFO, NVT_READ_RESET, NVT_READ_PID, NVT_READ_POINTS };
+struct nvt_request {
+    uint32_t address;
+    uint8_t page[3];            /* One write transaction, separate CS. */
+    uint8_t tx[NVT_MAX_WIRE];   /* Fully initialized, including dummy clocks. */
+    size_t wire_length;        /* One full-duplex transaction, CS held throughout. */
+    size_t payload_length;
+    uint8_t restore_page[3];   /* Independent write returning cursor to EVENT_BASE. */
+};
+struct nvt_fw_info {
+    uint8_t version, x_channels, y_channels, buttons, firmware_type;
+    uint16_t max_x, max_y;      /* FWINFO extents; native worker accepts <=extent.
+                                * Advertised native input range is0..extent-1. */
+};
+struct nvt_reset_info { uint8_t state, detail[4]; };
+enum nvt_event_kind { NVT_DOWN, NVT_MOVE, NVT_UP };
+struct nvt_contact {
+    uint16_t x, y, pressure;
+    uint8_t width, wire_status;
+    bool active;
+};
+struct nvt_event {
+    enum nvt_event_kind kind;
+    uint8_t id;                /* Controller ID 1..10; HID adapter chooses its own IDs. */
+    struct nvt_contact contact;
+};
+enum nvt_packet_kind { NVT_PACKET_CONTACTS, NVT_PACKET_ESD, NVT_PACKET_WDT };
+struct nvt_frame {
+    enum nvt_packet_kind kind;
+    unsigned event_count, active_count;
+    struct nvt_event events[NVT_MAX_CONTACTS];
+    uint8_t wdt_streak;
+    bool recovery_required;    /* WDT signature seen >10 consecutive valid transfers. */
+    uint8_t native_tail[5];    /* Payload60..64: no point checksum specified by pinned source. */
+};
+struct nvt_state {
+    uint16_t max_x, max_y;
+    bool initialized;
+    uint8_t wdt_streak;
+    struct nvt_contact contacts[NVT_MAX_CONTACTS];
+};
+
+int nvt_check_observed_chip(const uint8_t *trim, size_t length);
+int nvt_make_request(enum nvt_read_kind kind, struct nvt_request *out);
+/* All decode inputs are the ENTIRE raw RX transfer: command response, dummy,
+ * then payload. RX[0:2] is undefined and is never checked as an echo/checksum.
+ * Require exact wire lengths18/7/4/67; never pass native point_data or RX+2.
+ * Outputs and contact state remain unchanged on error.
+ */
+int nvt_decode_fwinfo(const uint8_t *rx, size_t length, struct nvt_fw_info *out);
+int nvt_decode_reset(const uint8_t *rx, size_t length, struct nvt_reset_info *out);
+bool nvt_reset_ready(const struct nvt_reset_info *info, uint8_t minimum);
+int nvt_decode_pid(const uint8_t *rx, size_t length, uint16_t *out);
+int nvt_state_init(struct nvt_state *state, const struct nvt_fw_info *info);
+/* Awake, normal-report mode only. Controller status1/2 means active; native
+ * releases IDs absent from the active snapshot. Events derive from old/new
+ * presence, so a first observed MOVE still starts a new HID contact.
+ * Malformed active records and duplicate valid IDs reject the whole snapshot.
+ * ESD/WDT signatures preserve contacts; caller decides when to cancel input.
+ */
+int nvt_decode_points(struct nvt_state *state, const uint8_t *rx, size_t length,
+                      struct nvt_frame *out);
+/* Explicit transport-loss/suspend policy action; never implicit on a bad frame. */
+int nvt_cancel_contacts(struct nvt_state *state, struct nvt_frame *out);
+#endif
--- /dev/null
+++ b/bsd/dev/gauguin_nvt/geni_spi_pio.c
@@ -0,0 +1,215 @@
+#include "geni_spi_pio.h"
+
+static uint32_t rd(struct gs_pio *s, uint32_t reg)
+{ return s->io.read32(s->io.cookie, reg); }
+static void wr(struct gs_pio *s, uint32_t reg, uint32_t value)
+{ s->io.write32(s->io.cookie, reg, value); }
+static void fence(struct gs_pio *s)
+{ s->io.barrier(s->io.cookie); }
+
+/* Fixed to the actual observed 16-word, 32-bit FIFOs for this first probe.
+ * Refuse unknown shapes/configurations before making any register writes.
+ */
+static int configured(struct gs_pio *s)
+{
+    uint32_t p0 = rd(s, GS_HW_PARAM0), p1 = rd(s, GS_HW_PARAM1);
+    if (((p0 >> 16) & 63) != 16 || ((p1 >> 16) & 63) != 16 ||
+        ((p0 >> 24) & 63) != 32 || ((p1 >> 24) & 63) != 32 ||
+        ((rd(s, GS_FW_REVISION) >> 8) & 255) != 1 ||
+        (rd(s, GS_FIFO_DISABLE) & 1) || (rd(s, GS_DMA_MODE) & 1) ||
+        rd(s, GS_IRQ_EN) || rd(s, GS_GSI_EVENT_EN) ||
+        (rd(s, GS_CPHA) & 1) || (rd(s, GS_CPOL) & 4) ||
+        (rd(s, GS_LOOPBACK) & 3) || (rd(s, GS_CS_SEL) & 15) ||
+        (rd(s, GS_CS_INV) & 1) || (rd(s, GS_WORD_LEN) & 1023) != 4 ||
+        rd(s, GS_BYTE_GRAN) != 0 ||
+        rd(s, GS_TX_PACK0) != GS_PACK0 || rd(s, GS_RX_PACK0) != GS_PACK0 ||
+        rd(s, GS_TX_PACK1) != GS_PACK1 || rd(s, GS_RX_PACK1) != GS_PACK1)
+        return GS_NOT_CONFIGURED;
+    if (rd(s, GS_STATUS) & (GS_CMD_ACTIVE | GS_S_CMD_ACTIVE))
+        return GS_BUSY;
+    if ((rd(s, GS_TX_STATUS) & GS_TX_WC_MASK) ||
+        (rd(s, GS_RX_STATUS) & GS_RX_WC_MASK))
+        return GS_DIRTY;
+    return GS_OK;
+}
+
+static int drain(struct gs_pio *s, uint8_t *rx, size_t len, bool discard)
+{
+    uint32_t stat = rd(s, GS_RX_STATUS);
+    uint32_t words = stat & GS_RX_WC_MASK;
+    uint32_t last = (stat >> 28) & 7;
+    size_t bytes;
+    s->diag.last_rx_status = stat;
+    if (words > 16 || ((stat & GS_RX_LAST) && last > 4))
+        return GS_IO_ERROR;
+    if (!words)
+        return GS_OK;
+    bytes = (size_t)words * 4;
+    /* Native RX_LAST: zero denotes a complete 4-byte final FIFO word. */
+    if ((stat & GS_RX_LAST) && last && last < 4)
+        bytes -= 4 - last;
+    if (!discard && (bytes > len - s->diag.rx_received ||
+                     s->diag.rx_received > s->diag.tx_queued ||
+                     bytes > s->diag.tx_queued - s->diag.rx_received))
+        return GS_IO_ERROR;
+    for (uint32_t i = 0; i < words; i++) {
+        uint32_t word = rd(s, GS_RX_FIFO);
+        size_t n = bytes < 4 ? bytes : 4;
+        for (size_t j = 0; j < n; j++) {
+            if (!discard) {
+                if (rx)
+                    rx[s->diag.rx_received] = (uint8_t)(word >> (j * 8));
+                s->diag.rx_received++;
+            }
+        }
+        bytes -= n;
+    }
+    return GS_OK;
+}
+
+static bool wait_stop(struct gs_pio *s, uint32_t completion)
+{
+    uint64_t start = s->io.now_us(s->io.cookie);
+    for (uint32_t n = 0; n < s->max_polls; n++) {
+        uint32_t irq = rd(s, GS_M_IRQ_STATUS);
+        s->diag.irq_seen |= irq;
+        /* Draining can unblock a full RX FIFO during cancellation. */
+        if (drain(s, NULL, 0, true) != GS_OK)
+            return false;
+        if ((irq & completion) && !(rd(s, GS_STATUS) & GS_CMD_ACTIVE)) {
+            wr(s, GS_M_IRQ_CLEAR, irq);
+            fence(s);
+            return true;
+        }
+        if ((uint64_t)(s->io.now_us(s->io.cookie) - start) >=
+            s->recovery_timeout_us)
+            break;
+        s->io.relax(s->io.cookie);
+    }
+    return false;
+}
+
+static void recover(struct gs_pio *s)
+{
+    s->poisoned = true;
+    wr(s, GS_TX_WM, 0);
+    fence(s);
+    if (!(rd(s, GS_STATUS) & GS_CMD_ACTIVE)) {
+        s->diag.recovery = GS_REC_IDLE;
+    } else {
+        /* Like the native cancel path, stop expecting normal CMD_DONE. */
+        wr(s, GS_M_IRQ_EN, rd(s, GS_M_IRQ_EN) & ~GS_DONE);
+        wr(s, GS_M_CTRL, 1u << 2);
+        fence(s);
+        if (wait_stop(s, GS_CANCELLED)) {
+            s->diag.recovery = GS_REC_CANCEL;
+        } else {
+            wr(s, GS_M_CTRL, 1u << 1);
+            fence(s);
+            s->diag.recovery = wait_stop(s, GS_ABORTED) ?
+                GS_REC_ABORT : GS_REC_STUCK;
+        }
+    }
+    if (drain(s, NULL, 0, true) != GS_OK)
+        s->diag.recovery = GS_REC_STUCK;
+}
+
+int gs_pio_xfer(struct gs_pio *s, const uint8_t *tx, uint8_t *rx, size_t len)
+{
+    uint64_t start;
+    int result;
+    bool done = false;
+    if (!s || !tx || !len || len > GS_MAX_WIRE ||
+        !s->io.read32 || !s->io.write32 || !s->io.barrier ||
+        !s->io.now_us || !s->io.relax || !s->timeout_us ||
+        s->timeout_us > 1000000 || !s->recovery_timeout_us ||
+        s->recovery_timeout_us > 100000 || !s->max_polls ||
+        s->max_polls > 1000000)
+        return GS_INVALID;
+    if (s->in_flight)
+        return GS_BUSY;
+    if (s->poisoned)
+        return GS_POISONED;
+    s->diag = (struct gs_diag){0};
+    result = configured(s);
+    if (result != GS_OK)
+        return result;
+    s->in_flight = true;
+    start = s->io.now_us(s->io.cookie);
+    wr(s, GS_M_IRQ_CLEAR, rd(s, GS_M_IRQ_STATUS));
+    wr(s, GS_M_IRQ_EN, GS_ERRORS | GS_DONE | (1u << 26) |
+       (1u << 27) | (1u << 30));
+    wr(s, GS_RX_WM, 0);
+    wr(s, GS_RX_RFR_WM, 14);
+    wr(s, GS_TRANS_CFG, rd(s, GS_TRANS_CFG) & ~1u);
+    wr(s, GS_TX_LEN, (uint32_t)len);
+    wr(s, GS_RX_LEN, (uint32_t)len);
+    fence(s);
+    /* One command: no fragmentation, per-word CS toggle, or FIFO splitting. */
+    wr(s, GS_M_CMD, GS_FULL_DUPLEX);
+    wr(s, GS_TX_WM, 1);
+    fence(s);
+    result = GS_TIMEOUT;
+    for (uint32_t n = 0; n < s->max_polls; n++) {
+        uint32_t irq = rd(s, GS_M_IRQ_STATUS), wc;
+        s->diag.polls++;
+        s->diag.irq_seen |= irq;
+        if (irq & GS_ERRORS) {
+            result = GS_IO_ERROR;
+            break;
+        }
+        /* Inspect RX even when only CMD_DONE is set: the last partial word
+         * must be drained before any completion/counter decision.
+         */
+        result = drain(s, rx, len, false);
+        if (result != GS_OK)
+            break;
+        done = done || (irq & GS_DONE);
+        if (done) {
+            if (s->diag.tx_queued != len || s->diag.rx_received != len) {
+                result = GS_SHORT;
+                break;
+            }
+            if (!(rd(s, GS_STATUS) & GS_CMD_ACTIVE)) {
+                result = GS_OK;
+                break;
+            }
+        }
+        s->diag.last_tx_status = rd(s, GS_TX_STATUS);
+        wc = s->diag.last_tx_status & GS_TX_WC_MASK;
+        if (wc > 16) {
+            result = GS_IO_ERROR;
+            break;
+        }
+        /* Credit covers ALL queued-but-not-drained bytes, including bytes
+         * already shifted into RX while the CPU was draining a snapshot.
+         * TX occupancy alone cannot prevent RX overflow under that race.
+         * <=60 outstanding bytes leave one RX FIFO word of headroom.
+         */
+        while (!done && wc < 15 && s->diag.tx_queued < len &&
+               s->diag.tx_queued - s->diag.rx_received < 60) {
+            uint32_t word = 0;
+            for (unsigned j = 0; j < 4 && s->diag.tx_queued < len; j++)
+                word |= (uint32_t)tx[s->diag.tx_queued++] << (j * 8);
+            wr(s, GS_TX_FIFO, word);
+            fence(s);
+            wc++;
+        }
+        if (s->diag.tx_queued == len)
+            wr(s, GS_TX_WM, 0);
+        wr(s, GS_M_IRQ_CLEAR, irq);
+        fence(s);
+        result = GS_TIMEOUT;
