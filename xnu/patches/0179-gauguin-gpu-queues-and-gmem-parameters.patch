+gpu_queue *GauguinGPUUserClient::queue(uint32_t id)
+{
+    if(id){for(auto &q:fQueues)if(q.id==id)return &q;return nullptr;}
+    /* Preserve legacy default/single-queue clients. Once there are multiple
+     * explicit queues, zero cannot guess a fence's namespace. A used default
+     * queue retains its own identity rather than aliasing a later new queue. */
+    if(fDefaultQueue.completed)return &fDefaultQueue;
+    gpu_queue *only=nullptr;
+    for(auto &q:fQueues)if(q.id){if(only)return nullptr;only=&q;}
+    return only?only:&fDefaultQueue;
