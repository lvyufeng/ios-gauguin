+static struct {
+    IOMemoryDescriptor *memory[2];
+    IOMemoryMap *mapping[2];
+} scanout383;
+
+/* The private descriptors are never published as IOSurfaces. This is the
+ * same VM mapping path as the inherited front framebuffer. */
+extern "C" void
+sweet_fb383_discard(void)
+{
+    for (unsigned i = 0; i < 2; ++i) {
+        OSSafeReleaseNULL(scanout383.mapping[i]);
+        OSSafeReleaseNULL(scanout383.memory[i]);
+    }
+}
+
+extern "C" bool
+sweet_fb383_map(uint32_t first, uint32_t bytes, uintptr_t address[2])
+{
+    if (bytes != F382_SLOT_BYTES || scanout383.memory[0] || scanout383.memory[1])
+        return false;
+    uintptr_t result[2] = {};
+    for (unsigned i = 0; i < 2; ++i) {
+        scanout383.memory[i] = IOMemoryDescriptor::withPhysicalAddress(
+            static_cast<uint64_t>(first) + i * bytes,bytes,kIODirectionInOut);
+        if (scanout383.memory[i])
+            scanout383.mapping[i] = scanout383.memory[i]->map(kIOMapWriteCombineCache);
+        if (scanout383.mapping[i])
+            result[i] = static_cast<uintptr_t>(scanout383.mapping[i]->getVirtualAddress());
+        if (!result[i]) {
+            sweet_fb383_discard();
+            return false;
+        }
+    }
+    address[0] = result[0];
+    address[1] = result[1];
+    return true;
