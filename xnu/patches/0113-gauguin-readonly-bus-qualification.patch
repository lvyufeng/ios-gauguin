+#ifndef GAUGUIN_BCM_PLAN_H
+#define GAUGUIN_BCM_PLAN_H
+#include <stddef.h>
+#include <stdint.h>
+/* Pure BCM command-DB decode and bounded six-command BOOT plan: PLAN ONLY.
+ * "Command" means one BCM_TCS_CMD data word per board row (6 of 6). Nothing
+ * here maps, reads or writes hardware, RPMh, SMC or PAS, and nothing
+ * is submitted. The board metadata below is VERIFIED for all six rows
+ * (parent-reviewed cmd-db text, research/tmp/dsh-gpu-bus-audit/REPORT.md);
+ * aux layout follows native pinned19b63c8192b1c9b7c4d931d7d3be92024bc2d778
+ * drivers/soc/qcom/msm_bus/msm_bus_fabric_rpmh.c:55-60 (struct bcm_db),
+ * :26-41 (BCM_TCS_CMD macro). Runtime callers supply entries parsed by
+ * cmd_db_snapshot.h from a CPU-owned snapshot. */
+struct ndb_entry; /* bsd/dev/cmd_db_snapshot.h */
+
+enum {
+    GBCM_COUNT = 6,
+    GBCM_AUX_BYTES = 8,
+    GBCM_MAX_VCD = 16,
+    GBCM_VOTE_MAX = 0x3fff,    /* BCM_TCS_CMD_VOTE_MASK, both 14-bit limits */
+};
+
+enum gbcm_result {
+    GBCM_OK, GBCM_ARGUMENT, GBCM_NOT_BCM, GBCM_MALFORMED, GBCM_MISMATCH,
+};
+
+struct gbcm_db {
+    uint32_t address, unit;
+    uint16_t width, bank_version;
+    uint8_t vcd, reserved;
+};
+struct gbcm_command {
+    uint32_t address, data;
+    uint8_t wait;
+};
+struct gbcm_plan {
+    struct gbcm_db db[GBCM_COUNT];
+    struct gbcm_command cmd[GBCM_COUNT];
+    uint32_t wait_mask;
+};
+
+enum {
+    GBCM_ACV = 5,              /* row index of ACV in the board table */
+    GBCM_COMMIT = 0x40000000u, /* BCM_TCS_CMD_COMMIT_MASK */
+    GBCM_VALID = 0x20000000u,  /* BCM_TCS_CMD_VALID_MASK */
+    /* Native APPS ACV mask (msm_bus_arb_rpmh.c:23,477-494), not a bit number:
+     * BCM_TCS_CMD(commit, valid, 0, BCM_TCS_CMD_ACV_APPS). */
+    GBCM_ACV_APPS = 0x8,
+    GBCM_EXPECT_WAIT_MASK = 0x3b,
+};
+
+/* Exact verified board rows, in deliberate BOOT plan order. SN0 before SN6
+ * within VCD3 is a board choice, not a claim about native client order. */
+struct gbcm_board_row {
+    const char *name;
+    uint32_t address, unit;
+    uint16_t width;
+    uint8_t vcd;
+};
+extern const struct gbcm_board_row gbcm_board[GBCM_COUNT];
+
+/* aux must be exactly8 bytes, reserved byte0; owner bank5, address bank5,
+ * nonzero, 4-byte aligned, unit>0, VCD<16; LE field order. bank_version is
+ * copied as observed, never version-gated. Output untouched on failure. */
+enum gbcm_result gbcm_decode(const struct ndb_entry *entry, struct gbcm_db *out);
+/* count must be6; entries[i] must be the zero-padded name of board row i and
+ * match its address/unit/width/vcd; duplicate names rejected; width0 is
+ * accepted only because the table itself requires it for ACV. Commands in
+ * board order: commit when this is ACV or the next row has another VCD
+ * (i.e. it ends its VCD); wait=commit, so active wait_mask=0x3b covers the five
+ * committed VCD groups, ACV's group included (ACV ends its own VCD and is one
+ * of the five). No TCS slot is chosen here.
+ * Numeric rows use the temporary boot-lifetime maximum (0x3fff/0x3fff):
+ * not an ordinary client vector, not a real frequency/current floor or a
+ * daily power policy, and not applied to ACV/ARC/ALC. *out is assigned only
+ * after every check passes and out must not alias entry input. */
+enum gbcm_result gbcm_build(const struct ndb_entry *entries, size_t count,
+    struct gbcm_plan *out);
+
+#endif /* GAUGUIN_BCM_PLAN_H */
