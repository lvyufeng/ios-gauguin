+bool
+SweetBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("backlight-control", true);
+	setProperty("brightness", (unsigned long long)0x400);
+	setProperty("max-brightness", (unsigned long long)0x800);
+	setProperty("IOClass", "SweetBacklight");
+	registerService();
+	IOLog("SWEET BL: backlight service published (backlight-control=true)\n");
+	return true;
+}
+
+void
+SweetBacklight::stop(IOService *provider)
+{
+	IOService::stop(provider);
