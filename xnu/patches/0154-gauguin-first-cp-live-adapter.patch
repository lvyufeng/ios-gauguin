+    if((off&3)||off>=(memory==GGQ_RING?32768u:4096u)||!gmb_ram)return 0;
+    if(write&&ggq_context.phase!=GGQ_MEMORY&&!(memory==GGQ_RING&&ggq_context.phase==GGQ_COMMANDS))return 0;
+    if(!write&&ggq_context.phase!=GGQ_MEMORY&&ggq_context.phase!=GGQ_COMMANDS&&
+       !(memory==GGQ_SCRATCH&&off==0&&ggq_context.phase==GGQ_WAIT))return 0;
+    return gmb_ram+ggb_plan.region[memory==GGQ_RING?GGP_RING:GGP_SCRATCH].offset-GMB_PAGE+off;
+}
+static bool ggq_board_memory_read(void *cookie,enum ggq_memory memory,uint32_t off,uint32_t *out)
+{(void)cookie;vm_offset_t va=ggq_memory_address(memory,off,false);if(!va||!out)return false;*out=gfw_load32(va);return true;}
+static bool ggq_board_memory_write(void *cookie,enum ggq_memory memory,uint32_t off,uint32_t value)
