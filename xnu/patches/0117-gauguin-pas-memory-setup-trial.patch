+enum gpm_state sweet_pas_mem_state(void)
+{ return (enum gpm_state)__atomic_load_n(&gpm_lifecycle, __ATOMIC_ACQUIRE); }
+static enum gpi_rc gpm_finish(enum gpi_rc rc, const struct gpi_receipt *receipt, struct gpm_receipt *out)
+{
+    if (rc != GPI_OK) gauguin_wdt_lease_quarantine();
+    *out = (struct gpm_receipt){
+        .stage_pa = receipt->stage_pa, .region_bytes = GPM_REGION_BYTES,
+        .returned = receipt->returned, .has_returned = receipt->has_returned,
+        .smc_calls = receipt->smc_calls, .fresh_attempts = receipt->fresh_attempts,
+        .continuations = receipt->continuations,
+    };
+    __atomic_store_n(&gpm_lifecycle, rc == GPI_OK ? GPM_COMPLETE : GPM_QUARANTINED, __ATOMIC_RELEASE);
+    char line[192];
+    snprintf(line, sizeof(line), "SWEET PAS MEM: terminal rc=%u returned=%u calls=%u fresh=%u continuations=%u; MEM_SETUP4096 only, no b02/AUTH_RESET/GPU; retained until reset",
+        (unsigned)rc, receipt->has_returned, receipt->smc_calls, receipt->fresh_attempts, receipt->continuations);
+    gpi_record(line);
+    return rc;
+}
+enum gpi_rc
+sweet_pas_mem_setup_once(struct gpm_receipt *out)
+{
+    unsigned expected = GPM_IDLE;
+    if (!sweet_pas_mem_requested()) return GPI_OFF;
+    if (out == NULL) return GPI_ARGUMENT;
+    if (!__atomic_compare_exchange_n(&gpm_lifecycle, &expected, GPM_RUNNING, false,
+        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return GPI_ALREADY;
+    struct gpi_receipt receipt = {0};
+    if (!gpi_context()) return gpm_finish(GPI_CONTEXT, &receipt, out);
+    if (!sweet_pas_init_requested() || !gpi_flags()) return gpm_finish(GPI_CONFIG, &receipt, out);
+    /* This acquire is the authority for the private immutable PA. Do not read
+     * it for IDLE/RUNNING/failed INIT; caller receipts/log values are irrelevant. */
+    if (sweet_pas_init_state() != GPI_COMPLETE) return gpm_finish(GPI_PREREQUISITE, &receipt, out);
+    receipt.stage_pa = gpi_success_pa;
+    if (!receipt.stage_pa || (receipt.stage_pa & UINT64_C(0xfffff)) ||
+        receipt.stage_pa > UINT64_C(0xfff00000) ||
+        sweet_bcm_transport_state() != GBCMT_COMPLETE) return gpm_finish(GPI_PREREQUISITE, &receipt, out);
+    return gpm_finish(gpi_transaction(true, &receipt), &receipt, out);
 }
