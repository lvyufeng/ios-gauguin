+
+/* CPU staging only. No EL3 authentication, permission or GPU readiness claim.
+ * Addresses are this boot's dynamically selected reservation, never an old log
+ * value. No mutable virtual buffer pointer is returned. The low mapping and
+ * whole reservation remain retained until reboot, even after claim/failure. */
+struct sweet_pas_cpu_stage {
+    uint64_t pa;
+    uint32_t metadata_bytes;
+    uint32_t reserved_bytes;
+};
+
+/* Internal owner-probe entry only: caller must first validate this boot's
+ * LowPASReservation provenance and all64 unmanaged NC pages. Both exact1
+ * flags sweetpasprobe/sweetpasstage are required. Disabled leaves IDLE; an
+ * enabled attempt is terminal even on error. Existing caller ABI retained. */
+void sweet_pas_stage_once(uint64_t pa, uint64_t region_bytes);
+
+/* Atomically claim the CPU-stage record once, after verified pin/copy/readback
+ * and zero-tail checks. Success returns PA,6860,16384 with acquire visibility.
+ * NULL, IDLE, in-progress, failed and already-claimed calls return false and
+ * leave any non-NULL output unchanged. No unclaim, retry, restage or free API.
+ * A later secure caller must qualify its own resources/ABI/permissions and
+ * issue the appropriate DSB before SMC; this function invokes no SMC. */
+bool sweet_pas_cpu_stage_claim(struct sweet_pas_cpu_stage *out);
