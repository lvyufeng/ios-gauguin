diff --git a/bsd/dev/gauguin_probe358.h b/bsd/dev/gauguin_probe358.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_probe358.h
@@ -0,0 +1,76 @@
+#ifndef GAUGUIN_PROBE358_H
+#define GAUGUIN_PROBE358_H
+
+#include "gauguin_blank352.h"
+
+enum {
+    SCAN358_PROBE_FIRST_LINE = 1728,
+    SCAN358_PROBE_LIMIT = 1024,
+    SCAN358_FRAME_CAPACITY = 20480,
+    SCAN358_PROBE_LOCK_BUSY = 1,
+    SCAN358_PROBE_STALE,
+    SCAN358_PROBE_PENDING,
+    SCAN358_PROBE_PUBLISHED
+};
+
+struct scan358_request {
+    uint64_t ticket;
+    uint32_t frame;
+};
+
+struct scan358_probe_slot {
+    struct scan358_request request;
+    uint32_t sent;
+};
+
+/* The route monitor already samples this counter. A request can be
+ * replaced by a newer scan before the workloop sees it. */
+static inline bool
+scan358_offer(struct scan358_probe_slot *slot, uint32_t frame, uint64_t ticket)
+{
+    const uint32_t step = frame - slot->request.frame;
+    if (!ticket || slot->sent >= SCAN358_PROBE_LIMIT ||
+        (slot->sent && (!step || step >= UINT32_C(0x80000000))))
+        return false;
+    slot->request.ticket = ticket;
+    slot->request.frame = frame;
+    ++slot->sent;
+    return true;
+}
+
+static inline struct scan358_request
+scan358_take(struct scan358_probe_slot *slot)
+{
+    const struct scan358_request request = slot->request;
+    slot->request.ticket = 0;
+    return request;
+}
+
+static inline bool
+scan358_probe_line(uint32_t line)
+{
+    /* The workloop separately checks the live, potentially earlier,
+     * end-of-blank guard before touching the GPU. */
+    return line >= SCAN358_PROBE_FIRST_LINE &&
+        (line < SCAN351_OPEN || scan352_can_copy(line, SCAN351_TOTAL - SCAN351_END_GUARD));
+}
+
+static inline bool
+scan358_still_timely(const struct scan358_request *request, const struct scan351_position *position,
+    const struct scan351_slot *blank)
+{
+    const uint32_t copy_line = position->line < SCAN351_OPEN ? SCAN351_OPEN : position->line;
+    return request->ticket && position->frame == request->frame &&
+        position->line >= SCAN358_PROBE_FIRST_LINE && scan352_can_copy(copy_line, position->end) &&
+        (!blank->attempts || blank->frame != position->frame);
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void sweet_fb358_request_probe(uint32_t frame);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
