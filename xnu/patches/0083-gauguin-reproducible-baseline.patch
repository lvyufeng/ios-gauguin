+ * event) into a lock-free ring; the dump path empties it later.
+ */
+#define SWEET_BLOCK_RING 256
+struct sweet_block_rec {
+	uint64_t tid;
+	uint64_t cont;
+	uint64_t ev;
+	uint32_t wqt;
+	uint32_t seq;
