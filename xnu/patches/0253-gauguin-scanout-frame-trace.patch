+/* Lagoon entry points from the board's live DT and Xiaomi gauguin-r-oss
+ * SDE/clock drivers. Mapped pages are aligned for the 16 KiB XNU kernel.
+ * Only the INTF1 MISR control receives writes, after a running 60 Hz
+ * interface and a zero control preimage have both been observed. */
+enum {
+    F344_PAGE = 0x4000, F344_GCC_PAGE = 0x00114000, F344_DISPCC_PA = 0x0af00000,
+    F344_MDP_PA = 0x0ae00000, F344_INTF_PAGE = 0x0ae68000, F344_INTF_OFF = 0x3800,
+    F344_GCC_AHB = 0x300c, F344_DISP_AHB = 0x104c, F344_DISP_MDP = 0x1010,
+    F344_TIMING_EN = 0, F344_HSYNC = 8, F344_VPERIOD = 0xc,
+    F344_VSTART = 0x1c, F344_VEND = 0x24, F344_FRAME_COUNT = 0xac,
+    F344_LINE_COUNT = 0xb0, F344_MISR_CTRL = 0x180, F344_MISR_SIG = 0x184,
+    F344_INTF_STATUS = 0x26c, F344_CRC_STATUS = 1u << 9, F344_CRC_CLEAR = 1u << 10,
+    F344_POLL_US = 1200, F344_POLL_LIMIT = 40960
+};
+#define F344_CRC_CONFIG UINT32_C(0x81000101)
+
+static struct gut_core frames;
+static mach_timebase_info_data_t frame_timebase;
+static bool frame_header, frame_footer;
+static thread_call_t scan_call;
+static const volatile uint32_t *scan_gcc, *scan_disp, *scan_mdp;
+static volatile uint32_t *scan_intf;
+static struct {
+    uint64_t last_tick, first_edge;
+    uint32_t frame, first_frame, crc_frame, crc_candidate_frame, crc_candidate;
+    uint32_t polls, vperiod, first_active, last_active;
+    bool have_frame, have_edge, configured, have_crc, have_candidate;
+} scan;
+
+static bool frame_active(void)
+{
+    return __atomic_load_n(&frames.state, __ATOMIC_ACQUIRE) == GUT_CAPTURE
+        && gut_enabled(&frames);
+}
+
+uint64_t sweet_frame344_clock(void)
+{
+    return frame_active() ? mach_absolute_time() : 0;
+}
+
+void sweet_frame344_record(uint32_t kind, uint64_t id, uint32_t flags,
+    uint64_t a, uint64_t b, uint64_t c)
+{
+    gut_record(&frames, kind, id, 0, flags, a, b, c);
+}
+
+static bool branch_on(uint32_t reg)
+{
+    return (reg & UINT32_C(0x80000001)) == 1;
+}
+
+static bool scan_powered(void)
+{
+    return scan_intf && branch_on(scan_gcc[F344_GCC_AHB / 4])
+        && branch_on(scan_disp[F344_DISP_AHB / 4]) && branch_on(scan_disp[F344_DISP_MDP / 4]);
+}
+
+static void misr_write(uint32_t value)
+{
+    scan_intf[F344_MISR_CTRL / 4] = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void scan_stop(const char *reason)
+{
+    bool restored = !scan.configured;
+    if (scan.configured && scan_powered()) {
+        misr_write(F344_CRC_CLEAR);
+        misr_write(0);
+        restored = scan_intf[F344_MISR_CTRL / 4] == 0;
+    }
+    printf("SWEET F344 DPU: stopped=%s polls=%u configured=%u restored=%u\n",
+        reason, scan.polls, scan.configured, restored);
+}
+
+static bool scan_timing(void)
+{
+    if (scan_mdp[0] != UINT32_C(0x60040000) ||
+        !(scan_intf[F344_INTF_STATUS / 4] & 1u) ||
+        !(scan_intf[F344_TIMING_EN / 4] & 1u)) return false;
+    const uint32_t hperiod = scan_intf[F344_HSYNC / 4] >> 16;
+    if (!hperiod) return false;
+    const uint32_t vperiod = scan_intf[F344_VPERIOD / 4] / hperiod;
+    const uint32_t first = scan_intf[F344_VSTART / 4] / hperiod;
+    const uint32_t last = scan_intf[F344_VEND / 4] / hperiod;
+    if (last < first || last - first != 2399 || vperiod <= last || vperiod > 6000)
+        return false;
+    if (scan.vperiod) {
+        return scan.vperiod == vperiod && scan.first_active == first && scan.last_active == last;
+    }
+    scan.vperiod = vperiod;
+    scan.first_active = first;
+    scan.last_active = last;
+    sweet_frame344_record(F344_TIMING, 1, 0, vperiod, first, last);
+    return true;
+}
+
+static bool scan_edge(uint32_t frame, uint64_t tick, uint32_t line)
+{
+    const uint32_t step = frame - scan.frame;
+    if (!scan.have_frame || step == 0) return true;
+    sweet_frame344_record(F344_VBLANK, frame, step, scan.last_tick, tick, line);
+    if (scan.configured) return true;
+    if (!scan.have_edge || step != 1) {
+        scan.have_edge = true;
+        scan.first_frame = frame;
+        scan.first_edge = tick;
+        return true;
+    }
+    if (frame - scan.first_frame < 3) return true;
+    uint64_t elapsed;
+    absolutetime_to_nanoseconds(tick - scan.first_edge, &elapsed);
+    if (elapsed < 46000000 || elapsed > 54000000 || scan_intf[F344_MISR_CTRL / 4])
+        return false;
+    misr_write(F344_CRC_CLEAR);
+    misr_write(F344_CRC_CONFIG);
+    scan.configured = true;
+    return true;
+}
+
+static void scan_crc(uint32_t frame, uint32_t line, uint32_t control, uint32_t signature)
+{
+    if (!scan.configured || frame - scan.first_frame < 5 ||
+        control != (F344_CRC_CONFIG | F344_CRC_STATUS) ||
+        line < scan.first_active + 128 || line >= scan.first_active + 768 ||
+        (scan.have_crc && frame == scan.crc_frame)) return;
+    if (!scan.have_candidate || frame != scan.crc_candidate_frame) {
+        scan.have_candidate = true;
+        scan.crc_candidate_frame = frame;
+        scan.crc_candidate = signature;
+        return;
+    }
+    /* Two polls inside the same part of active video must agree. A live
+     * accumulator or a latch moving within this window is not a frame CRC. */
+    sweet_frame344_record(F344_CRC, frame, signature != scan.crc_candidate,
+        signature, line, control);
+    scan.have_crc = true;
+    scan.crc_frame = frame;
+}
+
+static void scan_poll(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+    const uint64_t tick = mach_absolute_time();
+    if (!frame_active() || tick >= frames.end || scan.polls >= F344_POLL_LIMIT) {
+        scan_stop("deadline");
+        return;
+    }
+    ++scan.polls;
+    if (sweet_fb_display_state() != 1 || !scan_powered() || !scan_timing()) {
+        scan_stop("route");
+        return;
+    }
+    const uint32_t frame = scan_intf[F344_FRAME_COUNT / 4];
+    const uint32_t line = scan_intf[F344_LINE_COUNT / 4];
+    const uint32_t control = scan.configured ? scan_intf[F344_MISR_CTRL / 4] : 0;
+    const uint32_t sig = scan.configured ? scan_intf[F344_MISR_SIG / 4] : 0;
+    const uint32_t checked_frame = scan_intf[F344_FRAME_COUNT / 4];
+    const uint64_t sampled = mach_absolute_time();
+    if (frame == checked_frame && line < scan.vperiod) {
+        if (!scan_edge(frame, sampled, line)) {
+            scan_stop("preflight");
+            return;
+        }
+        scan_crc(frame, line, control, sig);
+        scan.have_frame = true;
+        scan.frame = frame;
+        scan.last_tick = tick; /* before the prior same-counter read */
+    }
+    uint64_t deadline;
+    clock_interval_to_deadline(F344_POLL_US, NSEC_PER_USEC, &deadline);
+    thread_call_enter_delayed(scan_call, deadline);
+}
+
+static void frame_init(void)
+{
+    uint32_t enabled = 0, script = 0, physical = 0;
+    PE_parse_boot_argn("sweetfb_stats", &enabled, sizeof(enabled));
+    PE_parse_boot_argn("swp", &script, sizeof(script));
+    PE_parse_boot_argn("sweetnvt", &physical, sizeof(physical));
+    if (enabled != 2 || script != 3 || physical || !sweet_metal_desktop_enabled()) return;
+    const uint32_t capacity = 16384;
+    uint64_t window;
+    nanoseconds_to_absolutetime(UINT64_C(45) * NSEC_PER_SEC, &window);
+    clock_timebase_info(&frame_timebase);
+    if (!window || !frame_timebase.numer || !frame_timebase.denom) return;
+    struct gut_event *events = kalloc_data(capacity * sizeof(*events), Z_WAITOK | Z_ZERO);
+    if (!events) return;
+    if (!gut_init_frames(&frames, events, capacity, window, now)) {
+        kfree_data(events, capacity * sizeof(*events));
+        return;
+    }
+    printf("SWEET F344: armed window=45s capacity=%u\n", capacity);
+}
+
+void sweet_frame344_prepare(void)
+{
+    if (__atomic_load_n(&frames.state, __ATOMIC_ACQUIRE) != GUT_ARMED) return;
+    const uint64_t tick = mach_absolute_time();
+    if (!gut_report(&frames, tick, tick, 0, 1)) return;
+    scan_gcc = (const volatile uint32_t *)ml_io_map_with_prot(F344_GCC_PAGE, F344_PAGE, VM_PROT_READ);
+    scan_disp = (const volatile uint32_t *)ml_io_map_with_prot(F344_DISPCC_PA, F344_PAGE, VM_PROT_READ);
+    scan_mdp = (const volatile uint32_t *)ml_io_map_with_prot(F344_MDP_PA, F344_PAGE, VM_PROT_READ);
+    scan_intf = (volatile uint32_t *)ml_io_map_with_prot(F344_INTF_PAGE, F344_PAGE, VM_PROT_READ | VM_PROT_WRITE);
+    if (!scan_gcc || !scan_disp || !scan_mdp || !scan_intf) {
+        scan_intf = NULL;
+        scan_stop("map");
+        return;
+    }
+    scan_intf += F344_INTF_OFF / 4;
+    scan_call = thread_call_allocate(scan_poll, NULL);
+    if (scan_call) thread_call_enter(scan_call);
+    else scan_stop("timer");
+}
+
+static void frame_drain(void)
+{
+    if (frame_footer) return;
+    struct gut_event batch[32];
+    struct gut_meta meta;
+    uint32_t n;
+    if (!gut_read(&frames, batch, 32, &n, &meta)) return;
+    if (!frame_header) {
+        frame_header = true;
+        printf("SWEET F344 H: count=%u reason=%u lost=%llu start=%llu end=%llu numer=%u denom=%u\n",
+            meta.count, meta.reason, (unsigned long long)meta.lost, (unsigned long long)meta.start,
+            (unsigned long long)meta.end, frame_timebase.numer, frame_timebase.denom);
+    }
+    for (uint32_t i = 0; i < n; ++i) {
+        const struct gut_event *row = batch + i;
+        char line[160];
+        int bytes = snprintf(line, sizeof(line), "\nSWEET F344 E %x %llx %x %llx %x %llx %llx %llx\n",
+            (uint32_t)row->seq, (unsigned long long)row->tick, row->kind,
+            (unsigned long long)row->id, row->flags, (unsigned long long)row->a,
+            (unsigned long long)row->b, (unsigned long long)row->c);
+        if (bytes > 0 && (size_t)bytes < sizeof(line)) sweet_log_append(line, bytes);
+        else printf("SWEET F344: formatter overflow\n");
+    }
+    if (meta.state == GUT_DRAINED) {
+        frame_footer = true;
+        printf("SWEET F344 F: count=%u lost=%llu\n", meta.count, (unsigned long long)meta.lost);
+    }
+}
