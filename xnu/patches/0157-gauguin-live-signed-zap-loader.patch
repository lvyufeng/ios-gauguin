+    for(unsigned i=0;i<sizeof(off)/sizeof(off[0]);i++){int v=0;(void)PE_parse_boot_argn(off[i],&v,sizeof(v));if(v)return false;}
+    return true;
+}
+static bool psz_geometry(void)
+{
+    uint64_t pa=pst_ready.pa;
+    if(!psz_context()||__atomic_load_n(&pst_state,__ATOMIC_ACQUIRE)!=PST_CLAIMED||
+       !pa||(pa&(PST_REGION-1))||pa>UINT64_C(0x100000000)-PST_REGION||
+       pst_ready.metadata_bytes!=PST_BYTES||pst_ready.reserved_bytes!=PST_PAGE||
+       !pst_mapping||(pst_mapping&(PST_PAGE-1))||pst_mapping>UINTPTR_MAX-(PST_PAGE-1))return false;
+    for(unsigned off=0;off<PST_REGION;off+=PST_PAGE){ppnum_t pn=(ppnum_t)((pa+off)>>PAGE_SHIFT);
+        if(pmap_valid_page(pn)||pmap_cache_attributes(pn)!=UINT32_C(0xd0000006))return false;}
+    return ml_vtophys(pst_mapping)==pa&&ml_vtophys(pst_mapping+PST_PAGE-1)==pa+PST_PAGE-1;
+}
+bool sweet_pas_zap_owner_live(enum gpz_phase phase,uint64_t expected_pa)
+{
+    enum psz_state s=sweet_pas_zap_owner_state();
+    if(expected_pa!=pst_ready.pa||!sweet_gpu_zap_owner_phase(phase,pst_ready.pa)||!psz_geometry())return false;
+    bool valid=phase==GPZ_SEAL?(s==PSZ_IDLE||s==PSZ_SEALED):
+        phase==GPZ_INIT?(s==PSZ_SEALED||s==PSZ_INIT_ENTERED||s==PSZ_INIT_DONE):
+        phase==GPZ_MEM?(s==PSZ_INIT_DONE||s==PSZ_MEM_DONE):
+        phase==GPZ_COPY?(s==PSZ_MEM_DONE||s==PSZ_COPYING||s==PSZ_COPIED):
+        phase==GPZ_AUTH?(s==PSZ_COPIED||s==PSZ_AUTH_DONE):phase==GPZ_FINAL&&s==PSZ_AUTH_DONE;
+    if(!valid)return false;
+    /* INIT_ENTER happens before any SMC. Once entered, even an interrupted
+     * return may have modified SCM_RW bytes: never rehash/rewrite MDT then. */
+    return s>=PSZ_INIT_ENTERED||sweet_pas_stage_owner_valid(&pst_ready);
+}
+void sweet_pas_zap_quarantine(void)
+{__atomic_store_n(&psz_lifecycle,PSZ_FAILED,__ATOMIC_RELEASE);}
+bool sweet_pas_zap_owner_action(enum gpz_owner_action action)
+{
+    if(!psz_flags()||!psz_geometry()||!sweet_gpu_zap_owner_action_allowed(action,pst_ready.pa))return false;
+    enum psz_state before,after;
+    switch(action){
+    case GPZO_SEAL:before=PSZ_IDLE;after=PSZ_SEALED;break;
+    case GPZO_INIT_ENTER:before=PSZ_SEALED;after=PSZ_INIT_ENTERED;break;
+    case GPZO_INIT_ACCEPT:before=PSZ_INIT_ENTERED;after=PSZ_INIT_DONE;break;
+    case GPZO_MEM_ACCEPT:before=PSZ_INIT_DONE;after=PSZ_MEM_DONE;break;
+    case GPZO_AUTH_ACCEPT:before=PSZ_COPIED;after=PSZ_AUTH_DONE;break;
+    default:return false;
+    }
+    if(action==GPZO_SEAL){
+        unsigned idle=PSZ_IDLE;
+        if(!__atomic_compare_exchange_n(&psz_lifecycle,&idle,PSZ_SEALING,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return false;
+        if(!sweet_pas_stage_owner_valid(&pst_ready)||!sweet_gpu_zap_asset_view(&psz_code)||
+           psz_code.bytes!=GPZ_CODE_BYTES||psz_code.pa<UINT64_C(0x100000000)){
+            sweet_pas_zap_quarantine();return false;}
+        __atomic_store_n(&psz_lifecycle,PSZ_SEALED,__ATOMIC_RELEASE);return true;
+    }
+    unsigned expected=(unsigned)before;
+    return __atomic_compare_exchange_n(&psz_lifecycle,&expected,(unsigned)after,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE);
+}
+static void psz_barrier(void)
+{__asm__ volatile("dsb sy" ::: "memory");}
+static bool psz_overlap(const void *p,size_t n,const void *q,size_t m)
+{uintptr_t a=(uintptr_t)p,b=(uintptr_t)q;return a<=b?b-a<n:a-b<m;}
+bool sweet_pas_zap_copy(struct gpz_copy *out)
+{
+    _Static_assert(GPZ_CODE_BYTES==GZA_CODE_BYTES,"fixed b02 size");
+    if(!out||(uintptr_t)out>UINTPTR_MAX-(sizeof(*out)-1)||!psz_flags()||!psz_geometry()||
+       !sweet_gpu_zap_owner_phase(GPZ_COPY,pst_ready.pa)||
+       psz_overlap(out,sizeof(*out),(const void *)pst_mapping,PST_PAGE)||
+       psz_overlap(out,sizeof(*out),psz_code.data,GZA_RESERVED_BYTES))return false;
+    unsigned expected=PSZ_MEM_DONE;
+    if(!__atomic_compare_exchange_n(&psz_lifecycle,&expected,PSZ_COPYING,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return false;
+    *out=(struct gpz_copy){0};struct gza_view current;
+    if(!sweet_gpu_zap_copy_live()||!sweet_gpu_zap_asset_view(&current)||
+       current.data!=psz_code.data||current.pa!=psz_code.pa||current.bytes!=GPZ_CODE_BYTES){sweet_pas_zap_quarantine();return false;}
+    volatile uint8_t *dst=(volatile uint8_t *)pst_mapping;
+    for(unsigned base=0;base<GPZ_CODE_BYTES;base+=64){
+        if(!sweet_gpu_zap_copy_live()){sweet_pas_zap_quarantine();return false;}
+        for(unsigned i=base;i<base+64;i++){dst[i]=psz_code.data[i];++out->written;}
+        if(!sweet_gpu_zap_copy_live()){sweet_pas_zap_quarantine();return false;}
+    }
+    psz_barrier();
+    for(unsigned base=0;base<GPZ_CODE_BYTES;base+=64){
+        if(!sweet_gpu_zap_copy_live()){sweet_pas_zap_quarantine();return false;}
+        for(unsigned i=base;i<base+64;i++){
+            if(dst[i]!=psz_code.data[i]){sweet_pas_zap_quarantine();return false;}++out->checked;}
+        if(!sweet_gpu_zap_copy_live()){sweet_pas_zap_quarantine();return false;}
+    }
+    psz_barrier();
+    if(!sweet_gpu_zap_copy_live()){sweet_pas_zap_quarantine();return false;}
+    __atomic_store_n(&psz_lifecycle,PSZ_COPIED,__ATOMIC_RELEASE);return true;
+}
