+       !span(gmu,sizeof(*gmu))||!span(out,sizeof(*out))||
+       overlap(plan,sizeof(*plan),c,sizeof(*c))||overlap(gmu,sizeof(*gmu),c,sizeof(*c))||
+       overlap(ops,sizeof(*ops),c,sizeof(*c))||overlap(out,sizeof(*out),c,sizeof(*c))||
