+    cpu402.temp_map = io_map(CPU402_TSENS_PAGE, F344_PAGE, VM_WIMG_IO, VM_PROT_READ, true);
+    cpu402.srot_map = io_map(CPU402_SROT_PAGE, F344_PAGE, VM_WIMG_IO, VM_PROT_READ, true);
+    if (!cpu402.perf_map || !cpu402.temp_map || !cpu402.srot_map) {
+        printf("SWEET CPU402 MAP: admitted=0\n");
