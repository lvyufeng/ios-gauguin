+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(GAUGUIN)
+/*
+ * Minimal reproduction for NOTES 22:47-22:52: a kernel thread started from
+ * userland context does assert_wait_deadline(now + 1 s) + thread_block() and
+ * reports whether it ever resumes. Nothing else is involved: no driver, no
+ * MMIO, no locks. If "woke" never appears, the deadline path of
+ * assert_wait_deadline is broken for kernel threads in this port.
+ */
+static char sweet_wait_chan;
+
+static void
+sweet_wait_probe_cont(void *arg, wait_result_t wresult)
+{
+	uint64_t deadline;
+	(void)arg;
+	printf("SWEET WAITPROBE: thread running, blocking for 1 s\n");
+	clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_wait_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	printf("SWEET WAITPROBE: woke (wresult=%d)\n", (int)wresult);
+	thread_terminate_self();
+}
+
+void
+sweet_wait_probe_start(void)
+{
+	thread_t th;
+	static bool started;
+	if (started) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(sweet_wait_probe_cont, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("SWEET WAITPROBE: kernel_thread_start failed\n");
+	}
+}
+#endif
