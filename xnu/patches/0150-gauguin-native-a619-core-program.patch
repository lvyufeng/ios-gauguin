+    }
+    c->reglist[3]=(GGC_REGLIST_OFFSET<<16)|(2u*GGC_REGLIST_VALUES);
+    /* A private zeroed NC region is required; no executing CP can own it.
+     * Capture live values before publishing the list. Header length is last. */
+    for(unsigned i=0;i<1024;i++){
+        uint32_t v;
+        if(!guard(c))return GGC_GUARD;
+        if(!c->ops.read_reglist(c->ops.cookie,4*i,&v))return GGC_IO;
+        if(!guard(c))return GGC_GUARD;
+        if(v)return GGC_MEMORY;
+    }
+    for(unsigned i=4;i<GGC_REGLIST_WORDS;i++){
+        if(!guard(c))return GGC_GUARD;
