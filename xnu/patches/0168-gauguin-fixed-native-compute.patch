+    if(reg==0x1f8c3){if(v)c->work.keepalive_set_attempted=1;else c->work.keepalive_clear_attempted=1;}
+    ++c->work.writes;if(!c->ops.write32(c->ops.cookie,reg,v))return GGK_IO;
+    return guard(c)?GGK_OK:GGK_GUARD;
+}
+static enum ggk_result mr(struct ggk_context *c,enum ggk_memory mem,uint32_t off,uint32_t *v)
