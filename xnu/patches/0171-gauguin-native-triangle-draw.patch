+        TRY(copy_nc(c,b.offset,b.words,NULL,id,&c->work.blob_written[id]));
+        TRY(barrier(c));
+        TRY(compare_nc(c,GGT_RING,b.offset,b.words,NULL,0,id,true,&c->work.blob_checked[id]));
+        c->work.artifact_written+=c->work.blob_written[id];c->work.artifact_checked+=c->work.blob_checked[id];
+    }
