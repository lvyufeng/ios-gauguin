+static bool guard(struct ggt_context *c)
+{return c->ops.guard(c->ops.cookie,(enum ggt_phase)c->phase);}
+static enum ggt_result sample(struct ggt_context *c,bool mem,uint32_t reg,uint32_t expected,uint32_t actual)
+{c->diagnostic=(struct ggt_diagnostic){1,mem,reg,expected,actual};return mem?GGT_MEMORY_ERROR:GGT_DIRTY_STATE;}
+static enum ggt_result rd(struct ggt_context *c,uint32_t reg,uint32_t *v)
+{
