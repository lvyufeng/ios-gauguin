+        struct ggj_blob b;if(!ggj_blob_get(0,id,&b))return false;
+        if(b.words&&off>=b.offset&&off-b.offset<4*b.words)return true;
+    }
+    return false;
+}
+uint32_t ggj_expected_eop(unsigned job)
+{return job<GGJ_JOBS?sequence172_eop[job]:0;}
+bool ggj_control_allowed(unsigned job,uint32_t value)
+{
