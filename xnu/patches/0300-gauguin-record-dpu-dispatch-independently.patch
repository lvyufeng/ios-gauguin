+#ifndef GAUGUIN_FRAME388_RECEIPTS_H
+#define GAUGUIN_FRAME388_RECEIPTS_H
+
+#include "gauguin_frame380_phase.h"
+
+#define F388_CLOSED UINT32_C(0x80000000)
+#define F388_UNARMED UINT32_C(0x40000000)
+
+struct f388_receipt {
+    struct f380_dispatch dispatch;
+    uint64_t tick;
+    unsigned sequence;
+};
+
+struct f388_receipts {
+    uint32_t gate;
+    uint64_t start, end, first, last;
+    unsigned aligned, software, fallback, missed, count;
+    struct f388_receipt rows[F380_SAMPLES];
+};
+
+static inline void
+f388_arm(struct f388_receipts *capture, uint64_t start, uint64_t end)
+{
+    if (__atomic_load_n(&capture->gate, __ATOMIC_RELAXED) != F388_UNARMED ||
+        !start || start >= end) return;
+    capture->start = start;
+    capture->end = end;
+    __atomic_store_n(&capture->gate, 0, __ATOMIC_RELEASE);
+}
+
+/* The framebuffer lock serializes the writer. Close waits for a writer
+ * that already entered and prevents any later writer from entering. */
+static inline void
+f388_record(struct f388_receipts *capture, enum f380_notice notice, uint64_t tick,
+    const struct f380_dispatch *dispatch)
+{
+    uint32_t expected = 0;
+    if (!__atomic_compare_exchange_n(&capture->gate, &expected, 1, false,
+        __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
+    if (tick >= capture->start && tick < capture->end) {
+        if (notice == F380_ALIGNED && dispatch) {
+            if (!capture->first) capture->first = tick;
+            capture->last = tick;
+            ++capture->aligned;
+            if (capture->count < F380_SAMPLES &&
+                (capture->aligned == F380_FIRST_SAMPLE || capture->aligned % F380_SAMPLE_STEP == 0)) {
+                struct f388_receipt *row = &capture->rows[capture->count++];
+                row->dispatch = *dispatch;
+                row->tick = tick;
+                row->sequence = capture->aligned;
+            }
+        } else if (notice == F380_MISSED) {
+            ++capture->missed;
+        } else if (notice == F380_SOFTWARE) {
+            ++capture->software;
+            if (capture->first) ++capture->fallback;
+        }
+    }
+    __atomic_fetch_sub(&capture->gate, 1, __ATOMIC_RELEASE);
+}
+
+static inline bool
+f388_close(struct f388_receipts *capture)
+{
+    if (__atomic_load_n(&capture->gate, __ATOMIC_ACQUIRE) == F388_UNARMED) return false;
+    __atomic_fetch_or(&capture->gate, F388_CLOSED, __ATOMIC_ACQ_REL);
+    return __atomic_load_n(&capture->gate, __ATOMIC_ACQUIRE) == F388_CLOSED;
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void sweet_frame388_notice(enum f380_notice, uint64_t, const struct f380_dispatch *);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
