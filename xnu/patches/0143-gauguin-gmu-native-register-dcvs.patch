+static enum gmf_result dcvs(struct gmf_context *c)
+{
+    c->dcvs_started=1;
+    if(!rd(c,GMF_CSR,C(0x1f992),&c->dcvs_before))return GMF_IO;
+    if(c->dcvs_before&0x80008000u)return GMF_INHERITED;
+    /* Native gmu_dcvs_set maps Linux active pwrlevel5 to ascending PERF1.
+     * The SAME selected253MHz DT row specifies BW5 (min4,max7), not BW1.
+     * Native mailbox words1cbfc..1cbff lie inside retained TCM, not CSR. */
+    const uint32_t off[]={T(0x1cbfc),T(0x1cbfd),T(0x1cbfe)};
+    const uint32_t value[]={0,0x30000001,0x00005005};
+    for(unsigned n=0;n<3;n++)if(!barrier(c)||!wr(c,GMF_TCM,off[n],value[n]))return GMF_IO;
+    c->dcvs_trigger_attempted=1;
+    if(!barrier(c)||!wr(c,GMF_CSR,C(0x1f994),1u<<23))return GMF_IO;
+    enum gmf_result rc=poll(c,GMF_CSR,C(0x1f992),1u<<31,1u<<31,&c->dcvs_ack);if(rc)return rc;
+    if(c->dcvs_ack&0x8000u)return GMF_FAULT;
+    c->dcvs_ack_valid=1;
+    if(!barrier(c)||!wr(c,GMF_CSR,C(0x1f991),1u<<31)||
+       !rd(c,GMF_CSR,C(0x1f992),&c->dcvs_cleared))return GMF_IO;
+    if(c->dcvs_cleared&(1u<<31))return mismatch(c,GMFD_OOB_CLEAR,GMF_CSR,C(0x1f992),1u<<31,0,c->dcvs_cleared);
+    if(!rd(c,GMF_TCM,T(0x1cbff),&c->dcvs_return))return GMF_IO;
+    c->dcvs_return_valid=1;c->dcvs_clear_attempted=1;
+    /* This is native completion of the owned OOB request even for a nonzero
+     * firmware return. Callback/guard/timeout failures stop immediately; no
+     * new failure cleanup or retry is invented. Do not reread live mailboxes. */
+    if(!barrier(c)||!wr(c,GMF_CSR,C(0x1f994),1u<<31)||!barrier(c))return GMF_IO;
