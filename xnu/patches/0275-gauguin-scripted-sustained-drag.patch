+	printf("SWEET M362: aborted reports=%u release_rc=%x\n", sweet_motion_step, rc);
+}
+
+static void
+sweet_motion_fire(uint64_t now)
+{
+	if (now < sweet_motion_due || now >= sweet_motion_limit ||
+	    sweet_fb_display_state() != 1 || sweet_motion_step >= SWEET_MOTION_REPORTS) {
+		sweet_motion_abort();
+		return;
+	}
+
+	unsigned step = sweet_motion_step++;
