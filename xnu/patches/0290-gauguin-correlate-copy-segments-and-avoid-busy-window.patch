+/* This is the existing software issue-to-observed-EOP interval. It
+ * supplies a contention hint and leaves GPU state and fences untouched. */
+void
+sweet_frame379_observe_gpu(uint32_t kind, uint64_t fence, uint64_t tick)
+{
+	if (!fence || fence > UINT32_MAX || !f375_enter()) return;
+	if (tick >= f374_start && tick < f374_end) {
+		if (kind == 0) {
+			__atomic_store_n(&f379_issued, (fence << 32) | (tick - f374_start), __ATOMIC_RELEASE);
+		} else {
+			uint64_t ticket = __atomic_load_n(&f379_issued, __ATOMIC_RELAXED);
+			if ((ticket >> 32) == fence) {
+				(void)__atomic_compare_exchange_n(&f379_issued, &ticket, 0, false,
+				    __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+			}
+		}
+	}
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+}
+
+uint64_t
+sweet_frame379_pending(uint64_t tick)
+{
+	if (!f375_enter()) return 0;
+	const uint64_t ticket = __atomic_load_n(&f379_issued, __ATOMIC_ACQUIRE);
+	const uint64_t issued = f374_start + (uint32_t)ticket;
+	const uint64_t result = issued <= tick && tick < f374_end &&
+	    tick - issued <= F379_MAX_ISSUE_AGE_TICKS ? ticket : 0;
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+	return result;
+}
