+extern "C" uint32_t GauguinGPUFrameBegin(SweetSurface *const *surfaces,uint32_t count,uint32_t *state)
+{
+    if(!state)return 0;
+    *state=SWEET_GPU_FRAME_INVALID;
+    if(!surfaces||!count||count>4)return 0;
+    IOLock *lock=__atomic_load_n(&gLock,__ATOMIC_ACQUIRE);
+    if(!lock){*state=SWEET_GPU_FRAME_READY;return 1;}
+    IOLockLock(lock);
+    bool pending=false;
+    for(uint32_t i=0;i<count;i++)if(surfaces[i]){
+        if(surfaces[i]->gpuState>1){IOLockUnlock(lock);return 0;}
+        pending|=surfaces[i]->gpuState==1;
+    }
+    if(pending){
+        /* Poll once, without gRequests or a blocking wait. All submitted
+         * pages remain owned by the GPU client while the display retries. */
+        bool completed=completePendingOwnerLocked(false,false);
+        pending=false;
+        for(uint32_t i=0;i<count;i++)if(surfaces[i]){
+            if(surfaces[i]->gpuState>1){IOLockUnlock(lock);return 0;}
+            pending|=surfaces[i]->gpuState==1;
+        }
+        if(pending){
+            /* A supposedly completed owner with a still-busy surface is
+             * inconsistent, not an endlessly retryable pending fence. */
+            if(!completed)*state=SWEET_GPU_FRAME_PENDING;
+            IOLockUnlock(lock);return 0;
+        }
+    }
+    *state=SWEET_GPU_FRAME_READY;
+    return 2; /* all layers stay protected through the entire copy */
