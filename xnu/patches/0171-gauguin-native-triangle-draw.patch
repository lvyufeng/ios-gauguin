+#include "gauguin_gpu_draw.h"
+#include "gauguin_gpu_draw_native.h"
+_Static_assert(DRAW171_RING_BASE==0xfc008000u&&DRAW171_RING_BYTES==32768u,"native ring");
+_Static_assert(DRAW171_MAIN_IOVA==DRAW171_RING_BASE+GGT_IB_OFFSET,"native IB");
+_Static_assert(DRAW171_TARGET_IOVA==GGD_DATA_IOVA&&DRAW171_CONTROL_IOVA==GGD_DATA_IOVA+GGT_EOP_OFFSET,"native DATA");
