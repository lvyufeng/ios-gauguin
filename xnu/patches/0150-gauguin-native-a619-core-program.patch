+enum ggc_result {GGC_OK,GGC_ARGUMENT,GGC_ALREADY,GGC_GUARD,GGC_IO,
+    GGC_PARENT,GGC_MEMORY};
+struct ggc_ops {
+    void *cookie;
+    bool (*guard)(void *,enum ggc_phase);
+    bool (*read32)(void *,uint32_t,uint32_t *);
+    bool (*write32)(void *,uint32_t,uint32_t);
+    bool (*barrier)(void *);
+    bool (*start_gpu)(void *,struct ggx_receipt *);
