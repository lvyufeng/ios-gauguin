+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/pexpert.h>
+
+/* defined in bsd/kern/kern_proc.c; sys/proc.h clashes with osfmk typedefs */
+extern void proc_selfname(char *buf, int size);
