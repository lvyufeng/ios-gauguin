+void sweet_frame357_calibrate_after_script(void)
+{
+    if (!scan357_enabled || !frame_active()) return;
+    uint64_t due, deadline;
+    clock_interval_to_deadline(SCAN357_CALIBRATION_WAIT_MS, NSEC_PER_MSEC, &due);
+    clock_interval_to_deadline(SCAN357_CALIBRATION_LIMIT_MS, NSEC_PER_MSEC, &deadline);
+    scan357_deadline = deadline;
+    __atomic_store_n(&scan357_due, due, __ATOMIC_RELEASE);
+}
+
+static void scan357_finish_if_expired(uint64_t now)
+{
+    if (__atomic_load_n(&scan357_due, __ATOMIC_ACQUIRE) && now >= scan357_deadline &&
+        scan357_step < SCAN357_FINISHED) {
+        scan357_abort();
+    }
+}
+
+static void scan357_pair(uint32_t frame, uint64_t tick)
+{
+    const uint64_t due = __atomic_load_n(&scan357_due, __ATOMIC_ACQUIRE);
+    if (!due || tick < due || scan357_step >= SCAN357_FINISHED ||
+        (scan357_step != SCAN357_PAUSE && frame - scan357_previous < SCAN357_CALIBRATION_GAP))
+        return;
+    if (scan357_step == SCAN357_ABORT) {
+        scan357_abort();
+        return;
+    }
+    const unsigned progress = sweet_fb357_calibration(scan357_step, frame);
+    if (progress == 1) {
+        scan357_previous = frame;
+        ++scan357_step;
+    } else if (progress == 2) {
+        /* Defer the one possible recovery store to a later qualified pair.
+         * Expiry also releases the presentation pause if pairs stop. */
+        scan357_step = SCAN357_ABORT;
+        scan357_previous = frame;
+    }
+    if (scan357_step == SCAN357_ABORT && progress == 1) scan357_step = SCAN357_FINISHED;
+}
