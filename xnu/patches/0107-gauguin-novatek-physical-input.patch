+    /* Exactly the proven level0/XO tuple; do not read another DFS table. */
+    if (!(dfs & 1) || ((dfs >> 1) & 15) != 0) return GSS_CLOCK;
+    if (rd(s, GSS_GCC, 0x21164, &cfg) || rd(s, GSS_SE, CLK_SEL, &sel) ||
+        rd(s, GSS_GCC, 0x2115c, &again_dfs) || rd(s, GSS_GCC, 0x21164, &again_cfg))
+        return GSS_OWNERSHIP;
