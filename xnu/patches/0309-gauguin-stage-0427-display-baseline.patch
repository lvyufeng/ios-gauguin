+        printf("SWEET CPU402 MAP: admitted=0 sensor_state=%08x enable=%08x state=%u\n",
+            srot, enable, cpu402_read((void *)cpu402.perf, CPU402_PERF_STATE));
+        if (enable != UINT32_MAX && (enable & 1u)) {
