+/* Fixed original native A619 graph submitted three times on one context.
+ * Each graph comes from unmodified Mesa emitters with native seqno inputs.
+ * Generated reference bytes and geometric expected pixels are not hardware
+ * observations. The fixed171 engine and its native table remain unchanged. */
+#include <string.h>
+#include "gauguin_gpu_texture.h"
+#include "gauguin_gpu_texture_native.h"
+_Static_assert(TEXTURE174_JOBS==GGF_JOBS&&TEXTURE174_BLOBS==GGF_BLOBS,"native profiles");
+_Static_assert(TEXTURE174_RING_BASE==0xfc008000u&&TEXTURE174_RING_BYTES==32768u,"native ring");
+_Static_assert(TEXTURE174_MAIN_IOVA==TEXTURE174_RING_BASE+GGF_IB_OFFSET,"native IB");
+_Static_assert(TEXTURE174_TARGET_IOVA==GGD_DATA_IOVA&&TEXTURE174_CONTROL_IOVA==GGD_DATA_IOVA+GGF_EOP_OFFSET,"native DATA");
+static bool span(const void *p,size_t n)
+{uintptr_t a=(uintptr_t)p;return a&&n&&a<=UINTPTR_MAX-n;}
+static bool overlap(const void *a,size_t an,const void *b,size_t bn)
+{return (uintptr_t)a<(uintptr_t)b+bn&&(uintptr_t)b<(uintptr_t)a+an;}
+static const struct texture174_native_blob *native_blob(unsigned job,unsigned id)
+{return job<GGF_JOBS&&id<GGF_BLOBS?&texture174_blobs[job][id]:NULL;}
+bool ggf_blob_get(unsigned job,unsigned id,struct ggf_blob *out)
+{
+    const struct texture174_native_blob *n=native_blob(job,id);
+    if(!n||!span(out,sizeof(*out)))return false;
+    struct ggf_blob b={0};
+    if(n->words){
+        if(!n->data||n->iova<TEXTURE174_RING_BASE+4096u||n->iova%128u||
+           !n->gpu_serialized_extent||n->gpu_serialized_extent%128u||
+           n->words>n->cpu_requested_capacity/4u||n->words>n->gpu_serialized_extent/4u||
+           n->iova-TEXTURE174_RING_BASE>TEXTURE174_RING_BYTES||
+           n->gpu_serialized_extent>TEXTURE174_RING_BYTES-(n->iova-TEXTURE174_RING_BASE))return false;
+        b=(struct ggf_blob){n->iova-TEXTURE174_RING_BASE,n->gpu_serialized_extent/4u,n->words};
+    }else if(n->iova||n->gpu_serialized_extent||n->data||n->cpu_requested_capacity)return false;
+    *out=b;return true;
+}
+bool ggf_blob_word(unsigned job,unsigned id,unsigned index,uint32_t *out)
+{
+    struct ggf_blob b;
+    if(!span(out,sizeof(*out))||!ggf_blob_get(job,id,&b)||index>=b.words)return false;
+    const struct texture174_native_blob *n=native_blob(job,id);
+    *out=index<b.payload_words?n->data[index]:0;return true;
+}
+bool ggf_artifact_allowed(uint32_t off)
+{
+    if(off&3)return false;
+    for(unsigned id=0;id<GGF_BLOBS;id++){
+        struct ggf_blob b;if(!ggf_blob_get(0,id,&b))return false;
+        if(b.words&&off>=b.offset&&off-b.offset<4*b.words)return true;
+    }
+    return false;
+}
+uint32_t ggf_expected_eop(unsigned job)
+{return job<GGF_JOBS?texture174_eop[job]:0;}
+bool ggf_control_allowed(unsigned job,uint32_t value)
+{
+    if(job>=GGF_JOBS)return false;
+    uint32_t previous=job?texture174_eop[job-1]:0,seed=16*job;
+    return value==previous||(value>seed&&value<=texture174_eop[job]);
+}
+static bool pixel_value(unsigned job,unsigned index,uint32_t *out)
+{
+    if(job>=GGF_JOBS||index>=GGF_OUTPUT_WORDS)return false;
+    unsigned x=(index%16u)/4u,y=(index/16u)/4u;
+    if(job==1){unsigned t=x;x=y;y=t;}
+    if(job==2)x=3u;
