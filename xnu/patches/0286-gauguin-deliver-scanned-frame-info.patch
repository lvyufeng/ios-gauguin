+enum {
+    F375_INFO_TYPE = 3,
+    F375_INFO_PRESENT = 1,
+    F375_INFO_REQUESTED = 2,
+    F375_INFO_MASK = F375_INFO_PRESENT | F375_INFO_REQUESTED,
+    F375_INFO_ARGS = 6,
