+enum gss_space { GSS_SE, GSS_WRAPPER, GSS_GCC };
+enum gss_result {
+    GSS_OK = 0, GSS_PREPARED = 1,
+    GSS_ARGUMENT = -1, GSS_OWNERSHIP = -2, GSS_PROFILE = -3,
+    GSS_BUSY = -4, GSS_CLOCK = -5, GSS_READBACK = -6,
+    GSS_RESTORE_FAILED = -7, GSS_UNSAFE_RESTORE = -8
