+    const struct ggp_region *r=&p->bootstrap.region[GGP_RING];
+    if(r->mapped!=32768||r->reserved!=32768||r->privileged||!r->readonly||r->executable||
+       r->iova!=DRAW171_RING_BASE||p->data.iova!=DRAW171_TARGET_IOVA||
+       GGT_EOP_OFFSET<4*GGT_OUTPUT_WORDS||GGT_EOP_OFFSET+GGT_CONTROL_BYTES>p->data.mapped)return false;
+    unsigned count=0,words=0,payload=0;
+    for(unsigned id=0;id<GGT_BLOBS;id++){
+        struct ggt_blob b;if(!ggt_blob_get(id,&b))return false;
+        if(!b.words)continue;
+        if(b.offset<4*GGT_END_DWORD||b.offset>r->mapped||4*b.words>r->mapped-b.offset)return false;
+        for(unsigned before=0;before<id;before++){
+            struct ggt_blob other;if(!ggt_blob_get(before,&other))return false;
+            if(other.words&&b.offset<other.offset+4*other.words&&other.offset<b.offset+4*b.words)return false;
+        }
+        if(id==0&&(b.offset!=GGT_IB_OFFSET||b.payload_words!=GGT_IB_WORDS))return false;
