+/* The real adapter must ALREADY have qualified wrapper0/SE0 access in THIS
+ * boot and must hold its mapped board resources/clock votes and exclusive
+ * controller ownership until release. This module cannot establish bus access.
+ *
+ * claim/current/generation establish SOFTWARE ownership only, not fabric
+ * accessibility. No caller-supplied "fabric=true" flag or PA mapping API exists.
+ * read32/write32/barrier are bounded adapter operations on already-owned IO;
+ * neither callbacks nor a software deadline recover a bus-blocked MMIO load.
+ * release(quarantine=true) must keep the controller out of service, not return
+ * an uncertain configuration to another user. No real adapter is supplied here.
+ */
+struct gss_owner {
+    void *cookie;
+    int (*claim)(void *, uint64_t *generation);
+    bool (*current)(void *, uint64_t generation);
+    uint32_t (*read32)(void *, uint64_t, enum gss_space, uint32_t offset);
+    void (*write32)(void *, uint64_t, enum gss_space, uint32_t offset, uint32_t value);
+    void (*barrier)(void *, uint64_t);
+    void (*release)(void *, uint64_t, bool quarantine);
+};
