+    if (!taken) return;
+    sweet_frame344_record(F352_WAKE, attempt, 0, signal.ticket, signal.fence, blankFrame);
+    /* The timed attempt already armed the next beat. Keep notifications
+     * on that clock even when completion makes a second copy possible. */
+    fb->presentTimed(frame.record, &frame, attempt, blankFrame);
 }
 
