+static int frame371_find_process(proc_t process, void *argument)
+{
+    struct frame371_processes *pair = argument;
+    char name[32];
+    const int pid = proc_pid(process);
+    proc_name(pid, name, sizeof(name));
+    const bool source = strcmp(name, "SpringBoard") == 0;
+    if (!source && strcmp(name, "backboardd") != 0) return PROC_RETURNED;
+    task_t task = proc_task(process);
+    if (task == TASK_NULL) return PROC_RETURNED;
+    const audit_token_t *token = task_get_audit_token(task);
+    if (token->val[5] != (uint32_t)pid || pid <= 0) return PROC_RETURNED;
+    const uint64_t key = ((uint64_t)token->val[7] << 32) | token->val[5];
+    if (source) {
+        pair->source = key;
+        ++pair->sources;
+    } else {
+        pair->receiver = key;
+        ++pair->receivers;
+    }
+    return PROC_RETURNED;
+}
