+/* Bit 24 selects data. All other bits must be clear in the observed idle value. */
+#define SCAN350_DATA_INPUT UINT32_C(0x01000000)
+
+static inline bool
+scan350_idle_pair(uint32_t first, uint32_t second, uint32_t frame_step)
+{
+    return first == SCAN350_DATA_INPUT && second == first && frame_step == 1;
+}
