+
+/* Only the latest held generation is watched. This publication does
+ * not reserve a hardware frame or give GPU code a surface pointer. */
+uint64_t
+AppleCLCD::watchPendingReadyLocked()
+{
+    if (!fReadyAcrossFrames || !blankPendingLocked() || fHeldPending.ready.observed) return 0;
+    const uint64_t ticket = scan352_ticket(fHeldPending.generation, fHeldPending.surfaces[0]->id);
+    fReadyGeneration = fHeldPending.generation;
+    __atomic_store_n(&gReadyTicket, ticket, __ATOMIC_RELEASE);
+    return ticket;
+}
+
+bool
+AppleCLCD::markPendingReadyLocked(uint64_t ticket, uint32_t fence, bool polled)
+{
+    if (!blankPendingLocked()) return false;
+    struct scan351_position pos;
+    const uint64_t observedFrame = sweet_frame351_position(&pos) ? pos.frame : UINT64_MAX;
+    const uint32_t surface = fHeldPending.surfaces[0]->id;
+    if (!scan353_mark(&fHeldPending.ready, ticket, sweet_fb352_waiting_ticket(), fReadyGeneration,
+        fHeldPending.generation, surface, observedFrame)) return false;
+    sweet_frame344_record(F353_READY, fHeldPending.generation, polled, surface, fence, observedFrame);
+    clearReadyTicketLocked();
+    return true;
+}
+
+/* The normal software beat gives precompleted surfaces and a last isolated
+ * submission a chance to become ready without waiting on the GPU lock. */
+void
+AppleCLCD::observePendingReady()
+{
+    IOLockLock(fLock);
+    const uint64_t ticket = watchPendingReadyLocked();
+    auto *surface = ticket ? fHeldPending.surfaces[0] : nullptr;
+    if (surface) surface->retain();
+    IOLockUnlock(fLock);
+    if (!surface) return;
+    const bool ready = GauguinGPUSurfaceIsReady(surface);
+    surface->release();
+    if (ready) {
+        IOLockLock(fLock);
+        markPendingReadyLocked(ticket, 0, true);
+        IOLockUnlock(fLock);
+    }
 }
 
