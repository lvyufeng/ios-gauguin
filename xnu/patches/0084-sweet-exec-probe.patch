+
+/*
+ * Watchdog sampler: once a second, read the APSS watchdog (0x17c10000,
+ * qcom,apss-wdt-sm6350 in the gauge DT) and log only when something changes,
+ * so the last lines of the persistent log say whether the block was armed
+ * (WDT0_EN, 0x08), whether the timers moved (BARK 0x10 / BITE 0x14) or the
+ * status counter (WDT0_STS, 0x0c) stalled - i.e. whether a watchdog can be the
+ * thing that resets the phone minutes into userland.
+ */
+#define SWEET_APSS_WDT_PA       0x17c10000ULL
+#define SWEET_APSS_WDT_SIZE     0x1000
+#define SWEET_WDT_BURST         10      /* samples per boot (1 s apart) */
+
+static thread_call_t sweet_wdt_call;
+static unsigned sweet_wdt_ticks_total;
+static unsigned sweet_wdt_burst;
+
+extern "C" void sweet_dump_tick(void);
+extern "C" void sweet_pstore_tick(void) __attribute__((weak));
+
+static void
+sweet_wdt_sample(thread_call_param_t, thread_call_param_t)
+{
+	static volatile uint32_t *wdt;
+	static uint32_t last[6];
+	static int announced;
+
+	if (wdt == NULL) {
+		wdt = (volatile uint32_t *)ml_io_map(SWEET_APSS_WDT_PA, SWEET_APSS_WDT_SIZE);
+		if (wdt == NULL) {
+			IOLog("SWEET WDT: cannot map 0x%llx, not sampling\n", SWEET_APSS_WDT_PA);
+			return;
+		}
+	}
+	uint32_t now[6];
+	for (int i = 0; i < 6; i++) {
+		now[i] = wdt[i];        /* CTL, RST, EN, STS, BARK, BITE */
+	}
+	if (!announced) {
+		announced = 1;
+		IOLog("SWEET WDT: ctl=%x rst=%x en=%x sts=%x bark=%x bite=%x\n",
+		    now[0], now[1], now[2], now[3], now[4], now[5]);
+	}
+	if (__builtin_memcmp(now, last, sizeof(now)) != 0) {
+		IOLog("SWEET WDT: ctl=%x rst=%x en=%x sts=%x bark=%x bite=%x\n",
+		    now[0], now[1], now[2], now[3], now[4], now[5]);
+		__builtin_memcpy(last, now, sizeof(now));
+	}
