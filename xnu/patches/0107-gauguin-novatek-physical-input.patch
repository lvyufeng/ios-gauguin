+        for (uint32_t offset = 0; offset < p->bytes;) {
+            uint8_t data[NBS_WRITE_WIRE_MAX - 2];
+            uint32_t address = p->sram + offset;
+            uint32_t bytes = p->bytes - offset;
+            uint32_t page_left = NFW_PAGE_BYTES - (address & 0x7f);
+            if (bytes > sizeof(data)) bytes = sizeof(data);
+            if (bytes > page_left) bytes = page_left;
+            int result = read_memory(c, address, data, bytes);
+            if (result) return result;
+            if (memcmp(data, firmware + p->bin_offset + offset, bytes)) return NBS_READBACK;
+            offset += bytes; c->session->report.bytes_verified += bytes;
+            if (!(c->session->report.transfers % 256)) {
+                result = phase(c, NBS_SRAM_READBACK, c->session->report.bytes_verified, image->total_write_bytes);
+                if (result) return result;
+            }
+        }
+    }
+    return NBS_OK;
+}
+static int crc_bank(struct context *c, const struct nfw_partition *p, uint32_t dest, uint32_t length, uint32_t golden)
+{
+    uint8_t address[] = {(uint8_t)p->sram, (uint8_t)(p->sram >> 8), (uint8_t)(p->sram >> 16)};
+    uint8_t size[] = {(uint8_t)p->size_field, (uint8_t)(p->size_field >> 8), (uint8_t)((p->size_field >> 16) & 1)};
+    uint8_t crc[] = {(uint8_t)p->golden_crc, (uint8_t)(p->golden_crc >> 8), (uint8_t)(p->golden_crc >> 16), (uint8_t)(p->golden_crc >> 24)};
+    int result = write_verify(c, dest, address, sizeof(address));
+    if (!result) result = write_verify(c, length, size, sizeof(size));
+    if (!result) result = write_verify(c, golden, crc, sizeof(crc));
+    return result;
+}
+
+int nbs_bootstrap(struct nbs_session *s, const struct nbs_io *io, const uint8_t *firmware, size_t bytes)
+{
+    if (!s) return NBS_ARGUMENT;
+    if (s->attempted) return NBS_ALREADY_USED; /* Preserve first attempt evidence. */
+    s->attempted = true; memset(&s->report, 0, sizeof(s->report));
+    s->report.phase = NBS_VALIDATE;
+    if (!io || !io->xfer || !io->reset || !io->delay_ms || !io->now_us || !firmware) {
+        s->report.result = NBS_ARGUMENT; return NBS_ARGUMENT;
+    }
+    struct nfw_image image;
+    int result = fixed_image(firmware, bytes, &image);
+    if (result) { s->report.result = result; return result; }
+    uint64_t start = io->now_us(io->cookie);
+    struct context c = {s, io, start, start};
+    uint8_t value = 0, rx[NVT_MAX_WIRE];
+#define STEP(expression) do { result = (expression); if (result) goto fail; } while (0)
+    STEP(phase(&c, NBS_RESET_LOW, 0, 0)); STEP(set_reset(&c, false));
+    STEP(phase(&c, NBS_ENG_RESET, 0, 0)); STEP(write_byte(&c, ENG_RESET, 0x5a)); STEP(delay(&c, 1));
+    STEP(phase(&c, NBS_RESET_HIGH, 0, 0)); STEP(set_reset(&c, true)); STEP(delay(&c, 10));
+    STEP(phase(&c, NBS_IDENTIFY_RESET, 0, 0)); STEP(bootloader_reset(&c));
+    STEP(phase(&c, NBS_TRIM, 0, 0)); STEP(read_memory(&c, TRIM_ADDRESS, s->report.trim, sizeof(s->report.trim)));
+    s->report.valid |= NBS_VALID_TRIM;
+    if (nvt_check_observed_chip(s->report.trim, sizeof(s->report.trim)) != NVT_OK) { result = NBS_IDENTITY; goto fail; }
+    s->report.trim_verified = true; s->report.event_base = NVT_EVENT_BASE; s->report.hw_crc = 2;
+    /* Native probe identifies first; native updater then performs its own reset. */
+    STEP(phase(&c, NBS_LOAD_RESET, 0, 0)); STEP(bootloader_reset(&c));
+    STEP(phase(&c, NBS_CRC_BASELINE, 0, 0)); STEP(read_memory(&c, CRC_FLAG, &s->report.crc_before, 1));
+    s->report.valid |= NBS_VALID_CRC_BEFORE;
+    /* The native sources do not specify clearing semantics for CRC history. */
+    STEP(phase(&c, NBS_UPLOAD, 0, image.total_write_bytes)); STEP(upload(&c, firmware, &image));
+    STEP(phase(&c, NBS_SRAM_READBACK, 0, image.total_write_bytes)); STEP(verify_sram(&c, firmware, &image));
+    STEP(phase(&c, NBS_CRC_BANKS, 0, 0));
+    STEP(crc_bank(&c, &image.parts[0], 0x3f128, 0x3f118, 0x3f100));
+    STEP(crc_bank(&c, &image.parts[1], 0x3f12c, 0x3f130, 0x3f104));
+    STEP(phase(&c, NBS_CRC_ENABLE, 0, 0)); STEP(read_memory(&c, CRC_ENABLE, &value, 1));
+    value |= 0x80; STEP(write_verify(&c, CRC_ENABLE, &value, 1));
+    STEP(phase(&c, NBS_FW_CRC_ENABLE, 0, 0));
+    STEP(write_byte(&c, NVT_EVENT_BASE + 0x60, 0)); STEP(write_byte(&c, NVT_EVENT_BASE + 0x50, 0xae));
+    STEP(phase(&c, NBS_BOOT_READY, 0, 0)); STEP(write_byte(&c, BOOT_READY, 1)); STEP(delay(&c, 5));
+    STEP(phase(&c, NBS_WAIT_READY, 0, 0));
+    for (unsigned attempt = 0; attempt < 11; ++attempt) {
+        STEP(read_memory(&c, CRC_FLAG, &s->report.crc_status, 1));
+        s->report.valid |= NBS_VALID_CRC_STATUS;
+        if ((s->report.crc_status & 4) && (s->report.crc_status & 3)) { result = NBS_CRC; goto fail; }
+        STEP(event_read(&c, NVT_READ_RESET, rx));
+        if (nvt_decode_reset(rx, 7, &s->report.reset_state) != NVT_OK) { result = NBS_FWINFO; goto fail; }
+        s->report.valid |= NBS_VALID_RESET_STATE;
+        if ((s->report.crc_status & 4) && nvt_reset_ready(&s->report.reset_state, 0xa0)) break;
+        if (attempt == 10) { result = NBS_TIMEOUT; goto fail; }
+        STEP(delay(&c, 10)); /* bounded status polling, never retry failed IO/reset/load */
+    }
+    STEP(phase(&c, NBS_CRC_RESULT, 0, 0));
+    STEP(read_word(&c, 0x3f120, &s->report.ilm_crc)); s->report.valid |= NBS_VALID_ILM_CRC;
+    STEP(read_word(&c, 0x3f124, &s->report.dlm_crc)); s->report.valid |= NBS_VALID_DLM_CRC;
+    if (s->report.ilm_crc != image.parts[0].golden_crc || s->report.dlm_crc != image.parts[1].golden_crc) { result = NBS_CRC; goto fail; }
+    STEP(read_word(&c, 0x3f100, &s->report.ilm_golden)); s->report.valid |= NBS_VALID_ILM_GOLDEN;
+    if (s->report.ilm_golden != image.parts[0].golden_crc) { result = NBS_CRC; goto fail; }
+    STEP(read_word(&c, 0x3f104, &s->report.dlm_golden)); s->report.valid |= NBS_VALID_DLM_GOLDEN;
+    if (s->report.dlm_golden != image.parts[1].golden_crc) { result = NBS_CRC; goto fail; }
+    STEP(phase(&c, NBS_READ_FWINFO, 0, 0)); STEP(event_read(&c, NVT_READ_FWINFO, rx));
+    if (nvt_decode_fwinfo(rx, 18, &s->report.fwinfo) != NVT_OK) { result = NBS_FWINFO; goto fail; }
+    s->report.valid |= NBS_VALID_FWINFO;
+    /* Native buf[14] is raw payload13. Recovery dmesg2768/2770 observed type1,
+     * version16 after loading this exact fw01; this is a fixed-profile gate. */
+    if (s->report.fwinfo.version != image.version ||
+        s->report.fwinfo.firmware_type != 1) { result = NBS_FWINFO; goto fail; }
+    STEP(phase(&c, NBS_READ_PID, 0, 0)); STEP(event_read(&c, NVT_READ_PID, rx));
+    if (nvt_decode_pid(rx, 4, &s->report.pid) != NVT_OK) { result = NBS_IDENTITY; goto fail; }
+    s->report.valid |= NBS_VALID_PID;
+    if (s->report.pid != NBS_EXPECTED_PID) { result = NBS_IDENTITY; goto fail; }
+    STEP(phase(&c, NBS_READY, image.total_write_bytes, image.total_write_bytes));
+    s->report.ready = true; s->report.result = NBS_OK; return NBS_OK;
+fail:
+    s->report.result = result; s->report.quarantine = s->report.hardware_touched;
+    return result;
+#undef STEP
+}
