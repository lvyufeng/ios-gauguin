--- /dev/null
+++ b/bsd/dev/gauguin_read360.h
@@ -0,0 +1,47 @@
+#ifndef GAUGUIN_READ360_H
+#define GAUGUIN_READ360_H
+
+#include "gauguin_ready354.h"
+
+/* A completed writer's pixels are pinned for one display read. GPU state
+ * observers still see the completed version. Only GPU admission and the
+ * display read guard participate in this additional state. */
+#define SCAN360_GPU_READ 3u
+
+static inline bool
+scan360_reserved(uint32_t state)
+{
+    return (state & SCAN354_GPU_STATUS) == SCAN360_GPU_READ;
+}
+
+static inline bool
+scan360_reserve(uint32_t *state, uint32_t version)
+{
+    if (!version || !scan354_has_version(version, version))
+        return false;
+    return __atomic_compare_exchange_n(state, &version, version | SCAN360_GPU_READ,
+        false, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED);
+}
+
+/* GPU callers retain their serial request lock and buffer references while
+ * waiting. A read that wins the CAS precedes GPU admission for this surface. */
+static inline bool
+scan360_try_gpu_state(uint32_t *state, uint32_t status, bool writer)
+{
+    uint32_t previous = __atomic_load_n(state, __ATOMIC_ACQUIRE);
+    if (scan360_reserved(previous))
+        return false;
+    const uint32_t next = scan354_gpu_state(previous, status, writer);
+    return __atomic_compare_exchange_n(state, &previous, next, false,
+        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+
+static inline bool
+scan360_release(uint32_t *state, uint32_t version)
+{
+    uint32_t held = version | SCAN360_GPU_READ;
+    return __atomic_compare_exchange_n(state, &held, version, false,
+        __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+}
+
+#endif
