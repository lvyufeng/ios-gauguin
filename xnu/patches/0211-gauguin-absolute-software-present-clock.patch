@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: MIT
+ * Absolute software beats and copy slots, not physical panel/vblank timing.
+ * Clock values are XNU absolute ticks; no assumed counter frequency. */
+#ifndef _SWEET_PRESENT_CLOCK_H
+#define _SWEET_PRESENT_CLOCK_H
+#include <stdint.h>
+
+struct SweetPresentClock {
+    uint64_t beat, copySpan, nextBeat, nextCopy, lastObserved, firedBeat;
+    uint64_t callbacks, skippedBeats, copies;
+    bool copyOffered;
+};
+struct SweetPresentTick { uint64_t elapsed; bool copyDue; };
+
+static inline uint64_t
+sweet_present_clock_add(uint64_t a, uint64_t b)
+{
+    return b > UINT64_MAX - a ? UINT64_MAX : a + b;
+}
+
+static inline bool
+sweet_present_clock_init(SweetPresentClock *c, uint64_t now, uint64_t beat, uint32_t divisor)
+{
+    *c = {};
+    if (beat == 0 || divisor == 0 || beat > UINT64_MAX / divisor) return false;
+    uint64_t span = beat * divisor;
+    if (now > UINT64_MAX - span) return false;
+    c->beat = beat; c->copySpan = span;
+    c->nextBeat = now + beat; c->nextCopy = now + span; c->lastObserved = now;
+    return true;
+}
+
+static inline bool
+sweet_present_clock_step(SweetPresentClock *c, uint64_t now, bool dirty, SweetPresentTick *tick)
+{
+    *tick = {}; c->copyOffered = false;
+    if (c->beat == 0 || c->nextBeat == 0 || now < c->lastObserved) return false;
+    c->lastObserved = now;
+    if (now < c->nextBeat) return true; /* an early/duplicate callback consumes no beat */
+    uint64_t remainder = (now - c->nextBeat) % c->beat;
+    uint64_t delta = c->beat - remainder;
+    if (now > UINT64_MAX - delta) return false;
+    uint64_t fired = now - remainder;
+    tick->elapsed = (fired - c->nextBeat) / c->beat + 1;
+    c->nextBeat = now + delta; c->firedBeat = fired;
+    c->callbacks = sweet_present_clock_add(c->callbacks, 1);
+    c->skippedBeats = sweet_present_clock_add(c->skippedBeats, tick->elapsed - 1);
+    tick->copyDue = dirty && fired >= c->nextCopy;
+    c->copyOffered = tick->copyDue;
+    return true;
+}
+
+static inline bool
+sweet_present_clock_copied(SweetPresentClock *c)
+{
+    if (!c->copyOffered || c->firedBeat == 0 || c->copySpan == 0 ||
+        c->firedBeat > UINT64_MAX - c->copySpan) return false;
+    /* Rebase the copy slot on the delivered logical beat, not its callback's
+     * jitter or the time spent copying. After idle, consume at most one frame. */
+    c->nextCopy = c->firedBeat + c->copySpan;
+    c->copies = sweet_present_clock_add(c->copies, 1); c->copyOffered = false;
+    return true;
+}
+
+static inline bool
+sweet_present_clock_next(SweetPresentClock *c, uint64_t now, uint64_t *deadline)
+{
+    if (c->beat == 0 || c->nextBeat == 0 || now < c->lastObserved) return false;
+    c->lastObserved = now;
+    if (c->nextBeat > now) { *deadline = c->nextBeat; return true; }
+    uint64_t delta = c->beat - (now - c->nextBeat) % c->beat;
+    if (now > UINT64_MAX - delta) return false;
+    *deadline = now + delta;
+    /* Do not consume the skipped logical beats here. The next actual callback
+     * accounts for them once, without issuing a burst of old notifications. */
+    return true;
+}
+#endif
