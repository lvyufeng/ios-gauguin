+/* One warmed, continuous horizontal drag. The due time is absolute to
+ * avoid accumulating callback jitter over the 33-second motion window. */
+static bool sweet_continuous_mode;
+static struct {
+	uint64_t due, interval, start, last, max_gap;
+	unsigned reports;
+	bool armed;
+} motion417;
+
+static void
+motion417_arm(void)
+{
+	nanoseconds_to_absolutetime(F417_SAMPLE_MS * NSEC_PER_MSEC, &motion417.interval);
+	if (!motion417.interval) return;
+	clock_interval_to_deadline(6, NSEC_PER_SEC, &motion417.due);
+	motion417.armed = true;
+	thread_call_enter_delayed(sweet_script_call, motion417.due);
+}
+
+static void
+motion417_finish(uint64_t now, bool complete)
+{
+	motion417.armed = false;
+	int rc = 0;
+	if (motion417.reports) {
+		struct sweet_hid_touch_snapshot release = {0};
+		rc = sweet_hid_touch_frame(&release);
+	}
+	printf("SWEET F417 MOTION: end=%llu reports=%u max_gap=%llu release_rc=%x complete=%u\n",
+	    (unsigned long long)now, motion417.reports, (unsigned long long)motion417.max_gap,
+	    rc, complete && !rc);
+}
+
+static void
+motion417_fire(uint64_t now)
+{
+	if (sweet_fb_display_state() != 1 || (motion417.start && now < motion417.start)) {
+		motion417_finish(now, false);
+		return;
+	}
+	if (now < motion417.due) {
+		thread_call_enter_delayed(sweet_script_call, motion417.due);
+		return;
+	}
+	if (!motion417.start) {
+		motion417.start = now;
+		printf("SWEET F417 MOTION: begin=%llu interval=%llu limit=%u\n",
+		    (unsigned long long)now, (unsigned long long)motion417.interval, F417_REPORT_LIMIT);
+	}
+	const uint64_t step = (now - motion417.start) / motion417.interval;
+	if (step >= F417_REPORT_LIMIT) {
+		motion417_finish(now, true);
+		return;
+	}
+	if (motion417.last && now - motion417.last > motion417.max_gap)
+		motion417.max_gap = now - motion417.last;
+	motion417.last = now;
+	struct sweet_hid_touch_snapshot position = {0};
+	position.active_mask = 1;
+	position.x[0] = f417_position((unsigned)step);
+	position.y[0] = 1200;
+	++motion417.reports;
+	if (sweet_hid_touch_frame(&position)) {
+		motion417_finish(mach_absolute_time(), false);
+		return;
+	}
+	motion417.due = motion417.start + (step + 1) * motion417.interval;
+	thread_call_enter_delayed(sweet_script_call, motion417.due);
+}
+
