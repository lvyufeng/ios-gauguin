+/* SWEET_DYLD_FILE_PROBE_BEGIN: complete body used by the host boundary test. */
+static void
+sweet_dyld_file_trace(vnode_t vp, unsigned operation, int prot, int flags,
+    uint64_t offset)
+{
+	proc_t p = current_proc();
+	char name[32];
+	if (!sweet_dyld_probe || p == NULL || vp == NULLVP || vnode_vtype(vp) != VREG) {
+		return;
+	}
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "backboardd") != 0 && strcmp(name, "xpcproxy") != 0) {
+		return;
+	}
+	const char *leaf = vnode_getname(vp);
+	if (leaf == NULL) {
+		return;
+	}
+	bool match = strcmp(leaf, "libGauguinEAGLAdmission.dylib") == 0;
+	vnode_putname(leaf);
+	if (!match) {
+		return;
+	}
+	/* vn_getpath walks the name cache and does not enter the filesystem. */
+	char path[MAXPATHLEN];
+	int length = sizeof(path);
+	if (vn_getpath(vp, path, &length) != 0 || length <= 0 ||
+	    (size_t)length > sizeof(path) || path[length - 1] != 0 ||
+	    strcmp(path, "/usr/local/lib/gauguin/libGauguinEAGLAdmission.dylib") != 0) {
+		return;
+	}
+	printf("SWEET DYLD FILE: pid=%d op=%u prot=%d flags=%d offset=%llu expected-path=1\n",
+	    proc_pid(p), operation, prot, flags, offset);
+}
+
+static int
+sweet_dyld_probe_open(__unused kauth_cred_t cred, vnode_t vp,
+    __unused struct label *label, int mode)
+{
+	sweet_dyld_file_trace(vp, 1, mode, 0, 0);
+	return 0;
+}
+
+static int
+sweet_dyld_probe_mmap(__unused kauth_cred_t cred, struct fileglob *fg,
+    __unused struct label *label, int prot, int flags, uint64_t offset,
+    __unused int *maxprot)
+{
+	if (sweet_dyld_probe && fg != NULL && fg->fg_ops != NULL &&
+	    FILEGLOB_DTYPE(fg) == DTYPE_VNODE) {
+		sweet_dyld_file_trace((vnode_t)fg_get_data(fg), 2, prot, flags, offset);
+	}
+	/* Diagnostic only: never change maximum protections or deny an operation. */
+	return 0;
+}
+/* SWEET_DYLD_FILE_PROBE_END */
+
 static const struct mac_policy_ops sweet_dyld_probe_ops = {
 	.mpo_policy_syscall = sweet_dyld_probe_syscall,
+	.mpo_vnode_check_open = sweet_dyld_probe_open,
+	.mpo_file_check_mmap = sweet_dyld_probe_mmap,
 };
 static struct mac_policy_conf sweet_dyld_probe_conf = {
 	.mpc_name = "AMFI",
