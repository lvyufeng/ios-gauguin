+		    (unsigned long long)sweet_motion_samples[i].entered,
+		    (unsigned long long)sweet_motion_samples[i].returned,
+		    sweet_motion_samples[i].x, sweet_motion_samples[i].down);
+	}
+	printf("SWEET M362: complete reports=%u\n", sweet_motion_step);
+}
