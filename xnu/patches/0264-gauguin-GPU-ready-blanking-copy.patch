+    fReadyGeneration = 0;
+}
+
+void
+AppleCLCD::readyEventFired(OSObject *owner, IOInterruptEventSource *sender, int)
+{
+    auto *fb = static_cast<AppleCLCD *>(owner);
+    SweetReadySignal signal = {};
+    IOLock *lock = __atomic_load_n(&gReadyLock, __ATOMIC_ACQUIRE);
+    IOLockLock(lock);
