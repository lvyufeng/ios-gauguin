+/* Publication owns one reference until stop. Callers take a reference under
+ * this short lock, then release the lock before entering the work-loop gate.
+ * The once-allocated publication lock outlives all service instances. */
+static IOLock *gSweetTouchLock;
+
+static bool
+sweetTouchEnsureLock(void)
+{
+	if (__atomic_load_n(&gSweetTouchLock, __ATOMIC_ACQUIRE)) return true;
+	IOLock *fresh = IOLockAlloc();
+	if (!fresh) return false;
+	IOLock *expected = NULL;
+	if (!__atomic_compare_exchange_n(&gSweetTouchLock, &expected, fresh, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) IOLockFree(fresh);
+	return true;
+}
+
+static bool
+sweetTouchPublish(SweetHIDTouch *service)
+{
+	IOLockLock(gSweetTouchLock);
+	bool available = gSweetTouch == NULL;
+	if (available) {
+		service->retain();
+		gSweetTouch = service;
+	}
+	IOLockUnlock(gSweetTouchLock);
+	return available;
+}
+
+static SweetHIDTouch *
+sweetTouchCopyService(void)
+{
+	IOLock *lock = __atomic_load_n(&gSweetTouchLock, __ATOMIC_ACQUIRE);
+	if (!lock) return NULL;
+	IOLockLock(lock);
+	SweetHIDTouch *service = gSweetTouch;
+	if (service) service->retain();
+	IOLockUnlock(lock);
+	return service;
+}
+
+static void
+sweetTouchUnpublish(SweetHIDTouch *service)
+{
+	IOLock *lock = __atomic_load_n(&gSweetTouchLock, __ATOMIC_ACQUIRE);
+	if (!lock) return;
+	IOLockLock(lock);
+	bool published = gSweetTouch == service;
+	if (published) gSweetTouch = NULL;
+	IOLockUnlock(lock);
+	if (published) service->release();
+}
 
