+static ipc_port_t sweet_kmsg_ports[SWEET_KMSG_SLOTS];
+static char sweet_kmsg_senders[SWEET_KMSG_SLOTS][20];
+static volatile uint32_t sweet_kmsg_count;
+static int sweet_kmsg_parsed;
+static char sweet_kmsg_needle[48];
+
+void
+sweet_kmsg_note(ipc_port_t port)
+{
+	if (!sweet_kmsg_parsed) {
+		sweet_kmsg_parsed = 1;
+		/*
+		 * Its own storage: sharing sweet_msgwait_needle meant
+		 * sweet_msgwait_init() cleared it whenever sweetmsgwait was absent,
+		 * and this trace then silently did nothing.
+		 */
+		if (!PE_parse_boot_argn("sweetkmssend", sweet_kmsg_needle,
+		    sizeof(sweet_kmsg_needle))) {
+			sweet_kmsg_needle[0] = '\0';
+		}
+	}
+	if (sweet_kmsg_needle[0] == '\0') {
+		return;
+	}
