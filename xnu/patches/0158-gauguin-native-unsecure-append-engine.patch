+/* Fixed19b63c8 native SET_SECURE_MODE0 + WHERE_AM_I on retained A619 RB0. */
+#include <string.h>
+#include "gauguin_gpu_unsecure.h"
+static bool span(const void *p,size_t n)
+{return p&&n&&(uintptr_t)p<=UINTPTR_MAX-(n-1);}
+static bool overlap(const void *a,size_t an,const void *b,size_t bn)
+{uintptr_t x=(uintptr_t)a,y=(uintptr_t)b;return x<=y?y-x<an:x-y<bn;}
+bool ggu_command_build(const struct ggp_plan *p,struct ggu_command *out)
+{
+    if(!span(p,sizeof(*p))||!span(out,sizeof(*out))||overlap(p,sizeof(*p),out,sizeof(*out))||
+       !ggp_plan_valid(p))return false;
+    /* Exact cp_packet(CP_SET_SECURE_MODE,1), zero, then native non-APRIV
+     * submit_spin's cp_packet(CP_WHERE_AM_I,2) and RB0 scratch address. */
+    const struct ggu_command c={{0x70e60001u,0,0x70620002u,p->region[GGP_SCRATCH].iova,0}};
+    *out=c;return true;
+}
+bool ggu_register_allowed(uint32_t reg,bool write)
+{
+    if(write)return reg==0x807||reg==0x1f8c3;
+    return reg==0x807||reg==0x201||reg==0x823||reg==0x23b13||
+        reg==0x23b0c||reg==0x1f888||reg==0x1f889;
+}
+static bool guard(struct ggu_context *c)
+{return c->ops.guard(c->ops.cookie,(enum ggu_phase)c->phase);}
+static enum ggu_result sample(struct ggu_context *c,bool mem,uint32_t reg,uint32_t expected,uint32_t actual)
+{c->diagnostic=(struct ggu_diagnostic){1,mem,reg,expected,actual};return mem?GGU_MEMORY_ERROR:GGU_DIRTY_STATE;}
+static enum ggu_result rd(struct ggu_context *c,uint32_t reg,uint32_t *v)
+{
+    if(!guard(c))return GGU_GUARD;
+    ++c->work.reads;if(!c->ops.read32(c->ops.cookie,reg,v))return GGU_IO;
+    c->diagnostic=(struct ggu_diagnostic){1,0,reg,0,*v};
+    return guard(c)?GGU_OK:GGU_GUARD;
+}
+static enum ggu_result wr(struct ggu_context *c,uint32_t reg,uint32_t v)
+{
+    if(!guard(c))return GGU_GUARD;
+    if(reg==0x807)c->work.submit_attempted=1;
+    if(reg==0x1f8c3){if(v)c->work.keepalive_set_attempted=1;else c->work.keepalive_clear_attempted=1;}
+    ++c->work.writes;if(!c->ops.write32(c->ops.cookie,reg,v))return GGU_IO;
+    return guard(c)?GGU_OK:GGU_GUARD;
+}
+static enum ggu_result mr(struct ggu_context *c,enum ggq_memory mem,uint32_t off,uint32_t *v)
+{
+    if(!guard(c))return GGU_GUARD;
+    if(!c->ops.read_memory(c->ops.cookie,mem,off,v))return GGU_IO;
+    c->diagnostic=(struct ggu_diagnostic){1,1,(mem==GGQ_SCRATCH?0x10000u:0u)+off,0,*v};
+    return guard(c)?GGU_OK:GGU_GUARD;
+}
+static enum ggu_result barrier(struct ggu_context *c)
+{
+    if(!guard(c))return GGU_GUARD;
+    if(!c->ops.barrier(c->ops.cookie))return GGU_IO;
+    return guard(c)?GGU_OK:GGU_GUARD;
+}
+static enum ggu_result delay(struct ggu_context *c)
+{
+    if(!guard(c))return GGU_GUARD;
+    if(!c->ops.delay_us(c->ops.cookie,10))return GGU_IO;
+    return guard(c)?GGU_OK:GGU_GUARD;
+}
+#define TRY(x) do{enum ggu_result result=(x);if(result)return result;}while(0)
+static enum ggu_result counter(struct ggu_context *c,uint64_t *v)
+{
+    uint32_t h,l,h1;TRY(rd(c,0x1f889,&h));TRY(rd(c,0x1f888,&l));TRY(rd(c,0x1f889,&h1));
+    if(h!=h1)TRY(rd(c,0x1f888,&l));*v=((uint64_t)h1<<32)|l;return GGU_OK;
+}
+static enum ggu_result faults(struct ggu_context *c)
+{
+    TRY(rd(c,0x201,&c->work.rbbm_status));TRY(rd(c,0x823,&c->work.cp_status));
+    return (c->work.rbbm_status&GGQ_RBBM_ERRORS)||(c->work.cp_status&GGQ_CP_ERRORS)?GGU_FAULT:GGU_OK;
+}
+static enum ggu_result capture(struct ggu_context *c,const struct ggq_command *prefix)
+{
+    TRY(faults(c));TRY(rd(c,0x807,&c->work.initial_wptr));
+    if(c->work.initial_wptr!=GGU_START_DWORD)return sample(c,false,0x807,GGU_START_DWORD,c->work.initial_wptr);
+    TRY(mr(c,GGQ_SCRATCH,0,&c->work.initial_shadow));
+    if(c->work.initial_shadow!=GGU_START_DWORD)return sample(c,true,0x10000,GGU_START_DWORD,c->work.initial_shadow);
+    TRY(rd(c,0x23b0c,&c->work.initial_busy));
+    if(c->work.initial_busy&(1u<<23))return GGU_FAULT;
+    for(unsigned i=0;i<GGU_END_DWORD;i++){
+        uint32_t v,expected=i<GGU_START_DWORD?prefix->word[i]:0xaaaaaaaau;
+        TRY(mr(c,GGQ_RING,4*i,&v));
+        if(v!=expected)return sample(c,true,4*i,expected,v);
+        if(i<GGU_START_DWORD)++c->work.prefix_checked;else ++c->work.clean_checked;
+    }
+    return GGU_OK;
+}
+static enum ggu_result commands(struct ggu_context *c)
+{
+    for(unsigned i=0;i<GGU_COMMAND_WORDS;i++){
+        if(!guard(c))return GGU_GUARD;
+        ++c->work.commands_written;
+        if(!c->ops.write_memory(c->ops.cookie,GGQ_RING,4*(GGU_START_DWORD+i),c->command.word[i]))return GGU_IO;
+        if(!guard(c))return GGU_GUARD;
+    }
+    TRY(barrier(c));
+    for(unsigned i=0;i<GGU_COMMAND_WORDS;i++){
+        uint32_t v;TRY(mr(c,GGQ_RING,4*(GGU_START_DWORD+i),&v));
+        if(v!=c->command.word[i])return sample(c,true,4*(GGU_START_DWORD+i),c->command.word[i],v);
+        ++c->work.commands_checked;
+    }
+    return barrier(c);
+}
+static enum ggu_result submit(struct ggu_context *c)
+{
+    TRY(wr(c,0x1f8c3,1));TRY(wr(c,0x807,GGU_END_DWORD));
+    TRY(counter(c,&c->work.counter_before));c->work.counter_before_valid=1;
+    unsigned i;
+    for(i=0;i<GGQ_FENCE_LIMIT;i++){
+        TRY(barrier(c));TRY(rd(c,0x23b13,&c->work.fence_status));++c->work.fence_checks;
+        if(!(c->work.fence_status&1u))break;
+        TRY(delay(c));TRY(wr(c,0x807,GGU_END_DWORD));
+    }
+    if(i>=100){c->work.fence_slow=1;TRY(counter(c,&c->work.counter_after));c->work.counter_after_valid=1;}
+    if(i==GGQ_FENCE_LIMIT)return GGU_TIMEOUT;
+    return wr(c,0x1f8c3,0);
+}
+static enum ggu_result wait_idle(struct ggu_context *c)
+{
+    for(unsigned i=0;i<GGQ_IDLE_LIMIT;i++){
+        TRY(faults(c));TRY(barrier(c));TRY(mr(c,GGQ_SCRATCH,0,&c->work.rptr));++c->work.idle_polls;
+        if(c->work.rptr>=GGQ_RING_WORDS)return sample(c,true,0x10000,GGU_END_DWORD,c->work.rptr);
+        if(c->work.rptr!=GGU_END_DWORD)continue;
+        TRY(rd(c,0x23b0c,&c->work.busy));
+        if(c->work.busy==UINT32_MAX)return GGU_FAULT;
+        if(!(c->work.busy&(1u<<23)))return GGU_OK;
+    }
+    return GGU_TIMEOUT;
+}
+static enum ggu_result execute(struct ggu_context *c,const struct ggp_plan *p,const struct ggq_command *prefix)
+{
+    c->phase=GGU_SEAL;if(!guard(c))return GGU_GUARD;
+    if(!c->ops.seal(c->ops.cookie,p->owner_pa))return GGU_OWNER;
+    c->work.sealed=c->work.requests_retained=1;if(!guard(c))return GGU_GUARD;
+    c->phase=GGU_CAPTURE;TRY(capture(c,prefix));
+    c->phase=GGU_COMMANDS;TRY(commands(c));
+    c->phase=GGU_SUBMIT;TRY(submit(c));
+    c->phase=GGU_WAIT;TRY(wait_idle(c));
+    c->phase=GGU_FINAL;TRY(barrier(c));if(!guard(c))return GGU_GUARD;
+    c->work.complete=1;return GGU_OK;
+}
+#undef TRY
+enum ggu_result ggu_start_once(struct ggu_context *c,const struct ggu_ops *ops,const struct ggp_plan *p,struct ggu_receipt *out)
+{
+    const void *ptr[]={c,ops,p,out};size_t len[]={sizeof(*c),sizeof(*ops),sizeof(*p),sizeof(*out)};
+    for(unsigned i=0;i<4;i++){
+        if(!span(ptr[i],len[i]))return GGU_ARGUMENT;
+        for(unsigned j=0;j<i;j++)if(overlap(ptr[i],len[i],ptr[j],len[j]))return GGU_ARGUMENT;
+    }
+    struct ggu_command cmd;struct ggq_command prefix;
+    if(!ggu_command_build(p,&cmd)||!ggq_command_build(p,&prefix)||!ops->guard||!ops->seal||
+       !ops->read32||!ops->write32||!ops->read_memory||!ops->write_memory||
+       !ops->barrier||!ops->delay_us||!ops->quarantine)return GGU_ARGUMENT;
+    const struct ggu_ops saved=*ops;const struct ggp_plan plan=*p;unsigned idle=0;
+    if(!__atomic_compare_exchange_n(&c->state,&idle,1,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return GGU_ALREADY;
+    c->ops=saved;c->command=cmd;memset(&c->work,0,sizeof(c->work));memset(&c->diagnostic,0,sizeof(c->diagnostic));
+    enum ggu_result result=execute(c,&plan,&prefix);
+    if(result){__atomic_store_n(&c->state,3,__ATOMIC_RELEASE);c->ops.quarantine(c->ops.cookie);}
+    else{c->phase=GGU_DONE;*out=c->work;__atomic_store_n(&c->state,2,__ATOMIC_RELEASE);}
+    return result;
+}
--- /dev/null
+++ b/bsd/dev/gauguin_gpu_unsecure.h
@@ -0,0 +1,60 @@
+#ifndef GAUGUIN_GPU_UNSECURE_H
+#define GAUGUIN_GPU_UNSECURE_H
+#include "gauguin_gpu_cp.h"
+enum ggu_phase {GGU_IDLE,GGU_SEAL,GGU_CAPTURE,GGU_COMMANDS,GGU_SUBMIT,
+    GGU_WAIT,GGU_FINAL,GGU_DONE};
+enum ggu_result {GGU_OK,GGU_ARGUMENT,GGU_ALREADY,GGU_GUARD,GGU_OWNER,GGU_IO,
+    GGU_DIRTY_STATE,GGU_MEMORY_ERROR,GGU_FAULT,GGU_TIMEOUT};
+#define GGU_START_DWORD 15u
+#define GGU_COMMAND_WORDS 5u
+#define GGU_END_DWORD 20u
+struct ggu_command {uint32_t word[GGU_COMMAND_WORDS];};
+struct ggu_ops {
+    void *cookie;
+    bool (*guard)(void *,enum ggu_phase);
+    bool (*seal)(void *,uint64_t);
+    bool (*read32)(void *,uint32_t,uint32_t *);
+    bool (*write32)(void *,uint32_t,uint32_t);
+    bool (*barrier)(void *);
+    bool (*delay_us)(void *,unsigned);
+    bool (*read_memory)(void *,enum ggq_memory,uint32_t,uint32_t *);
+    bool (*write_memory)(void *,enum ggq_memory,uint32_t,uint32_t);
+    void (*quarantine)(void *);
+};
+struct ggu_receipt {
+    uint32_t reads,writes,prefix_checked,clean_checked,commands_written,commands_checked;
+    uint32_t sealed,initial_wptr,initial_shadow,initial_busy,submit_attempted;
+    uint32_t keepalive_set_attempted,keepalive_clear_attempted,fence_checks,fence_status;
+    uint32_t fence_slow,counter_before_valid,counter_after_valid,idle_polls;
+    uint32_t rptr,busy,rbbm_status,cp_status,complete,requests_retained;
+    uint64_t counter_before,counter_after;
+};
+struct ggu_diagnostic {uint32_t valid,memory,reg,expected,actual;};
+struct ggu_context {
+    uint32_t state,phase;
+    struct ggu_ops ops;
+    struct ggu_command command;
+    struct ggu_receipt work;
+    struct ggu_diagnostic diagnostic;
+};
+bool ggu_command_build(const struct ggp_plan *,struct ggu_command *);
+bool ggu_register_allowed(uint32_t,bool);
+/* Fixed native A619 RB0 append following THIS boot's signed-ZAP acceptance.
+ * The provider's seal/guard must establish actual private CP/core/FW/owner/
+ * full64 INIT/MEM/AUTH0 receipts, not a caller-produced receipt. owner_pa is
+ * only compared, never a pointer/authority setter. Post-AUTH guards must not
+ * call the original MDT validator or access the secure region. The new live
+ * stage may inspect GPU registers and private ring/scratch under its own
+ * explicit authority; the signed loader's SECURE/LATE rules remain intact.
+ * Require exclusive retained Device/NC mappings, live routes/clock/IRQ/fault/
+ * WDT/context, monotonically bounded total/phase/native2s idle checks.
+ * Write ONLY ring DW15..19, preserve first15 words and every other byte,
+ * never clear scratch, restart SQE, reprogram RB, release HOST or fall back
+ * to TRUST_CONTROL0. Guard every memory/MMIO callback, including readback.
+ * Failures consume the attempt and quarantine BEFORE returning; no further
+ * hardware operation or rollback follows refusal. Output stays untouched.
+ * Pure engine only: no dispatch, SMC, allocation, mapping or Metal API.
+ */
+enum ggu_result ggu_start_once(struct ggu_context *,const struct ggu_ops *,
+    const struct ggp_plan *,struct ggu_receipt *);
+#endif
