--- /dev/null
+++ b/bsd/dev/gauguin_gmu_asset.c
@@ -0,0 +1,42 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <vm/vm_map.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm64/boot.h>
+#include <libkern/crypto/sha2.h>
+#include "gauguin_gmu_asset.h"
+extern unsigned long gPhysBase,real_phys_size;
+extern vm_offset_t arm_vm_kernelcache_phys_end;
+static const uint8_t gma_expected[32]={
+    0x9e,0xf1,0x0b,0x2b,0x17,0x90,0x54,0xfb,0x57,0xaf,0x25,0x00,0x8e,0x29,0xfe,0xb2,
+    0x43,0x00,0xc2,0xea,0xae,0xab,0xf9,0x07,0xbd,0x74,0x17,0x86,0xbb,0xac,0xbf,0x2e
+};
+bool sweet_gmu_asset_view(struct gma_view *out)
+{
+    if(!out)return false;
+    const boot_args *a=PE_state.bootArgs;
+    DTEntry node;const void *property=NULL;unsigned length=0;uint64_t range[2];
+    if(!a||a->Version!=kBootArgsVersion2||a->physBase!=gPhysBase||!real_phys_size||
+       !a->memSize||a->memSize>real_phys_size||a->physBase>UINT64_MAX-real_phys_size||
+       (a->topOfKernelData&0x3fff)||a->topOfKernelData<a->physBase||
+       a->topOfKernelData>a->physBase+a->memSize||arm_vm_kernelcache_phys_end<a->physBase||
+       arm_vm_kernelcache_phys_end>a->topOfKernelData||
+       SecureDTLookupEntry(NULL,"/chosen/memory-map",&node)!=kSuccess||
+       SecureDTGetProperty(node,"A619GMUFirmware",&property,&length)!=kSuccess||
+       !property||length!=sizeof(range))return false;
+    memcpy(range,property,sizeof(range));uint64_t pa=range[0],bytes=range[1];
+    if(!pa||(pa&0x3fff)||bytes!=32768||pa<arm_vm_kernelcache_phys_end||
+       pa>=a->topOfKernelData||bytes>a->topOfKernelData-pa||
+       bytes>a->physBase+a->memSize-pa)return false;
+    vm_offset_t first=ml_static_ptovirt((vm_offset_t)pa);
+    if(!first||first>UINTPTR_MAX-32767||ml_static_ptovirt((vm_offset_t)(pa+32767))!=first+32767)return false;
+    uint8_t digest[32];SHA256_CTX ctx;
+    SHA256_Init(&ctx);SHA256_Update(&ctx,(const void *)first,32768);SHA256_Final(digest,&ctx);
+    if(memcmp(digest,gma_expected,sizeof(digest)))return false;
+    *out=(struct gma_view){(const uint8_t *)first,pa,32768};return true;
+}
+#endif /* GAUGUIN */
diff --git a/bsd/dev/gauguin_gmu_asset.h b/bsd/dev/gauguin_gmu_asset.h
