--- /dev/null
+++ b/bsd/dev/gauguin_frame374_wire.h
@@ -0,0 +1,82 @@
+#ifndef GAUGUIN_FRAME374_WIRE_H
+#define GAUGUIN_FRAME374_WIRE_H
+
+#include "gauguin_frame372_wire.h"
+
+enum {
+    F374_EVENT_CAP = 16384, F374_WIRE_CAP = 210000, F374_BLOCK = 32,
+    F374_MAX_ROW = 34,
+    F374_RENDER_BEGIN = 1, F374_RENDER_END, F374_ANNOTATION, F374_FRAME_INFO,
+    F374_HITCH, F374_RENDER_TIME, F374_VSYNC, F374_VSYNC_UPDATE
+};
+
+struct f374_event {
+    uint64_t tick, thread, a, b, c, d;
+    unsigned kind;
+};
+
+static inline unsigned
+f374_kind(uint32_t debugid)
+{
+    switch (debugid) {
+    case 0x31ca000d: return F374_RENDER_BEGIN;
+    case 0x31ca000e: return F374_RENDER_END;
+    case 0x31ca0084: return F374_ANNOTATION;
+    case 0x31ca002c: return F374_FRAME_INFO;
+    case 0x31ca01e0: return F374_HITCH;
+    case 0x31ca0010: return F374_RENDER_TIME;
+    case 0x31ca0000: return F374_VSYNC;
+    case 0x31ca0110: return F374_VSYNC_UPDATE;
+    default: return 0;
+    }
+}
+
+static inline void
+f374_le64(uint8_t *out, uint64_t value)
+{
+    f372_le32(out, (uint32_t)value);
+    f372_le32(out + 4, (uint32_t)(value >> 32));
+}
+
+static inline unsigned
+f374_pack(uint8_t out[F374_MAX_ROW], uint64_t start, uint64_t end,
+    const struct f374_event *event, uint8_t thread)
+{
+    if (!event->thread || event->tick < start || event->tick >= end ||
+        event->tick - start > UINT32_MAX) {
+        return 0;
+    }
+    f372_le32(out, (uint32_t)(event->tick - start));
+    out[4] = (uint8_t)event->kind;
+    out[5] = thread;
+    switch (event->kind) {
+    case F374_RENDER_BEGIN:
+        if (event->b > UINT32_MAX) return 0;
+        f372_le32(out + 6, (uint32_t)event->b);
+        return 10;
+    case F374_RENDER_END:
+    case F374_VSYNC:
+    case F374_VSYNC_UPDATE:
+        return 6;
+    case F374_ANNOTATION:
+        if (event->a > UINT32_MAX || event->d > UINT32_MAX) return 0;
+        f372_le32(out + 6, (uint32_t)event->a);
+        f372_le32(out + 10, (uint32_t)event->d);
+        return 14;
+    case F374_FRAME_INFO:
+    case F374_HITCH:
+        if (event->a > UINT32_MAX) return 0;
+        f372_le32(out + 6, (uint32_t)event->a);
+        f374_le64(out + 10, event->b);
+        f374_le64(out + 18, event->c);
+        f374_le64(out + 26, event->d);
+        return 34;
+    case F374_RENDER_TIME:
+        f374_le64(out + 6, event->a);
+        return 14;
+    default:
+        return 0;
+    }
+}
+
+#endif
