+static inline bool
+f377_pack_copy(uint8_t out[F377_COPY_ROW], uint64_t base, uint64_t attempt,
+    uint64_t begin, uint64_t stores, uint64_t end, uint64_t runtime)
+{
+    if (!attempt || attempt > UINT16_MAX || begin < base || stores < begin ||
+        end < stores || end - base > UINT32_MAX || runtime > UINT32_MAX) {
+        return false;
+    }
+    out[0] = (uint8_t)attempt;
+    out[1] = (uint8_t)(attempt >> 8);
+    f372_le32(out + 2, (uint32_t)(begin - base));
+    f372_le32(out + 6, (uint32_t)(stores - begin));
+    f372_le32(out + 10, (uint32_t)(end - stores));
+    f372_le32(out + 14, (uint32_t)runtime);
+    return true;
+}
+
