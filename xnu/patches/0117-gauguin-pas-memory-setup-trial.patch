+/* Private two-operation engine: no caller can choose a function or PA here.
+ * Each stage gets its own bounded5s transaction and fresh10s entry budget. */
+static enum gpi_rc gpi_transaction(bool memory, struct gpi_receipt *receipt)
+{
+    const char *prefix = memory ? "SWEET PAS MEM" : "SWEET PAS INIT";
+    uint64_t deadline;
+    clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+    for (unsigned fresh = 0; fresh < GPI_BUSY_ATTEMPTS; ++fresh) {
+        struct gpi_registers r = {{memory ? GPM_FUNCTION : GPI_FUNCTION,
+            memory ? GPM_ARGINFO : GPI_ARGINFO, GPI_PAS_ID, receipt->stage_pa,
+            memory ? GPM_REGION_BYTES : 0, 0, 0}};
+        char line[192];
+        if (memory) {
+            snprintf(line, sizeof(line), "SWEET PAS MEM: before fresh=%u fn=42000202 arginfo=3 pas=13 pa=%016llx bytes=4096; retained until reset, software timeout cannot cancel SMC",
+                fresh + 1u, (unsigned long long)receipt->stage_pa);
+        } else {
+            snprintf(line, sizeof(line), "SWEET PAS INIT: before fresh=%u fn=42000201 arginfo=82 pas=13 pa=%016llx; SCM_RW retained, software timeout cannot cancel SMC",
+                fresh + 1u, (unsigned long long)receipt->stage_pa);
+        }
+        gpi_record(line);
+        bool first_call = true;
+        for (;;) {
+            /* After every synchronous pre-call log, and before each tight
+             * continuation: fresh read-only budgets, no intervening UFS/sleep. */
+            enum gpi_rc guard = gpi_guard(deadline, receipt->smc_calls == 0 ? GPI_INITIAL_BUDGET : GPI_CALL_BUDGET, memory);
+            if (guard != GPI_OK) {
+                if (!first_call) gpi_raw(prefix, receipt);
+                return guard;
+            }
+            if (first_call) ++receipt->fresh_attempts;
+            else ++receipt->continuations;
+            ++receipt->smc_calls;
+            __asm__ volatile("dsb sy" ::: "memory");
+            gpi_invoke(&r);
+            receipt->returned = r; receipt->has_returned = 1;
+            if (r.x[0] != UINT64_C(1)) break;
+            if (receipt->continuations == GPI_CONTINUATIONS) {
+                gpi_raw(prefix, receipt);
+                return GPI_CONTINUATION_LIMIT;
+            }
+            first_call = false;
+        }
+        /* The continuation chain ended. Only now may synchronous logs run. */
+        gpi_raw(prefix, receipt);
+        enum gpi_rc guard = gpi_guard(deadline, GPI_CALL_BUDGET, memory);
+        if (guard != GPI_OK) return guard;
+        if ((int32_t)r.x[0] == -12) {
+            if (fresh + 1u == GPI_BUSY_ATTEMPTS) return GPI_BUSY_LIMIT;
+            IOSleep(30); /* fresh native BUSY retry, not continuation */
+            continue;
+        }
+        if (r.x[0] != 0) return GPI_TRANSPORT;
+        if (r.x[1] != 0) return GPI_SERVICE;
+        return GPI_OK;
+    }
+    return GPI_BUSY_LIMIT;
+}
