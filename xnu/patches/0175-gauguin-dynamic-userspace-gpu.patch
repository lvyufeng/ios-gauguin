+IOReturn GauguinGPUUserClient::submit(struct ggr_submit *r)
+{
+    if((r->flags&~UINT32_C(0x80000010))||(r->flags&0x1f)!=0x10||r->fence||
+       !r->nr_bos||r->nr_bos>GGR_MAX_BUFFERS||!r->nr_cmds||r->nr_cmds>GGR_MAX_COMMANDS||
+       (r->queueid&&r->queueid!=fQueue)||r->in_syncobjs||r->out_syncobjs||r->nr_in_syncobjs||
+       r->nr_out_syncobjs||r->syncobj_stride||r->pad||r->fence_fd!=-1||
+       !ggr_user_span(r->bos,(uint64_t)r->nr_bos*sizeof(struct ggr_submit_bo))||
+       !ggr_user_span(r->cmds,(uint64_t)r->nr_cmds*sizeof(struct ggr_submit_cmd)))return kIOReturnBadArgument;
+    auto bos=IONew(struct ggr_submit_bo,r->nr_bos);
+    auto cmds=IONew(struct ggr_submit_cmd,r->nr_cmds);
+    IOReturn result=kIOReturnBadArgument;
+    if(!bos||!cmds){result=kIOReturnNoMemory;goto out;}
+    if(copyin(r->bos,bos,r->nr_bos*sizeof(*bos))||copyin(r->cmds,cmds,r->nr_cmds*sizeof(*cmds))) {
+        result=kIOReturnVMError;goto out;
+    }
+    {
+        uint64_t addresses[GGR_MAX_COMMANDS];uint32_t words[GGR_MAX_COMMANDS];
+        for(uint32_t i=0;i<r->nr_bos;i++) {
+            gpu_buffer *b=find(bos[i].handle);
+            if(!b||!bos[i].flags||(bos[i].flags&~3u)||
+               ((bos[i].flags&2)&&(b->flags&GGR_BO_READONLY))||
+               (bos[i].presumed&&bos[i].presumed!=b->address))goto out;
+            for(uint32_t j=0;j<i;j++)if(bos[j].handle==bos[i].handle)goto out;
+        }
+        for(uint32_t i=0;i<r->nr_cmds;i++) {
+            if(cmds[i].submit_idx>=r->nr_bos)goto out;
+            gpu_buffer *b=find(bos[cmds[i].submit_idx].handle);
+            if(!(bos[cmds[i].submit_idx].flags&1)||!ggr_command_range(cmds+i,b->size))goto out;
+            addresses[i]=b->address+cmds[i].submit_offset;words[i]=cmds[i].size/4;
+        }
+        /* Validate ALL requests before changing any surface state or ringing
+         * a doorbell. Descriptor arrays are kernel copies, not reread later. */
+        for(uint32_t i=0;i<r->nr_bos;i++) {
+            gpu_buffer *b=find(bos[i].handle);
+            if(b->surface) {
+                uintptr_t ptr=b->surface->kernelAddress();
+                if(!ptr)goto out;
+            }
+        }
+        for(uint32_t i=0;i<r->nr_bos;i++) {
+            gpu_buffer *b=find(bos[i].handle);
+            if(b->surface) {
+                b->surface->gpuState=1;
+                flush_dcache64(b->surface->kernelAddress(),(unsigned)b->size,0);
+            }
+        }
+        memoryBarrier();uint32_t fence=0;
+        bool ok=sweet_gpu_runtime_submit(addresses,words,r->nr_cmds,&fence);
+        for(uint32_t i=0;i<r->nr_bos;i++) {
+            gpu_buffer *b=find(bos[i].handle);
+            if(b->surface) {
+                if(ok)flush_dcache64(b->surface->kernelAddress(),(unsigned)b->size,0);
+                b->surface->gpuState=ok?0:2;
+            }
+        }
+        memoryBarrier();
+        if(ok){r->fence=fence;fLastFence=fence;result=kIOReturnSuccess;}
+        else result=kIOReturnTimeout;
+    }
+out:
+    if(bos)IODelete(bos,struct ggr_submit_bo,r->nr_bos);
+    if(cmds)IODelete(cmds,struct ggr_submit_cmd,r->nr_cmds);
+    return result;
+}
