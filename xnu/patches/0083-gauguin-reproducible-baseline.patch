+	 * The waitq handed in is &port->ip_waitq, which shares storage with
+	 * &port->ip_messages.imq_waitq (union in ipc_port.h), so the owning port
+	 * is recoverable. From there ip_receiver -> is_task gives the *receiving*
+	 * task: who the process is waiting for, which the thread dump could not
+	 * answer (NOTES (53)).
+	 *
+	 * ip_receiver is a signed pointer, so a bogus port traps. The kotype
+	 * check keeps a wrong guess from taking the machine down.
+	 */
+	{
+		ipc_port_t port = (ipc_port_t)((char *)waitq -
+		    offsetof(struct ipc_port, ip_waitq));
+		const char *owner = "?";
+
+		/*
+		 * No kotype check: a message queue port is not a kobject, so
+		 * ip_kotype() would reject the very ports we want. ip_receiver is a
+		 * signed pointer and the only field read through it, so a bogus
+		 * port still has to be excluded - the null tests below do that for
+		 * the common case, and the pointer signing turns the rest into a
+		 * panic rather than a wrong answer.
+		 */
+		{
+			ipc_space_t space = port->ip_receiver;
+			if (space != IPC_SPACE_NULL && space->is_task != TASK_NULL) {
+				extern void *get_bsdtask_info(task_t);
+				extern char *proc_name_address(void *p);
+				void *p = get_bsdtask_info(space->is_task);
+				if (p != NULL) {
+					char *nm = proc_name_address(p);
+					if (nm != NULL && nm[0] != '\0') {
+						owner = nm;
+					}
+				}
+			}
+		}
+		/*
+		 * Also name ip_destination. ip_receiver says who owns the port the
+		 * wait is on; ip_destination is the port's server side, so a
+		 * different name there means this is a service somebody else
+		 * provides and SpringBoard is waiting to be called - a completely
+		 * different situation from idling on its own dispatch queues
+		 * (NOTES (86)).
+		 */
+		{
+			const char *downer = "none";
+			ipc_port_t dest = port->ip_destination;
+			if (dest != IPC_PORT_NULL && dest != port) {
+				ipc_space_t ds = dest->ip_receiver;
+				if (ds != IPC_SPACE_NULL && ds->is_task != TASK_NULL) {
+					extern void *get_bsdtask_info(task_t);
+					extern char *proc_name_address(void *p);
+					void *dp = get_bsdtask_info(ds->is_task);
+					if (dp != NULL) {
+						char *dn = proc_name_address(dp);
+						if (dn != NULL && dn[0] != '\0') {
+							downer = dn;
+						}
+					}
+				}
+			}
+			printf("SWEET MSGWAIT: %s port=%p owner=%s dest=%s type=%u\n", procname,
+			    (void *)waitq, owner, downer,
+			    (unsigned)waitq_type((waitq_t){ .wq_q = waitq }));
+		}
+	}
+}
