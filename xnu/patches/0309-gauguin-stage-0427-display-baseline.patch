+static void cpu402_write(void *cookie, unsigned offset, uint32_t value)
+{
+    volatile uint32_t *regs = cookie;
+    assert(offset == CPU402_PERF_STATE);
+    (void)offset;
+    regs[CPU402_PERF_STATE / sizeof(uint32_t)] = value;
+    __asm__ volatile("dsb osh" ::: "memory");
