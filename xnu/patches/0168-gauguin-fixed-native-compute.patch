+    c->diagnostic=(struct ggk_diagnostic){1,1,(mem==GGK_SCRATCH?0x10000u:mem==GGK_DATA?0x20000u:mem==GGK_IB?0x30000u:mem==GGK_PROGRAM?0x40000u:mem==GGK_IBO?0x50000u:0u)+off,0,*v};
