+/* SPDX-License-Identifier: MIT
+ * Kernel-to-kernel full-frame input API. No user pointer or wire protocol.
+ */
+#ifndef SWEET_HID_TOUCH_FRAME_H
+#define SWEET_HID_TOUCH_FRAME_H
+#include <stdint.h>
+#define SWEET_HID_TOUCH_CONTACTS 10
+struct sweet_hid_touch_snapshot {
+    uint32_t active_mask; /* NVT ID1..10 maps tobit(ID-1), using bits0..9 only. */
+    int32_t x[SWEET_HID_TOUCH_CONTACTS];
+    int32_t y[SWEET_HID_TOUCH_CONTACTS];
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+void sweet_hid_touch(int finger, int down, int x, int y);
+/* Physical panel pixels, clamped to0..1079/2399, not logical iPhone coordinates.
+ * Inactive coordinates are ignored; releases use the last position.
+ * Caller owns stable input for this call. Requires a sleepable thread context.
+ * Returns an IOReturn value. Success includes an unchanged/no-dispatch frame.
+ * Callback reentry returns Busy without consuming the frame. No synthetic input.
+ */
+int sweet_hid_touch_frame(const struct sweet_hid_touch_snapshot *snapshot);
+#ifdef __cplusplus
+}
+#endif
+#endif
