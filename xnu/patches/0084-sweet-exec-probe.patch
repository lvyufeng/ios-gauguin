diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
index 67c5f79..2bc0b2b 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -2510,6 +2510,143 @@ task_clear_corpse(task_t task)
 	task_unlock(task);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET bring-up probe, minimal and safe: named processes are reported once at
+ * exec with their thread count. Walking the thread list from the exec path
+ * hung the boot twice (NOTES 15:28, 15:52) - the exec thread owns that queue
+ * while it runs, so only scalars are read here.
+ */
+static char sweet_dump_names[64];
+static bool sweet_dump_parsed;
+static unsigned sweet_dump_count;
+
+static task_t sweet_later_task = TASK_NULL;
+static char sweet_later_name[48];
+static unsigned sweet_dump_round;
+static unsigned sweet_dump_wait_execs;
+static unsigned sweet_dump_now_tick;
+static unsigned sweet_dump_target_tick;
+
+/* Print one task's threads (scalars only; no task lock is taken). */
+static void
+sweet_dump_walk(task_t task, const char *why)
+{
+	thread_t th;
+	unsigned n = 0;
+
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (n++ >= 64) {
+			break;
+		}
+		printf("SWEET THREADS: %s tid=%llu run=%d state=%x ev=%llu wq=%p\n", why,
+		    (unsigned long long)th->thread_id,
+		    (th->state & TH_RUN) ? 1 : 0, th->state,
+		    (unsigned long long)th->wait_event, th->waitq);
+	}
+	if (n == 0) {
+		printf("SWEET THREADS: %s has no threads\n", why);
+	}
+}
+
+/* Called once per second from the watchdog thread (known-good context). */
+void
+sweet_dump_tick(void)
+{
+	sweet_dump_now_tick++;
+	if (sweet_later_task == TASK_NULL || sweet_dump_target_tick == 0 ||
+	    sweet_dump_now_tick < sweet_dump_target_tick) {
+		return;
+	}
+	sweet_dump_target_tick = 0;
+	task_t task = sweet_later_task;
+	sweet_later_task = TASK_NULL;
+	printf("SWEET THREADS: %s now, threads=%d\n", sweet_later_name,
+	    task->thread_count);
+	sweet_dump_walk(task, sweet_later_name);
+	task_deallocate(task);
+}
+
+void
+sweet_dump_threads_soon(task_t task, const char *name)
+{
+	if (!sweet_dump_parsed) {
+		sweet_dump_parsed = true;
+		if (!PE_parse_boot_argn("sweetdump", sweet_dump_names,
+		    sizeof(sweet_dump_names))) {
+			sweet_dump_names[0] = '\0';
+		}
+	}
+	if (sweet_dump_names[0] == '\0' || task == TASK_NULL ||
+	    sweet_dump_count >= 16) {
+		return;
+	}
+	if (sweet_later_task != TASK_NULL && sweet_dump_wait_execs > 0) {
+		sweet_dump_wait_execs--;
+		return;
+	}
+	/*
+	 * If a target is pending from an earlier exec, dump it now: the exec path
+	 * is a context where walking a *different* task's threads has been shown
+	 * to work, and it happens ~260 more times during boot (NOTES 16:32). The
+	 * watchdog cannot be used for this - its callback runs once per boot.
+	 */
+	if (sweet_later_task != TASK_NULL) {
+		task_t pending = sweet_later_task;
+		sweet_later_task = TASK_NULL;
+		sweet_dump_round++;
+		printf("SWEET THREADS: %s sample %u, threads=%d (at %s exec)\n",
+		    sweet_later_name, sweet_dump_round, pending->thread_count, name);
+		sweet_dump_walk(pending, sweet_later_name);
+		/* Sample again a fixed number of execs later, up to 4 samples. */
+		if (sweet_dump_round < 4) {
+			sweet_later_task = pending;
+			strlcpy(sweet_later_name, name, sizeof(sweet_later_name));
+			sweet_dump_wait_execs = sweet_dump_round == 1 ? 20 :
+			    sweet_dump_round == 2 ? 100 : 260;
+		} else {
+			task_deallocate(pending);
+		}
+		return;
+	}
+	const char *t = sweet_dump_names;
+	bool match = false;
+	while (*t) {
+		const char *end = strchr(t, ',');
+		size_t len = end ? (size_t)(end - t) : strlen(t);
+		if (len == strlen(name) && strncmp(t, name, len) == 0) {
+			match = true;
+			break;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	if (!match) {
+		return;
+	}
+	sweet_dump_count++;
+	printf("SWEET THREADS: %s exec, threads=%d\n", name, task->thread_count);
+	/*
+	 * The interesting state is seconds later. A thread call queued here did
+	 * not fire (NOTES 16:21), so the dump is driven from the watchdog's 1 Hz
+	 * sample instead: osfmk/kern/task.c exposes sweet_dump_tick(), which the
+	 * SweetWatchdog thread calls, and that path is a normal blocking-context
+	 * thread call that is known to work.
+	 */
+	if (sweet_later_task == TASK_NULL) {
+		task_reference(task);
+		sweet_later_task = task;
+		strlcpy(sweet_later_name, name, sizeof(sweet_later_name));
+		sweet_dump_target_tick = sweet_dump_now_tick + 20;
+		printf("SWEET THREADS: %s will be dumped at tick %u\n", name,
+		    sweet_dump_target_tick);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+
