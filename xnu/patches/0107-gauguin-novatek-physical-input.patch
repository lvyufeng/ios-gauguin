+#ifndef GAUGUIN_NVT_BOOTSTRAP_H
+#define GAUGUIN_NVT_BOOTSTRAP_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "../nvt_protocol.h"
+
+#define NBS_FIRMWARE_BYTES 139264u
+#define NBS_FIRMWARE_SHA256 "007143e7d0a816e4ef228b5a08bf3132285230a5cd16164e8086696115d60f88"
+#define NBS_WRITE_WIRE_MAX 64u
+#define NBS_EXPECTED_PID 0x5937u /* observed recovery project ID, not a response sentinel */
+
+enum nbs_status {
+    NBS_OK = 0, NBS_ARGUMENT = -1, NBS_ALREADY_USED = -2,
+    NBS_FIRMWARE = -3, NBS_TRANSPORT = -4, NBS_RESET_IO = -5,
+    NBS_IDENTITY = -6, NBS_READBACK = -7, NBS_CRC = -8,
+    NBS_TIMEOUT = -9, NBS_CLOCK = -10, NBS_FWINFO = -11
+};
+enum nbs_phase {
+    NBS_VALIDATE, NBS_RESET_LOW, NBS_ENG_RESET, NBS_RESET_HIGH,
+    NBS_IDENTIFY_RESET, NBS_TRIM, NBS_LOAD_RESET, NBS_CRC_BASELINE,
+    NBS_UPLOAD, NBS_SRAM_READBACK, NBS_CRC_BANKS, NBS_CRC_ENABLE,
+    NBS_FW_CRC_ENABLE, NBS_BOOT_READY, NBS_WAIT_READY,
+    NBS_CRC_RESULT, NBS_READ_FWINFO, NBS_READ_PID, NBS_READY
+};
+enum nbs_valid {
+    NBS_VALID_TRIM = 1u << 0, NBS_VALID_CRC_BEFORE = 1u << 1,
+    NBS_VALID_CRC_STATUS = 1u << 2, NBS_VALID_RESET_STATE = 1u << 3,
+    NBS_VALID_ILM_CRC = 1u << 4, NBS_VALID_DLM_CRC = 1u << 5,
+    NBS_VALID_ILM_GOLDEN = 1u << 6, NBS_VALID_DLM_GOLDEN = 1u << 7,
+    NBS_VALID_FWINFO = 1u << 8, NBS_VALID_PID = 1u << 9,
+    NBS_VALID_ELAPSED = 1u << 10, NBS_VALID_RESET_PIN = 1u << 11
+};
+struct nbs_io {
+    void *cookie;
+    /* Exact raw full-duplex length. Zero means the whole transaction completed;
+     * read data includes undefined RX0/RX1. No implicit dummy/mask/retry here. */
+    int (*xfer)(void *, const uint8_t *tx, uint8_t *rx, size_t wire_length);
+    /* Drive/readback the already-owned GPIO21. false=LOW, true=HIGH. */
+    int (*reset)(void *, bool high);
+    void (*delay_ms)(void *, unsigned milliseconds);
+    uint64_t (*now_us)(void *); /* monotonic microseconds */
+    void (*progress)(void *, enum nbs_phase, uint32_t completed, uint32_t total);
+};
+struct nbs_report {
+    enum nbs_phase phase;
+    int result, callback_error;
+    /* Flags identify last successfully read/decoded fields, not current state
+     * after a later failure. Unflagged zero fields are NOT observations. Byte
+     * and transfer counters are software progress/attempt counts from zero. */
+    uint32_t valid;
+    bool hardware_touched, reset_raised, trim_verified, ready, quarantine;
+    uint32_t bytes_written, bytes_verified, transfers;
+    uint8_t trim[6], crc_before, crc_status, hw_crc;
+    uint32_t event_base;
+    uint32_t ilm_crc, dlm_crc, ilm_golden, dlm_golden;
+    struct nvt_reset_info reset_state;
+    struct nvt_fw_info fwinfo;
+    uint16_t pid; /* Actual decoded PID; READY requires NBS_EXPECTED_PID. */
+    uint64_t elapsed_us;
+};
+struct nbs_session { bool attempted; struct nbs_report report; };
+
+/* Zero-initialize session once; a second call is refused with no IO. Caller
+ * must verify the exact SHA256/size above BEFORE acquiring the configured bus,
+ * retain immutable firmware bytes, and own the same bus/GPIO lease throughout.
+ * Entry bus is configured and GPIO21 LOW. This function is the sole allowed
+ * ENG_RESET SPI exception while LOW; it then drives HIGH and identifies the chip
+ * before any SRAM upload. No automatic retry, HID/input dispatch or cleanup IO.
+ * On any failure after hardware_touched, quarantine=true: caller must isolate
+ * and must not issue further SPI. Success leaves the bus lease held and event
+ * page selected for the caller's later protocol reads. READY means observed
+ * chip/CRC/reset/FWINFO/readback gates passed, not a successful touch gesture.
+ */
+int nbs_bootstrap(struct nbs_session *, const struct nbs_io *, const uint8_t *firmware, size_t bytes);
+#endif
