+#include <pexpert/arm64/boot.h>
+#include <libkern/crypto/sha2.h>
+#include "gauguin_gpu_sqe_asset.h"
+extern unsigned long gPhysBase,real_phys_size;
+extern vm_offset_t arm_vm_kernelcache_phys_end;
+static const uint8_t gsa_expected[32]={
+    0xa0,0xe1,0xb5,0x83,0xf6,0x20,0xfa,0xbe,0x32,0x72,0x9c,0xe3,0x67,0x95,0x9d,0x19,
+    0x60,0x63,0x86,0x63,0x24,0x4d,0x7d,0x0c,0xfc,0x21,0xb9,0xa5,0x21,0x5a,0x01,0x8b
+};
+static bool gsa_range(const boot_args *a,uint64_t pa,uint64_t bytes)
+{
+    return pa&&!(pa&0x3fff)&&pa>=arm_vm_kernelcache_phys_end&&
+        pa<a->topOfKernelData&&bytes<=a->topOfKernelData-pa&&
+        bytes<=a->physBase+a->memSize-pa;
+}
+bool sweet_gpu_sqe_asset_view(struct gsa_view *out)
+{
+    if(!out)return false;
+    const boot_args *a=PE_state.bootArgs;
+    DTEntry node;const void *property=NULL;unsigned length=0;uint64_t range[2];
+    if(!a||a->Version!=kBootArgsVersion2||a->physBase!=gPhysBase||!real_phys_size||
+       !a->memSize||a->memSize>real_phys_size||a->physBase>UINT64_MAX-real_phys_size||
+       (a->topOfKernelData&0x3fff)||a->topOfKernelData<a->physBase||
+       a->topOfKernelData>a->physBase+a->memSize||arm_vm_kernelcache_phys_end<a->physBase||
+       arm_vm_kernelcache_phys_end>a->topOfKernelData||
+       SecureDTLookupEntry(NULL,"/chosen/memory-map",&node)!=kSuccess||
+       SecureDTGetProperty(node,"A630SQEFirmware",&property,&length)!=kSuccess||
+       !property||length!=sizeof(range))return false;
+    memcpy(range,property,sizeof(range));uint64_t pa=range[0];
+    if(range[1]!=GSA_ASSET_BYTES||!gsa_range(a,pa,GSA_RESERVED_BYTES))return false;
+    static const char *const names[]={"NovatekFirmware","A615ZapMDT","A619GMUFirmware"};
+    static const uint64_t raw[]={139264,16384,32768},reserved[]={147456,16384,32768};
+    uint64_t old_pa[3];
+    for(unsigned i=0;i<3;i++){
+        property=NULL;length=0;
+        if(SecureDTGetProperty(node,names[i],&property,&length)!=kSuccess||
+           !property||length!=sizeof(range))return false;
+        memcpy(range,property,sizeof(range));old_pa[i]=range[0];
+        if(range[1]!=raw[i]||!gsa_range(a,range[0],reserved[i])||
+           (pa<range[0]+reserved[i]&&range[0]<pa+GSA_RESERVED_BYTES))return false;
+        for(unsigned j=0;j<i;j++)
+            if(range[0]<old_pa[j]+reserved[j]&&old_pa[j]<range[0]+reserved[i])return false;
+    }
+    vm_offset_t first=ml_static_ptovirt((vm_offset_t)pa);
+    if(!first||first>UINTPTR_MAX-(GSA_RESERVED_BYTES-1)||
+       ml_static_ptovirt((vm_offset_t)(pa+GSA_RESERVED_BYTES-1))!=first+GSA_RESERVED_BYTES-1)return false;
+    const uint8_t *data=(const uint8_t *)first;
+    for(unsigned i=GSA_ASSET_BYTES;i<GSA_RESERVED_BYTES;i++)if(data[i])return false;
+    uint8_t digest[32];SHA256_CTX ctx;
+    SHA256_Init(&ctx);SHA256_Update(&ctx,data,GSA_ASSET_BYTES);SHA256_Final(digest,&ctx);
+    if(memcmp(digest,gsa_expected,sizeof(digest)))return false;
+    *out=(struct gsa_view){data,pa,GSA_ASSET_BYTES};return true;
+}
