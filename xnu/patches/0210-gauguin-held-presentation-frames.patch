+
+/* Destination is empty, source owns the entire handoff. Caller holds fLock. */
+static void
+sweet_fb_frame_move(struct sweet_fb_frame *to, struct sweet_fb_frame *from)
+{
+    *to = *from;
+    bzero(from, sizeof(*from));
+}
+
+static bool
+sweet_fb_frame_prepare(struct sweet_fb_frame *frame, const uint8_t *rec,
+    IOMobileFramebufferUserClient *owner)
+{
+    bzero(frame, sizeof(*frame));
+    uint32_t mask = get32(rec, 0x104);
+    if (owner == NULL || (mask & ~((1u << SWEET_FB_LAYERS) - 1u))) return false;
+    memcpy(frame->record, rec, SWEET_FB_SWAP_REC_SIZE);
+    for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+        uint32_t id = get32(rec, 0x54 + 4 * layer);
+        if (!(mask & (1u << layer)) || id == 0) continue;
+        frame->surfaces[layer] = sweet_surface_hold(id);
+        if (frame->surfaces[layer] == NULL) {
+            sweet_fb_frame_release(frame);
+            return false;
+        }
+    }
+    frame->owner = owner;
+    return true;
+}
+
+/* Return the same retained-object contract as the old lookup. Held frames
+ * never resolve an ID again; their table use lives through the whole copy. */
+static SweetSurface *
+sweet_fb_present_surface(const uint8_t *rec, SweetSurface *const *held, uint32_t layer)
+{
+    if (layer >= SWEET_FB_LAYERS) return NULL;
+    uint32_t id = get32(rec, 0x54 + 4 * layer);
+    if (!(get32(rec, 0x104) & (1u << layer)) || id == 0) return NULL;
+    if (held == NULL) return sweet_surface_copy(id);
+    SweetSurface *s = held[layer];
+    if (s == NULL || s->id != id) return NULL;
+    s->retain();
+    return s;
+}
+
+bool
+AppleCLCD::takeHeldFrameLocked(struct sweet_fb_frame *frame)
+{
+    if (!fHoldPresent || !fDirty || fHeldActive || fHeldPending.owner == NULL) return false;
+    sweet_fb_frame_move(frame, &fHeldPending);
+    fDirty = false;
+    fHeldActive = true;
+    fHeldConsumed++;
+    return true;
+}
+
+void
+AppleCLCD::cancelHeldFrameLocked(struct sweet_fb_frame *frame, IOMobileFramebufferUserClient *owner)
+{
+    if (fHoldPresent && fHeldPending.owner != NULL &&
+        (owner == NULL || fHeldPending.owner == owner)) {
+        sweet_fb_frame_move(frame, &fHeldPending);
+        fDirty = false;
+        fHeldCanceled++;
+    }
+}
+
+void
+AppleCLCD::finishHeldFrame(struct sweet_fb_frame *frame)
+{
+    bool consumed = frame->owner != NULL;
+    sweet_fb_frame_release(frame);  /* after GPURead and the copy, before another frame */
+    if (consumed) {
+        IOLockLock(fLock);
+        fHeldActive = false;
+        fHeldRetired++;
+        IOLockUnlock(fLock);
+    }
+}
