+_Static_assert(SEQUENCE172_JOBS==GGJ_JOBS&&SEQUENCE172_BLOBS==GGJ_BLOBS,"native profiles");
+_Static_assert(SEQUENCE172_RING_BASE==0xfc008000u&&SEQUENCE172_RING_BYTES==32768u,"native ring");
+_Static_assert(SEQUENCE172_MAIN_IOVA==SEQUENCE172_RING_BASE+GGJ_IB_OFFSET,"native IB");
+_Static_assert(SEQUENCE172_TARGET_IOVA==GGD_DATA_IOVA&&SEQUENCE172_CONTROL_IOVA==GGD_DATA_IOVA+GGJ_EOP_OFFSET,"native DATA");
+static bool span(const void *p,size_t n)
