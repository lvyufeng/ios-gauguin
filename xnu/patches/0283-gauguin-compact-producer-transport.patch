--- /dev/null
+++ b/bsd/dev/gauguin_frame372_wire.h
@@ -0,0 +1,58 @@
+#ifndef GAUGUIN_FRAME372_WIRE_H
+#define GAUGUIN_FRAME372_WIRE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+    F372_PAIR_CAP = 10240, F372_BLOCK = 64, F372_ROW = 20,
+    F372_THREAD_CAP = 256, F372_MISS_CAP = 64
+};
+
+static inline void
+f372_le32(uint8_t *out, uint32_t value)
+{
+    for (unsigned i = 0; i < 4; ++i) {
+        out[i] = (uint8_t)(value >> (8 * i));
+    }
+}
+
+static inline bool
+f372_pack_pair(uint8_t out[F372_ROW], uint64_t base, uint32_t serial, uint32_t message,
+    uint64_t send, uint64_t post, uint64_t copyout, uint8_t source, uint8_t receiver)
+{
+    if (!serial || serial > UINT16_MAX || send < base || post < send ||
+        copyout < post || copyout - base > UINT32_MAX) {
+        return false;
+    }
+    out[0] = (uint8_t)serial;
+    out[1] = (uint8_t)(serial >> 8);
+    f372_le32(out + 2, message);
+    f372_le32(out + 6, (uint32_t)(send - base));
+    f372_le32(out + 10, (uint32_t)(post - send));
+    f372_le32(out + 14, (uint32_t)(copyout - send));
+    out[18] = source;
+    out[19] = receiver;
+    return true;
+}
+
+static inline unsigned
+f372_base64(const uint8_t *in, unsigned count, char *out)
+{
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    unsigned length = 0;
+    for (unsigned i = 0; i < count; i += 3) {
+        unsigned left = count - i;
+        uint32_t bits = (uint32_t)in[i] << 16;
+        if (left > 1) bits |= (uint32_t)in[i + 1] << 8;
+        if (left > 2) bits |= in[i + 2];
+        out[length++] = alphabet[(bits >> 18) & 63];
+        out[length++] = alphabet[(bits >> 12) & 63];
+        out[length++] = left > 1 ? alphabet[(bits >> 6) & 63] : '=';
+        out[length++] = left > 2 ? alphabet[bits & 63] : '=';
+    }
+    out[length] = '\0';
+    return length;
+}
+
+#endif
