+/* HM_CALLBACK_SCOPE_BEGIN: shared verbatim with the actual-method host test. */
+struct hm_callback_scope {
+    const void *buffer;
+    struct hm_callback_scope *previous;
+};
+static _Thread_local struct hm_callback_scope *hm_active_callback;
+static BOOL
+hm_inside_callback(id buffer)
+{
+    for (struct hm_callback_scope *scope = hm_active_callback; scope != NULL; scope = scope->previous) {
+        if (scope->buffer == (const void *)buffer) return YES;
+    }
+    return NO;
+}
