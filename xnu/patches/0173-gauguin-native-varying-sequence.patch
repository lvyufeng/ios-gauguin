+static bool pixel_bounds(unsigned job,unsigned index,uint32_t *lo,uint32_t *hi,uint32_t *preferred)
+{
+    if(job>=GGV_JOBS||index>=GGV_OUTPUT_WORDS)return false;
+    unsigned x=index%16u,y=index/16u;
+    if(job==1){unsigned t=x;x=y;y=t;}
