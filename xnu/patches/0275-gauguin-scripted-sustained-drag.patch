+static void
+sweet_motion_arm(void)
+{
+	clock_interval_to_deadline(SWEET_MOTION_WAIT_MS, NSEC_PER_MSEC, &sweet_motion_due);
+	clock_interval_to_deadline(SWEET_MOTION_WAIT_MS + SWEET_MOTION_LIMIT_MS,
+	    NSEC_PER_MSEC, &sweet_motion_limit);
+	sweet_motion_armed = true;
+	printf("SWEET M362: armed due=%llu limit=%llu reports=%u\n",
+	    (unsigned long long)sweet_motion_due, (unsigned long long)sweet_motion_limit,
+	    SWEET_MOTION_REPORTS);
+	thread_call_enter_delayed(sweet_script_call, sweet_motion_due);
+}
+
+static void
+sweet_motion_abort(void)
+{
+	sweet_motion_armed = false;
+	int rc = 0;
+	if (sweet_motion_step) {
+		struct sweet_hid_touch_snapshot release = {0};
+		rc = sweet_hid_touch_frame(&release);
