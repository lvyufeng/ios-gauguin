+void
+AppleCLCD::observeSwapWait(IOMobileFramebufferUserClient *owner, uint64_t swapID, uint64_t timeout)
+{
+    constexpr uint32_t maxSamples = 384;
+    if (!swapID || swapID > UINT32_MAX || (swapID & 3) || !sweet_frame344_clock() ||
+        __atomic_load_n(&fSwapWaitSamples, __ATOMIC_RELAXED) >= maxSamples ||
+        __atomic_fetch_add(&fSwapWaitSamples, 1, __ATOMIC_RELAXED) >= maxSamples) return;
+    /* The diagnostic never waits for the framebuffer lock. Kind 63 reports
+     * a requested swap ID, timeout scalar, live generation and latest accept. */
+    if (!IOLockTryLock(fLock)) {
+        sweet_frame344_record(63, swapID, 5, timeout, 0, 0);
+        return;
+    }
+    const auto matches = [owner, swapID](const sweet_fb_frame &frame) {
+        return frame.owner == owner && get32(frame.record, 0x50) == swapID;
+    };
+    uint32_t state = 0;
+    uint64_t generation = 0;
+    if (matches(fHeldPending)) {
+        state = 1;
+        generation = fHeldPending.generation;
+    } else if (matches(fHeldReady)) {
+        state = 3;
+        generation = fHeldReady.generation;
+    } else if (fHeldActive && fActiveSwapOwner == owner && fActiveSwapID == swapID) {
+        state = 4;
+        generation = fHeldLastTaken;
+    } else {
+        for (const auto &frame : fHeldIssued) {
+            if (!matches(frame)) continue;
+            state = 2;
+            generation = frame.generation;
+            break;
+        }
+    }
+    sweet_frame344_record(63, swapID, state, timeout, generation, fHeldSubmitted);
+    IOLockUnlock(fLock);
 }
 
