 	}
 	printf("SWEET F377 C footer: rows=%u lost=%u\n", emitted, captured - emitted);
+}
+
+unsigned
+sweet_frame378_select(uint64_t attempt, uint64_t tick)
+{
+	if (!f375_enter()) return 0;
+	unsigned lane = tick < f374_end ? f378_probe_class(tick, f374_start, attempt) : 0;
+	if (lane) {
+		const unsigned limit = lane == F378_CONTROL ? F378_CONTROL_LIMIT : F378_SCENE_LIMIT;
+		unsigned count = __atomic_load_n(&f378_selected[lane], __ATOMIC_RELAXED);
+		while (count < limit &&
+		    !__atomic_compare_exchange_n(&f378_selected[lane], &count, count + 1, true,
+		    __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+		if (count >= limit) lane = 0;
+	}
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+	return lane;
+}
+
+void
+sweet_frame378_probe(uint64_t attempt, unsigned lane, const struct f378_probe_deltas *deltas)
+{
+	if (!lane || !f375_enter()) return;
+	const unsigned index = __atomic_fetch_add(&f378_count, 1, __ATOMIC_RELAXED);
+	if (index < F378_PROBE_CAP) {
+		f378_probes[index] = (struct f378_probe_event){attempt, lane, *deltas};
+	}
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+}
+
+static void
+f378_drain(void)
+{
+	const unsigned selected = f378_selected[F378_CONTROL] + f378_selected[F378_STROKE2] +
+	    f378_selected[F378_STROKE6];
+	const unsigned available = f378_count < F378_PROBE_CAP ? f378_count : F378_PROBE_CAP;
+	unsigned emitted = 0;
+	while (emitted < available) {
+		uint8_t packed[F378_PROBE_BLOCK * F378_PROBE_ROW_BYTES];
+		char encoded[4 * ((sizeof(packed) + 2) / 3) + 1];
+		char line[sizeof(encoded) + 64];
+		unsigned count = 0;
+		while (count < F378_PROBE_BLOCK && emitted + count < available) {
+			const struct f378_probe_event *row = &f378_probes[emitted + count];
+			if (!f378_pack_probe(packed + count * F378_PROBE_ROW_BYTES,
+			    row->attempt, row->lane, &row->deltas)) break;
+			++count;
+		}
+		if (!count) break;
+		f372_base64(packed, count * F378_PROBE_ROW_BYTES, encoded);
+		const int length = snprintf(line, sizeof(line), "\nSWEET F378 P %u %u %s\n", emitted, count, encoded);
+		if (length <= 0 || (size_t)length >= sizeof(line)) break;
+		emitted += count;
+		sweet_log_append(line, length);
+	}
+	printf("SWEET F378 F: rows=%u lost=%u control=%u stroke2=%u stroke6=%u\n",
+	    emitted, selected - emitted, f378_selected[F378_CONTROL],
+	    f378_selected[F378_STROKE2], f378_selected[F378_STROKE6]);
 }
 
