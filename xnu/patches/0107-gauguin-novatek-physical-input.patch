+        rd(s, GSS_SE, S_IRQ_STATUS, &s->report.irq_before_s)) return fail(s, GSS_OWNERSHIP);
+    for (unsigned i = 0; i < GSS_SAVED_MAX; i++) {
+        struct gss_saved *p = &s->saved[i];
+        p->offset = config[i].offset; p->mask = config[i].mask;
+        if (rd(s, GSS_SE, p->offset, &p->value)) return fail(s, GSS_OWNERSHIP);
+        s->saved_count++;
+    }
+    /* Unknown reserved packing/route bits would fail the existing PIO contract. */
+    if ((s->saved[0].value & ~15u) || (s->saved[1].value & ~15u) ||
+        (s->saved[10].value & ~0xfffffu) || (s->saved[11].value & ~0xfffffu) ||
+        (s->saved[12].value & ~0xfffffu) || (s->saved[13].value & ~0xfffffu))
+        return fail(s, GSS_PROFILE);
+    if ((result = set(s, IRQ_EN, 0)) || (result = set(s, GSI_EN, 0)) ||
+        (result = set(s, M_IRQ_EN, 0)) || (result = set(s, S_IRQ_EN, 0)) ||
+        (result = set(s, CGC_CTRL, 0x7f)) || (result = set(s, DMA_GENERAL, 15)) ||
+        (result = set(s, OUTPUT_CTRL, 0x7f))) return fail(s, result);
+    return GSS_PREPARED;
+}
+
+int gss_commit_native_defaults(struct gss_session *s)
+{
+    if (!s || !s->owner || s->state != GSS_HELD || s->saved_count != GSS_SAVED_MAX)
+        return GSS_ARGUMENT;
+    int result = qualify(s);
+    if (result) return fail(s, result);
