--- a/bsd/dev/gauguin_wdt_lease.h
+++ b/bsd/dev/gauguin_wdt_lease.h
@@ -69,7 +69,8 @@
  * lock and verify idle/EOP/fault/routes/power BEFORE calling. Serialize with
  * budget checks. Require fresh advancing counter + CPU-clock agreement, exact
  * EN3/thresholds/quiet NS IRQs and three seconds left before ONE RST1 write.
- * Check the reset counter/readbacks before moving the CPU-time epoch. Never
+ * Allow bounded read-only clock-domain acknowledgement, then check the reset
+ * counter/readbacks before moving the CPU-time epoch. Never
  * enable/disable/reprogram thresholds, sleep, retry or release DMA memory.
  * Failure permanently quarantines this lease. A concurrent quarantine cannot
  * revoke an already in-flight store; it can never be overwritten as READY.
--- a/bsd/dev/gauguin_wdt_test.c
+++ b/bsd/dev/gauguin_wdt_test.c
@@ -448,6 +448,10 @@
     uint32_t before = 0, after = 0, irq = UINT32_MAX;
     uint32_t en = 0, bark = 0, bite = 0, status = 0, reason = 1;
     uint64_t now = 0, elapsed_ns = 0, refreshed_at = 0;
+    uint64_t ack_ns = 0;
+    unsigned samples = 0, stable = 0;
+    uint32_t previous = UINT32_MAX;
+    bool acknowledged = false;
     if (__atomic_load_n(&wdt_lease_state, __ATOMIC_ACQUIRE) != WDL_READY ||
         !wdt_context() || !sweet_wdt_irq_quiet(&irq) || wdt_refresh_sequence == UINT32_MAX) {
         goto done;
@@ -485,6 +489,29 @@
         goto done;
     }
     wdt_write(WDT_RST, 1u);
+    /* The APSS counter lives in a slower clock domain: an immediately
+     * following STS read may still contain the PRE-pulse count (real177).
+     * Never replay the pulse. Wait read-only for two matching decreased
+     * samples, bounded by BOTH CPU time and count even if a clock stalls. */
+    reason = 6;
+    for (samples = 0; samples < 256; ++samples) {
+        now = mach_absolute_time();
+        if (!wdt_context() || now < refreshed_at ||
+            __atomic_load_n(&wdt_lease_state, __ATOMIC_ACQUIRE) != WDL_READY) goto done;
+        absolutetime_to_nanoseconds(now - refreshed_at, &ack_ns);
+        if (ack_ns >= UINT64_C(2000000)) goto done;
+        status = wdt_read(WDT_STS);
+        after = (status >> 1) & 0xfffffu;
+        if (after < before && after <= WDT_HZ / 4u) {
+            stable = after == previous ? stable + 1u : 1u;
+            previous = after;
+            if (stable >= 2u) { acknowledged = true; break; }
+        } else {
+            stable = 0; previous = UINT32_MAX;
+        }
+        IODelay(10);
+    }
+    if (!acknowledged) goto done;
     en = wdt_read(WDT_EN); bark = wdt_read(WDT_BARK);
     bite = wdt_read(WDT_BITE); status = wdt_read(WDT_STS);
     after = (status >> 1) & 0xfffffu;
@@ -505,8 +532,8 @@
     __atomic_store_n(&wdt_budget_busy, 0u, __ATOMIC_RELEASE);
     if (!valid) {
         char line[192];
-        snprintf(line, sizeof(line), "SWEET WDT SERVICE: failed reason=%u seq=%u before=%u after=%u dt_ns=%llu en=%x bark=%u bite=%u; no retry/disable",
-            reason, wdt_refresh_sequence, before, after, elapsed_ns, en, bark, bite);
+        snprintf(line, sizeof(line), "SWEET WDT SERVICE: failed reason=%u seq=%u before=%u after=%u dt_ns=%llu ack_ns=%llu samples=%u en=%x bark=%u bite=%u; no retry/disable",
+            reason, wdt_refresh_sequence, before, after, elapsed_ns, ack_ns, samples, en, bark, bite);
         return wdt_lease_fail(line); /* cached observations only; no diagnostic MMIO */
     }
     *out = (struct gauguin_wdt_refresh_record){refreshed_at, wdt_refresh_sequence, before, after};
