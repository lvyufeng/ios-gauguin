diff --git a/bsd/dev/gauguin_scanout345.h b/bsd/dev/gauguin_scanout345.h
--- a/bsd/dev/gauguin_scanout345.h
+++ b/bsd/dev/gauguin_scanout345.h
@@ -80,6 +80,33 @@
     return status->enable == 1 && (status->count == 0 || status->count == 3);
 }

+struct scan348_motion_lane {
+    uint32_t samples, compared_pairs, frame_changes, line_changes, line_wraps;
+};
+
+struct scan348_motion {
+    struct scan348_motion_lane zero, enabled;
+    uint32_t control, frame, line, rejected_control;
+    bool previous_valid;
+};
+
+static inline void
+scan348_sample(struct scan348_motion *motion, uint32_t control, uint32_t frame, uint32_t line)
+{
+    struct scan348_motion_lane *lane = control == 0 ? &motion->zero : &motion->enabled;
+    ++lane->samples;
+    if (motion->previous_valid && control == motion->control) {
+        ++lane->compared_pairs;
+        lane->frame_changes += frame != motion->frame;
+        lane->line_changes += line != motion->line;
+        lane->line_wraps += line < motion->line;
+    }
+    motion->control = control;
+    motion->frame = frame;
+    motion->line = line;
+    motion->previous_valid = true;
+}
