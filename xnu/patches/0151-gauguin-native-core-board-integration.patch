+    }
+    return mach_absolute_time()<ggc_deadline&&mach_absolute_time()<ggc_phase_deadline&&
+        gauguin_wdt_lease_check_budget(GMB_MIN);
+}
+static vm_offset_t ggc_address(uint32_t reg,bool write)
+{
+    if(!ggc_register_allowed(reg,write))return 0;
+    if(ggc_context.phase==GGC_BUS)return write&&reg==0x3c45?gfw_map[GMF_GBIF]+0x3114:0;
+    if(ggc_context.phase<GGC_ADDRESS||ggc_context.phase>GGC_REGLIST||!ggc_maps_ready)return 0;
+    uint32_t byte=reg*4,page=byte&~(GMB_PAGE-1);
+    for(unsigned i=0;i<10;i++){
+        uint32_t off;if(!ggc_register_page(i,&off))return 0;
+        if(off==page&&ggc_alias[i])return ggc_alias[i]+byte-page;
+    }
+    return 0;
+}
+static bool ggc_board_read32(void *cookie,uint32_t reg,uint32_t *out)
+{(void)cookie;vm_offset_t va=ggc_address(reg,false);if(!va||!out)return false;*out=gfw_load32(va);return true;}
+static bool ggc_board_write32(void *cookie,uint32_t reg,uint32_t value)
+{
+    (void)cookie;vm_offset_t va=ggc_address(reg,true);
+    if(!va||(reg==0x3c45&&(ggc_context.phase!=GGC_BUS||value)))return false;
+    gfw_store32(va,value);return true;
+}
+static bool ggc_board_start(void *cookie,struct ggx_receipt *out)
+{
+    (void)cookie;
+    if(!out||ggc_context.phase!=GGC_MMU_OOB||sweet_gpu_start_state()!=GMB_IDLE||
+       !ggc_board_guard(NULL,GGC_MMU_OOB))return false;
+    return sweet_gpu_start_once(out)==GGX_OK;
+}
+static bool ggc_device_valid(vm_offset_t va,uint64_t pa)
+{
+    ppnum_t pn=(ppnum_t)(pa>>PAGE_SHIFT);
+    return va&&!(va&(GMB_PAGE-1))&&va<=UINTPTR_MAX-(GMB_PAGE-1)&&
+        !pmap_valid_page(pn)&&(pmap_cache_attributes(pn)&255u)==7u&&
+        ml_vtophys(va)==pa&&ml_vtophys(va+GMB_PAGE-1)==pa+GMB_PAGE-1;
+}
+static bool ggc_board_open(void *cookie)
+{
+    (void)cookie;
+    if(ggc_maps_ready||ggc_created||ggc_context.phase!=GGC_MAP||ggc_register_page_count()!=10||
+       !ggc_board_guard(NULL,GGC_MAP))return false;
+    gmb_record("SWEET GPU CORE: before native core register pages; GPU OOB owned, private aliases retained");
+    for(unsigned i=0;i<10;i++){
+        uint32_t off;if(!ggc_register_page(i,&off)||!ggc_board_guard(NULL,GGC_MAP))return false;
+        uint64_t pa=UINT64_C(0x03d00000)+off;vm_offset_t va=0;
+        if(off==0)va=ggx_core;
+        else if(off==0xc000)va=gfw_map[GMF_GBIF];
+        else if(off==0x7c000)va=gmb_reset;
+        else if(off==0x8c000)va=gfw_map[GMF_AO];
+        else{
+            if(off!=0x20000&&off!=0x24000&&off!=0x28000&&off!=0x2c000&&off!=0x3c000&&off!=0x68000)return false;
+            ppnum_t pn=(ppnum_t)(pa>>PAGE_SHIFT);
+            if(pmap_valid_page(pn)||(pmap_cache_attributes(pn)&255u)!=7u||!ggc_board_guard(NULL,GGC_MAP))return false;
+            va=ml_io_map_with_prot((vm_offset_t)pa,GMB_PAGE,VM_PROT_READ|VM_PROT_WRITE);
+            /* Keep even a bad returned alias for diagnostics; never retry. */
+            ggc_alias[i]=va;++ggc_created;
+        }
+        ggc_alias[i]=va;
+        if(!ggc_device_valid(va,pa)||!ggc_board_guard(NULL,GGC_MAP))return false;
+    }
+    if(ggc_created!=6)return false;ggc_maps_ready=1;return ggc_board_guard(NULL,GGC_MAP);
+}
+static vm_offset_t ggc_reglist_address(uint32_t off)
+{
+    if(ggc_context.phase!=GGC_REGLIST||!ggc_maps_ready||(off&3)||off>=4096||!gmb_ram)return 0;
+    return gmb_ram+ggb_plan.region[GGP_REGLIST].offset-GMB_PAGE+off;
+}
+static bool ggc_reglist_read(void *cookie,uint32_t off,uint32_t *out)
+{(void)cookie;vm_offset_t va=ggc_reglist_address(off);if(!va||!out)return false;*out=gfw_load32(va);return true;}
+static bool ggc_reglist_write(void *cookie,uint32_t off,uint32_t value)
+{(void)cookie;vm_offset_t va=ggc_reglist_address(off);if(!va)return false;gfw_store32(va,value);return true;}
+static void ggc_records(bool complete)
+{
+    const struct ggc_receipt *r=complete?&ggc_work:&ggc_context.work;char line[224];
+    snprintf(line,sizeof(line),"SWEET GPU CORE: %s phase=%u rc=%u reads=%u writes=%u memory=%u/%u hwcg_skip=%u configured=%u retained=%u",complete?"complete":"partial",ggc_context.phase,ggc_result,r->reads,r->writes,r->mem_written,r->mem_compared,r->hwcg_skipped,r->configured,r->requests_retained);gmb_record(line);
+    snprintf(line,sizeof(line),"SWEET GPU CORE PAGES: ready=%u required=10 map_attempts=%u reused=%u; private Device aliases retained",ggc_maps_ready,ggc_created,ggc_maps_ready?4u:0u);gmb_record(line);
+    snprintf(line,sizeof(line),"SWEET GPU CORE RESTORE: iova=%08x pa=%016llx values=66 length=%u offset=%u bytes=544; live registers, no CP/SQE execution",ggb_plan.region[GGP_REGLIST].iova,gmb_stage.pa+ggb_plan.region[GGP_REGLIST].offset,r->list_length,r->list_offset);gmb_record(line);
+    if(complete)for(unsigned i=0;i<GGC_REGLIST_VALUES;i++){
+        snprintf(line,sizeof(line),"SWEET GPU CORE RGL: index=%u reg=%05x value=%08x",i,ggc_context.reglist[4+2*i],ggc_context.reglist[5+2*i]);gmb_record(line);
+    }
+    else if(ggc_context.diagnostic.valid){
+        snprintf(line,sizeof(line),"SWEET GPU CORE SAMPLE: phase=%u reg=%05x value=%08x; last cached sample",ggc_context.phase,ggc_context.diagnostic.reg,ggc_context.diagnostic.value);gmb_record(line);
+    }
+}
+enum ggc_result sweet_gpu_core_once(struct ggc_receipt *out)
+{
+    if(!out)return GGC_ARGUMENT;unsigned expected=GMB_IDLE;
+    if(!__atomic_compare_exchange_n(&ggc_board_lifecycle,&expected,GMB_RUNNING,false,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED))return GGC_ALREADY;
+    clock_interval_to_deadline(8,NSEC_PER_SEC,&ggc_deadline);ggc_phase_deadline=ggc_deadline;ggc_result=GGC_GUARD;
+    if(gauguin_wdt_lease_check_budget(13u*GAUGUIN_WDT_CLOCK_HZ)&&
+       ggb_sqe_requested&&ggb_sqe_loaded&&ggb_sqe_same()){
+        struct ggc_ops ops={NULL,ggc_board_guard,ggc_board_read32,ggc_board_write32,gmb_barrier,
+            ggc_board_start,ggc_board_open,ggc_reglist_read,ggc_reglist_write};
+        ggc_result=ggc_core_once(&ggc_context,&ops,&ggb_plan,&ggb_smmu,&ggc_work);
+    }
+    if(ggc_result!=GGC_OK||!ggc_board_guard(NULL,GGC_FINAL)){
+        if(ggc_result==GGC_OK)ggc_result=GGC_GUARD;
+        bool needs_quarantine=sweet_gmu_board_state()!=GMB_QUARANTINED;
+        __atomic_store_n(&ggc_board_lifecycle,GMB_QUARANTINED,__ATOMIC_RELEASE);
+        __atomic_store_n(&ggx_board_lifecycle,GMB_QUARANTINED,__ATOMIC_RELEASE);
+        __atomic_store_n(&gfw_lifecycle,GMB_QUARANTINED,__ATOMIC_RELEASE);
+        if(needs_quarantine)gmb_fail(GMB_GPU,"native live GPU core setup");
+        ggc_records(false);return ggc_result;
+    }
+    *out=ggc_work;__atomic_store_n(&ggc_board_lifecycle,GMB_READY,__ATOMIC_RELEASE);ggc_records(true);return GGC_OK;
+}
