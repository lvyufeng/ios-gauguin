+/* These isolated output markers run after the measured workload. fLock
+ * excludes a take, and fHeldActive excludes a copy already in progress. */
+unsigned
+AppleCLCD::calibrate357(unsigned step, uint32_t frame)
+{
+    IOLockLock(fLock);
+    unsigned result = 0;
+    const bool abort = step == SCAN357_ABORT;
+    const bool usable = fHoldPresent && fPhasePresent && fReadyAcrossFrames && !fHeldStopped && !fPowerOff &&
+        !fHeldActive && fPixels && fWidth == 1080 && fHeight == 2400 && fRowBytes == 4320;
+    if (step == SCAN357_PAUSE && usable && !fCalibrating) {
+        fCalibrating = true;
+        fCalibrationStep = SCAN357_PAUSE;
+        sweet_frame344_record(F357_CALIBRATION, frame, 1, 0, 0, 0);
+        result = 1;
+    } else if (step == SCAN357_RESUME || abort) {
+        result = step == SCAN357_RESUME && fCalibrating && fCalibrationStep == SCAN357_RESTORE ? 1 : 2;
+    }
+    if (usable && fCalibrating &&
+        ((step >= SCAN357_FIRST && step <= SCAN357_RESTORE && step == fCalibrationStep+1) ||
+         (abort && fCalibrationStep >= SCAN357_FIRST && fCalibrationStep < SCAN357_RESTORE))) {
+        struct scan351_position pos;
+        if (sweet_frame351_position(&pos) && (abort || pos.frame == frame) &&
+            scan357_calibration_window(&pos)) {
+            volatile uint32_t *pixel = (volatile uint32_t *)(fPixels +
+                (uint64_t)(fHeight/2)*fRowBytes + (fWidth/2)*sizeof(uint32_t));
+            const uint32_t before = *pixel;
+            if (step == SCAN357_FIRST) fCalibrationPixel = before;
+            if (before == scan357_pixel(fCalibrationPixel, fCalibrationStep)) {
+                const uint32_t value = scan357_pixel(fCalibrationPixel, step);
+                const uint64_t begin = mach_absolute_time();
+                *pixel = value;
+                __asm__ volatile("dsb sy" ::: "memory");
+                const uint32_t observed = *pixel;
+                const uint64_t end = mach_absolute_time();
+                struct scan351_position after;
+                const bool verified = observed == value && sweet_frame351_position(&after) &&
+                    pos.frame == after.frame && pos.line <= after.line && after.line < pos.end &&
+                    pos.end == after.end;
+                fCalibrationStep = abort ? SCAN357_RESTORE : step;
+                sweet_frame344_record(F357_CALIBRATION, ((uint64_t)step<<32)|pos.frame,
+                    verified, begin, end, ((uint64_t)fCalibrationPixel<<32)|observed);
+                result = verified ? 1 : 2;
+            } else {
+                result = 2;  /* Do not overwrite pixels another update owns. */
+            }
+        }
+    }
+    if (step == SCAN357_RESUME || abort) {
+        fCalibrating = false;
+        sweet_frame344_record(F357_CALIBRATION, ((uint64_t)SCAN357_RESUME<<32)|frame,
+            !abort && result==1, 0, 0, 0);
+    }
+    IOLockUnlock(fLock);
+    return result;
 }
 
