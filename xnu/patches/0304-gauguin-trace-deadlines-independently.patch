+static void frame419_drain(void)
+{
+    static bool header, footer, overflow;
+    static uint32_t wire_bytes;
+    if (footer) return;
+
+    struct gut_event batch[32];
+    struct gut_meta meta;
+    uint32_t count;
+    if (!gut_read(&timeline419, batch, 32, &count, &meta)) return;
+    if (!header) {
+        header = true;
+        printf("SWEET F419 H: count=%u reason=%u lost=%llu start=%llu end=%llu\n",
+            meta.count, meta.reason, (unsigned long long)meta.lost, (unsigned long long)meta.start,
+            (unsigned long long)meta.end);
+    }
+    for (uint32_t i = 0; i < count && !overflow; ++i) {
+        const struct gut_event *row = batch + i;
+        char line[128];
+        const int bytes = snprintf(line, sizeof(line), "\nF419E %x %llx %x %llx %x %x %llx %llx %llx\n",
+            (uint32_t)row->seq, (unsigned long long)row->tick, row->kind, (unsigned long long)row->id,
+            row->pid, row->flags, (unsigned long long)row->a, (unsigned long long)row->b,
+            (unsigned long long)row->c);
+        if (bytes <= 0 || (size_t)bytes >= sizeof(line) || (uint32_t)bytes > F419_MAX_WIRE_BYTES - wire_bytes) {
+            overflow = true;
+        } else {
+            sweet_log_append(line, bytes);
+            wire_bytes += bytes;
+        }
+    }
+    if (meta.state == GUT_DRAINED) {
+        footer = true;
+        printf("SWEET F419 F: count=%u lost=%llu bytes=%u overflow=%u\n",
+            meta.count, (unsigned long long)meta.lost, wire_bytes, overflow);
+    }
+}
