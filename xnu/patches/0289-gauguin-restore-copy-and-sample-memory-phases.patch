+#ifndef GAUGUIN_COPY378_PROBE_H
+#define GAUGUIN_COPY378_PROBE_H
+
+#include "gauguin_copy356.h"
+#include "gauguin_frame378_probe.h"
+
+static_assert(F378_ROW_FIRST + (F378_PROBE_ROWS - 1) * F378_ROW_STEP < SCAN352_HEIGHT,
+    "probe rows stay inside the original surface");
+
+#define SCAN378_LOAD64 \
+"ldp x8, x9, [%[s], #0]\n" \
+"ldp x10, x11, [%[s], #16]\n" \
+"ldp x12, x13, [%[s], #32]\n" \
+"ldp x14, x15, [%[s], #48]\n"
+
+#define SCAN378_STORE64 \
+"stnp x8, x9, [%[d], #0]\n" \
+"stnp x10, x11, [%[d], #16]\n" \
+"stnp x12, x13, [%[d], #32]\n" \
+"stnp x14, x15, [%[d], #48]\n"
+
+#define SCAN378_REST288 \
+"ldp x8, x9, [%[s], #64]\n" \
+"ldp x10, x11, [%[s], #80]\n" \
+"ldp x12, x13, [%[s], #96]\n" \
+"ldp x14, x15, [%[s], #112]\n" \
+"stnp x8, x9, [%[d], #64]\n" \
+"stnp x10, x11, [%[d], #80]\n" \
+"stnp x12, x13, [%[d], #96]\n" \
+"stnp x14, x15, [%[d], #112]\n" \
+"ldp x8, x9, [%[s], #128]\n" \
+"ldp x10, x11, [%[s], #144]\n" \
+"ldp x12, x13, [%[s], #160]\n" \
+"ldp x14, x15, [%[s], #176]\n" \
+"stnp x8, x9, [%[d], #128]\n" \
+"stnp x10, x11, [%[d], #144]\n" \
+"stnp x12, x13, [%[d], #160]\n" \
+"stnp x14, x15, [%[d], #176]\n" \
+"ldp x8, x9, [%[s], #192]\n" \
+"ldp x10, x11, [%[s], #208]\n" \
+"ldp x12, x13, [%[s], #224]\n" \
+"ldp x14, x15, [%[s], #240]\n" \
+"stnp x8, x9, [%[d], #192]\n" \
+"stnp x10, x11, [%[d], #208]\n" \
+"stnp x12, x13, [%[d], #224]\n" \
+"stnp x14, x15, [%[d], #240]\n" \
+"ldp x8, x9, [%[s], #256]\n" \
+"ldp x10, x11, [%[s], #272]\n" \
+"stnp x8, x9, [%[d], #256]\n" \
+"stnp x10, x11, [%[d], #272]\n" \
+"add %[s], %[s], #288\n" \
+"add %[d], %[d], #288\n"
+
+static inline uint32_t
+scan378_delta(uint64_t begin, uint64_t end)
+{
+    return end >= begin && end - begin <= UINT32_MAX ? (uint32_t)(end - begin) : UINT32_MAX;
+}
+
+/* Only the first 64 bytes of this row are timed. The other instructions
+ * preserve the original 0375 data movement, including its prefetch. */
+static inline void
+scan378_probe_row(void *dst, const void *src, unsigned probe, bool drain,
+    struct f378_probe_deltas *out)
+{
+#if defined(__aarch64__)
+    size_t remaining = SCAN352_PANEL_STRIDE - SCAN356_COPY_BLOCK_BYTES;
+    uint64_t before, loaded, issued, drained;
+    __asm__ volatile(
+        "prfm pldl1keep, [%[s], #160]\n"
+        "isb\n"
+        "mrs %[before], cntvct_el0\n"
+        SCAN378_LOAD64
+        "dsb ld\n"
+        "isb\n"
+        "mrs %[loaded], cntvct_el0\n"
+        SCAN378_STORE64
+        "isb\n"
+        "mrs %[issued], cntvct_el0\n"
+        "mov %[drained], %[issued]\n"
+        "cbz %w[drain], 1f\n"
+        "dsb st\n"
+        "isb\n"
+        "mrs %[drained], cntvct_el0\n"
+        "1:\n"
+        SCAN378_REST288
+        "2:\n"
+        "prfm pldl1keep, [%[s], #160]\n"
+        SCAN378_LOAD64
+        SCAN378_STORE64
+        SCAN378_REST288
+        "subs %[n], %[n], #288\n"
+        "b.ne 2b\n"
+        : [d] "+&r"(dst), [s] "+&r"(src), [n] "+&r"(remaining),
+          [before] "=&r"(before), [loaded] "=&r"(loaded),
+          [issued] "=&r"(issued), [drained] "=&r"(drained)
+        : [drain] "r"((unsigned)drain)
+        : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "cc", "memory");
+    out->read[probe] = scan378_delta(before, loaded);
+    out->issue[probe] = scan378_delta(loaded, issued);
+    if (drain) out->drain = scan378_delta(issued, drained);
+#else
+    __builtin_memcpy(dst, src, SCAN352_PANEL_STRIDE);
+    out->read[probe] = out->issue[probe] = 0;
+    if (drain) out->drain = 0;
+#endif
+}
+
+#undef SCAN378_LOAD64
+#undef SCAN378_STORE64
+#undef SCAN378_REST288
+
+#endif
