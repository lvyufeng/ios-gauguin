+static bool
+wdt_bus_conflict(void)
+{
+    static const char *const off[] = {"sweetwdtpet", "sweetreboot",
+        "sweetwdttest", "sweetbusprobe", "sweetgpuprobe", "sweetscmprobe",
+        "sweettouchmode"};
+    for (unsigned i = 0; i < sizeof(off) / sizeof(off[0]); ++i) {
+        int value = 0;
+        (void)PE_parse_boot_argn(off[i], &value, sizeof(value));
+        if (value != 0) {
+            char line[160];
+            snprintf(line, sizeof(line), "SWEET WDT LEASE: conflict %s=%d; no arm", off[i], value);
+            wdt_record(line);
+            return true;
+        }
+    }
+    /* CPU-only PAS preparation may be enabled by the coordinator. These
+     * flags are not evidence that it completed; the caller must await READY. */
+    static const char *const cpu[] = {"sweetpasprobe", "sweetpasstage"};
+    for (unsigned i = 0; i < sizeof(cpu) / sizeof(cpu[0]); ++i) {
+        int value = 0;
+        (void)PE_parse_boot_argn(cpu[i], &value, sizeof(value));
+        if (value != 0 && value != 1) {
+            wdt_record("SWEET WDT LEASE: invalid CPU-stage flag; no arm");
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Software upper window in nominal WDT ticks. This is a refusal guard if the
+ * WDT count stalls, not an alternate reset or cancellation mechanism. Bound
+ * nanoseconds BEFORE multiplication; no CPU-frequency constant is assumed. */
+static bool
+wdt_cpu_window(uint64_t armed_at, uint64_t now, uint32_t minimum)
+{
+    uint64_t nanoseconds;
+    if (now < armed_at) {
+        return false;
+    }
+    absolutetime_to_nanoseconds(now - armed_at, &nanoseconds);
+    if (nanoseconds >= UINT64_C(23000000000)) {
+        return false;
+    }
+    uint64_t used = nanoseconds * WDT_HZ / UINT64_C(1000000000);
+    return used < WDT_BITE_TICKS && WDT_BITE_TICKS - used >= minimum;
+}
+
+bool
+gauguin_wdt_lease_arm(struct gauguin_wdt_lease_record *out)
+{
+    /* Rejected absent-mode/NULL calls do not consume a real attempt. */
+    if (out == NULL || !wdt_bus_requested()) {
+        return false;
+    }
+    if (__atomic_exchange_n(&wdt_started, 1u, __ATOMIC_ACQ_REL)) {
+        return false;
+    }
+    unsigned expected = WDL_IDLE;
+    if (!__atomic_compare_exchange_n(&wdt_lease_state, &expected, WDL_ARMING,
+        false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        return false;
+    }
+    if (!wdt_context() || wdt_bus_conflict()) {
+        return wdt_lease_fail("SWEET WDT LEASE: context/config rejected; quarantined");
+    }
+    wdt_record("SWEET WDT LEASE: one arm requested by bus coordinator; no automatic re-arm or PET");
+    struct wdt_arm_snapshot arm;
+    if (!wdt_arm_registers(&arm)) {
+        return wdt_lease_fail("SWEET WDT LEASE: arm failed; quarantined with no cleanup writes");
+    }
+    IOSleep(1000); /* exactly one readiness wait in this API */
+    if (!wdt_context()) {
+        return wdt_lease_fail("SWEET WDT LEASE: invalid context after readiness wait; quarantined");
+    }
+    uint32_t en = wdt_read(WDT_EN), bark = wdt_read(WDT_BARK);
+    uint32_t bite = wdt_read(WDT_BITE), status = wdt_read(WDT_STS);
+    uint32_t count = (status >> 1) & 0xfffffu;
+    uint64_t now = mach_absolute_time();
+    if (en != 3u || bark != WDT_BARK_TICKS || bite != WDT_BITE_TICKS ||
+        count <= ((arm.status >> 1) & 0xfffffu) || count >= WDT_BITE_TICKS ||
+        !wdt_cpu_window(arm.armed_at_ticks, now, 1u)) {
+        return wdt_lease_fail("SWEET WDT LEASE: readiness/counter/window mismatch; quarantined");
+    }
+    struct gauguin_wdt_lease_record ready = {
+        arm.armed_at_ticks, now, count, WDT_BARK_TICKS, WDT_BITE_TICKS, WDT_HZ
+    };
+    char line[192];
+    snprintf(line, sizeof(line), "SWEET WDT LEASE: readiness sample en=%08x count=%u arm_at=%llu ready_at=%llu; counter evidence only",
+        en, count, ready.armed_at_ticks, ready.ready_at_ticks);
+    wdt_record(line);
+    if (!wdt_context()) {
+        return wdt_lease_fail("SWEET WDT LEASE: invalid publication context; quarantined");
+    }
+    wdt_lease_record = ready;
+    wdt_lease_last_count = count;
+    wdt_lease_last_at = now;
+    expected = WDL_ARMING;
+    if (!__atomic_compare_exchange_n(&wdt_lease_state, &expected, WDL_READY,
+        false, __ATOMIC_RELEASE, __ATOMIC_RELAXED)) {
+        return false; /* another error path quarantined; never overwrite it */
+    }
+    *out = ready;
+    return true;
+}
+
+bool
+gauguin_wdt_lease_check_budget(uint32_t minimum_remaining_ticks)
+{
+    if (__atomic_load_n(&wdt_lease_state, __ATOMIC_ACQUIRE) != WDL_READY) {
+        return false;
+    }
+    if (!wdt_bus_requested() || !wdt_context() || minimum_remaining_ticks == 0 ||
+        minimum_remaining_ticks >= WDT_BITE_TICKS) {
+        return wdt_lease_fail("SWEET WDT LEASE: invalid budget request/context; quarantined");
+    }
+    unsigned clear = 0;
+    if (!__atomic_compare_exchange_n(&wdt_budget_busy, &clear, 1u, false,
+        __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+        return wdt_lease_fail("SWEET WDT LEASE: concurrent budget check; quarantined");
+    }
+    /* A simultaneous quarantine does not turn into another READY state. */
+    if (__atomic_load_n(&wdt_lease_state, __ATOMIC_ACQUIRE) != WDL_READY) {
+        __atomic_store_n(&wdt_budget_busy, 0u, __ATOMIC_RELEASE);
+        return false;
+    }
+    uint32_t en = wdt_read(WDT_EN), bark = wdt_read(WDT_BARK);
+    uint32_t bite = wdt_read(WDT_BITE), status = wdt_read(WDT_STS);
+    uint32_t count = (status >> 1) & 0xfffffu;
+    uint64_t now = mach_absolute_time();
+    bool valid = en == 3u && bark == WDT_BARK_TICKS && bite == WDT_BITE_TICKS &&
+        count >= wdt_lease_last_count && count < WDT_BITE_TICKS &&
+        now >= wdt_lease_last_at &&
+        WDT_BITE_TICKS - count >= minimum_remaining_ticks &&
+        wdt_cpu_window(wdt_lease_record.armed_at_ticks, now, minimum_remaining_ticks);
+    if (valid) {
+        wdt_lease_last_count = count;
+        wdt_lease_last_at = now;
+    } else {
+        gauguin_wdt_lease_quarantine();
+    }
+    bool still_ready = __atomic_load_n(&wdt_lease_state, __ATOMIC_ACQUIRE) == WDL_READY;
+    __atomic_store_n(&wdt_budget_busy, 0u, __ATOMIC_RELEASE);
+    if (!valid) {
+        wdt_record("SWEET WDT LEASE: budget/readback/counter/window failed; quarantined, no PET or cleanup");
+    }
+    return valid && still_ready;
+}
