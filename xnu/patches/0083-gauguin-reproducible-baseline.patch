+/* Boot-arg sweetmsgwait=Name: trace that process's blocking receives. */
+char sweet_msgwait_needle[48];
+static char sweet_msgsend_needle[48];
+static int sweet_msgsend_parsed;
+static int sweet_msgsend_lines;
+
+/*
+ * Send-side note. Called from ipc_mqueue_send_locked with the port lock held,
+ * so it must not log, allocate, or take any other lock: sweet_log_write takes
+ * sweet_log_lock, and doing that under a port lock is exactly the pairing that
+ * wedges a single-core boot. It only touches a fixed array with an atomic
+ * counter; sweet_msgsend_report() prints it later.
+ */
+#define SWEET_MSGSEND_SLOTS 16
+static ipc_port_t sweet_msgsend_ports[SWEET_MSGSEND_SLOTS];
+static char sweet_msgsend_senders[SWEET_MSGSEND_SLOTS][20];
+static volatile uint32_t sweet_msgsend_count;
+
+void
+sweet_msg_send_note(ipc_port_t port)
+{
+	if (!sweet_msgsend_parsed) {
+		sweet_msgsend_parsed = 1;
+		if (!PE_parse_boot_argn("sweetmsgsend", sweet_msgsend_needle,
+		    sizeof(sweet_msgsend_needle))) {
+			sweet_msgsend_needle[0] = '\0';
