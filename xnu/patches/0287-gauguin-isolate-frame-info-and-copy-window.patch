+#ifndef GAUGUIN_FRAME376_WIRE_H
+#define GAUGUIN_FRAME376_WIRE_H
+
+#include "gauguin_frame372_wire.h"
+
+enum {
+    F376_TRANSPORT_BYTES = 110000,
+    F376_TRANSPORT_THREADS = 64,
+    F376_DISPLAY_THREADS = 32,
+    F376_COPY_CAP = 32,
+    F376_COPY_TICKS = 96000, /* 5 ms on the pinned 19.2 MHz timebase */
+    F376_PAIR_MAX = 23,
+};
+
+static inline unsigned
+f376_uleb32(uint8_t *out, uint32_t value)
+{
+    unsigned used = 0;
+    do {
+        const uint8_t group = value & 0x7f;
+        value >>= 7;
+        out[used++] = group | (value ? 0x80 : 0);
+    } while (value);
+    return used;
+}
+
+static inline unsigned
+f376_pack_pair(uint8_t *out, uint64_t base, uint32_t serial, uint32_t message,
+    uint64_t send, uint64_t post, uint64_t copyout, uint8_t source, uint8_t receiver)
+{
+    if (!serial || serial > UINT16_MAX || send < base || post < send ||
+        copyout < post || copyout - base > UINT32_MAX) {
+        return 0;
+    }
+    f372_le32(out, (uint32_t)(send - base));
+    out[4] = (uint8_t)serial;
+    out[5] = (uint8_t)(serial >> 8);
+    out[6] = source;
+    out[7] = receiver;
+    const bool common = message >= 40002 && message <= 40005;
+    out[8] = common ? (uint8_t)(message - 40002) : 4;
+    unsigned size = 9;
+    if (!common) {
+        f372_le32(out + size, message);
+        size += 4;
+    }
+    size += f376_uleb32(out + size, (uint32_t)(post - send));
+    size += f376_uleb32(out + size, (uint32_t)(copyout - send));
+    return size;
+}
+
