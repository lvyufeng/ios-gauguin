new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_calibration357.h
@@ -0,0 +1,38 @@
+#ifndef GAUGUIN_CALIBRATION357_H
+#define GAUGUIN_CALIBRATION357_H
+
+#include "gauguin_blank351.h"
+
+enum {
+    SCAN357_PAUSE, SCAN357_FIRST, SCAN357_SECOND, SCAN357_RESTORE,
+    SCAN357_RESUME, SCAN357_ABORT, SCAN357_FINISHED,
+    SCAN357_CALIBRATION_GAP = 8, SCAN357_CALIBRATION_WAIT_MS = 750,
+    SCAN357_CALIBRATION_LIMIT_MS = 1500
+};
+
+static inline bool
+scan357_calibration_window(const struct scan351_position *pos)
+{
+    return pos->line >= 2752 && pos->line < pos->end &&
+        (uint64_t)(pos->end - pos->line) * SCAN351_MIN_LINE_NS >= 2400000;
+}
+
+static inline uint32_t
+scan357_pixel(uint32_t original, unsigned step)
+{
+    if (step == SCAN357_FIRST) return original ^ UINT32_C(0x00ff0000);
+    if (step == SCAN357_SECOND) return original ^ UINT32_C(0x0000ff00);
+    return original;
+}
