+
+/* Only the first 64 bytes of this row are timed. The other instructions
+ * preserve the original 0375 data movement, including its prefetch. */
+static inline void
+scan379_probe_row(void *dst, const void *src, unsigned segment,
+    struct f379_segments *out)
+{
+#if defined(__aarch64__)
+    size_t remaining = SCAN352_PANEL_STRIDE - SCAN356_COPY_BLOCK_BYTES;
+    uint64_t before, loaded, issued;
+    __asm__ volatile(
+        "prfm pldl1keep, [%[s], #160]\n"
+        "isb\n"
+        "mrs %[before], cntvct_el0\n"
+        SCAN379_LOAD64
+        "dsb ld\n"
+        "isb\n"
+        "mrs %[loaded], cntvct_el0\n"
+        SCAN379_STORE64
+        "isb\n"
+        "mrs %[issued], cntvct_el0\n"
+        SCAN379_REST288
+        "2:\n"
+        "prfm pldl1keep, [%[s], #160]\n"
+        SCAN379_LOAD64
+        SCAN379_STORE64
+        SCAN379_REST288
+        "subs %[n], %[n], #288\n"
+        "b.ne 2b\n"
+        : [d] "+&r"(dst), [s] "+&r"(src), [n] "+&r"(remaining),
+          [before] "=&r"(before), [loaded] "=&r"(loaded),
+          [issued] "=&r"(issued)
+        :
+        : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "cc", "memory");
+    out->read[segment] = scan379_delta(before, loaded);
+    out->issue[segment] = scan379_delta(loaded, issued);
+#else
+    __builtin_memcpy(dst, src, SCAN352_PANEL_STRIDE);
+    out->read[segment] = out->issue[segment] = 0;
+#endif
+}
+
+#undef SCAN379_LOAD64
+#undef SCAN379_STORE64
+#undef SCAN379_REST288
+
+#endif
