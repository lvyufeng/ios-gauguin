diff --git a/bsd/dev/gauguin_handoff_memory.c b/bsd/dev/gauguin_handoff_memory.c
index 00becb9d1c715ad26618adf74ae775187e913f3a..e0657e2f5249aa45f68f133afd6f30493def80a9 100644
--- a/bsd/dev/gauguin_handoff_memory.c
+++ b/bsd/dev/gauguin_handoff_memory.c
@@ -360,4 +360,97 @@ enum gh_status gh_read_memory(const uint8_t *d, size_t bytes,
         return GH_BAD_PAS;
     return parse_fdt(d + GH_HEADER, fdt_bytes, m) ? GH_OK : GH_BAD_FDT;
 }
+
+void gh_copy_name(const uint8_t *fdt, size_t bytes, uint32_t offset, char name[GH_NAME])
+{
+    size_t i = 0;
+    if (offset < bytes) {
+        for (; i < GH_NAME - 1 && i < bytes - offset && fdt[offset + i]; ++i) {
+            uint8_t c = fdt[offset + i];
+            name[i] = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+                c == ',' || c == '.' || c == '_' || c == '+' || c == '@' || c == '-' ? (char)c : '_';
+        }
+    }
+    name[i] = 0;
+}
+
+static void put_le32(uint8_t *p, uint32_t value)
+{
+    for (unsigned i = 0; i < 4; ++i)
+        p[i] = (uint8_t)(value >> (i * 8));
+}
+
+static void put_le64(uint8_t *p, uint64_t value)
+{
+    put_le32(p, (uint32_t)value);
+    put_le32(p + 4, (uint32_t)(value >> 32));
+}
+
+static void put_range(uint8_t *p, struct gh_range r)
+{
+    put_le64(p, r.base);
+    put_le64(p + 8, r.size);
+}
+
+size_t gh_pack_memory(uint8_t block[GH_RECEIPT_BLOCK], uint32_t run, enum gh_status status,
+    const struct gh_live *live, const struct gh_inventory *m, const uint8_t *fdt,
+    const uint8_t fdt_hash[GH_DIGEST])
+{
+    if (!block || !run || (unsigned)status > GH_RECEIPT_OVERFLOW)
+        return 0;
+    size_t body = GH_RECEIPT_HEADER;
+    if (status == GH_OK) {
+        if (!m || !live || !fdt || !fdt_hash || m->bank_count > GH_BANK_LIMIT ||
+            m->header_reserve_count > GH_FIXED_LIMIT || m->fixed_count > GH_FIXED_LIMIT ||
+            m->pool_count > GH_POOL_LIMIT || m->alloc_count > GH_ALLOC_LIMIT)
+            return 0;
+        body += 16 * (8 + m->bank_count + m->header_reserve_count + m->alloc_count) +
+            (16 + GH_NAME) * (m->fixed_count + m->pool_count);
+        if (body > GH_RECEIPT_BLOCK - GH_DIGEST) {
+            body = GH_RECEIPT_HEADER;
+            status = GH_RECEIPT_OVERFLOW;
+        }
+    }
+    for (size_t i = 0; i < GH_RECEIPT_BLOCK; ++i)
+        block[i] = 0;
+    for (unsigned i = 0; i < 8; ++i)
+        block[i] = (uint8_t)"GAUHRAM1"[i];
+    put_le32(block + 8, (uint32_t)(body + GH_DIGEST));
+    put_le32(block + 12, run);
+    put_le32(block + 16, status);
+    if (status != GH_OK)
+        return body;
+    put_le32(block + 20, m->bank_count);
+    put_le32(block + 24, m->header_reserve_count);
+    put_le32(block + 28, m->fixed_count);
+    put_le32(block + 32, m->pool_count);
+    put_le32(block + 36, m->alloc_count);
+    for (unsigned i = 0; i < GH_DIGEST; ++i)
+        block[40 + i] = fdt_hash[i];
+
+    const struct gh_range owners[] = {
+        m->original_fdt, m->input, m->shim, m->pas, live->framebuffer,
+        {live->managed.base, live->top - live->managed.base}, live->adt, live->managed,
+    };
+    uint8_t *next = block + GH_RECEIPT_HEADER;
+    for (unsigned i = 0; i < sizeof(owners) / sizeof(owners[0]); ++i, next += 16)
+        put_range(next, owners[i]);
+    for (uint32_t i = 0; i < m->bank_count; ++i, next += 16)
+        put_range(next, m->banks[i]);
+    for (uint32_t i = 0; i < m->header_reserve_count; ++i, next += 16)
+        put_range(next, m->header_reserves[i]);
+    for (uint32_t i = 0; i < m->fixed_count; ++i, next += 16 + GH_NAME) {
+        put_range(next, m->fixed[i].range);
+        gh_copy_name(fdt, m->original_fdt.size, m->fixed[i].name, (char *)(next + 16));
+    }
+    for (uint32_t i = 0; i < m->pool_count; ++i, next += 16 + GH_NAME) {
+        put_le64(next, m->pools[i].size);
+        put_le32(next + 8, m->pools[i].first_alloc);
+        put_le32(next + 12, m->pools[i].alloc_count);
+        gh_copy_name(fdt, m->original_fdt.size, m->pools[i].name, (char *)(next + 16));
+    }
+    for (uint32_t i = 0; i < m->alloc_count; ++i, next += 16)
+        put_range(next, m->allocations[i]);
+    return (size_t)(next - block) == body ? body : 0;
+}
 #endif
