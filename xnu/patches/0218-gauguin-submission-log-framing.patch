-            rc,n,ggrb_context.submitted,ggrb_context.completed,ggrb_context.wptr,ggrb_context.polls);gmb_record(line);
+            rc,n,ggrb_context.submitted,ggrb_context.completed,ggrb_context.wptr,ggrb_context.polls);gmb_record_submission(line);
