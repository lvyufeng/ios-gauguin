+static uint64_t expected_leaf(const struct ggd_plan *p,unsigned index)
+{
+    uint32_t va=GGP_GLOBAL_BASE+4096u*index;
+    for(unsigned i=0;i<=GGP_COUNT;i++){
+        const struct ggp_region *m=i<GGP_COUNT?&p->bootstrap.region[i]:&p->data;
+        if(va<m->iova||va-m->iova>=m->mapped)continue;
+        uint64_t attr=UINT64_C(0xe03)|(m->privileged?0:0x40u)|(m->readonly?0x80u:0);
+        if(!m->executable)attr|=UINT64_C(3)<<53;
+        return (p->bootstrap.owner_pa+m->offset+(va-m->iova))|attr;
+    }
+    return 0;
+}
+bool ggd_tables_match(const struct ggd_plan *p,const volatile void *memory,size_t bytes)
+{
+    if(!ggd_plan_valid(p)||bytes<GGP_TABLE_BYTES||!span((const void *)memory,GGP_TABLE_BYTES)||
+       ((uintptr_t)memory&7)||overlap(p,sizeof(*p),(const void *)memory,GGP_TABLE_BYTES))return false;
+    const volatile uint64_t *actual=memory;uint64_t pa=p->bootstrap.owner_pa+GGP_TABLE_OFFSET;
+    for(unsigned i=0;i<GGP_TABLE_BYTES/8;i++){
+        uint64_t expected=0;
+        if(i==3)expected=(pa+0x1000)|3u;
+        else if(i==512+480)expected=(pa+0x2000)|3u;
+        else if(i>=1024&&i<1536)expected=expected_leaf(p,i-1024);
+        if(actual[i]!=expected)return false;
+    }
+    return true;
+}
