+    }
+    cpu402.perf = (volatile uint32_t *)(cpu402.perf_map + CPU402_DOMAIN_OFFSET);
+    cpu402.temp = (volatile uint32_t *)(cpu402.temp_map + CPU402_TSENS_OFFSET);
+    const uint32_t srot = cpu402_read((void *)cpu402.srot_map, CPU402_SROT_CONTROL);
