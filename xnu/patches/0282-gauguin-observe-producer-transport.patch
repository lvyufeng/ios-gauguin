diff --git a/osfmk/ipc/ipc_kmsg.c b/osfmk/ipc/ipc_kmsg.c
--- a/osfmk/ipc/ipc_kmsg.c
+++ b/osfmk/ipc/ipc_kmsg.c
@@ -148,6 +148,251 @@
 #include <sys/csr.h>
 #endif
 
+#if defined(GAUGUIN)
+#include <mach/mach_time.h>
+#include "../../bsd/dev/gauguin_frame344.h"
+
+extern void sweet_log_append(const char *, int);
+
+enum { F371_SLOTS = 4096, F371_SENDS = 16384, F371_PAIRS = 1536 };
+#define F371_CLOSED (UINT64_C(1) << 63)
+
+struct f371_delivery {
+	uint64_t send, post, copyout, source_thread, receiver_thread;
+	uint32_t serial, message_id;
+};
+
+static struct f371_slot {
+	uintptr_t key;
+	uint32_t busy;
+	struct f371_delivery data;
+} f371_slots[F371_SLOTS];
+
+static struct f371_delivery f371_pairs[F371_PAIRS];
+static uint64_t f371_source, f371_receiver, f371_end;
+static uint64_t f371_gate = F371_CLOSED;
+static uint32_t f371_sent, f371_copied, f371_missed, f371_busy, f371_evicted, f371_failed;
+
+static bool
+f371_live(void)
+{
+	return !(__atomic_load_n(&f371_gate, __ATOMIC_ACQUIRE) & F371_CLOSED);
+}
+
+static void
+f371_leave(void)
+{
+	__atomic_fetch_sub(&f371_gate, 1, __ATOMIC_RELEASE);
+}
+
+static bool
+f371_enter(uint64_t tick)
+{
+	if (tick >= __atomic_load_n(&f371_end, __ATOMIC_RELAXED)) {
+		return false;
+	}
+	if (__atomic_fetch_add(&f371_gate, 1, __ATOMIC_ACQ_REL) & F371_CLOSED) {
+		f371_leave();
+		return false;
+	}
+	return true;
+}
+
+void
+sweet_frame371_arm(uint64_t source, uint64_t receiver, uint64_t end)
+{
+	assert(source && receiver && source != receiver && end && !f371_end);
+	f371_source = source;
+	f371_receiver = receiver;
+	__atomic_store_n(&f371_end, end, __ATOMIC_RELAXED);
+	__atomic_store_n(&f371_gate, 0, __ATOMIC_RELEASE);
+}
+
+static uint64_t
+f371_identity(const audit_token_t *token)
+{
+	return ((uint64_t)token->val[7] << 32) | token->val[5];
+}
+
+static bool
+f371_task(task_t task, uint64_t identity)
+{
+	return task != TASK_NULL && (uint32_t)task_pid(task) == (uint32_t)identity &&
+	       f371_identity(task_get_audit_token(task)) == identity;
+}
+
+static struct f371_slot *
+f371_slot_for(ipc_kmsg_t kmsg)
+{
+	const uintptr_t key = (uintptr_t)kmsg;
+	return &f371_slots[((key >> 8) ^ (key >> 20)) & (F371_SLOTS - 1)];
+}
+
+static bool
+f371_try_slot(struct f371_slot *slot)
+{
+	if (__atomic_exchange_n(&slot->busy, 1, __ATOMIC_ACQUIRE)) {
+		__atomic_fetch_add(&f371_busy, 1, __ATOMIC_RELAXED);
+		return false;
+	}
+	return true;
+}
+
+static void
+f371_release_slot(struct f371_slot *slot)
+{
+	__atomic_store_n(&slot->busy, 0, __ATOMIC_RELEASE);
+}
+
+/* The port is already locked by ipc_kmsg_send. Keep the destination check
+ * under that lock and never acquire another lock for the observation. */
+static void
+f371_send(ipc_kmsg_t kmsg, ipc_port_t port, uint64_t tick)
+{
+	ipc_space_t space = ip_get_receiver(port);
+	if (!space || !is_active(space) || !f371_task(space->is_task, f371_receiver) ||
+	    f371_identity(&ipc_kmsg_get_trailer(kmsg, false)->msgh_audit) != f371_source ||
+	    !f371_enter(tick)) {
+		return;
+	}
+	const uint32_t serial = __atomic_fetch_add(&f371_sent, 1, __ATOMIC_RELAXED) + 1;
+	struct f371_slot *slot = f371_slot_for(kmsg);
+	if (serial <= F371_SENDS && f371_try_slot(slot)) {
+		const uintptr_t key = (uintptr_t)kmsg;
+		const uintptr_t previous = __atomic_load_n(&slot->key, __ATOMIC_RELAXED);
+		if (previous && previous != key) {
+			__atomic_fetch_add(&f371_evicted, 1, __ATOMIC_RELAXED);
+		}
+		slot->data = (struct f371_delivery){
+			.send = tick,
+			.source_thread = thread_tid(current_thread()),
+			.serial = serial,
+			.message_id = (uint32_t)ikm_header(kmsg)->msgh_id,
+		};
+		__atomic_store_n(&slot->key, key, __ATOMIC_RELEASE);
+		f371_release_slot(slot);
+	}
+	f371_leave();
+}
+
+/* Called before freeing the message, including undeliverable messages. The
+ * key can only be replaced by a distinct live kmsg until this object is freed. */
+static void
+f371_forget(ipc_kmsg_t kmsg)
+{
+	struct f371_slot *slot = f371_slot_for(kmsg);
+	uintptr_t key = (uintptr_t)kmsg;
+	if (__atomic_load_n(&slot->key, __ATOMIC_RELAXED) == key) {
+		(void)__atomic_compare_exchange_n(&slot->key, &key, 0, false,
+		    __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+	}
+}
+
+/* Entry to the existing post path, after mqueue admission and before the
+ * message is queued or handed directly to a receiver. */
+static void
+f371_post(ipc_kmsg_t kmsg)
+{
+	struct f371_slot *slot = f371_slot_for(kmsg);
+	const uintptr_t key = (uintptr_t)kmsg;
+	if (__atomic_load_n(&slot->key, __ATOMIC_ACQUIRE) != key ||
+	    !f371_enter(mach_absolute_time())) {
+		return;
+	}
+	if (f371_try_slot(slot)) {
+		if (__atomic_load_n(&slot->key, __ATOMIC_RELAXED) == key) {
+			slot->data.post = mach_absolute_time();
+		}
+		f371_release_slot(slot);
+	}
+	f371_leave();
+}
+
+static bool
+f371_take(ipc_kmsg_t kmsg, ipc_space_t space, struct f371_delivery *delivery)
+{
+	task_t task = current_task();
+	if (!f371_task(task, f371_receiver) || space != task->itk_space ||
+	    f371_identity(&ipc_kmsg_get_trailer(kmsg, false)->msgh_audit) != f371_source ||
+	    !f371_enter(mach_absolute_time())) {
+		return false;
+	}
+	const uintptr_t key = (uintptr_t)kmsg;
+	struct f371_slot *slot = f371_slot_for(kmsg);
+	bool found = false;
+	if (f371_try_slot(slot)) {
+		if (__atomic_load_n(&slot->key, __ATOMIC_RELAXED) == key &&
+		    slot->data.message_id == (uint32_t)ikm_header(kmsg)->msgh_id &&
+		    slot->data.post >= slot->data.send) {
+			*delivery = slot->data;
+			delivery->receiver_thread = thread_tid(current_thread());
+			__atomic_store_n(&slot->key, 0, __ATOMIC_RELAXED);
+			found = true;
+		}
+		f371_release_slot(slot);
+	}
+	if (!found) {
+		__atomic_fetch_add(&f371_missed, 1, __ATOMIC_RELAXED);
+	}
+	f371_leave();
+	return found;
+}
+
+static void
+f371_complete(struct f371_delivery *row, mach_msg_return_t result)
+{
+	row->copyout = mach_absolute_time();
+	if (!f371_enter(row->copyout)) {
+		return;
+	}
+	if (result == MACH_MSG_SUCCESS) {
+		const uint32_t idx = __atomic_fetch_add(&f371_copied, 1, __ATOMIC_RELAXED);
+		if (idx < F371_PAIRS) {
+			f371_pairs[idx] = *row;
+		}
+	} else {
+		__atomic_fetch_add(&f371_failed, 1, __ATOMIC_RELAXED);
+	}
+	f371_leave();
+}
+
+void
+sweet_frame371_drain(void)
+{
+	static uint32_t cursor;
+	static bool header, done;
+	if (done || !__atomic_load_n(&f371_end, __ATOMIC_RELAXED)) {
+		return;
+	}
+	if ((__atomic_fetch_or(&f371_gate, F371_CLOSED, __ATOMIC_ACQ_REL) & ~F371_CLOSED) != 0) {
+		return;
+	}
+	const uint32_t count = MIN(f371_copied, F371_PAIRS);
+	if (!header) {
+		header = true;
+		printf("SWEET F371 H: count=%u cap=%u sent=%u sent_cap=%u copied=%u missed=%u busy=%u evicted=%u failed=%u\n",
+		    count, F371_PAIRS, f371_sent, F371_SENDS, f371_copied, f371_missed,
+		    f371_busy, f371_evicted, f371_failed);
+	}
+	const uint32_t end = MIN(cursor + 64, count);
+	for (; cursor < end; ++cursor) {
+		const struct f371_delivery *row = &f371_pairs[cursor];
+		char line[144];
+		const int bytes = snprintf(line, sizeof(line), "\nSWEET F371 E %x %x %llx %llx %llx %llx %llx\n",
+		    row->serial, row->message_id, (unsigned long long)row->send,
+		    (unsigned long long)row->post, (unsigned long long)row->copyout,
+		    (unsigned long long)row->source_thread, (unsigned long long)row->receiver_thread);
+		if (bytes > 0 && (size_t)bytes < sizeof(line)) {
+			sweet_log_append(line, bytes);
+		}
+	}
+	if (cursor == count) {
+		done = true;
+		printf("SWEET F371 F: count=%u\n", count);
+	}
+}
