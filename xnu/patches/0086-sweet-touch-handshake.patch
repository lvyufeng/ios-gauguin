+	printf("SWEET BLOCKRING: %u blocks total, showing %u\n", head, n);
+	for (uint32_t k = 0; k < n; k++) {
+		struct sweet_block_rec *r = &sweet_block_ring[k % SWEET_BLOCK_RING];
