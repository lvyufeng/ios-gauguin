+static void nv_pio_barrier(void *cookie) { (void)cookie; nv_barrier(); }
+static uint64_t nv_pio_time(void *cookie) { (void)cookie; return nv_now_us(); }
+static void nv_pio_relax(void *cookie) { (void)cookie; delay(1); }
