+/*
+ * Sample the pixels a surface holds right now: non-black count, distinct colour
+ * count (capped at 8) and pixel 0. Called from the framebuffer SwapEnd path to
+ * tell "userland submitted a new image" from "userland submitted the same image
+ * again"; the panel sample runs on the vsync timer and cannot (NOTES (47)).
+ * Returns 0 when the surface cannot be mapped.
+ */
+extern "C" int
+sweet_surface_sample(uint32_t id, uint32_t *nonblack, uint32_t *distinct,
+    uint32_t *px0)
+{
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return 0;
+	}
+	uintptr_t base = s->kernelAddress();
+	if (base == 0 || s->width == 0 || s->height == 0 || s->bytesPerRow == 0) {
+		s->release();
+		return 0;
+	}
+	uint32_t nb = 0, dist = 0, seen[8] = { 0 };
+	uint32_t total = s->width * s->height;
+	uint32_t step = total / 1024;
+	if (step == 0) {
+		step = 1;
+	}
+	*px0 = *(const uint32_t *)base;
+	for (uint32_t i = 0; i < total; i += step) {
+		uint32_t y = i / s->width, x = i % s->width;
+		uint32_t px = *(const uint32_t *)(base +
+		    (uintptr_t)y * s->bytesPerRow + (uintptr_t)x * 4);
+		uint32_t c = px & 0x00ffffffu;
+		if (c != 0) {
+			nb++;
+			uint32_t k = 0;
+			for (; k < dist && k < 8; k++) {
+				if (seen[k] == c) {
+					break;
+				}
+			}
+			if (k == dist && dist < 8) {
+				seen[dist++] = c;
+			}
+		}
+	}
+	*nonblack = nb;
+	*distinct = dist;
+	s->release();
+	return 1;
+}
