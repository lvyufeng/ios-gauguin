--- /dev/null
+++ b/iokit/Kernel/arm/SweetPresentStats.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: MIT
+ * CPU-side present diagnostics only. Not panel scanout or GPU execution time.
+ * One caller serializes each stats object. Histograms cover all valid samples.
+ */
+#ifndef _SWEET_PRESENT_STATS_H
+#define _SWEET_PRESENT_STATS_H
+#include <stdint.h>
+
+struct SweetPresentSample {
+    uint64_t waitTicks, copyTicks, copiedBytes;
+    uint32_t copiedLayers, gpuGuards, gpuRefusals;
+    bool timingValid;
+};
+
+struct SweetPresentStats {
+    uint64_t attempts, copied, zeroBytes, invalidTime, bytes, layers, gpuGuards, gpuRefusals;
+    uint64_t waitSamples, copySamples;
+    uint64_t waitHistogram[8], copyHistogram[8];
+};
+
+static inline uint64_t
+sweet_present_stats_saturating_add(uint64_t a, uint64_t b)
+{
+    return b > UINT64_MAX - a ? UINT64_MAX : a + b;
+}
+
+/* On a reversed clock or overflow leave the prior total unchanged. */
+static inline bool
+sweet_present_sample_add_ticks(uint64_t *total, uint64_t begin, uint64_t end)
+{
+    if (total == 0 || end < begin || end - begin > UINT64_MAX - *total) return false;
+    *total += end - begin;
+    return true;
+}
+
+/* Upper-exclusive bounds in ns: .5, 1, 2, 4, 8, 16 and 33.333333 ms. */
+static inline unsigned
+sweet_present_stats_bin(uint64_t ns)
+{
+    const uint64_t limits[7] = {500000, 1000000, 2000000, 4000000,
+                                8000000, 16000000, 33333333};
+    for (unsigned i = 0; i < 7; ++i) if (ns < limits[i]) return i;
+    return 7;
+}
+
+/* Invalid clock samples still account for bytes/outcomes, but never enter a
+ * timing histogram. Wait samples require a guard; copy samples require actual
+ * copied bytes, so zero-work frames cannot bias latency percentiles downward.
+ * Converted ns must be obtained from the platform timebase. */
+static inline bool
+sweet_present_stats_record(SweetPresentStats *stats, const SweetPresentSample *sample,
+                           uint64_t wait_ns, uint64_t copy_ns)
+{
+    if (stats == 0 || sample == 0) return false;
+    stats->attempts = sweet_present_stats_saturating_add(stats->attempts, 1);
+    if (sample->copiedBytes != 0) stats->copied = sweet_present_stats_saturating_add(stats->copied, 1);
+    else stats->zeroBytes = sweet_present_stats_saturating_add(stats->zeroBytes, 1);
+    stats->bytes = sweet_present_stats_saturating_add(stats->bytes, sample->copiedBytes);
+    stats->layers = sweet_present_stats_saturating_add(stats->layers, sample->copiedLayers);
+    stats->gpuGuards = sweet_present_stats_saturating_add(stats->gpuGuards, sample->gpuGuards);
+    stats->gpuRefusals = sweet_present_stats_saturating_add(stats->gpuRefusals, sample->gpuRefusals);
+    if (!sample->timingValid) {
+        stats->invalidTime = sweet_present_stats_saturating_add(stats->invalidTime, 1);
+        return true;
+    }
+    if (sample->gpuGuards != 0) {
+        unsigned wait = sweet_present_stats_bin(wait_ns);
+        stats->waitHistogram[wait] = sweet_present_stats_saturating_add(stats->waitHistogram[wait], 1);
+        stats->waitSamples = sweet_present_stats_saturating_add(stats->waitSamples, 1);
+    }
+    if (sample->copiedBytes != 0) {
+        unsigned copy = sweet_present_stats_bin(copy_ns);
+        stats->copyHistogram[copy] = sweet_present_stats_saturating_add(stats->copyHistogram[copy], 1);
+        stats->copySamples = sweet_present_stats_saturating_add(stats->copySamples, 1);
+    }
+    return true;
+}
+#endif
