+/* All mode-5 writes go through this literal register address. The count
+ * control, signature and clock registers are read-only in this mode. */
+static void scan349_misr_write(uint32_t value)
+{
+    ++scan.misr_writes;
+    scan_intf_write(F344_MISR_CTRL, value);
+}
+
+static bool scan349_owned(uint32_t control)
+{
+    return (control & ~F344_CRC_STATUS) == F344_CRC_CONFIG;
+}
+
+static bool scan349_stop(void)
+{
+    uint32_t before = UINT32_MAX, after = UINT32_MAX;
+    struct scan345_status status = {0};
+    struct scan345_geometry geometry = {0};
+    // Check route and the exact preexisting geometry again before cleanup.
+    const bool readable = scan.misr_writes == 2 &&
+        scan_route(&status, &geometry) == SCAN345_OK && scan349_timing(&geometry);
+    if (readable) {
+        before = scan_intf[F344_MISR_CTRL / 4];
+        after = before;
+        if (scan349_owned(before)) {
+            scan349_misr_write(F344_CRC_CLEAR);
+            scan349_misr_write(0);
+            after = scan_intf[F344_MISR_CTRL / 4];
+        }
+    }
+    printf("SWEET F349 RESET: poll=%u readable=%u before=%x after=%x writes=%u fault=%u pairs=%u not_ready=%u rejected=%u\n",
+        scan.polls, readable, before, after, scan.misr_writes, scan.misr_fault,
+        scan.crc_pairs, scan.crc_not_ready, scan.crc_rejected);
+    return !scan.misr_writes || (readable && after == 0);
+}
