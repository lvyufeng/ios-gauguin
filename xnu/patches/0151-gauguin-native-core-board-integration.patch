+/* Live native A619 core setup. All original cold/GGX APIs retain their scope. */
+static unsigned ggc_board_lifecycle,ggc_board_phase,ggc_maps_ready,ggc_created;
+static uint64_t ggc_deadline,ggc_phase_deadline;
+static vm_offset_t ggc_alias[10];
+static struct ggc_context ggc_context;
+static struct ggc_receipt ggc_work;
+static enum ggc_result ggc_result;
+enum gmb_state sweet_gpu_core_state(void)
+{return (enum gmb_state)__atomic_load_n(&ggc_board_lifecycle,__ATOMIC_ACQUIRE);}
+static bool ggc_nc_valid(void)
+{
+    if(!gmb_ram||!ggp_plan_valid(&ggb_plan)||gmb_ram>UINTPTR_MAX-(GGM_REGION_BYTES-GMB_PAGE-1))return false;
+    const struct ggp_region *r=&ggb_plan.region[GGP_REGLIST];
+    vm_offset_t va=gmb_ram+r->offset-GMB_PAGE;uint64_t pa=gmb_stage.pa+r->offset;
+    ppnum_t pn=(ppnum_t)(pa>>PAGE_SHIFT);
+    return !(va&(GMB_PAGE-1))&&!pmap_valid_page(pn)&&pmap_cache_attributes(pn)==UINT32_C(0xd0000006)&&
+        ml_vtophys(va)==pa&&ml_vtophys(va+GMB_PAGE-1)==pa+GMB_PAGE-1;
+}
+static bool ggc_board_guard(void *cookie,enum ggc_phase phase)
+{
+    (void)cookie;
+    if(phase<GGC_BUS||phase>GGC_FINAL||phase<ggc_board_phase||phase>ggc_board_phase+1)return false;
+    if(phase!=ggc_board_phase){ggc_board_phase=phase;clock_interval_to_deadline(4,NSEC_PER_SEC,&ggc_phase_deadline);}
+    uint32_t gx,irq[3];
+    if(sweet_gpu_core_state()!=GMB_RUNNING||sweet_gmu_firmware_state()!=GMB_READY||
+       sweet_gmu_board_state()!=GMB_READY||!gmb_thread()||mach_absolute_time()>=ggc_deadline||
+       mach_absolute_time()>=ggc_phase_deadline||!gauguin_wdt_lease_check_budget(GMB_MIN)||
+       !sweet_pas_stage_owner_valid(&gmb_stage)||!gmb_reset||!gmb_smmu||!gmb_ram||
+       !gfw_map[GMF_AO]||!gfw_map[GMF_GBIF]||gfw_map[GMF_CSR]!=gmb_reset||
+       gfw_work.phase!=GMF_DONE||gfw_work.result!=GMF_OK||!gfw_work.release_attempted||
+       !gfw_work.oob_attempted||gfw_context.state!=2||!gfw_context.perf_valid||
+       !gfw_context.bw_valid||!gfw_context.test_valid||!gfw_context.dcvs_valid||
+       !gfw_context.dcvs_return_valid||gfw_context.dcvs_return||
+       !ggb_sqe_requested||!ggb_sqe_loaded||ggb_sqe_written!=8192||ggb_sqe_checked!=8192||
+       ggb_aperture.state!=2||ggb_secure_result!=GPA_OK||
+       !sweet_gmu_clock_live(true,&gx)||!sweet_gmu_irq_quiet(irq)||(irq[1]&0x1000)||
+       gfw_load32(gmb_reset+0x2000)||!gfw_faults(false)||!ggb_context_valid()||
+       (gfw_work.host_info&(1u<<24))||!ggc_nc_valid())return false;
+    enum gmb_state parent=sweet_gpu_start_state();
+    if(phase==GGC_BUS){if(parent!=GMB_IDLE||ggx_context.state||ggx_core)return false;}
+    else if(phase==GGC_MMU_OOB){if(parent!=GMB_IDLE&&parent!=GMB_READY)return false;}
+    else if(parent!=GMB_READY)return false;
+    if(parent==GMB_READY){
+        uint32_t v;const struct ggx_receipt *r=&ggx_work;
+        if(ggx_context.state!=2||ggx_context.phase!=GGX_DONE||ggx_result!=GGX_OK||!ggx_core||
+           r->bank!=ggb_smmu.bank||r->asid!=ggb_smmu.asid||r->ttbr0!=ggb_smmu.ttbr0||
+           r->ack_valid!=1||r->ack_clear_attempted!=1||r->request_retained!=1||r->core_opened!=1||
+           (gx&0x80000001u)!=0x80000000u||
