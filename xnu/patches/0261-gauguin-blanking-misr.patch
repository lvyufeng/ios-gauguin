--- a/bsd/dev/gauguin_scanout345.h
+++ b/bsd/dev/gauguin_scanout345.h
@@ -124,4 +124,51 @@
     return line >= geometry->first + 128 && line < geometry->first + 1536;
 }
 
+
+enum {
+    SCAN349_BLANK_START = 2752, SCAN349_BLANK_END = 4480,
+    SCAN349_LINE_BITS = 13, SCAN349_TICK_BITS = 20, SCAN349_READ_US = 250
+};
+
+static inline bool
+scan349_timing(const struct scan345_geometry *geometry)
+{
+    return geometry->htotal == 462 && geometry->vtotal == 4910 &&
+        geometry->first == 32 && geometry->last == 2431;
+}
+
+static inline bool
+scan349_line(uint32_t line)
+{
+    return line >= SCAN349_BLANK_START && line < SCAN349_BLANK_END;
+}
+
+struct scan349_read {
+    uint64_t start, end;
+    uint32_t line, signature;
+};
+
+/* The two polls have separate timing brackets on the wire. The caller has
+ * already checked both line endpoints, the frame and the ready status. */
+static inline bool
+scan349_pack(const struct scan349_read *first, const struct scan349_read *second,
+    uint32_t *lines, uint64_t *signatures, uint64_t *ticks)
+{
+    const uint64_t limit = UINT64_C(1) << SCAN349_TICK_BITS;
+    if (first->start >= first->end || first->end >= second->start ||
+        second->start >= second->end || !scan349_line(first->line) ||
+        !scan349_line(second->line) || first->line >= second->line)
+        return false;
+    const uint64_t first_width = first->end - first->start;
+    const uint64_t gap = second->start - first->start;
+    const uint64_t second_width = second->end - second->start;
+    if (first_width >= limit || gap >= limit || second_width >= limit)
+        return false;
+    *lines = first->line | (second->line << SCAN349_LINE_BITS);
+    *signatures = ((uint64_t)first->signature << 32) | second->signature;
+    *ticks = (gap << (2 * SCAN349_TICK_BITS)) |
+        (first_width << SCAN349_TICK_BITS) | second_width;
+    return true;
+}
+
 #endif
