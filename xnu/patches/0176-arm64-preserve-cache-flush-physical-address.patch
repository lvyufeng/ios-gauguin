--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6881,7 +6881,9 @@
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	/* ppnum_t is 32-bit. Widen before shifting so cache-mode changes on
+	 * managed pages above 4 GiB retain the complete physical address. */
+	flush_dcache((vm_offset_t) ptoa_64(pp), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP
