+#include "gauguin_gmu_hfi.h"
+struct ndb_entry;
+#define GMF_FW_BYTES 32768u
+enum gmf_domain {GMF_CX,GMF_MX,GMF_GFX,GMF_XO,GMF_DOMAINS};
