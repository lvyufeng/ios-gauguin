+    TRY(write32(c,0x3c45u,0));TRY(barrier(c));
+    c->phase=GGC_MMU_OOB;
+    if(!guard(c)){rc=GGC_GUARD;goto done;}
+    if(!c->ops.start_gpu(c->ops.cookie,&c->work.start)){rc=GGC_PARENT;goto done;}
+    if(!guard(c)){rc=GGC_GUARD;goto done;}
+    const struct ggx_receipt *s=&c->work.start;
+    if(s->bank!=parent.bank||s->asid!=parent.asid||s->ttbr0!=parent.ttbr0||s->contextidr||(s->tlb_status&1u)||
+       s->writes32!=7||s->writes64!=1||!s->tlb_polls||s->tlb_polls>20000||!s->oob_polls||s->oob_polls>1000||
+       s->request_attempted!=1||s->ack_valid!=1||s->ack_clear_attempted!=1||s->core_opened!=1||s->request_retained!=1||
+       (s->oob_before&(0x8000u|(1u<<24)))||(s->oob_ack&(0x8000u|(1u<<24)))!=(1u<<24)||
+       (s->oob_cleared&(0x8000u|(1u<<24)))){rc=GGC_PARENT;goto done;}
+    c->phase=GGC_MAP;
+    if(!guard(c)){rc=GGC_GUARD;goto done;}
+    if(!c->ops.open_registers(c->ops.cookie)){rc=GGC_IO;goto done;}
+    if(!guard(c)){rc=GGC_GUARD;goto done;}
+    c->phase=GGC_ADDRESS;TRY(program(c,addresses,COUNT(addresses)));
+    c->phase=GGC_HWCG;TRY(program(c,gmu_hwcg,COUNT(gmu_hwcg)));
+    uint32_t clock;TRY(read32(c,0xaeu,&clock));
+    if(clock==0x8aa8aa82u)c->work.hwcg_skipped=1;
+    else{
+        const struct ggc_reg sp_off={0x1a880u,1,0},sp_on={0x1a880u,0,1};
+        TRY(program(c,&sp_off,1));TRY(program(c,hwcg,COUNT(hwcg)));
