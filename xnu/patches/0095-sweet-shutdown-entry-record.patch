+/* Record before normal shutdown takes locks, waits or notifies drivers.
+ * Stage 0 is reboot_kernel; stage 1 also catches direct platform requests.
+ * Use only current-process fields: process lookup/name APIs may take locks.
+ * A flush can fail or recurse into panic, so it is best-effort and guarded. */
+void
+sweet_record_shutdown(unsigned stage, unsigned options, unsigned details, uintptr_t caller)
+{
+	static unsigned active, recorded;
+	char line[256];
+	if (stage > 1 || __atomic_exchange_n(&active, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	unsigned bit = 1u << stage;
+	if (__atomic_fetch_or(&recorded, bit, __ATOMIC_RELAXED) & bit) {
+		__atomic_store_n(&active, 0, __ATOMIC_RELEASE);
+		return;
+	}
+	struct proc *p = current_thread() != THREAD_NULL ? current_proc() : NULL;
+	char name[sizeof(p->p_comm) + 1];
+	if (p != NULL) {
+		memcpy(name, p->p_comm, sizeof(p->p_comm));
+		name[sizeof(p->p_comm)] = '\0';
+	} else {
+		strlcpy(name, "<none>", sizeof(name));
+	}
+	boolean_t interrupts = ml_get_interrupts_enabled();
+	int length = snprintf(line, sizeof(line),
+	    "\nSWEET SHUTDOWN ENTRY: stage=%s pid=%d proc=%s %s=0x%x details=0x%x at=%llu caller=0x%llx irq=%u\n",
+	    stage == 0 ? "reboot_kernel" : "platform", p != NULL ? p->p_pid : -1, name,
+	    stage == 0 ? "howto" : "type", options, details,
+	    (unsigned long long)mach_absolute_time(), (unsigned long long)caller,
+	    (unsigned)interrupts);
+	if (length > 0) {
+		sweet_log_append(line, MIN(length, (int)sizeof(line) - 1));
+	}
+	/* Keep UFS polling non-sleeping, including when entered with IRQs off. */
+	interrupts = ml_set_interrupts_enabled(FALSE);
+	sweet_log_flush_panic();
+	ml_set_interrupts_enabled(interrupts);
+	__atomic_store_n(&active, 0, __ATOMIC_RELEASE);
+}
+
