+int nvt_bus_configure(struct nvt_bus *b, uint32_t max_sck_hz)
+{
+    if (!nv_owned(b)) return EPERM;
+    if (b->status.state != NVT_BUS_OPEN || nv_quarantined) return EBUSY;
+    if (!max_sck_hz || max_sck_hz > 1000000) return EINVAL;
+    int result = gss_prepare(&b->setup, &b->setup_owner, max_sck_hz);
+    if (result == GSS_PREPARED) result = gss_commit_native_defaults(&b->setup);
+    b->status.setup_result = result;
+    if (result != GSS_OK) { b->status.error = EIO; return EIO; }
+    b->status.state = NVT_BUS_CONFIGURED;
+    b->status.sck_hz = b->setup.report.sck_hz;
+    return 0;
+}
+
+int nvt_bus_activate_native_pins(struct nvt_bus *b)
+{
+    if (!nv_owned(b)) return EPERM;
+    if (b->status.state != NVT_BUS_CONFIGURED || b->status.pins_active) return EBUSY;
+    /* Map/snapshot ALL before the first GPIO write. Only these six pins. */
+    for (unsigned i = 0; i < 6; i++) {
+        if (!nv_map(&nv_maps.pins[i], NV_TLMM_PA + nv_pins[i] * 0x1000u, 0x1000))
+            return ENOMEM;
+        b->pins[i].cfg = nv_read(nv_maps.pins[i], 0);
+        b->pins[i].io = nv_read(nv_maps.pins[i], 4);
+        b->pins[i].mask = NV_PIN_FIELDS | (i >= 4 ? NV_OE : 0) |
+            ((b->pins[i].cfg & NV_EGPIO_PRESENT) ? NV_EGPIO_ENABLE : 0);
+    }
+    /* Assert reset BEFORE muxing SPI pins. IO low precedes the OE write. */
+    b->pins[4].io_touched = true;
+    if (nv_set(nv_maps.pins[4], 4, NV_GPIO_OUT, 0)) goto failed;
+    static const unsigned order[6] = {4, 5, 0, 1, 2, 3};
+    for (unsigned n = 0; n < 6; n++) {
+        unsigned i = order[n];
+        uint32_t value = nv_pin_values[i] | (i == 4 ? NV_OE : 0) |
+            ((b->pins[i].cfg & NV_EGPIO_PRESENT) ? NV_EGPIO_ENABLE : 0);
+        b->pins[i].touched = true;
+        if (nv_set(nv_maps.pins[i], 0, b->pins[i].mask, value)) goto failed;
+    }
+    b->status.pins_active = true; b->status.reset_high = false;
+    return 0;
+failed:
+    nv_contain(b, EIO); /* uncertain pin configuration: no automatic retry */
+    return EIO;
+}
+
+int nvt_bus_set_reset(struct nvt_bus *b, bool high)
+{
+    if (!nv_owned(b)) return EPERM;
+    if (b->status.state != NVT_BUS_CONFIGURED || !b->status.pins_active) return EBUSY;
+    if (nv_set(nv_maps.pins[4], 4, NV_GPIO_OUT, high ? NV_GPIO_OUT : 0)) {
+        nv_contain(b, EIO); return EIO;
+    }
+    b->status.reset_high = high;
+    return 0;
+}
+
+int nvt_bus_xfer(struct nvt_bus *b, const uint8_t *tx, uint8_t *rx, size_t length)
+{
+    if (!nv_owned(b)) return EPERM;
+    if (b->status.state != NVT_BUS_CONFIGURED || !b->status.pins_active ||
+        !nv_current(b, b->status.generation)) return EBUSY;
+    if (!tx || !length || length > GS_MAX_WIRE) return EINVAL;
+    if (rx && ((uintptr_t)tx <= (uintptr_t)rx ?
+        (uintptr_t)rx - (uintptr_t)tx : (uintptr_t)tx - (uintptr_t)rx) < length)
+        return EINVAL;
+    /* Recheck the qualified source before EVERY command. Configuration/clock
+     * changes by another owner are a fault; never send at an unbounded SCK. */
+    if (!nv_clock() || nv_read(nv_maps.se, 0x7c) != 0 ||
+        (nv_read(nv_maps.se, 0x48) & 0xfff1) != ((b->setup.report.divider << 4) | 1)) {
+        nv_contain(b, EIO); return EIO;
+    }
+    int result = gs_pio_xfer(&b->pio, tx, rx, length);
+    b->status.pio_result = result;
+    if (result != GS_OK) {
+        b->status.error = result == GS_TIMEOUT ? ETIMEDOUT : EIO;
+        (void)gss_restore(&b->setup, result);
+        nv_contain(b, b->status.error);
+        return b->status.error;
+    }
+    return 0;
+}
+
+static int nv_restore_pins(struct nvt_bus *b)
+{
+    for (unsigned n = 6; n > 0; n--) {
+        unsigned i = n - 1;
+        struct nv_pin_save *p = &b->pins[i];
+        if (!p->touched && !p->io_touched) continue;
+        /* Reset: tri-state before restoring the saved latch, then restore its
+         * original mux/pull/drive/OE. Do not manufacture a reset-high edge. */
+        if (p->io_touched && (nv_set(nv_maps.pins[i], 0, NV_OE, 0) ||
+            nv_set(nv_maps.pins[i], 4, NV_GPIO_OUT, p->io))) return EIO;
+        if (nv_set(nv_maps.pins[i], 0, p->mask, p->cfg)) return EIO;
+    }
+    b->status.pins_restored = true;
+    return 0;
+}
+
+static void nv_snapshot(struct nvt_bus *b, struct nvt_bus_status *out)
+{
+    if (out) {
+        *out = b->status;
+        out->setup = b->setup.report;
+        out->pio = b->pio.diag;
+    }
+}
+
+int nvt_bus_close(struct nvt_bus *b, struct nvt_bus_status *final_status)
+{
+    if (!nv_owned(b)) return EPERM;
+    int error = 0;
+    if (b->setup.state == GSS_HELD || b->setup.state == GSS_CONFIGURED) {
+        int result = gss_restore(&b->setup, nv_quarantined ? EIO : 0);
+        if (result) error = EIO;
+    }
+    if (nv_quarantined || error) nv_contain(b, error);
+    else if (nv_restore_pins(b) || nv_restore_votes(b)) nv_contain(b, EIO);
+    else b->status.state = NVT_BUS_CLOSED;
+    error = nv_quarantined ? (b->status.error ? b->status.error : EIO) : 0;
+    nv_snapshot(b, final_status);
+    nv_release_worker(b);
+    return error;
+}
+
+void nvt_bus_abort(struct nvt_bus *b, int error, struct nvt_bus_status *final_status)
+{
+    if (!nv_owned(b)) return;
+    if (b->setup.state == GSS_HELD || b->setup.state == GSS_CONFIGURED)
+        (void)gss_restore(&b->setup, error ? error : EIO);
+    nv_contain(b, error);
+    nv_snapshot(b, final_status);
+    nv_release_worker(b);
+}
+
+int nvt_bus_get_status(struct nvt_bus *b, struct nvt_bus_status *out)
+{
+    if (!out) return EINVAL;
+    if (!nv_owned(b)) return EPERM;
+    nv_snapshot(b, out);
+    return 0;
+}
