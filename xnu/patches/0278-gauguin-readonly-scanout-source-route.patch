+/* A bounded observation of the inherited route. CTL shares the already
+ * mapped MDP page. Sapphire/Mayfly register addresses do not apply here. */
+enum { F367_CONTROLS = 4, F367_PIPES = 4, F367_SAMPLES = 3, F367_MAX_ATTEMPTS = 8 };
+struct scan367_snapshot {
+    uint32_t ctl[F367_CONTROLS][11];
+    uint32_t pipe[F367_PIPES][9];
+};
+static struct {
+    vm_offset_t pages[3];
+    struct scan367_snapshot snapshot;
+    uint32_t attempts, samples, first_frame, last_frame, last_attempt_frame;
+    bool done;
+} scan367;
+
+static void scan367_finish(const char *status)
+{
+    for (size_t i = 0; i < sizeof(scan367.pages) / sizeof(scan367.pages[0]); ++i) {
+        if (scan367.pages[i]) ml_io_unmap(scan367.pages[i], F344_PAGE);
+        scan367.pages[i] = 0;
+    }
+    scan367.done = true;
+    printf("SWEET F367 ROUTE: status=%s attempts=%u samples=%u first=%u last=%u\n",
+        status, scan367.attempts, scan367.samples, scan367.first_frame, scan367.last_frame);
+}
+
+static bool scan367_map(void)
+{
+    static const vm_offset_t addresses[] = {0x0ae04000, 0x0ae24000, 0x0ae28000};
+    for (size_t i = 0; i < sizeof(addresses) / sizeof(addresses[0]); ++i) {
+        const vm_offset_t pa = addresses[i];
+        const vm_offset_t va = ml_io_map_with_prot(pa, F344_PAGE, VM_PROT_READ);
+        scan367.pages[i] = va;
+        if (!va || ml_vtophys(va) != pa ||
+            ml_vtophys(va + F344_PAGE - 1) != pa + F344_PAGE - 1)
+            return false;
+    }
+    return true;
+}
+
+static void scan367_read(struct scan367_snapshot *snapshot)
+{
+    /* Lagoon CTL_TOP, FLUSH, INTF_ACTIVE and both LM stage sets. See
+     * Xiaomi gauguin-q-oss sde_hw_ctl.c and sde_hw_sspp.c at e601e14. */
+    static const uint32_t ctl_offsets[] = {
+        0x014, 0x018, 0x0f4, 0x000, 0x040, 0x070, 0x0a0, 0x004, 0x044, 0x074, 0x0a4
+    };
+    static const uint32_t pipe_offsets[] = {
+        0x000, 0x008, 0x00c, 0x010, 0x014, 0x024, 0x030, 0x038, 0x170
+    };
+    for (uint32_t i = 0; i < F367_CONTROLS; ++i) {
+        const uint32_t base = 0x2000 + 0x200 * i;
+        for (size_t j = 0; j < sizeof(ctl_offsets) / sizeof(ctl_offsets[0]); ++j)
+            snapshot->ctl[i][j] = scan_mdp[(base + ctl_offsets[j]) / 4];
+    }
+    const volatile uint32_t *const pipe_blocks[] = {
+        (const volatile uint32_t *)(scan367.pages[0] + 0x1000),
+        (const volatile uint32_t *)(scan367.pages[1] + 0x1000),
+        (const volatile uint32_t *)(scan367.pages[1] + 0x3000),
+        (const volatile uint32_t *)(scan367.pages[2] + 0x1000),
+    };
+    for (uint32_t i = 0; i < F367_PIPES; ++i) {
+        for (size_t j = 0; j < sizeof(pipe_offsets) / sizeof(pipe_offsets[0]); ++j)
+            snapshot->pipe[i][j] = pipe_blocks[i][pipe_offsets[j] / 4];
+    }
+}
+
+static void scan367_poll(uint32_t frame)
+{
+    if (scan367.done || !scan.configured || !sweet_frame351_window() ||
+        (scan367.attempts && frame == scan367.last_attempt_frame)) return;
+    if (!scan367.attempts && !scan367.pages[0] && !scan367_map()) {
+        scan367_finish("map-failed");
+        return;
+    }
+    ++scan367.attempts;
+    scan367.last_attempt_frame = frame;
+    struct scan351_position first, last;
+    struct scan367_snapshot sample = {0};
+    uint64_t duration_ns = UINT64_MAX;
+    if (scan351_position(&first) && first.frame == frame) {
+        scan367_read(&sample);
+        if (scan351_position(&last) && frame == last.frame &&
+            first.line <= last.line && first.tick <= last.tick)
+            absolutetime_to_nanoseconds(last.tick - first.tick, &duration_ns);
+    }
+    if (duration_ns <= UINT64_C(1000000)) {
+        if (!scan367.samples || memcmp(&scan367.snapshot, &sample, sizeof(sample))) {
+            scan367.snapshot = sample;
+            scan367.samples = 0;
+            scan367.first_frame = frame;
+        }
+        scan367.last_frame = frame;
+        if (++scan367.samples == F367_SAMPLES) {
+            PE_Video video = {0};
+            PE_current_console(&video);
+            printf("SWEET F367 FB: base=%llx width=%u height=%u stride=%u\n",
+                (unsigned long long)video.v_baseAddr, (uint32_t)video.v_width,
+                (uint32_t)video.v_height, (uint32_t)video.v_rowBytes);
+            for (uint32_t i = 0; i < F367_CONTROLS; ++i) {
+                const uint32_t *c = scan367.snapshot.ctl[i];
+                printf("SWEET F367 CTL: index=%u fields=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x\n",
+                    i, c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10]);
+            }
+            for (uint32_t i = 0; i < F367_PIPES; ++i) {
+                const uint32_t *p = scan367.snapshot.pipe[i];
+                printf("SWEET F367 SSPP: index=%u fields=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x\n",
+                    i, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8]);
+            }
+            scan367_finish("stable");
+            return;
+        }
+    }
+    if (scan367.attempts == F367_MAX_ATTEMPTS) scan367_finish("unstable");
+}
