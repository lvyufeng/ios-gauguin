+struct gge_command {uint32_t word[GGE_COMMAND_WORDS],ib[GGE_IB_WORDS];};
+struct gge_ops {
+    void *cookie;
+    bool (*guard)(void *,enum gge_phase);
+    bool (*seal)(void *,uint64_t);
+    bool (*read32)(void *,uint32_t,uint32_t *);
+    bool (*write32)(void *,uint32_t,uint32_t);
+    bool (*barrier)(void *);
+    bool (*delay_us)(void *,unsigned);
+    bool (*read_memory)(void *,enum gge_memory,uint32_t,uint32_t *);
+    bool (*write_memory)(void *,enum gge_memory,uint32_t,uint32_t);
+    void (*quarantine)(void *);
+};
+struct gge_receipt {
+    uint32_t reads,writes,prefix_checked,clean_checked,commands_written,commands_checked;
+    uint32_t sealed,initial_wptr,initial_shadow,initial_busy,submit_attempted;
+    uint32_t keepalive_set_attempted,keepalive_clear_attempted,fence_checks,fence_status;
+    uint32_t fence_slow,counter_before_valid,counter_after_valid,idle_polls;
+    uint32_t rptr,busy,rbbm_status,cp_status,complete,requests_retained;
+    uint32_t data_before_checked,data_after_checked,edge_checked,unchanged_checked,ring_after_checked;
+    uint32_t ib_clean_checked,ib_written,ib_checked,ib_after_checked;
+    uint32_t eop_polls,eop_value,eop_complete,eop_checked;
+    uint64_t counter_before,counter_after;
