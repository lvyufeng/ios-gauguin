 bool
+AppleCLCD::blankPendingLocked() const
+{
+    return fPhasePresent && fHoldPresent && fDirty && !fPowerOff &&
+        fHeldPending.owner && get32(fHeldPending.record,0x104) == 1 && sweet_frame351_window();
+}
+
+bool
+AppleCLCD::takeBlankFrameLocked(struct sweet_fb_frame *frame, uint64_t *blankFrame)
+{
+    struct scan351_position pos;
+    if (!blankPendingLocked() || !sweet_frame351_position(&pos) ||
+        !scan351_can_take(&fBlankSlot,&pos)) return false;
+    if (fBlankSlot.attempts && pos.frame == fBlankSlot.frame) {
+        uint64_t retry;
+        nanoseconds_to_absolutetime(SCAN351_RETRY_NS,&retry);
+        if (pos.tick - fBlankSlot.attempted_at < retry) return false;
+    }
+    if (!takeHeldFrameLocked(frame)) return false;
+    scan351_take(&fBlankSlot,&pos);
+    *blankFrame = pos.frame;
+    return true;
+}
