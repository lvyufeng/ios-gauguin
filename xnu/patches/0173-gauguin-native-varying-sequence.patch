+        if(varying173_eop[job]!=16*job+6)return false;
+        for(unsigned id=0;id<GGV_BLOBS;id++){
+            struct ggv_blob b;struct ggt_blob old;
+            if(!ggv_blob_get(job,id,&b)||!ggt_blob_get(id,&old)||memcmp(&b,&old,sizeof(b)))return false;
+            if(!b.words)continue;
+            if(b.offset<4*GGV_END_DWORD||b.offset>VARYING173_RING_BYTES||4*b.words>VARYING173_RING_BYTES-b.offset)return false;
+            for(unsigned before=0;before<id;before++){
