diff --git a/bsd/dev/gauguin_ready357.h b/bsd/dev/gauguin_ready357.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_ready357.h
@@ -0,0 +1,75 @@
+#ifndef GAUGUIN_READY357_H
+#define GAUGUIN_READY357_H
+
+#include "gauguin_ready354.h"
+
+enum { SCAN357_WRITERS = 2, SCAN357_NONE = SCAN357_WRITERS };
+
+/* The native submit path has one in-flight fence. The second mailbox
+ * cell lets the next writer bind before the workloop drains completion. */
+struct scan357_writer {
+    uint64_t ticket;
+    uint32_t version;
+    uint32_t fence;
+    bool terminal;
+};
+
+static inline unsigned
+scan357_find(const struct scan357_writer *slots, uint64_t ticket)
+{
+    if (ticket)
+        for (unsigned i = 0; i < SCAN357_WRITERS; ++i)
+            if (slots[i].ticket == ticket) return i;
+    return SCAN357_NONE;
+}
+
+static inline bool
+scan357_claim(struct scan357_writer *slots, uint64_t ticket, uint32_t expected, uint32_t version)
+{
+    if (!ticket || expected != version || !scan354_has_version(version, expected) ||
+        scan357_find(slots, ticket) != SCAN357_NONE)
+        return false;
+    for (unsigned i = 0; i < SCAN357_WRITERS; ++i) {
+        if (slots[i].ticket && !slots[i].terminal) return false;
+    }
+    for (unsigned i = 0; i < SCAN357_WRITERS; ++i) {
+        if (slots[i].ticket) continue;
+        slots[i].ticket = ticket;
+        slots[i].version = version;
+        return true;
+    }
+    return false;
+}
+
+static inline bool
+scan357_signal(struct scan357_writer *slots, uint64_t ticket, uint32_t version, uint32_t fence)
+{
+    const unsigned i = scan357_find(slots, ticket);
+    if (i == SCAN357_NONE || slots[i].terminal || slots[i].version != version)
+        return false;
+    slots[i].fence = fence;
+    slots[i].terminal = true;
+    return true;
+}
+
+static inline unsigned
+scan357_terminal(const struct scan357_writer *slots)
+{
+    unsigned i = SCAN357_NONE;
+    for (unsigned j = 0; j < SCAN357_WRITERS; ++j) {
+        if (slots[j].terminal && (i == SCAN357_NONE || slots[j].ticket < slots[i].ticket))
+            i = j;
+    }
+    return i;
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+bool sweet_fb357_claim_writer(uint64_t ticket, uint32_t version);
+void sweet_fb357_finish_writer(uint64_t ticket, uint32_t version, uint32_t fence);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
