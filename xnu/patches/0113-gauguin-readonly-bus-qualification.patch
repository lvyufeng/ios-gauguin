+#ifndef GAUGUIN_CMD_DB_SNAPSHOT_H
+#define GAUGUIN_CMD_DB_SNAPSHOT_H
+#include <stddef.h>
+#include <stdint.h>
+/* Pure parser of an immutable CPU-owned byte snapshot. No mapping/MMIO/RPMh.
+ * Bounds are policy, not an assertion that firmware trusts arbitrary buffers.
+ * The debugfs text export cannot substitute for this binary snapshot format. */
+enum { NDB_HEADER_BYTES=144, NDB_MAX_BYTES=0x20000, NDB_MAX_ENTRIES=1024,
+       NDB_MAX_AUX=32, NDB_MAX_LEVELS=16 };
+enum ndb_result { NDB_OK, NDB_ARGUMENT, NDB_LENGTH, NDB_FORMAT,
+    NDB_UNSUPPORTED, NDB_NOT_FOUND, NDB_AMBIGUOUS, NDB_CAPACITY, NDB_NOT_ARC };
+struct ndb_entry {
+    char name[9];
+    uint32_t address, priority[2];
+    uint16_t owner_slave, bank_version, aux_length;
+    uint8_t aux[NDB_MAX_AUX];
+};
+struct ndb_arc_levels { uint16_t value[NDB_MAX_LEVELS]; unsigned count; };
+/* Validate every traversed entry's range, resolve auxiliary data using its
+ * actual containing RSC header, and reject duplicate requested keys rather
+ * than silently applying native's first-match policy. Zero-address metadata
+ * may be read, but cannot pass ndb_decode_arc. Output unchanged on failure.
+ * name_bytes is1..8 non-NUL printable bytes, zero-padded like native lookup.
+ * Inputs/output must not alias and callers retain snapshot immutability. */
+enum ndb_result ndb_lookup(const uint8_t *,size_t,const char *,size_t,struct ndb_entry *);
+/* Metadata only. No voltage/readback/current-vote/ownership claim, and no
+ * automatic LOW_SVS selector. Strictly ordered levels plus zero tail padding. */
+enum ndb_result ndb_decode_arc(const struct ndb_entry *,struct ndb_arc_levels *);
+#endif
