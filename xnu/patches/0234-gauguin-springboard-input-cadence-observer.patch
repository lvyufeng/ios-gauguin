+#if defined(GAUGUIN)
+bool IOHIDEventServiceQueue::copyTraceState(UInt32 *head, UInt32 *tail,
+                                         UInt32 *capacity, UInt64 *notifications)
+{
+    if (!dataQueue || !head || !tail || !capacity || !notifications) return false;
+    *head = __c11_atomic_load((_Atomic UInt32 *)&dataQueue->head, __ATOMIC_ACQUIRE);
+    *tail = __c11_atomic_load((_Atomic UInt32 *)&dataQueue->tail, __ATOMIC_ACQUIRE);
+    *capacity = getQueueSize();
+    *notifications = _notificationCount;
+    return true; /* a snapshot, not proof of Mach delivery or SpringBoard receipt */
+}
+#endif
