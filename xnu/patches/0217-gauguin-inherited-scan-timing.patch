 	const boot_args *boot = (const boot_args *)PE_state.bootArgs;
 	printf("SWEET RAM: base=%016llx vm_bytes=%llu boot_bytes=%llu max_bytes=%llu max_actual_bytes=%llu sane_bytes=%llu\n",
