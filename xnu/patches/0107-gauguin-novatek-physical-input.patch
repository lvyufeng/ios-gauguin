+    int irq_mask = set(s, IRQ_EN, 0);
+    int gsi_mask = set(s, GSI_EN, 0);
+    if (irq_mask || gsi_mask) {
+        /* Attempt both masks, but never rewrite clocks/packing/IO with an
+         * unconfirmed output mask. A retry is containment, not restoration. */
+        (void)set(s, IRQ_EN, 0); (void)set(s, GSI_EN, 0);
+        s->report.restore_failure = GSS_RESTORE_FAILED;
+        release(s, true);
+        return GSS_RESTORE_FAILED;
+    }
