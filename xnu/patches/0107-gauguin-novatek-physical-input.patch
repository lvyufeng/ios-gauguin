+ */
+int gss_prepare(struct gss_session *, const struct gss_owner *, uint32_t max_sck_hz);
+/* Explicit irreversible boundary: issue native FORCE_DEFAULT, then configure
+ * FIFO, divider,8-bit packing, mode0/CS0. Acknowledge only observed M/S flags.
