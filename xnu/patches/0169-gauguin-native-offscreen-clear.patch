+    const struct ggp_region *r=&p->bootstrap.region[GGP_RING];
+    if(r->mapped!=32768||r->reserved!=32768||r->privileged||!r->readonly||r->executable||
+       r->iova!=0xfc008000u||p->data.iova!=0xfc018000u||
+       GGL_IB_OFFSET<4*GGL_END_DWORD||GGL_IB_OFFSET+4*GGL_IB_WORDS>GGL_RESTORE_OFFSET||
+       GGL_RESTORE_OFFSET+4*GGL_RESTORE_WORDS>GGL_PREAMBLE_OFFSET||
+       GGL_PREAMBLE_OFFSET+4*GGL_PREAMBLE_WORDS>r->mapped||
+       GGL_EOP_OFFSET<4*GGL_OUTPUT_WORDS||GGL_EOP_OFFSET+GGL_CONTROL_BYTES>p->data.mapped)return false;
+    struct ggl_command c={0};
+    memcpy(c.ib,native_ib,sizeof(c.ib));memcpy(c.restore,native_restore,sizeof(c.restore));
+    memcpy(c.preamble,native_preamble,sizeof(c.preamble));
