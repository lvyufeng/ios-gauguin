+static IOLock *gReadyLock;
+static IOInterruptEventSource *gReadySource;
+static SweetReadySignal gReadySignal;
+static uint64_t gReadyTicket;
+
+extern "C" uint64_t
+sweet_fb352_waiting_ticket(void)
+{
+    const uint64_t ticket = __atomic_load_n(&gReadyTicket, __ATOMIC_ACQUIRE);
+    return ticket && sweet_frame351_window() ? ticket : 0;
+}
+
+extern "C" void
+sweet_fb352_signal_ready(uint64_t ticket, uint32_t fence)
+{
+    if (!ticket || ticket != sweet_fb352_waiting_ticket()) return;
+    IOLock *lock = __atomic_load_n(&gReadyLock, __ATOMIC_ACQUIRE);
+    if (!lock) return;
+    IOLockLock(lock);
+    if (gReadySource && ticket == sweet_fb352_waiting_ticket()) {
+        gReadySignal = {ticket, fence};
+        gReadySource->interruptOccurred(nullptr, nullptr, 0);
+    }
+    IOLockUnlock(lock);
+}
+
+static void
+sweet_fb352_clear_ticket(uint64_t ticket)
+{
+    if (ticket)
+        __atomic_compare_exchange_n(&gReadyTicket, &ticket, 0, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
