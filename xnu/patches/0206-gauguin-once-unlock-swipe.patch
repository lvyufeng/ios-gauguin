 		return;
 	}
+	int swipe = 0;
+	(void)PE_parse_boot_argn("swp", &swipe, sizeof(swipe));
+	if (physical == 0 && swipe == 1) {
+		sweet_swipe_arm();
+		return; /* Diagnostic only: neither physical nor legacy probes run. */
+	}
