+
+/* Re-arm one second out, from inside the callback as well as at start. */
+static void
+sweet_wdt_schedule(void)
+{
+	if (sweet_wdt_call != NULL) {
+		thread_call_enter_delayed(sweet_wdt_call, mach_absolute_time() + 1000000000ULL);
+	}
+}
 
