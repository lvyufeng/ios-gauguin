+static void phase(struct run *r,enum ggf_phase p)
+{r->phase=p;r->c->phase=p;}
+static enum ggf_result sample(struct run *r,bool mem,uint32_t reg,uint32_t expected,uint32_t actual)
+{r->c->diagnostic=(struct ggf_diagnostic){1,r->job,mem,reg,expected,actual};return mem?GGF_MEMORY_ERROR:GGF_DIRTY_STATE;}
