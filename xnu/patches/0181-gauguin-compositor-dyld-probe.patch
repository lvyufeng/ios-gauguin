--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -28,8 +28,10 @@
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
 #include <sys/codesign.h>
+#include <sys/kauth.h>
 #include <sys/mount.h>
 #include <sys/priv.h>
+#include <sys/stat.h>
 #include <sys/proc.h>
 #include <sys/systm.h>
 #include <sys/ubc_internal.h>
@@ -48,6 +50,129 @@
 
 /* boot-arg sweet_amfi_debug=1: log the entitlements attached to each signature. */
 static TUNABLE(uint32_t, sweet_amfi_debug, "sweet_amfi_debug", 0);
+
+/* Opt-in loader diagnosis. Default boot policy and GPU privileges are unchanged.
+ * Actual dyld1067 asks policy AMFI/call90 with two64-bit fields and only scans
+ * path environment variables when output bit1 is set. This probe grants only
+ * that bit for the protected backboardd executable; it is not job attestation
+ * or permission to open the GPU, and is not a general application policy.
+ */
+static TUNABLE(uint32_t, sweet_dyld_probe, "sweet_dyld_probe", 0);
+
+/* SWEET_DYLD_PROBE_BEGIN: compiled unchanged by the typed host boundary model. */
+struct sweet_dyld_policy_args {
+	uint64_t input_flags;
+	user_addr_t output_flags;
+};
+_Static_assert(sizeof(struct sweet_dyld_policy_args) == 16, "dyld1067 AMFI90 size");
+_Static_assert(__builtin_offsetof(struct sweet_dyld_policy_args, output_flags) == 8,
+    "dyld1067 AMFI90 output pointer offset");
+
+static bool
+sweet_dyld_probe_subject(proc_t p, uid_t *effective, uid_t *real)
+{
+	kauth_cred_t cred = NULL;
+	vnode_t actual = NULLVP, expected = NULLVP;
+	struct vnode_attr attributes;
+	bool trusted = false;
+	int error;
+	*effective = *real = (uid_t)-1;
+	if (p == NULL || p != current_proc()) {
+		return false;
+	}
+	cred = kauth_cred_proc_ref(p);
+	if (cred == NULL) {
+		return false;
+	}
+	*effective = kauth_cred_getuid(cred);
+	*real = kauth_cred_getruid(cred);
+	kauth_cred_unref(&cred);
+	if (*effective != *real || (*effective != 0 && *effective != 501)) {
+		return false;
+	}
+	actual = proc_getexecutablevnode(p); /* holds an iocount */
+	if (actual == NULLVP || vnode_lookup("/usr/libexec/backboardd",
+	    VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT, &expected,
+	    vfs_context_kernel()) != 0) {
+		goto out;
+	}
+	if (actual != expected || vnode_vtype(actual) != VREG ||
+	    vnode_mount(actual) == NULL || !(vfs_flags(vnode_mount(actual)) & MNT_ROOTFS)) {
+		goto out;
+	}
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_uid);
+	VATTR_WANTED(&attributes, va_mode);
+	if (vnode_getattr(actual, &attributes, vfs_context_kernel()) != 0 ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_uid) ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_mode) || attributes.va_uid != 0 ||
+	    (attributes.va_mode & (S_IWGRP | S_IWOTH)) != 0) {
+		goto out;
+	}
+	if (*effective != 0) {
+		/* Check effective ACL/MAC access too, not just the POSIX mode bits. */
+		error = vnode_authorize(actual, NULLVP, KAUTH_VNODE_WRITE_DATA,
+		    vfs_context_current());
+		if (error != EACCES && error != EPERM) {
+			goto out;
+		}
+	}
+	trusted = true;
+out:
+	if (expected != NULLVP) {
+		vnode_put(expected);
+	}
+	if (actual != NULLVP) {
+		vnode_put(actual);
+	}
+	return trusted;
+}
+
+static int
+sweet_dyld_probe_syscall(proc_t p, int call, user_addr_t user_args)
+{
+	struct sweet_dyld_policy_args args;
+	uint64_t output = 2; /* actual1067 ALLOW_PATH_VARS; bit2 is shared-cache */
+	uid_t effective, real;
+	char name[32];
+	int error;
+	if (!sweet_dyld_probe || call != 90 || p == NULL || p != current_proc()) {
+		return ENOPOLICY;
+	}
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "backboardd") != 0) {
+		return ENOPOLICY;
+	}
+	if (!sweet_dyld_probe_subject(p, &effective, &real)) {
+		printf("SWEET DYLD PROBE: pid=%d uid=%u ruid=%u protected-exec=0 rc=%d\n",
+		    proc_pid(p), effective, real, ENOPOLICY);
+		return ENOPOLICY;
+	}
+	error = copyin(user_args, &args, sizeof(args));
+	if (error == 0 && (args.input_flags & ~UINT64_C(6)) != 0) {
+		error = EINVAL;
+	}
+	if (error == 0 && (args.output_flags == 0 || (args.output_flags & 7) != 0)) {
+		error = EFAULT;
+	}
+	if (error == 0) {
+		error = copyout(&output, args.output_flags, sizeof(output));
+	}
+	printf("SWEET DYLD PROBE: pid=%d uid=%u ruid=%u protected-exec=1 output-mask=2 rc=%d\n",
+	    proc_pid(p), effective, real, error);
+	return error;
+}
+/* SWEET_DYLD_PROBE_END */
+
+static const struct mac_policy_ops sweet_dyld_probe_ops = {
+	.mpo_policy_syscall = sweet_dyld_probe_syscall,
+};
+static struct mac_policy_conf sweet_dyld_probe_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET opt-in compositor dyld probe",
+	.mpc_ops = &sweet_dyld_probe_ops,
+};
+static mac_policy_handle_t sweet_dyld_probe_handle;
 
 /* The entitlements object of a process's main binary, or NULL. */
 static void *
@@ -386,6 +511,12 @@
 void
 sweet_amfi_policy_register(void)
 {
+	if (sweet_dyld_probe) {
+		int probe_error = mac_policy_register(&sweet_dyld_probe_conf,
+		    &sweet_dyld_probe_handle, NULL);
+		printf("SWEET DYLD PROBE: AMFI policy registered rc=%d; outputPATHmask2 only, GPU privileges unchanged\n",
+		    probe_error);
+	}
 	int error = mac_policy_register(&sweet_amfi_mac_conf, &sweet_amfi_mac_handle, NULL);
 	printf("SWEET AMFI: platform binary policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
