+		struct { ipc_port_t p; bool want; } static cache[SWEET_KMSG_CACHE];
+		uint32_t idx = ((uintptr_t)port >> 6) & (SWEET_KMSG_CACHE - 1);
+		if (cache[idx].p == port) {
+			if (cache[idx].want) {
+				goto matched;
+			}
+			return;
+		}
+		const char *owner = "?";
+		ipc_space_t space = port->ip_receiver;
+		if (space != IPC_SPACE_NULL && space->is_task != TASK_NULL) {
+			extern void *get_bsdtask_info(task_t);
+			extern char *proc_name_address(void *p);
+			void *p = get_bsdtask_info(space->is_task);
+			if (p != NULL) {
+				char *nm = proc_name_address(p);
+				if (nm != NULL && nm[0] != '\0') {
+					owner = nm;
+				}
+			}
+		}
