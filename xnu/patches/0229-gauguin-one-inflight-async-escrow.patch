+IOReturn GauguinGPUUserClient::finishPending(bool wait,bool reap,const struct ggr_timespec *deadline)
+{
+    /* Caller holds gLock. The pending array points only into fBuffers;
+     * those entries retain their descriptors, surfaces and SMMU mappings. */
+    if(!fPendingCount)return kIOReturnSuccess;
+    if(!fPendingNativeFence||!fPendingQueue)return kIOReturnNotReady;
+    enum ggr_error rc=GGR_PENDING;
+    if(wait&&deadline){
+        /* msm timeouts are absolute on the continuous clock. A caller's
+         * earlier deadline never frees or cancels a submitted GPU buffer. */
+        __uint128_t target=(__uint128_t)deadline->seconds*NSEC_PER_SEC+
+                           (uint64_t)deadline->nanoseconds;
+        for(uint32_t i=0;i<200000;i++){
+            rc=sweet_gpu_runtime_poll(fPendingNativeFence);
+            if(rc!=GGR_PENDING)break;
+            uint64_t now;
+            absolutetime_to_nanoseconds(mach_continuous_time(),&now);
+            if(target<=now)return kIOReturnTimeout;
+            IODelay(10);
+        }
+        if(rc==GGR_PENDING){sweet_gpu_runtime_stop();return kIOReturnNotReady;}
+    } else rc=wait?sweet_gpu_runtime_wait(fPendingNativeFence):
+                   sweet_gpu_runtime_poll(fPendingNativeFence);
+    if(rc==GGR_PENDING)return kIOReturnNotReady;
+    if(rc!=GGR_OK||
+       fPendingQueue->issued!=fPendingQueueFence||
+       fPendingQueue->completed>=fPendingQueueFence){
+        sweet_gpu_runtime_stop();
+        for(uint32_t i=0;i<fPendingCount;i++)
+            if(fPending[i]&&fPending[i]->surface)fPending[i]->surface->gpuState=2;
+        /* Fault escrow stays mapped until reset. */
+        return rc==GGR_TIMEOUT?kIOReturnTimeout:kIOReturnNotReady;
+    }
+    /* Check every retained alias before clearing any surface or pending BO.
+     * A failed late alias must leave the complete submitted set quarantined. */
+    for(uint32_t i=0;i<fPendingCount;i++){
+        gpu_buffer *b=fPending[i];
+        if(!b||!b->memory||!b->pending||
+           (b->surface&&!b->surface->kernelAddress())){
+            sweet_gpu_runtime_stop();
+            for(uint32_t j=0;j<fPendingCount;j++)
+                if(fPending[j]&&fPending[j]->surface)fPending[j]->surface->gpuState=2;
+            return kIOReturnNotReady;
+        }
+    }
+    for(uint32_t i=0;i<fPendingCount;i++){
+        gpu_buffer *b=fPending[i];
+        if(b->surface){
+            uintptr_t ptr=b->surface->kernelAddress();
+            flush_dcache64(ptr,(unsigned)b->size,0);
+            memoryBarrier();b->surface->gpuState=0;
+            sweet_ui_trace_record(GUT_SURFACE,fPendingQueueFence,0,b->flags,
+                                  b->surface->id,fPendingNativeFence,1);
+        }
+        b->pending=false;fPending[i]=nullptr;
+    }
+    fPendingQueue->completed=fPendingQueueFence;
+    fNativeFence=fPendingNativeFence;
+    fPendingQueue=nullptr;fPendingCount=fPendingNativeFence=fPendingQueueFence=0;
+    if(reap&&!reapClosed())return kIOReturnNotReady;
+    return kIOReturnSuccess;
+}
