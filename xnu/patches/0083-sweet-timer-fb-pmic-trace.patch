 	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
 	setProperty("IOPMUPrimary", 1ULL, 32);
 	registerService();
+	/* Sample the SoC watchdog block so the log says whether it comes back to
+	 * life while userland runs (ABL leaves it disabled: see the shim). */
+	extern uint32_t sweet_timebase_hz;      /* pexpert/arm/pe_identify_machine.c */
+	IOLog("SWEET CLOCK: timebase=%u Hz\n", sweet_timebase_hz);
+	sweet_wdt_thread_start();
+	sweet_pon_dump();
 	IOLog("SWEET WDT: IOWatchdog registered (accepts check-ins, never fires)\n");
 	return true;
