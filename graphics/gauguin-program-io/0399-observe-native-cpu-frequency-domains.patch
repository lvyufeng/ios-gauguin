+static void discardDisplayClock399Maps()
+{
+    for (auto &mapping : gDisplayClock399Maps) {
+        OSSafeReleaseNULL(mapping);
+    }
+}
+
+static void mapDisplayClocks399()
+{
+    constexpr uint64_t bases[] = {UINT64_C(0x18323000), UINT64_C(0x18325800)};
+    static_assert(sizeof(bases) / sizeof(bases[0]) == CPU399_DOMAIN_COUNT, "CPU frequency domains");
+    for (unsigned domain = 0; domain < CPU399_DOMAIN_COUNT; ++domain) {
+        auto *memory = IOMemoryDescriptor::withPhysicalAddress(
+            bases[domain], CPU399_DOMAIN_BYTES, kIODirectionOut);
+        if (memory) {
+            gDisplayClock399Maps[domain] = memory->map(kIOMapReadOnly | kIOMapInhibitCache);
+            memory->release(); // The mapping owns a reference until stop.
+        }
+        if (!gDisplayClock399Maps[domain] || !gDisplayClock399Maps[domain]->getVirtualAddress()) {
+            discardDisplayClock399Maps();
+            return;
+        }
+    }
+}
+
+static uint32_t readDisplayClock399(void *cookie, unsigned offset)
+{
+    auto *registers = static_cast<const volatile uint32_t *>(cookie);
+    const uint32_t value = registers[offset / sizeof(uint32_t)];
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+static void readDisplayClocks399(DisplayClock399Reading &sample, uint64_t tick)
+{
+    sample.tick = tick;
+    for (unsigned domain = 0; domain < CPU399_DOMAIN_COUNT; ++domain) {
+        void *registers = reinterpret_cast<void *>(gDisplayClock399Maps[domain]->getVirtualAddress());
+        if (cpu399_sample_domain(readDisplayClock399, registers, &sample.domains[domain])) {
+            sample.mask |= 1u << domain;
+        }
+    }
+    sample.end = mach_absolute_time();
+}
+
+static void sampleDisplayClockIssue399(uint64_t displayTicket, uint32_t fence)
+{
+    if (!displayTicket || !gDisplayClock399Maps[0] ||
+        gDisplayClock399Count == kDisplayClockSampleLimit ||
+        thread_tid(current_thread()) != gDisplayWriterThread398) {
+        return;
+    }
+    const uint64_t tick = mach_absolute_time();
+    const int cpu = cpu_number();
+    if (tick < gDisplayClock399Next || cpu < 0 || cpu >= 8) {
+        return;
+    }
+    auto &sample = gDisplayClock399Samples[gDisplayClock399Count++];
+    sample.fence = fence;
+    sample.cpu = cpu;
+    readDisplayClocks399(sample.issue, tick);
+    gDisplayClock399Next = tick + kDisplayClockSampleInterval;
+}
+
+static void sampleDisplayClockCompletion399(uint32_t fence)
+{
+    if (!gDisplayClock399Maps[0] || !gDisplayClock399Count) {
+        return;
+    }
+    auto &sample = gDisplayClock399Samples[gDisplayClock399Count - 1];
+    if (sample.fence == fence && !sample.completed.tick) {
+        readDisplayClocks399(sample.completed, mach_absolute_time());
+    }
+}
