@@ -0,0 +1,274 @@
+/* Gauguin apps DRV2 ACTIVE1, one boot-lifetime six-command BCM batch.
+ * Pinned19b63c8192b1c9b7c4d931d7d3be92024bc2d778 rpmh-rsc.c:221-354:
+ * per-command RESP_REQ follows cmd.wait (batch wait_for_compl=false).
+ * Native IRQ completion is mandatory; native has no CMD_STATUS clear path.
+ * No masked-IRQ/busy-progress fallback, retry, vote release or PDC/sleep/wake write.
+ * Caller supplies a freshly validated same-boot plan and an armed WDT lease.
+ * Old sweet_rpmh_vreg_enable must reject this flag BEFORE mapping or locking;
+ * immutable boot configuration excludes the only other HLOS RSC writer.
+ * Register observations do not establish firmware-side ownership. Any uncertain
+ * write/completion quarantines this controller and lease until reset.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <mach/mach_time.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLib.h>
+#include "gauguin_bcm_transport.h"
+#include "gauguin_wdt_lease.h"
+extern vm_offset_t ml_io_map_with_prot(vm_offset_t, vm_size_t, vm_prot_t);
+extern vm_offset_t ml_vtophys(vm_offset_t);
+extern boolean_t pmap_valid_page(ppnum_t);
+extern unsigned int pmap_cache_attributes(ppnum_t);
+extern int get_preemption_level(void);
+extern void sweet_log_mark_sync(const char *);
+extern void sweet_log_flush_now(void);
+extern bool sweet_rsc_irq_quiet(uint32_t *);
+
+#define GT_PA UINT64_C(0x18220000)
+#define GT_BYTES 0x4000u
+#define GT_CONFIG 0xcu
+#define GT_IRQ_EN 0xd00u
+#define GT_IRQ_STATUS 0xd04u
+#define GT_IRQ_CLEAR 0xd08u
+#define GT_BASE 0xd00u
+#define GT_STRIDE 0x2a0u
+#define GT_SLOT 1u
+#define GT_BIT (1u << GT_SLOT)
+#define GT_OWN (GT_BASE + GT_SLOT * GT_STRIDE)
+#define GT_WAIT 0x10u
+#define GT_CONTROL 0x14u
+#define GT_STATUS 0x18u
+#define GT_ENABLE 0x1cu
+#define GT_MSGID 0x30u
+#define GT_ADDR 0x34u
+#define GT_DATA 0x38u
+#define GT_CMD_STATUS 0x3cu
+#define GT_CMD_STRIDE 0x14u
+#define GT_AMC (1u << 16)
+#define GT_TRIGGER (1u << 24)
+#define GT_ISSUED (1u << 8)
+#define GT_COMPL (1u << 16)
+#define GT_WDT_HZ 32765u
+#define GT_START_TICKS (15u * GT_WDT_HZ)
+#define GT_POLL_TICKS (3u * GT_WDT_HZ)
+#define GT_TOTAL_MS 10000u
+_Static_assert(PAGE_SHIFT == 14, "DRV2 probe covers one16KiB page");
+_Static_assert(GBCM_COUNT == 6, "only the reviewed six-command request is accepted");
+
+static unsigned gt_state;
+static vm_offset_t gt_map;
+static bool gt_wrote;
+static uint64_t gt_deadline;
+static struct gbcmt_receipt gt_receipt;
+
+static bool gt_context(void)
+{ return ml_get_interrupts_enabled() && !ml_at_interrupt_context() && get_preemption_level() == 0; }
+static void gt_record(const char *line)
+{
+    printf("%s\n", line);
+    if (gt_context()) { sweet_log_mark_sync(line); sweet_log_flush_now(); }
+}
+static uint32_t gt_read(uint32_t offset)
+{
+    uint32_t value = *(volatile uint32_t *)(gt_map + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+static void gt_write(uint32_t offset, uint32_t value)
+{
+    /* Mark uncertain before the actual access: a fault must never authorize a retry. */
+    gt_wrote = true;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(gt_map + offset) = value;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+static enum gbcmt_rc gt_fail(enum gbcmt_rc rc, const char *why)
+{
+    char line[192];
+    __atomic_store_n(&gt_state, gt_wrote ? GBCMT_QUARANTINED : GBCMT_REJECTED, __ATOMIC_RELEASE);
+    gauguin_wdt_lease_quarantine(); /* software only; never disable or pet */
+    snprintf(line, sizeof(line), "SWEET BCM TX: stopped rc=%u writes=%u reason=%s; no retry/rollback", (unsigned)rc, gt_wrote ? 1u : 0u, why);
+    gt_record(line);
+    return rc;
+}
+bool sweet_bcm_vote_requested(void)
+{
+    int flag = 0; (void)PE_parse_boot_argn("sweetbusvote", &flag, sizeof(flag));
+    return flag == 1;
+}
+enum gbcmt_state sweet_bcm_transport_state(void)
+{ return (enum gbcmt_state)__atomic_load_n(&gt_state, __ATOMIC_ACQUIRE); }
+static bool gt_conflicts(void)
+{
+    static const char *const keys[] = {"sweettouchmode", "sweetwdtpet", "sweetreboot",
+        "sweetbusprobe", "sweetgpuprobe", "sweetscmprobe", "sweetwdttest"};
+    for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); ++i) {
+        int value = 0; (void)PE_parse_boot_argn(keys[i], &value, sizeof(value));
+        if (value != 0) return true;
+    }
+    return false;
+}
+static bool gt_plan_valid(const struct gbcm_plan *p)
+{
+    static const uint32_t values[GBCM_COUNT] = {
+        0x6fffffff,0x6fffffff,0x2fffffff,0x6fffffff,0x6fffffff,0x60000008};
+    if (p->wait_mask != 0x3bu) return false;
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        const struct gbcm_board_row *b = &gbcm_board[i];
+        const struct gbcm_db *d = &p->db[i];
+        if (d->address != b->address || d->unit != b->unit || d->width != b->width ||
+            d->vcd != b->vcd || d->reserved || p->cmd[i].address != b->address ||
+            p->cmd[i].data != values[i] || p->cmd[i].wait != ((0x3bu >> i) & 1u)) return false;
+    }
+    return true;
+}
+static bool gt_budget(uint32_t minimum)
+{ return gt_context() && mach_absolute_time() < gt_deadline && gauguin_wdt_lease_check_budget(minimum); }
+/* Every synchronous write is performed ONCE. Polls have both a count and a
+ * shared10s transaction deadline; no copy of native's unbounded sync loop. */
+static bool gt_sync(uint32_t offset, uint32_t value)
+{
+    if (!gt_budget(GT_POLL_TICKS)) return false;
+    gt_write(offset, value);
+    for (unsigned i = 0; i < 1000; ++i) {
+        if (!gt_budget(GT_POLL_TICKS)) return false;
+        if (gt_read(offset) == value) return true;
+        delay(10);
+    }
+    return false;
+}
+struct gt_snapshot { uint32_t config, irq_en, irq_status, tcs[8][4]; };
+static bool gt_snapshot(struct gt_snapshot *s)
+{
+    memset(s, 0, sizeof(*s));
+    s->config = gt_read(GT_CONFIG);
+    unsigned count = (s->config >> 12) & 63u, ncpt = (s->config >> 27) & 31u;
+    if (count < 8 || ncpt < 6 || ncpt > 16) return false;
+    s->irq_en = gt_read(GT_IRQ_EN); s->irq_status = gt_read(GT_IRQ_STATUS);
+    if ((s->irq_en & GT_BIT) || s->irq_en == UINT32_MAX || s->irq_status != 0) return false;
+    /* Dedicated experiment: require every normal slot inert as observed in113.
+     * We do not own or change the six sleep/wake slots merely by inspecting them. */
+    for (unsigned t = 0; t < 8; ++t) {
+        uint32_t base = GT_BASE + t * GT_STRIDE;
+        for (unsigned f = 0; f < 4; ++f) s->tcs[t][f] = gt_read(base + GT_WAIT + f * 4u);
+        if (s->tcs[t][0] || s->tcs[t][1] || !s->tcs[t][2] ||
+            s->tcs[t][2] == UINT32_MAX || s->tcs[t][3]) return false;
+    }
+    return true;
+}
+static uint32_t gt_msgid(unsigned command)
+{ return 0x10008u | (((0x3bu >> command) & 1u) ? 0x100u : 0u); }
+static bool gt_payload_matches(const struct gbcm_plan *p)
+{
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        uint32_t base = GT_OWN + i * GT_CMD_STRIDE;
+        if (gt_read(base + GT_MSGID) != gt_msgid(i) ||
+            gt_read(base + GT_ADDR) != p->cmd[i].address ||
+            gt_read(base + GT_DATA) != p->cmd[i].data) return false;
+    }
+    return gt_read(GT_OWN + GT_WAIT) == 0x3bu && gt_read(GT_OWN + GT_ENABLE) == 0x3fu;
+}
+
+enum gbcmt_rc
+sweet_bcm_submit_once(const struct gbcm_plan *input, struct gbcmt_receipt *out)
+{
+    unsigned expected = GBCMT_IDLE;
+    struct gbcm_plan plan;
+    struct gt_snapshot first, second;
+    uint32_t irq = UINT32_MAX;
+    char line[192];
+    if (!sweet_bcm_vote_requested()) return GBCMT_OFF;
+    if (!input || !out) return GBCMT_ARGUMENT;
+    if (!__atomic_compare_exchange_n(&gt_state, &expected, GBCMT_RUNNING, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return GBCMT_ALREADY;
+    if (!gt_context()) return gt_fail(GBCMT_CONTEXT, "invalid thread context");
+    plan = *input; /* caller's immutable CPU-owned validated plan; no MMIO input */
+    if (!gt_plan_valid(&plan) || gt_conflicts()) return gt_fail(GBCMT_CONFIG, "plan/boot flags rejected");
+    if (!gauguin_wdt_lease_check_budget(GT_START_TICKS)) return gt_fail(GBCMT_BUDGET, "armed watchdog lease unavailable");
+    if (!sweet_rsc_irq_quiet(&irq)) return gt_fail(GBCMT_CONFIG, "GIC NS INTID37 is enabled/unavailable");
+    snprintf(line, sizeof(line), "SWEET BCM TX: ACTIVE1 exclusive experiment; GIC NS ISENABLER1=%08x; secure ownership unproven", irq);
+    gt_record(line);
+    ppnum_t page = (ppnum_t)(GT_PA >> PAGE_SHIFT);
+    if (pmap_valid_page(page) || (pmap_cache_attributes(page) & 255u) != 7u) return gt_fail(GBCMT_MAPPING, "pmap not unmanaged Device");
+    gt_record("SWEET BCM TX: mapping DRV2 18220000+4000 Device RW; fixed ACTIVE1 whitelist");
+    gt_map = ml_io_map_with_prot(GT_PA, GT_BYTES, VM_PROT_READ | VM_PROT_WRITE);
+    if (!gt_map || ml_vtophys(gt_map) != GT_PA || ml_vtophys(gt_map + GT_BYTES - 1u) != GT_PA + GT_BYTES - 1u) return gt_fail(GBCMT_MAPPING, "map/translation failed");
+    if (!gt_snapshot(&first)) return gt_fail(GBCMT_BUSY, "geometry/slot/pending IRQ not inert");
+    IOSleep(1);
+    if (!gt_snapshot(&second) || memcmp(&first, &second, sizeof(first))) return gt_fail(GBCMT_BUSY, "preflight snapshot changed");
+    gt_receipt.slot = GT_SLOT; gt_receipt.config = first.config; gt_receipt.irq_before = first.irq_en;
+    gt_record("SWEET BCM TX: preflight stable; six native batch commands, WAIT3b/ENABLE3f; next write claims own IRQ bit1");
+    clock_interval_to_deadline(GT_TOTAL_MS, NSEC_PER_MSEC, &gt_deadline);
+    if (!gt_budget(GT_START_TICKS) || !sweet_rsc_irq_quiet(&irq) ||
+        !gt_snapshot(&second) || memcmp(&first, &second, sizeof(first))) return gt_fail(GBCMT_BUSY, "pre-write guard changed");
+    if (!gt_sync(GT_IRQ_EN, first.irq_en | GT_BIT)) return gt_fail(GBCMT_READBACK, "own IRQ enable readback/budget");
+    /* A masked old pending indication may appear on unmask: never ACK it and
+     * never mistake it for this request. IRQ_CLEAR does not clear CMD_STATUS. */
+    if (gt_read(GT_IRQ_STATUS) != 0) return gt_fail(GBCMT_BUSY, "pending IRQ appeared before payload");
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        uint32_t base = GT_OWN + i * GT_CMD_STRIDE;
+        if (!gt_budget(GT_POLL_TICKS)) return gt_fail(GBCMT_BUDGET, "payload budget");
+        if (!gt_sync(base + GT_MSGID, gt_msgid(i)) ||
+            !gt_sync(base + GT_ADDR, plan.cmd[i].address) ||
+            !gt_sync(base + GT_DATA, plan.cmd[i].data)) return gt_fail(GBCMT_READBACK, "payload readback");
+    }
+    if (!gt_sync(GT_OWN + GT_WAIT, 0x3bu) || !gt_sync(GT_OWN + GT_ENABLE, 0x3fu)) return gt_fail(GBCMT_READBACK, "WAIT/ENABLE readback");
+    /* Native trigger order: clear TRIGGER, clear AMC, set AMC, trigger ONCE. */
+    uint32_t control = gt_read(GT_OWN + GT_CONTROL);
+    if (control != 0 || gt_read(GT_IRQ_EN) != (first.irq_en | GT_BIT)) return gt_fail(GBCMT_BUSY, "controller ownership changed before trigger");
+    if (!gt_sync(GT_OWN + GT_CONTROL, control & ~GT_TRIGGER) ||
+        !gt_sync(GT_OWN + GT_CONTROL, control & ~(GT_TRIGGER | GT_AMC)) ||
+        !gt_sync(GT_OWN + GT_CONTROL, GT_AMC)) return gt_fail(GBCMT_READBACK, "AMC preparation");
+    if (!gt_budget(GT_POLL_TICKS) || !sweet_rsc_irq_quiet(&irq) || gt_read(GT_CONFIG) != first.config ||
+        gt_read(GT_IRQ_STATUS) != 0 || !gt_payload_matches(&plan)) return gt_fail(GBCMT_BUSY, "final trigger guards changed");
+    gt_write(GT_OWN + GT_CONTROL, GT_AMC | GT_TRIGGER); /* never sync/rewrite trigger */
+    bool complete = false;
+    for (unsigned i = 0; i < GT_TOTAL_MS; ++i) {
+        if (!gt_budget(GT_POLL_TICKS)) return gt_fail(GBCMT_TIMEOUT, "completion deadline/watchdog budget");
+        uint32_t pending = gt_read(GT_IRQ_STATUS);
+        if (pending & ~GT_BIT) return gt_fail(GBCMT_BUSY, "foreign completion observed");
+        if (pending == GT_BIT) { gt_receipt.irq_completed = pending; complete = true; break; }
+        IOSleep(1);
+    }
+    if (!complete) return gt_fail(GBCMT_TIMEOUT, "no new own completion IRQ");
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        uint32_t value = gt_read(GT_OWN + GT_CMD_STATUS + i * GT_CMD_STRIDE);
+        gt_receipt.cmd_status[i] = value;
+        if (value == UINT32_MAX || !(value & GT_ISSUED) ||
+            (((0x3bu >> i) & 1u) && !(value & GT_COMPL))) return gt_fail(GBCMT_COMPLETION, "native command status incomplete");
+    }
+    uint32_t idle = gt_read(GT_OWN + GT_STATUS);
+    control = gt_read(GT_OWN + GT_CONTROL);
+    if (!idle || idle == UINT32_MAX || (control & ~(GT_AMC | GT_TRIGGER)) ||
+        gt_read(GT_IRQ_EN) != (first.irq_en | GT_BIT) || !gt_payload_matches(&plan)) return gt_fail(GBCMT_COMPLETION, "completed payload/idle/ownership changed");
+    /* Clear only the successful transport. This does not release BCM votes. */
+    if (!gt_sync(GT_OWN + GT_CONTROL, control & ~GT_TRIGGER) ||
+        !gt_sync(GT_OWN + GT_CONTROL, control & ~(GT_TRIGGER | GT_AMC)) ||
+        !gt_sync(GT_OWN + GT_ENABLE, 0) || !gt_sync(GT_OWN + GT_WAIT, 0)) return gt_fail(GBCMT_READBACK, "successful transport cleanup");
+    if (!gt_budget(GT_POLL_TICKS)) return gt_fail(GBCMT_BUDGET, "before own IRQ clear");
+    gt_write(GT_IRQ_CLEAR, GT_BIT); /* write-one-to-clear OWN bit, never a read */
+    bool cleared = false;
+    for (unsigned i = 0; i < 1000; ++i) {
+        if (!gt_budget(GT_POLL_TICKS)) return gt_fail(GBCMT_TIMEOUT, "IRQ clear budget");
+        uint32_t pending = gt_read(GT_IRQ_STATUS);
+        if (pending & ~GT_BIT) return gt_fail(GBCMT_BUSY, "foreign IRQ during cleanup");
+        if (!pending) { cleared = true; break; }
+        delay(10);
+    }
+    if (!cleared) return gt_fail(GBCMT_TIMEOUT, "own IRQ did not clear");
+    uint32_t current_irq = gt_read(GT_IRQ_EN);
+    if (current_irq != (first.irq_en | GT_BIT)) return gt_fail(GBCMT_BUSY, "IRQ enable changed during cleanup");
+    /* Restore only the one bit we acquired; never write a stale full mask. */
