+struct nfw_window { uint32_t base, bytes; };
+struct nfw_policy {
+    size_t window_count;
+    struct nfw_window windows[NFW_MAX_WINDOWS];
+};
+struct nfw_partition {
+    enum nfw_kind kind;
+    uint32_t index, bin_offset, sram, size_field, bytes, golden_crc;
+};
