+
+static bool
+sweet_script_display_ready(uint64_t now)
+{
+	uint32_t state = sweet_fb_display_state();
+	if (state == 0 || state > 2) {
+		printf("SWEET UI WAKE: unknown display state=%u; abort\n", state);
+		sweet_script_abort(); return false;
+	}
+	if (sweet_script_wake_phase == SWEET_WAKE_INITIAL && state == 2) {
+		sweet_script_wake_phase = SWEET_WAKE_WAIT;
+		clock_interval_to_deadline(5000, NSEC_PER_MSEC, &sweet_script_end);
+		/* Queue release in this same callback, even if wake rendering is slow.
+		 * A later timer must never be responsible for releasing the key. */
+		printf("SWEET UI WAKE: power press tick=%llu state=off\n", (unsigned long long)now);
+		sweet_hid_key(0, 1);
+		sweet_hid_key(0, 0);
+		printf("SWEET UI WAKE: power release tick=%llu; one pair only\n", (unsigned long long)mach_absolute_time());
+	} else if (state == 1) {
+		if (sweet_script_wake_phase == SWEET_WAKE_SETTLE) {
+			sweet_script_wake_phase = SWEET_WAKE_READY;
+			clock_interval_to_deadline(1500, NSEC_PER_MSEC, &sweet_script_end);
+			printf("SWEET UI WAKE: display-on confirmed tick=%llu; begin workload\n", (unsigned long long)now);
+			return true;
+		}
+		sweet_script_wake_phase = SWEET_WAKE_SETTLE;
+		clock_interval_to_deadline(1000, NSEC_PER_MSEC, &sweet_script_due);
+		clock_interval_to_deadline(2500, NSEC_PER_MSEC, &sweet_script_end);
+		printf("SWEET UI WAKE: observed on tick=%llu; settle 1s\n", (unsigned long long)now);
+		thread_call_enter_delayed(sweet_script_call, sweet_script_due);
+		return false;
+	} else if (sweet_script_wake_phase == SWEET_WAKE_SETTLE) {
+		printf("SWEET UI WAKE: display returned off during settle; abort\n");
+		sweet_script_abort(); return false;
+	}
+	if (++sweet_script_wake_polls > 100) {
+		printf("SWEET UI WAKE: poll limit; abort\n");
+		sweet_script_abort(); return false;
+	}
+	clock_interval_to_deadline(50, NSEC_PER_MSEC, &sweet_script_due);
+	thread_call_enter_delayed(sweet_script_call, sweet_script_due);
+	return false;
 }

