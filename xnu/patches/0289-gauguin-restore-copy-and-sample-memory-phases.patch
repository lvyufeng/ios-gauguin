--- /dev/null
+++ b/bsd/dev/gauguin_frame378_probe.h
@@ -0,0 +1,66 @@
+#ifndef GAUGUIN_FRAME378_PROBE_H
+#define GAUGUIN_FRAME378_PROBE_H
+
+#include "gauguin_frame372_wire.h"
+
+enum {
+    F378_PROBE_ROWS = 8,
+    F378_PROBE_BLOCK = 8,
+    F378_PROBE_CAP = 80,
+    F378_CONTROL_LIMIT = 16,
+    F378_SCENE_LIMIT = 32,
+    F378_CONTROL = 1,
+    F378_STROKE2 = 2,
+    F378_STROKE6 = 3,
+    F378_ROW_FIRST = 128,
+    F378_ROW_STEP = 288,
+    F378_MIN_SLACK_NS = 5700000,
+    F378_PROBE_ROW_BYTES = 55,
+};
+
+/* Offsets are 19.2 MHz absolute ticks relative to F344 arming. The
+ * windows replay the times of the observed stroke 2 and 6 release tails. */
+static inline unsigned
+f378_probe_class(uint64_t tick, uint64_t start, uint64_t attempt)
+{
+    if (!start || !attempt || tick < start) return 0;
+    const uint64_t offset = tick - start;
+    if (offset >= UINT64_C(157056000) && offset < UINT64_C(166656000)) return F378_STROKE2;
+    if (offset >= UINT64_C(336960000) && offset < UINT64_C(346752000)) return F378_STROKE6;
+    return attempt % 71 == 0 ? F378_CONTROL : 0;
+}
+
+struct f378_probe_deltas {
+    uint32_t read[F378_PROBE_ROWS];
+    uint32_t issue[F378_PROBE_ROWS];
+    uint32_t drain;
+};
+
+static inline bool
+f378_le24(uint8_t *out, uint32_t value)
+{
+    if (value > 0xffffff) return false;
+    out[0] = (uint8_t)value;
+    out[1] = (uint8_t)(value >> 8);
+    out[2] = (uint8_t)(value >> 16);
+    return true;
+}
+
+static inline bool
+f378_pack_probe(uint8_t out[F378_PROBE_ROW_BYTES], uint64_t attempt, unsigned lane,
+    const struct f378_probe_deltas *group)
+{
+    if (!attempt || attempt > UINT16_MAX || lane < F378_CONTROL || lane > F378_STROKE6)
+        return false;
+    out[0] = (uint8_t)attempt;
+    out[1] = (uint8_t)(attempt >> 8);
+    out[2] = (uint8_t)lane;
+    out[3] = (uint8_t)(attempt % F378_PROBE_ROWS);
+    for (unsigned row = 0; row < F378_PROBE_ROWS; ++row) {
+        if (!f378_le24(out + 4 + row * 6, group->read[row]) ||
+            !f378_le24(out + 7 + row * 6, group->issue[row])) return false;
+    }
+    return f378_le24(out + 4 + 6 * F378_PROBE_ROWS, group->drain);
+}
+
+#endif
