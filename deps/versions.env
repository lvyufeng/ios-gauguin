# Pinned revisions for deps/build-local.sh (see deps/README.md).
# Same sources dxb uses for macOS 13.5 (apple-oss-distributions/distribution-macOS
# macos-135/release.json) plus the commits the SWEET staging scripts pin.
XNU_TAG=xnu-8796.141.3
XNU_REV=1b191cb58250d0705d8a51287127505aa4bc0789
DTRACE_TAG=dtrace-397
DTRACE_REV=3df488e9184b2ecbeeccebe0cc05f504714722b2
AVV_TAG=AvailabilityVersions-121
LIBSYSTEM_TAG=Libsystem-1319.100.3
LIBPLATFORM_TAG=libplatform-292.120.1.0.1
LIBDISPATCH_TAG=libdispatch-1415.140.2
# Bump PATCH_SET whenever xnu/patches changes so the cached tree is rebuilt.
PATCH_SET=0082-2
REPO_URL=https://github.com/lvyufeng/ios-gauguin
# guagvin/sweet patches are applied to the checkout above; the res of these
# trees is fetched by revision (depth 1) at the build tags, not by tag name,
# except when a revision is given:
AVV_REV=
LIBSYSTEM_REV=
LIBPLATFORM_REV=
LIBDISPATCH_REV=
