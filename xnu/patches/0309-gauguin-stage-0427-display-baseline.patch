+    const uint32_t sensor_mask = (0xfu << (9 + 3)) | 1u;
+    const bool sensors = srot != UINT32_MAX && (srot & sensor_mask) == sensor_mask;
+    cpu402.configured = sensors && cpu402_find_point(cpu402_read, (void *)cpu402.perf, &cpu402.point);
+    if (!cpu402.configured) {
