+        {RX_PACK0,0x7f8fe}, {RX_PACK1,0xffefe}, {BYTE_GRAN,0}, {WORD_LEN,4},
+        {LOOPBACK,0}, {CS_SEL,0}, {CPHA,0}, {CPOL,0}, {CS_INV,0}, {DELAYS,0},
+        {TRANS_CFG,0}, {TX_WM,0}, {RX_WM,0}, {RX_RFR,14}
+    };
