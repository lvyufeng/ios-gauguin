+    NFW_OK, NFW_ARGUMENT, NFW_HEADER, NFW_BOUNDS, NFW_CAPACITY,
+    NFW_SRAM, NFW_OVERLAP, NFW_CRC_LENGTH, NFW_END_MARKER, NFW_VERSION,
+    NFW_UNQUALIFIED_OFFSET
+};
