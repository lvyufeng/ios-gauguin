new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_ready353.h
@@ -0,0 +1,35 @@
+#ifndef GAUGUIN_READY353_H
+#define GAUGUIN_READY353_H
+
+#include "gauguin_blank352.h"
+
+struct scan353_ready {
+    bool observed;
+    uint64_t frame;
+};
+
+static inline bool
+scan353_mark(struct scan353_ready *ready, uint64_t ticket, uint64_t watched,
+    uint64_t watched_generation, uint64_t pending_generation, uint32_t surface, uint64_t observed_frame)
+{
+    if (ready->observed || !scan352_matches(ticket, watched, watched_generation, pending_generation, surface))
+        return false;
+    ready->observed = true;
+    ready->frame = observed_frame;
+    return true;
+}
+
+static inline bool
+scan353_can_take(const struct scan353_ready *ready, const struct scan351_slot *slot,
+    const struct scan351_position *position)
+{
+    return ready->observed && scan352_can_take(slot, position, false);
+}
+
+static inline bool
+scan353_carried(const struct scan353_ready *ready, uint32_t target_frame)
+{
+    return ready->observed && ready->frame != UINT64_MAX && (uint32_t)ready->frame != target_frame;
+}
+
+#endif
