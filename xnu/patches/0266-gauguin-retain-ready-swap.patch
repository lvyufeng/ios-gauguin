--- /dev/null
+++ b/bsd/dev/gauguin_ready354.h
@@ -0,0 +1,44 @@
+#ifndef GAUGUIN_READY354_H
+#define GAUGUIN_READY354_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* The low bits describe GPU readiness. The remaining bits advance before
+ * each new GPU writer can access this surface. The version saturates so a
+ * held display record can never match again after a wrap. */
+#define SCAN354_GPU_STATUS 3u
+#define SCAN354_GPU_VERSION (~SCAN354_GPU_STATUS)
+
+static inline uint32_t
+scan354_next_version(uint32_t state)
+{
+    const uint32_t version = state & SCAN354_GPU_VERSION;
+    return version == SCAN354_GPU_VERSION ? version : version + SCAN354_GPU_STATUS + 1;
+}
+
+static inline uint32_t
+scan354_gpu_state(uint32_t previous, uint32_t status, bool writer)
+{
+    return (writer ? scan354_next_version(previous) : previous & SCAN354_GPU_VERSION) | status;
+}
+
+static inline bool
+scan354_has_version(uint32_t state, uint32_t expected)
+{
+    return expected < SCAN354_GPU_VERSION && (state & SCAN354_GPU_VERSION) == expected;
+}
+
+static inline bool
+scan354_can_promote(uint32_t state, uint32_t version, uint64_t waiting, uint64_t ready)
+{
+    return waiting > ready && state == version && scan354_has_version(state, version);
+}
+
+static inline bool
+scan354_can_retry(uint32_t state, uint32_t version, uint64_t selected, uint64_t ready)
+{
+    return selected > ready && scan354_has_version(state, version);
+}
+
+#endif
