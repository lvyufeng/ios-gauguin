+		    strnlen(sweet_kmsg_needle, sizeof(sweet_kmsg_needle))) != 0) {
+			cache[idx].p = port;
+			cache[idx].want = false;
+			return;
+		}
+		cache[idx].p = port;
+		cache[idx].want = true;
+	}
+matched:
+	uint32_t slot = __atomic_fetch_add(&sweet_kmsg_count, 1, __ATOMIC_RELAXED);
+	if (slot >= SWEET_KMSG_SLOTS) {
+		return;
+	}
+	sweet_kmsg_ports[slot] = port;
+	proc_selfname(sweet_kmsg_senders[slot], sizeof(sweet_kmsg_senders[slot]));
+}
+
+void
+sweet_kmsg_report(void)
+{
+	/*
+	 * Once, not on every receive.
+	 *
+	 * This is called from ipc_mqueue_receive, which runs for every message
+	 * received in the system - the sibling report ran 34,132 times in one
+	 * boot. Each call walks 64 slots and resolves a process name per slot,
+	 * so the unguarded version was millions of operations of pure overhead
+	 * on a single core.
+	 */
+	static uint32_t calls;
+
+	if (sweet_kmsg_needle[0] == '\0') {
+		return;
+	}
+	/*
+	 * Every 4096th receive. Reporting only once would print the state before
+	 * most messages are sent; reporting every time (34,132 calls in one boot)
+	 * is pure overhead. A sparse periodic sample keeps both ends visible.
+	 */
+	if ((__atomic_fetch_add(&calls, 1, __ATOMIC_RELAXED) & 4095u) != 0) {
+		return;
+	}
+	uint32_t n = sweet_kmsg_count;
+	if (n > SWEET_KMSG_SLOTS) {
+		n = SWEET_KMSG_SLOTS;
+	}
+	uint32_t hits = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		ipc_port_t port = sweet_kmsg_ports[i];
+		const char *owner = "?";
+		if (port != IPC_PORT_NULL) {
+			ipc_space_t space = port->ip_receiver;
+			if (space != IPC_SPACE_NULL && space->is_task != TASK_NULL) {
+				extern void *get_bsdtask_info(task_t);
+				extern char *proc_name_address(void *p);
+				void *p = get_bsdtask_info(space->is_task);
+				if (p != NULL) {
+					char *nm = proc_name_address(p);
+					if (nm != NULL && nm[0] != '\0') {
+						owner = nm;
+					}
+				}
+			}
+		}
+		if (strncmp(owner, sweet_kmsg_needle,
+		    strnlen(sweet_kmsg_needle, sizeof(sweet_kmsg_needle))) == 0) {
+			hits++;
+			printf("SWEET KMSG: %s -> %s\n", sweet_kmsg_senders[i], owner);
+		}
+	}
+	printf("SWEET KMSG: %u captured, %u to %s\n", n, hits, sweet_kmsg_needle);
+}
+
+void
+sweet_msgsend_report(void)
+{
+	/*
+	 * Sampled, not every receive.
+	 *
+	 * Unbounded, this printed once per message received in the whole system and
+	 * filled the 4 MiB ring with nothing else: a boot that looked like it
+	 * "stopped at 941 lines" was a boot whose entire log was this line
+	 * repeated. It cost rounds chasing a phantom regression.
+	 */
+	static uint32_t calls;
+	if ((__atomic_fetch_add(&calls, 1, __ATOMIC_RELAXED) & 4095u) != 0) {
+		return;
+	}
+	uint32_t n = sweet_msgsend_count;
+
+	if (n > SWEET_MSGSEND_SLOTS) {
+		n = SWEET_MSGSEND_SLOTS;
+	}
+	printf("SWEET MSGSEND: %u message(s) captured\n", n);
+	for (uint32_t i = 0; i < n; i++) {
+		ipc_port_t port = sweet_msgsend_ports[i];
+		const char *owner = "?";
+		if (port != IPC_PORT_NULL) {
+			ipc_space_t space = port->ip_receiver;
+			if (space != IPC_SPACE_NULL && space->is_task != TASK_NULL) {
+				extern void *get_bsdtask_info(task_t);
+				extern char *proc_name_address(void *p);
+				void *p = get_bsdtask_info(space->is_task);
+				if (p != NULL) {
+					char *nm = proc_name_address(p);
+					if (nm != NULL && nm[0] != '\0') {
+						owner = nm;
+					}
+				}
+			}
+		}
+		printf("SWEET MSGSEND: %s -> %s port=%p\n",
+		    sweet_msgsend_senders[i], owner, (void *)port);
+	}
+}
+static bool sweet_msgwait_parsed;
+static unsigned sweet_msgwait_lines;
+
+/*
+ * Parse the boot-arg.
+ *
+ * This has to be callable from the call site, not from inside the trace: the
+ * call site gates on `sweet_msgwait_needle[0] != '\0'`, so a tracer that only
+ * parses on its own first invocation can never be reached - the needle stays
+ * empty forever and the trace never runs. That is why
+ * sweetmsgwait=SpringBoard produced no output at all (NOTES (53)).
+ */
+void
+sweet_msgwait_init(void)
+{
+	if (sweet_msgwait_parsed) {
+		return;
+	}
+	sweet_msgwait_parsed = true;
+	if (!PE_parse_boot_argn("sweetmsgwait", sweet_msgwait_needle,
+	    sizeof(sweet_msgwait_needle))) {
+		sweet_msgwait_needle[0] = '\0';
+	}
+}
+
+void
+sweet_msgwait_trace(struct waitq *waitq, const char *procname)
+{
+	sweet_msgwait_init();
+	/*
+	 * 200, not 40. With a cap of 40 the whole record was used up between log
+	 * lines 620 and 777 of a 1649-line boot: the first 7 ports filled it and
+	 * every later wait on any other port was invisible (NOTES (81)). The cap
+	 * is there to bound the ring's use, not to sample the first few events.
+	 */
+	if (sweet_msgwait_needle[0] == '\0' || sweet_msgwait_lines >= 2000) {
+		return;
+	}
+	/*
+	 * Prefix match on the needle's own length. The previous form compared
+	 * sizeof(needle) (48) bytes against a char[32] name, which reads past the
+	 * name's terminator and never matches a shorter needle (NOTES (53)).
+	 */
+	if (strncmp(procname, sweet_msgwait_needle,
+	    strnlen(sweet_msgwait_needle, sizeof(sweet_msgwait_needle))) != 0) {
+		return;
+	}
+	sweet_msgwait_lines++;
