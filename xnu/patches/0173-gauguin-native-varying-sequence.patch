+}
+bool ggv_artifact_allowed(uint32_t off)
+{
+    if(off&3)return false;
+    for(unsigned id=0;id<GGV_BLOBS;id++){
+        struct ggv_blob b;if(!ggv_blob_get(0,id,&b))return false;
+        if(b.words&&off>=b.offset&&off-b.offset<4*b.words)return true;
+    }
