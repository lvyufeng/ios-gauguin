+static int
+sweet_scan_log_record(uint32_t run, unsigned mode, bool done, const struct gscan_result *r)
+{
+	_Static_assert(SWEET_LOG_BLOCKS == GSCAN_LOG_BLOCKS, "scan log ring size");
+	_Static_assert(UFS_RESERVED_TAIL_BLOCKS == GSCAN_LOG_RESERVED, "scan log tail size");
+	uint64_t lba;
+	if (!run || mode < 1 || mode > 3 || su.ready || su.writable || !su.dma ||
+	    !gscan_log_record_lba(su.first_block, su.nblocks, su.fs_nblocks, &lba))
+		return EPERM;
+
+	uint8_t *block = (uint8_t *)(su.dma + DMA_MARK);
+	lck_mtx_lock(&sweet_dma_owner_lock);
+	if (!ufs_dma_available()) {
+		lck_mtx_unlock(&sweet_dma_owner_lock);
+		return EIO;
+	}
+	bzero(block, UFS_BLOCK);
+	int len = snprintf((char *)block, UFS_BLOCK,
+	    "GAUGUIN_SCAN1 run=%u mode=%u done=%u status=%u stage=%u\n"
+	    "gcc=%08x/%08x/%08x disp=%08x/%08x/%08x/%08x timing=%08x count=%08x\n"
+	    "attempts=%u samples=%u crossed=%u frame=%u/%u line=%u/%u advances=%u "
+	    "start_ns=%llu end_ns=%llu millihz=%u nominal=%u\nEND_GAUGUIN_SCAN1 run=%u\n",
+	    run, mode, (unsigned)done, r->status, r->stage, r->gcc[0], r->gcc[1], r->gcc[2],
+	    r->disp[0], r->disp[1], r->disp[2], r->disp[3], r->timing_enable, r->counter_enable,
+	    r->attempts, r->samples, r->crossed, r->first_frame, r->last_frame, r->first_line,
+	    r->last_line, r->frames, (unsigned long long)r->start_ns,
+	    (unsigned long long)r->end_ns, r->millihz, r->nominal_hz, run);
+	if (len <= 0 || (unsigned)len >= UFS_BLOCK) {
+		lck_mtx_unlock(&sweet_dma_owner_lock);
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0, (uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8),
+		(uint8_t)lba, 0, 0, 1, 0
+	};
+	clean_dcache64((addr64_t)(su.dma_pa + DMA_MARK), UFS_BLOCK, TRUE);
+	int error = ufs_scsi_slot(cdb, sizeof(cdb), UFS_BLOCK, true,
+	    su.dma_pa + DMA_MARK, UFS_SLOT_MARK);
+	if (!error)
+		error = sweet_log_sync_cache();
+	lck_mtx_unlock(&sweet_dma_owner_lock);
+	return error;
+}
+
+void sweet_scan_log_diagnostic(void);
+
+void
+sweet_scan_log_diagnostic(void)
+{
+	uint32_t requested = 0;
+	if (!PE_parse_boot_argn("sweetscanlog", &requested, sizeof(requested)) || !requested)
+		return;
+
+	uint32_t scan = 0, ufs_write = 0, root_write = 0, run = 0;
+	PE_parse_boot_argn("sweetscan", &scan, sizeof(scan));
+	PE_parse_boot_argn("ufsrw", &ufs_write, sizeof(ufs_write));
+	PE_parse_boot_argn("rootrw", &root_write, sizeof(root_write));
+	PE_parse_boot_argn("sweetscanid", &run, sizeof(run));
+	if (gscan_log_profile(requested, scan, ufs_write, root_write, run)) {
+		int result = sweet_ufs_init(true);
+		if (!result) {
+			struct gscan_result snapshot = {0};
+			bool done = false;
+			for (unsigned i = 0; i < 80 && !(done = sweet_scan_timing_snapshot(&snapshot)); ++i)
+				IOSleep(25);
+			if (!done)
+				done = sweet_scan_timing_snapshot(&snapshot);
+			result = sweet_scan_log_record(run, scan, done, &snapshot);
+		}
+		printf("SWEET SCANLOG: run=%u rc=%d before root mount\n", run, result);
+	} else {
+		printf("SWEET SCANLOG: conflicting boot profile; no disk access\n");
+	}
+
+	/* An opted-in diagnostic never falls through to mounting the root. */
+	(void)reboot_kernel(RB_AUTOBOOT | RB_QUICK | RB_NOSYNC, NULL);
+	panic("SWEET SCANLOG: platform restart returned");
+}
