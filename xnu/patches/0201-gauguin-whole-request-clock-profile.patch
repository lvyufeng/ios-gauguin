+
+/* All mutable samples are protected by gLock after publication. Before it,
+ * the unpublished runtime owner is exclusive and no API sample is active.
+ * Times are elapsed wall time, NOT CPU-active or GPU-only execution time. */
+enum { GAPI_COUNT=16 };
+static const uint32_t gapi_selectors[GAPI_COUNT]={
+    0x09,0x40,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x4a,0x4b,0x4c,0x7e,
+    0x100,0x101,0x102 /* memory mapping,clientClose,heartbeat */
+};
+struct gapi_sample {uint64_t calls,failures,queue_ticks,held_ticks,max_held_ticks;};
+struct gapi_pending {uint64_t token,queued,locked;uint32_t index;};
+static struct gapi_sample gapi_samples[GAPI_COUNT];
+static struct gapi_pending gapi_pending;
+static uint64_t gapi_sequence,gapi_pending_queue,gapi_pending_held;
+static bool gapi_valid=true,gapi_frozen,gapi_dumped;
+static bool gapi_add(uint64_t *value,uint64_t delta)
+{
+    if(*value>UINT64_MAX-delta){gapi_valid=false;return false;}
+    *value+=delta;return true;
+}
+static uint64_t gapi_begin(uint32_t selector,uint64_t queued,uint64_t locked)
+{
+    if(gapi_frozen||!gapi_valid)return 0;
+    unsigned index=0;while(index<GAPI_COUNT&&gapi_selectors[index]!=selector)++index;
+    if(index==GAPI_COUNT||gapi_pending.token||locked<queued||gapi_sequence==UINT64_MAX){
+        gapi_valid=false;return 0;
+    }
+    gapi_pending={++gapi_sequence,queued,locked,index};
+    return gapi_pending.token;
+}
+static void gapi_end(uint64_t token,IOReturn result)
+{
+    if(!token||gapi_frozen)return;
+    if(token!=gapi_pending.token){gapi_valid=false;return;}
+    uint64_t now=mach_absolute_time();
+    if(!gapi_valid||now<gapi_pending.locked){gapi_valid=false;gapi_pending={};return;}
+    uint64_t queued=gapi_pending.locked-gapi_pending.queued,held=now-gapi_pending.locked;
+    struct gapi_sample sample=gapi_samples[gapi_pending.index];
+    if(gapi_add(&sample.calls,1)&&gapi_add(&sample.failures,result!=kIOReturnSuccess)&&
+       gapi_add(&sample.queue_ticks,queued)&&gapi_add(&sample.held_ticks,held)){
+        if(held>sample.max_held_ticks)sample.max_held_ticks=held;
+        gapi_samples[gapi_pending.index]=sample;
+    }
+    gapi_pending={};
+}
+extern "C" void GauguinGPUProfileFreeze(void)
+{
+    if(gapi_frozen)return;
+    gapi_frozen=true;
+    if(gapi_pending.token){
+        uint64_t now=mach_absolute_time();
+        if(now<gapi_pending.locked){gapi_valid=false;return;}
+        gapi_pending_queue=gapi_pending.locked-gapi_pending.queued;
+        gapi_pending_held=now-gapi_pending.locked;
+    }
+}
+extern "C" void GauguinGPUProfileDump(void (*record)(const char *))
+{
+    if(!record||!gapi_frozen||gapi_dumped)return;
+    gapi_dumped=true;char line[256];uint64_t queued,held;
+    absolutetime_to_nanoseconds(gapi_pending_queue,&queued);
+    absolutetime_to_nanoseconds(gapi_pending_held,&held);
+    snprintf(line,sizeof(line),"SWEET GPU API PERF: valid=%u pending=%u selector=%x queue_ns=%llu held_ns=%llu; completed prefix, elapsed CPU clock only",
+        gapi_valid?1u:0u,gapi_pending.token?1u:0u,gapi_pending.token?gapi_selectors[gapi_pending.index]:0u,
+        (unsigned long long)queued,(unsigned long long)held);record(line);
+    for(unsigned i=0;i<GAPI_COUNT;i++)if(gapi_samples[i].calls){
+        uint64_t maximum;const struct gapi_sample *s=&gapi_samples[i];
+        absolutetime_to_nanoseconds(s->queue_ticks,&queued);
+        absolutetime_to_nanoseconds(s->held_ticks,&held);
+        absolutetime_to_nanoseconds(s->max_held_ticks,&maximum);
+        snprintf(line,sizeof(line),"SWEET GPU API PERF: selector=%x calls=%llu failures=%llu queue_ns=%llu held_ns=%llu max_held_ns=%llu; lock-held whole request",
+            gapi_selectors[i],(unsigned long long)s->calls,(unsigned long long)s->failures,
+            (unsigned long long)queued,(unsigned long long)held,(unsigned long long)maximum);record(line);
+    }
+}
 
