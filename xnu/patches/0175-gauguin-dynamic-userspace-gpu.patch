+       !o->write_ring||!o->barrier||!o->delay_us||!o->quarantine)return GGR_ARGUMENT;
+    c->ops=*o;c->state=GGR_READY;c->wptr=20;c->scratch_iova=scratch;c->completion_iova=completion;
+    uint64_t now=o->nanoseconds(o->cookie);
+    if(now>UINT64_MAX-UINT64_C(2000000000)){ggr_fail(c,GGR_UNAVAILABLE);return GGR_UNAVAILABLE;}
+    c->operation_end_ns=now+UINT64_C(2000000000);
+    uint32_t w,shadow,eop,busy;
+    if(!faults(c)||!rd(c,0x807,&w)||w!=20||!mr(c,GGR_SHADOW,0,&shadow)||shadow!=20||
+       !mr(c,GGR_COMPLETION,0,&eop)||eop||!rd(c,0x23b0c,&busy)||busy==UINT32_MAX||(busy&(1u<<23))) {
+        ggr_fail(c,GGR_UNAVAILABLE);return GGR_UNAVAILABLE;
+    }
+    return GGR_OK;
+}
+enum ggr_error ggr_submit(struct ggr_context *c,const uint64_t *addresses,const uint32_t *words,uint32_t count,uint32_t *fence)
+{
+    if(!c||!addresses||!words||!fence||!count||count>GGR_MAX_COMMANDS)return GGR_ARGUMENT;
+    for(uint32_t i=0;i<count;i++)if(addresses[i]<GGR_VA_START||addresses[i]>=GGR_VA_END||
+        (addresses[i]&3)||!words[i]||words[i]>0xfffff||4ull*words[i]>GGR_VA_END-addresses[i])return GGR_ARGUMENT;
+    if(c->state!=GGR_READY||c->submitted==UINT32_MAX)return GGR_UNAVAILABLE;
+    uint64_t now=c->ops.nanoseconds(c->ops.cookie);
+    if(now>UINT64_MAX-UINT64_C(2000000000)){ggr_fail(c,GGR_UNAVAILABLE);return GGR_UNAVAILABLE;}
+    c->operation_end_ns=now+UINT64_C(2000000000);c->state=GGR_BUSY;
+    uint32_t shadow,wptr,busy,control;
+    if(!faults(c)||!rd(c,0x807,&wptr)||wptr!=c->wptr||!mr(c,GGR_SHADOW,0,&shadow)||shadow!=c->wptr||
+       !mr(c,GGR_COMPLETION,0,&control)||control!=c->completed||!rd(c,0x23b0c,&busy)||
+       busy==UINT32_MAX||(busy&(1u<<23)))goto io;
+    /* One in flight: the whole ring is idle, so wrapping cannot overwrite an
+     * unread packet. CP_RB_CNTL already selects the native 8192-DWORD ring. */
+    uint32_t packet[4*GGR_MAX_COMMANDS+8],n=0,next=c->submitted+1;
+    for(uint32_t i=0;i<count;i++) {
+        packet[n++]=0x70bf8003u;packet[n++]=(uint32_t)addresses[i];
+        packet[n++]=0;packet[n++]=words[i];
+    }
+    packet[n++]=0x70460004u;packet[n++]=4;packet[n++]=c->completion_iova;packet[n++]=0;packet[n++]=next;
+    packet[n++]=0x70620002u;packet[n++]=c->scratch_iova;packet[n++]=0;
+    for(uint32_t i=0;i<n;i++) {
+        if(!alive(c)||!c->ops.write_ring(c->ops.cookie,4*((c->wptr+i)%8192),packet[i])||!alive(c))goto io;
+    }
+    if(!barrier(c))goto io;
+    for(uint32_t i=0;i<n;i++) {
+        uint32_t v;
+        if(!mr(c,GGR_RING,4*((c->wptr+i)%8192),&v)||v!=packet[i])goto io;
+    }
+    uint32_t end=(c->wptr+n)%8192;
+    if(!wr(c,0x1f8c3,1)||!wr(c,0x807,end))goto io;
+    c->submitted=next;
+    /* Native fence-off path: protocol WPTR reissues, not command replays. */
+    uint32_t i;
+    for(i=0;i<200;i++) {
+        uint32_t status;
+        if(!barrier(c)||!rd(c,0x23b13,&status))goto io;
+        if(!(status&1u))break;
+        if(!delay(c)||!wr(c,0x807,end))goto io;
+    }
+    if(i==200)goto timeout;
+    if(!wr(c,0x1f8c3,0))goto io;
+    for(i=0;i<200000;i++) {
+        ++c->polls;
+        if(!faults(c)||!barrier(c)||!mr(c,GGR_COMPLETION,0,&control)||!mr(c,GGR_SHADOW,0,&shadow)||
+           !rd(c,0x23b0c,&busy))goto io;
+        if(busy==UINT32_MAX||shadow>=8192||control>next)goto io;
+        if(control==next&&shadow==end&&!(busy&(1u<<23))) {
+            c->wptr=end;c->completed=next;c->state=GGR_READY;*fence=next;return GGR_OK;
+        }
+        if(!delay(c))goto timeout;
+    }
+timeout:ggr_fail(c,GGR_TIMEOUT);return GGR_TIMEOUT;
+io:ggr_fail(c,GGR_IO);return GGR_IO;
+}
