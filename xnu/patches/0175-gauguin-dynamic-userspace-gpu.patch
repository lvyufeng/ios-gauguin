+/* msm-numbered IOKit transport for the existing A619 bootstrap.
+ * Interface compatibility: HakiOS 63fc2b4633bac3af8e57dadab9f5a8d4cb940438.
+ * The backend, ownership, exact wire validation and SweetSurface adapter here
+ * are local. Opt-in/root-only/one client; submissions initially synchronize
+ * before returning. This is not an IOAccelerator or a Metal implementation. */
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <vm/pmap.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include "SweetSurface.h"
+#include "../../../bsd/dev/gauguin_gpu_runtime.h"
+extern "C" void flush_dcache64(addr64_t,unsigned,int);
+extern "C" boolean_t pmap_valid_page(ppnum_t);
+
+static IOLock *gLock;
+static IOUserClient *gOwner;
+/* Kept until reset even on failure: a table visible to a live SMMU may never
+ * be returned to the allocator merely because an operation timed out. */
+static IOBufferMemoryDescriptor *gTables;
+static volatile uint64_t *gPtes;
+static uint64_t gAllocated[256]; /* one bit per 64KiB GPU VA allocation unit */
+static bool gPublished;
+#define GPU_TABLE_BYTES (4096u+512u*4096u)
+#define GPU_TABLE_ALLOC ((GPU_TABLE_BYTES+16383u)&~16383u)
+#define GPU_VA_UNIT UINT64_C(65536)
+
+static bool physicalPage(IOMemoryDescriptor *m,uint64_t off,uint64_t *pa)
+{
+    IOByteCount length=0;
+    uint64_t p=m->getPhysicalSegment(off,&length,kIOMemoryMapperNone);
+    /* Only pages owned by the VM allocator, never MMIO, protected PAS memory
+     * or an unvalidated physical IOSurface. Current native SMMU OAS is >=36. */
+    if(!p||(p&4095)||p>UINT64_C(0x0000000ffffff000)||length<4096||
+       !pmap_valid_page((ppnum_t)(p>>PAGE_SHIFT)))return false;
+    *pa=p;return true;
+}
+static void memoryBarrier(void)
+{__asm__ volatile("dsb sy" ::: "memory");}
+
+static bool prepareTables(void)
+{
+    if(gTables)return gPtes&&sweet_gpu_runtime_ready();
+    IOBufferMemoryDescriptor *m=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+        kIODirectionInOut|kIOMapWriteCombineCache,GPU_TABLE_ALLOC,PAGE_SIZE);
+    if(!m)return false;
+    if(m->prepare()!=kIOReturnSuccess){m->release();return false;}
+    volatile uint64_t *p=(volatile uint64_t *)m->getBytesNoCopy();
+    if(!p){m->complete();m->release();return false;}
+    bzero((void *)p,GPU_TABLE_ALLOC);
+    uint64_t directory=0;
+    bool valid=p&&physicalPage(m,0,&directory);
+    for(uint32_t i=0;i<512&&valid;i++) {
+        uint64_t leaf;
+        valid=physicalPage(m,4096ull*(i+1),&leaf);
+        if(valid)p[i]=leaf|3;
+    }
+    if(!valid){m->complete();m->release();return false;}
+    memoryBarrier();
+    /* Publish retention BEFORE handing a physical address to the SMMU. */
+    gTables=m;gPtes=p;
+    if(!sweet_gpu_runtime_install_root(directory))return false;
+    return true;
+}
+static uint64_t reserveAddress(uint64_t bytes)
+{
+    const uint32_t units=(uint32_t)((bytes+GPU_VA_UNIT-1)/GPU_VA_UNIT);
+    uint32_t first=0,run=0;
+    if(!units||units>16384)return 0;
+    for(uint32_t i=0;i<16384;i++) {
+        if(gAllocated[i/64]&(UINT64_C(1)<<(i%64))){run=0;continue;}
+        if(!run)first=i;
+        if(++run!=units)continue;
+        for(uint32_t j=first;j<first+units;j++)gAllocated[j/64]|=UINT64_C(1)<<(j%64);
+        return GGR_VA_START+first*GPU_VA_UNIT;
+    }
+    return 0;
+}
+static void releaseAddress(uint64_t address,uint64_t bytes)
+{
+    uint32_t first=(uint32_t)((address-GGR_VA_START)/GPU_VA_UNIT);
+    uint32_t units=(uint32_t)((bytes+GPU_VA_UNIT-1)/GPU_VA_UNIT);
+    for(uint32_t j=first;j<first+units;j++)gAllocated[j/64]&=~(UINT64_C(1)<<(j%64));
+}
+static volatile uint64_t *leafAt(uint64_t address)
+{return gPtes+512+(address-GGR_VA_START)/4096;}
+
+struct gpu_buffer {
+    IOMemoryDescriptor *memory;
+    SweetSurface *surface;
+    uint64_t address,size;
+    uint32_t handle,flags;
+    bool installed;
+};
+class GauguinGPUUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(GauguinGPUUserClient);
+    task_t fTask;
+    gpu_buffer *fBuffers;
+    uint64_t fBytes;
+    uint32_t fNextHandle,fQueue,fNextQueue,fLastFence;
+    bool fClosed;
+    gpu_buffer *find(uint32_t);
+    IOReturn add(IOMemoryDescriptor *,SweetSurface *,uint64_t,uint32_t,uint32_t *);
+    bool drop(gpu_buffer *);
+    IOReturn submit(struct ggr_submit *);
+    IOReturn surface(struct ggr_surface *);
+public:
+    bool initWithTask(task_t,void *,UInt32,OSDictionary *) APPLE_KEXT_OVERRIDE;
+    bool start(IOService *) APPLE_KEXT_OVERRIDE;
+    IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+    void free(void) APPLE_KEXT_OVERRIDE;
+    IOReturn clientMemoryForType(UInt32,IOOptionBits *,IOMemoryDescriptor **) APPLE_KEXT_OVERRIDE;
+    IOReturn externalMethod(uint32_t,IOExternalMethodArguments *,IOExternalMethodDispatch *,OSObject *,void *) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(GauguinGPUUserClient,IOUserClient);
+
+/* Class name deliberately matches the reused userspace transport. */
+class HakiosGPU : public IOService {
+    OSDeclareDefaultStructors(HakiosGPU);
+public:
+    bool start(IOService *p) APPLE_KEXT_OVERRIDE {
+        if(!IOService::start(p))return false;
+        setProperty(kIOUserClientClassKey,"GauguinGPUUserClient");
+        setProperty("GPUModel","Adreno 619");
+        setProperty("GauguinPrivilegedPrototype",kOSBooleanTrue);
+        setName("HakiosGPU");registerService();return true;
+    }
+};
+OSDefineMetaClassAndStructors(HakiosGPU,IOService);
+
+extern "C" bool GauguinGPUStart(void)
+{
+    if(gPublished||!sweet_gpu_runtime_ready())return false;
+    IOLock *lock=IOLockAlloc();
+    if(!lock)return false;
+    /* Display readers can race publication; install once and never replace. */
+    __atomic_store_n(&gLock,lock,__ATOMIC_RELEASE);
+    IOService *p=IOService::getPlatform();
+    HakiosGPU *s=OSTypeAlloc(HakiosGPU);
+    if(!p||!s){OSSafeReleaseNULL(s);return false;}
+    bool initialized=s->init();
+    bool attached=initialized&&s->attach(p);
+    bool started=attached&&s->start(p);
+    if(attached&&!started)s->detach(p);
+    s->release();gPublished=started;
+    IOLog("SWEET GPU USER: service=%u root-only single-client synchronous-submit\n",started);
+    return started;
+}
+extern "C" void GauguinGPUStop(void)
+{
+    if(gLock)IOLockLock(gLock);
+    sweet_gpu_runtime_stop();
+    if(gLock)IOLockUnlock(gLock);
+}
+
+/* Token 1: CPU-only path before GPU publication; 2: the GPU lock is held.
+ * The token avoids unlocking a lock published between begin and end. Lock
+ * order is framebuffer -> GPU -> surface lookup; GPU never calls framebuffer. */
+extern "C" uint32_t GauguinGPUSurfaceBegin(SweetSurface *s)
+{
+    IOLock *lock=__atomic_load_n(&gLock,__ATOMIC_ACQUIRE);
+    if(!lock)return 1;
+    IOLockLock(lock);
+    if(s->gpuState){IOLockUnlock(lock);return 0;}
+    return 2;
+}
+extern "C" void GauguinGPUSurfaceEnd(uint32_t token)
+{if(token==2)IOLockUnlock(gLock);}
+
+bool GauguinGPUUserClient::initWithTask(task_t task,void *sid,UInt32 type,OSDictionary *properties)
+{
+    if(type||clientHasPrivilege(task,kIOClientPrivilegeAdministrator)!=kIOReturnSuccess||
+       !IOUserClient::initWithTask(task,sid,type,properties))return false;
+    fTask=task;fNextHandle=1;fNextQueue=1;return true;
+}
+bool GauguinGPUUserClient::start(IOService *p)
+{
+    if(!gLock||!IOUserClient::start(p))return false;
+    IOLockLock(gLock);
+    bool ok=!gOwner&&sweet_gpu_runtime_ready()&&prepareTables();
+    if(ok){fBuffers=IONewZero(gpu_buffer,GGR_MAX_BUFFERS);ok=fBuffers!=nullptr;}
+    if(ok)gOwner=this;
+    IOLockUnlock(gLock);return ok;
+}
+gpu_buffer *GauguinGPUUserClient::find(uint32_t handle)
+{
+    if(!handle||!fBuffers)return nullptr;
+    for(uint32_t i=0;i<GGR_MAX_BUFFERS;i++)if(fBuffers[i].memory&&fBuffers[i].handle==handle)return fBuffers+i;
+    return nullptr;
+}
+IOReturn GauguinGPUUserClient::add(IOMemoryDescriptor *m,SweetSurface *s,uint64_t size,uint32_t flags,uint32_t *handle)
+{
+    if(!size||(size&PAGE_MASK)||size>GGR_MAX_BO_BYTES||size>GGR_MAX_CLIENT_BYTES-fBytes||!fNextHandle)
+        return kIOReturnNoResources;
+    gpu_buffer *slot=nullptr;
+    for(uint32_t i=0;i<GGR_MAX_BUFFERS;i++)if(!fBuffers[i].memory){slot=fBuffers+i;break;}
+    if(!slot)return kIOReturnNoResources;
+    uint64_t address=reserveAddress(size);
+    if(!address)return kIOReturnNoResources;
+    if(m->prepare()!=kIOReturnSuccess){releaseAddress(address,size);return kIOReturnVMError;}
+    /* Complete validation before the first PTE store. No partial map on an
+     * invalid physical segment. Each CPU 16KiB page contributes FOUR leaves. */
+    for(uint64_t off=0;off<size;off+=4096) {
+        uint64_t pa;
+        if(!physicalPage(m,off,&pa)||*leafAt(address+off)) {
+            m->complete();releaseAddress(address,size);return kIOReturnVMError;
+        }
+    }
+    m->retain();if(s)s->retain();
+    *slot={m,s,address,size,fNextHandle++,flags,true};fBytes+=size;
+    for(uint64_t off=0;off<size;off+=4096) {
+        uint64_t pa=0;
+        if(!physicalPage(m,off,&pa)){sweet_gpu_runtime_stop();return kIOReturnVMError;}
+        /* Native NC/outer-shareable/user/AF/nG. GPU data and code buffers
+         * share Linux-msm's mapping policy; AP RO is honored when requested. */
+        *leafAt(address+off)=pa|UINT64_C(0xe43)|((flags&GGR_BO_READONLY)?0x80:0);
+    }
+    memoryBarrier();
+    if(!sweet_gpu_runtime_sync())return kIOReturnNotReady; /* retained */
+    *handle=slot->handle;return kIOReturnSuccess;
+}
+bool GauguinGPUUserClient::drop(gpu_buffer *b)
+{
+    if(!b->memory)return true;
+    if(!sweet_gpu_runtime_ready())return false;
+    for(uint64_t off=0;off<b->size;off+=4096)*leafAt(b->address+off)=0;
+    memoryBarrier();
+    if(!sweet_gpu_runtime_sync())return false;
+    releaseAddress(b->address,b->size);fBytes-=b->size;
+    b->memory->complete();b->memory->release();OSSafeReleaseNULL(b->surface);
+    bzero(b,sizeof(*b));return true;
+}
+IOReturn GauguinGPUUserClient::clientClose(void)
+{
+    if(gLock) {
+        IOLockLock(gLock);
+        if(!fClosed) {
+            fClosed=true;bool clean=true;
+            if(fBuffers)for(uint32_t i=0;i<GGR_MAX_BUFFERS;i++)if(!drop(fBuffers+i))clean=false;
+            if(gOwner==this&&clean)gOwner=nullptr;
+            if(!clean)IOLog("SWEET GPU USER: client closed after fault; DMA-visible memory/tables retained until reset\n");
+        }
+        IOLockUnlock(gLock);
+    }
+    if(!isInactive())terminate();return kIOReturnSuccess;
+}
+void GauguinGPUUserClient::free(void)
+{
+    /* Even unusual start/death paths must not release a descriptor still
+     * visible to DMA. Normal clientClose has already completed/unmapped it. */
+    if(fBuffers){IODelete(fBuffers,gpu_buffer,GGR_MAX_BUFFERS);fBuffers=nullptr;}
+    IOUserClient::free();
+}
+IOReturn GauguinGPUUserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory)
+{
+    if(!options||!memory||!gLock)return kIOReturnBadArgument;
+    IOLockLock(gLock);IOReturn r=kIOReturnBadArgument;
+    gpu_buffer *b=!fClosed&&gOwner==this?find(type):nullptr;
+    if(b&&sweet_gpu_runtime_ready()) {
+        b->memory->retain();*memory=b->memory;*options=0;r=kIOReturnSuccess;
+    }
+    IOLockUnlock(gLock);return r;
+}
+
+IOReturn GauguinGPUUserClient::surface(struct ggr_surface *r)
+{
+    SweetSurface *s=sweet_surface_copy(r->surface);
+    if(!s)return kIOReturnNotFound;
+    /* SweetSurface::memory ALREADY names pixels. Its state page is separate.
+     * Importing a MiniIOSurface-style PAGE_SIZE subrange here corrupts rows. */
+    if(!OSDynamicCast(IOBufferMemoryDescriptor,s->memory)||!s->allocSize||
+       s->allocSize>GGR_MAX_BO_BYTES||(s->allocSize&PAGE_MASK)||s->offset>=s->allocSize||s->planeCount>1||
+       !s->width||!s->height||s->bytesPerElement!=4||s->bytesPerRow<4ull*s->width||
+       (uint64_t)s->offset+(uint64_t)(s->height-1)*s->bytesPerRow+4ull*s->width>s->allocSize) {
+        s->release();return kIOReturnUnsupported;
+    }
+    r->size=s->allocSize;r->offset=s->offset;r->rowBytes=s->bytesPerRow;
+    r->width=s->width;r->height=s->height;r->pixelFormat=s->pixelFormat;r->planes=s->planeCount;
+    IOReturn ret=kIOReturnSuccess;
+    if(r->handle==UINT32_MAX)r->handle=0;
+    else {
+        gpu_buffer *existing=nullptr;
+        for(uint32_t i=0;i<GGR_MAX_BUFFERS;i++)if(fBuffers[i].memory&&fBuffers[i].surface==s){existing=fBuffers+i;break;}
+        if(existing)r->handle=existing->handle;
+        else ret=add(s->memory,s,s->allocSize,0,&r->handle);
+    }
+    s->release();return ret;
+}
