 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
-	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	/* Restrict access to read-only blocks owned by EE0; keys keep their lanes. */
 	unsigned peripheral = addr >> 8;
-	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
+	/*
+	 * 0x08 is the PMK8350 PON (gauge DT: pony@1300 in the pmk8350 node,
+	 * reg-names "hlos"), and 0x0a is its PBS. Both are read-only here too:
+	 * the PON POFF_REASON/WARM_RESET registers are how the bring-up learns
+	 * which hardware really reset the phone (the SoC's IMEM restart_reason
+	 * only says "warm reset").
+	 */
+	if (!sp_ready || !out || sid > 15 || addr > 0xffffu ||
+	    (peripheral != 0x08 && peripheral != 0x0a &&
+	    peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
 	    peripheral != 0x13 && peripheral != 0x48)) {
 		return -1;
 	}
