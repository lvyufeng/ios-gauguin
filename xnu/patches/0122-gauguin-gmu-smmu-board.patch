@@ -237,3 +240,19 @@
 }

+bool sweet_pas_stage_owner_valid(const struct sweet_pas_cpu_stage *stage)
+{
+    if(!stage||!ml_get_interrupts_enabled()||ml_at_interrupt_context()||get_preemption_level()||
+       __atomic_load_n(&pst_state,__ATOMIC_ACQUIRE)!=PST_CLAIMED||!pst_mapping||
+       stage->pa!=pst_ready.pa||stage->metadata_bytes!=PST_BYTES||stage->reserved_bytes!=PST_PAGE)return false;
+    for(uint64_t pa=stage->pa;pa<stage->pa+PST_REGION;pa+=PST_PAGE){
+        ppnum_t pn=(ppnum_t)(pa>>PAGE_SHIFT);
+        if(pmap_valid_page(pn)||pmap_cache_attributes(pn)!=UINT32_C(0xd0000006))return false;
+    }
+    if(ml_vtophys(pst_mapping)!=stage->pa||ml_vtophys(pst_mapping+PST_PAGE-1)!=stage->pa+PST_PAGE-1)return false;
+    uint8_t digest[SHA256_DIGEST_LENGTH];
+    if(!pst_hash((const uint8_t *)pst_mapping,digest))return false;
+    const volatile uint8_t *bytes=(const volatile uint8_t *)pst_mapping;
+    for(unsigned i=PST_BYTES;i<PST_PAGE;i++)if(bytes[i])return false;
+    return true;
+}
 #endif /* GAUGUIN */
