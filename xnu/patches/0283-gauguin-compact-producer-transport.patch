+static void
+f372_observe_copyout(ipc_space_t space, uint16_t serial)
+{
+	if (!f371_live()) return;
+	task_t task = current_task();
+	if (space != task->itk_space || !f371_task(task, f371_receiver) ||
+	    mach_absolute_time() >= __atomic_load_n(&f371_end, __ATOMIC_RELAXED)) return;
+	const uint64_t thread = thread_tid(current_thread());
+	struct f372_receiver_slot *slot = f372_receiver_for(thread);
+	uint64_t owner = __atomic_load_n(&slot->thread, __ATOMIC_RELAXED);
+	if (!owner && __atomic_compare_exchange_n(&slot->thread, &owner, thread, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) owner = thread;
+	if (owner != thread) return;
+	const uint64_t sequence = __atomic_add_fetch(&f372_receiver_sequence, 1, __ATOMIC_RELAXED);
+	__atomic_store_n(&slot->stamp, (sequence << 16) | serial, __ATOMIC_RELEASE);
