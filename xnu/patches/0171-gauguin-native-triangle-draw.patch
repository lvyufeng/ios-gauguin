+                else if(index<GGT_OUTPUT_WORDS){++c->work.pixels_checked;++c->work.foreground_checked;}
+                else ++c->work.unchanged_checked;
+            }
+        }
+        if(c->work.max_nc_batch_words<n)c->work.max_nc_batch_words=n;
+        if(!guard(c))return GGT_GUARD;
+    }
+    return GGT_OK;
+}
+static enum ggt_result copy_nc(struct ggt_context *c,unsigned off,unsigned words,
+    const uint32_t *values,unsigned blob,uint32_t *count)
+{
+    for(unsigned base=0;base<words;base+=GGT_BATCH_WORDS){
+        unsigned n=words-base;if(n>GGT_BATCH_WORDS)n=GGT_BATCH_WORDS;
+        if(!guard(c))return GGT_GUARD;
+        for(unsigned i=0;i<n;i++){
+            unsigned index=base+i;uint32_t value;
+            if(values)value=values[index];else if(!ggt_blob_word(blob,index,&value))return GGT_ARGUMENT;
+            ++*count;if(!c->ops.write_memory(c->ops.cookie,GGT_RING,off+4*index,value))return GGT_IO;
+        }
+        if(c->work.max_nc_batch_words<n)c->work.max_nc_batch_words=n;
+        if(!guard(c))return GGT_GUARD;
+    }
+    return GGT_OK;
+}
+static enum ggt_result capture(struct ggt_context *c,const struct ggt_prefix *prefix)
