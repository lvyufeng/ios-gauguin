#!/bin/bash
# Minimal `iig` for a Linux kernel-only build: --def X.iig --header X.h emits
# a placeholder header (the kernel does not consume DriverKit's iig output;
# the DriverKit framework headers are installed but not built here).
header=
impl=
while [ $# -gt 0 ]; do
	case "$1" in
	--header) header=$2; shift 2;;
	--impl) impl=$2; shift 2;;
	*) shift;;
	esac
done
if [ -n "$header" ]; then
	printf '/* placeholder generated by the iig stand-in (see deps/toolchain/mig) */\n#ifndef __I_%s__\n#define __I_%s__\n#endif\n' \
		"$(basename "$header" | tr -c 'A-Za-z0-9' '_')" "$(basename "$header" | tr -c 'A-Za-z0-9' '_')" > "$header"
fi
if [ -n "$impl" ]; then
	printf '/* placeholder generated by the iig stand-in */\n' > "$impl"
fi
exit 0
