diff --git a/bsd/dev/gauguin_handoff_memory.c b/bsd/dev/gauguin_handoff_memory.c
new file mode 100644
index 0000000000000000000000000000000000000000..00becb9d1c715ad26618adf74ae775187e913f3a
--- /dev/null
+++ b/bsd/dev/gauguin_handoff_memory.c
@@ -0,0 +1,363 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <stdbool.h>
+#include "gauguin_handoff_memory.h"
+
+#define GH_PAGE UINT64_C(0x4000)
+#define GH_MIB UINT64_C(0x100000)
+#define GH_INPUT_LIMIT UINT64_C(0x20000000)
+
+static uint32_t get_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+        ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint32_t get_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+        ((uint32_t)p[2] << 8) | p[3];
+}
+
+static uint64_t get_le64(const uint8_t *p)
+{
+    return get_le32(p) | ((uint64_t)get_le32(p + 4) << 32);
+}
+
+static uint64_t get_be64(const uint8_t *p)
+{
+    return ((uint64_t)get_be32(p) << 32) | get_be32(p + 4);
+}
+
+static struct gh_range get_le_range(const uint8_t *p)
+{
+    return (struct gh_range){ get_le64(p), get_le64(p + 8) };
+}
+
+static struct gh_range get_be_range(const uint8_t *p)
+{
+    return (struct gh_range){ get_be64(p), get_be64(p + 8) };
+}
+
+static bool span(uint64_t start, uint64_t bytes, uint64_t limit)
+{
+    return start <= limit && bytes <= limit - start;
+}
+
+static bool valid(struct gh_range r)
+{
+    return r.size && span(r.base, r.size, UINT64_MAX);
+}
+
+static bool same(struct gh_range a, struct gh_range b)
+{
+    return a.base == b.base && a.size == b.size;
+}
+
+static bool contains(struct gh_range outer, struct gh_range inner)
+{
+    return inner.base >= outer.base && span(inner.base - outer.base, inner.size, outer.size);
+}
+
+/* Both ranges have already been bounded. */
+static bool overlaps(struct gh_range a, struct gh_range b)
+{
+    return a.base < b.base + b.size && b.base < a.base + a.size;
+}
+
+static bool tag(const uint8_t *p, size_t bytes, const char *s)
+{
+    size_t i = 0;
+    for (; i < bytes; ++i) {
+        if (p[i] != (uint8_t)s[i])
+            return false;
+        if (!s[i])
+            return i + 1 == bytes;
+    }
+    return !s[i];
+}
+
+static bool context_matches(const uint8_t *d, const struct gh_live *live)
+{
+    if (!valid(live->managed) || !valid(live->adt) || !valid(live->framebuffer) ||
+        !same(live->managed, get_le_range(d + 64)) || !same(live->adt, get_le_range(d + 80)) ||
+        !same(live->framebuffer, get_le_range(d + 128)) ||
+        get_le64(d + 96) != live->args || get_le64(d + 104) != live->top ||
+        get_le64(d + 144) != live->adt.base ||
+        ((live->managed.base | live->managed.size | live->adt.base | live->args) & (GH_PAGE - 1)) ||
+        !contains(live->managed, live->adt) || live->adt.size > GH_MIB ||
+        !contains(live->managed, (struct gh_range){live->args, GH_PAGE}))
+        return false;
+    uint64_t adt_end = live->adt.base + live->adt.size;
+    return adt_end <= UINT64_MAX - (GH_PAGE - 1) &&
+        ((adt_end + GH_PAGE - 1) & ~(GH_PAGE - 1)) == live->args &&
+        live->top == live->args + GH_PAGE;
+}
+
+static bool pas_matches(const uint8_t *pas, const uint8_t *io,
+                        const struct gh_live *live, const struct gh_inventory *m)
+{
+    const struct gh_range input = m->input;
+    if (!tag(pas, 8, "LPASOWN1") || get_le32(pas + 8) != 1 || get_le32(pas + 12) != 1 ||
+        get_le64(pas + 24) != 2 * GH_MIB || get_le64(pas + 32) != GH_MIB ||
+        get_le64(pas + 40) != GH_MIB || get_le64(pas + 48) != input.size ||
+        get_le64(pas + 56) || !same(m->pas, get_le_range(pas + 64)) ||
+        !same(input, get_le_range(pas + 80)) || !same(m->original_fdt, get_le_range(pas + 96)) ||
+        !same(m->shim, get_le_range(pas + 112)) || !same(m->pas, get_le_range(io)) ||
+        get_le32(io + 16) != 0xd0000006 || get_le32(io + 20) != 0x50415331)
+        return false;
+    uint64_t tail = get_le64(pas + 16);
+    if (input.size <= 2 * GH_MIB || input.size > GH_INPUT_LIMIT || (input.base & 7) ||
+        tail != input.size - 2 * GH_MIB || (tail & (GH_PAGE - 1)) ||
+        m->shim.size > GH_MIB || overlaps(input, live->managed) ||
+        overlaps(input, m->original_fdt) || overlaps(input, m->shim) ||
+        overlaps(m->original_fdt, m->shim) || overlaps(live->adt, m->original_fdt) ||
+        overlaps(live->adt, m->shim))
+        return false;
+    uint64_t tail_base = input.base + tail;
+    return m->pas.size == GH_MIB &&
+        m->pas.base == ((tail_base + GH_MIB - 1) & ~(GH_MIB - 1)) &&
+        span(m->pas.base, m->pas.size, UINT64_C(0x100000000)) && contains(input, m->pas);
+}
+
+enum fdt_node_kind { NODE_OTHER, NODE_ROOT, NODE_CHOSEN, NODE_MEMORY, NODE_RESERVED, NODE_RESERVE };
+struct fdt_node {
+    enum fdt_node_kind kind;
+    uint32_t name, reg, reg_bytes, alloc, alloc_bytes;
+    uint64_t dynamic_size;
+    unsigned cell_flags;
+    bool has_child;
+};
+
+static size_t string_size(const uint8_t *d, size_t at, size_t end, size_t limit)
+{
+    for (size_t i = 0; i < limit && i < end - at; ++i) {
+        if (!d[at + i])
+            return i + 1;
+    }
+    return 0;
+}
+
+static bool compatible(const uint8_t *d, size_t bytes)
+{
+    bool lagoon = false, gauguin = false, sm7225 = false;
+    for (size_t at = 0; at < bytes;) {
+        size_t len = string_size(d, at, bytes, 128);
+        if (!len)
+            return false;
+        lagoon |= tag(d + at, len, "qcom,lagoon");
+        gauguin |= tag(d + at, len, "xiaomi,gauguin");
+        sm7225 |= tag(d + at, len, "qcom,sm7225");
+        at += len;
+    }
+    return lagoon || (gauguin && sm7225);
+}
+
+static bool add_node(const uint8_t *d, const struct fdt_node *n, struct gh_inventory *m)
+{
+    if (n->kind == NODE_ROOT || n->kind == NODE_RESERVED)
+        return n->cell_flags == (n->kind == NODE_ROOT ? 3u : 7u);
+    if (n->kind != NODE_MEMORY && n->kind != NODE_RESERVE)
+        return true;
+    if (n->reg) {
+        if (!n->reg_bytes || n->reg_bytes % 16)
+            return false;
+        for (uint32_t i = 0; i < n->reg_bytes; i += 16) {
+            struct gh_range range = get_be_range(d + n->reg + i);
+            if (!valid(range))
+                return false;
+            if (n->kind == NODE_MEMORY) {
+                if (m->bank_count == GH_BANK_LIMIT)
+                    return false;
+                for (uint32_t j = 0; j < m->bank_count; ++j) {
+                    if (overlaps(m->banks[j], range))
+                        return false;
+                }
+                m->banks[m->bank_count++] = range;
+            } else {
+                if (m->fixed_count == GH_FIXED_LIMIT)
+                    return false;
+                m->fixed[m->fixed_count++] = (struct gh_named_range){range, n->name};
+            }
+        }
+        return true;
+    }
+    if (n->kind != NODE_RESERVE || !n->dynamic_size || m->pool_count == GH_POOL_LIMIT ||
+        n->alloc_bytes % 16 || n->alloc_bytes / 16 > GH_ALLOC_LIMIT - m->alloc_count)
+        return false;
+    uint32_t first = m->alloc_count;
+    for (uint32_t i = 0; i < n->alloc_bytes; i += 16) {
+        struct gh_range limit = get_be_range(d + n->alloc + i);
+        if (!valid(limit))
+            return false;
+        m->allocations[m->alloc_count++] = limit;
+    }
+    m->pools[m->pool_count++] = (struct gh_pool){n->dynamic_size, n->name, first, m->alloc_count - first};
+    return true;
+}
+
+static bool parse_fdt(const uint8_t *d, size_t bytes, struct gh_inventory *m)
+{
+    if (bytes < 40 || get_be32(d) != 0xd00dfeed || get_be32(d + 4) != bytes ||
+        get_be32(d + 20) != 17 || get_be32(d + 24) > 17)
+        return false;
+    uint32_t structure = get_be32(d + 8), strings = get_be32(d + 12), reserve = get_be32(d + 16);
+    uint32_t text_bytes = get_be32(d + 32), structure_bytes = get_be32(d + 36);
+    struct gh_range tokens = {structure, structure_bytes}, names = {strings, text_bytes};
+    if (structure < 40 || strings < 40 || reserve < 40 || (structure & 3) || (reserve & 7) ||
+        !structure_bytes || !text_bytes || !span(structure, structure_bytes, bytes) ||
+        !span(strings, text_bytes, bytes) || overlaps(tokens, names))
+        return false;
+    size_t rpos = reserve;
+    for (;;) {
+        if (!span(rpos, 16, bytes) || overlaps((struct gh_range){rpos, 16}, tokens) ||
+            overlaps((struct gh_range){rpos, 16}, names))
+            return false;
+        struct gh_range range = get_be_range(d + rpos);
+        rpos += 16;
+        if (!range.base && !range.size)
+            break;
+        if (!valid(range) || m->header_reserve_count == GH_FIXED_LIMIT)
+            return false;
+        m->header_reserves[m->header_reserve_count++] = range;
+    }
+
+    struct fdt_node stack[16];
+    unsigned depth = 0, nodes = 0, props = 0, chosen = 0, reserved = 0, initrd = 0;
+    bool root = false, board = false;
+    size_t end = structure + structure_bytes, at = structure;
+    while (span(at, 4, end)) {
+        uint32_t token = get_be32(d + at);
+        at += 4;
+        if (token == 1) {
+            size_t len = string_size(d, at, end, 256);
+            if (!len || depth == 16 || ++nodes > 4096)
+                return false;
+            struct fdt_node n = {.name = (uint32_t)at};
+            if (!depth) {
+                if (root || len != 1)
+                    return false;
+                root = true;
+                n.kind = NODE_ROOT;
+            } else {
+                struct fdt_node *parent = &stack[depth - 1];
+                parent->has_child = true;
+                if (parent->kind == NODE_RESERVED)
+                    n.kind = NODE_RESERVE;
+                else if (parent->kind == NODE_RESERVE)
+                    return false;
+                else if (parent->kind == NODE_ROOT) {
+                    if (tag(d + at, len, "chosen")) {
+                        n.kind = NODE_CHOSEN;
+                        ++chosen;
+                    } else if (tag(d + at, len, "reserved-memory")) {
+                        n.kind = NODE_RESERVED;
+                        ++reserved;
+                    } else if (tag(d + at, len, "memory") || (len > 8 && tag(d + at, 7, "memory@"))) {
+                        n.kind = NODE_MEMORY;
+                    }
+                }
+            }
+            stack[depth++] = n;
+            at += (len + 3) & ~(size_t)3;
+        } else if (token == 2) {
+            if (!depth || !add_node(d, &stack[--depth], m))
+                return false;
+        } else if (token == 3) {
+            if (!depth || ++props > 16384 || !span(at, 8, end))
+                return false;
+            uint32_t len = get_be32(d + at), name = get_be32(d + at + 4);
+            at += 8;
+            struct fdt_node *n = &stack[depth - 1];
+            if (name >= text_bytes || !span(at, len, end) || n->has_child)
+                return false;
+            const uint8_t *p = d + strings + name;
+            size_t nl = string_size(d, strings + name, strings + text_bytes, 128);
+            if (!nl)
+                return false;
+            unsigned flag = 0;
+            if (n->kind == NODE_ROOT || n->kind == NODE_RESERVED) {
+                if (tag(p, nl, "#address-cells"))
+                    flag = 1;
+                else if (tag(p, nl, "#size-cells"))
+                    flag = 2;
+                else if (n->kind == NODE_RESERVED && tag(p, nl, "ranges"))
+                    flag = 4;
+                if (flag) {
+                    if ((n->cell_flags & flag) || (flag == 4 ? len != 0 : len != 4 || get_be32(d + at) != 2))
+                        return false;
+                    n->cell_flags |= flag;
+                }
+            }
+            if (n->kind == NODE_ROOT && tag(p, nl, "compatible")) {
+                if (board || !compatible(d + at, len))
+                    return false;
+                board = true;
+            } else if ((n->kind == NODE_MEMORY || n->kind == NODE_RESERVE) && tag(p, nl, "reg")) {
+                if (n->reg)
+                    return false;
+                n->reg = (uint32_t)at;
+                n->reg_bytes = len;
+            } else if (n->kind == NODE_RESERVE && tag(p, nl, "size")) {
+                if (len != 8 || n->dynamic_size || !get_be64(d + at))
+                    return false;
+                n->dynamic_size = get_be64(d + at);
+            } else if (n->kind == NODE_RESERVE && tag(p, nl, "alloc-ranges")) {
+                if (n->alloc || !len || len % 16)
+                    return false;
+                n->alloc = (uint32_t)at;
+                n->alloc_bytes = len;
+            } else if (n->kind == NODE_CHOSEN) {
+                bool start = tag(p, nl, "linux,initrd-start");
+                bool stop = tag(p, nl, "linux,initrd-end");
+                if (start || stop) {
+                    unsigned bit = start ? 1u : 2u;
+                    uint64_t expected = start ? m->input.base : m->input.base + m->input.size;
+                    if ((initrd & bit) || (len != 4 && len != 8) ||
+                        expected != (len == 4 ? get_be32(d + at) : get_be64(d + at)))
+                        return false;
+                    initrd |= bit;
+                }
+            }
+            at += ((size_t)len + 3) & ~(size_t)3;
+        } else if (token == 9) {
+            unsigned in_bank = 0;
+            for (uint32_t i = 0; i < m->bank_count; ++i)
+                in_bank += contains(m->banks[i], m->input);
+            return !depth && root && board && at == end &&
+                chosen == 1 && reserved == 1 && initrd == 3 && in_bank == 1;
+        } else if (token != 4) {
+            return false;
+        }
+    }
+    return false;
+}
+
+enum gh_status gh_read_memory(const uint8_t *d, size_t bytes,
+    const uint8_t *pas, size_t pas_bytes, const uint8_t *io, size_t io_bytes,
+    const struct gh_live *live, struct gh_inventory *m)
+{
+    if (!d || !m || bytes < GH_HEADER || !tag(d, 8, "GHFDOWN1") ||
+        get_le32(d + 8) != 1 || get_le32(d + 12) != 1 || get_le64(d + 152))
+        return GH_BAD_RECORD;
+    uint32_t fdt_bytes = get_le32(d + 16), capacity = get_le32(d + 20);
+    if (capacity < GH_PAGE || capacity > GH_MAX_FDT || (capacity & (GH_PAGE - 1)) ||
+        fdt_bytes < 40 || fdt_bytes > capacity || bytes != GH_HEADER + capacity)
+        return GH_BAD_RECORD;
+    for (uint32_t i = fdt_bytes; i < capacity; ++i) {
+        if (d[GH_HEADER + i])
+            return GH_BAD_RECORD;
+    }
+    if (!live || !context_matches(d, live))
+        return GH_BAD_CONTEXT;
+    *m = (struct gh_inventory){0};
+    m->original_fdt = (struct gh_range){get_le64(d + 24), fdt_bytes};
+    m->input = get_le_range(d + 32);
+    m->shim = get_le_range(d + 48);
+    m->pas = get_le_range(d + 112);
+    if (!pas || pas_bytes != 128 || !io || io_bytes != 24 || !valid(m->original_fdt) ||
+        !valid(m->input) || !valid(m->shim) || !valid(m->pas) || !pas_matches(pas, io, live, m))
+        return GH_BAD_PAS;
+    return parse_fdt(d + GH_HEADER, fdt_bytes, m) ? GH_OK : GH_BAD_FDT;
+}
+#endif
diff --git a/bsd/dev/gauguin_handoff_memory.h b/bsd/dev/gauguin_handoff_memory.h
new file mode 100644
index 0000000000000000000000000000000000000000..52529a874d8ab6871e8dc8f889aa73ec6f2cf345
--- /dev/null
+++ b/bsd/dev/gauguin_handoff_memory.h
@@ -0,0 +1,40 @@
+#ifndef GAUGUIN_HANDOFF_MEMORY_H
+#define GAUGUIN_HANDOFF_MEMORY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum gh_status { GH_OK, GH_BAD_RECORD, GH_BAD_CONTEXT, GH_BAD_PAS, GH_BAD_FDT };
+enum {
+    GH_HEADER = 160, GH_MAX_FDT = 768 * 1024, GH_BANK_LIMIT = 32,
+    GH_FIXED_LIMIT = 128, GH_POOL_LIMIT = 128, GH_ALLOC_LIMIT = 256,
+};
+
+struct gh_range { uint64_t base, size; };
+struct gh_named_range { struct gh_range range; uint32_t name; };
+struct gh_pool {
+    uint64_t size;
+    uint32_t name, first_alloc, alloc_count;
+};
+struct gh_live {
+    struct gh_range managed, adt, framebuffer;
+    uint64_t args, top;
+};
+struct gh_inventory {
+    struct gh_range original_fdt, input, shim, pas;
+    uint32_t bank_count, header_reserve_count, fixed_count, pool_count, alloc_count;
+    struct gh_range banks[GH_BANK_LIMIT], header_reserves[GH_FIXED_LIMIT];
+    struct gh_named_range fixed[GH_FIXED_LIMIT];
+    struct gh_pool pools[GH_POOL_LIMIT];
+    struct gh_range allocations[GH_ALLOC_LIMIT];
+};
+
+/* Only ADT-resident bytes and independently obtained live boot geometry.
+ * Contents of inventory are meaningful only on GH_OK. Physical ranges
+ * are observations and declarations, never passed to an allocator. */
+enum gh_status gh_read_memory(const uint8_t *capture, size_t capture_bytes,
+    const uint8_t *pas, size_t pas_bytes, const uint8_t *io, size_t io_bytes,
+    const struct gh_live *, struct gh_inventory *);
+void sweet_handoff_memory_init(void);
+
+#endif
diff --git a/bsd/dev/gauguin_handoff_memory_board.c b/bsd/dev/gauguin_handoff_memory_board.c
new file mode 100644
index 0000000000000000000000000000000000000000..97e2d15bded963d87dc684b17da43094f128cd98
--- /dev/null
+++ b/bsd/dev/gauguin_handoff_memory_board.c
@@ -0,0 +1,148 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm64/boot.h>
+#include <libkern/crypto/sha2.h>
+#include "gauguin_handoff_memory.h"
+
+static bool property_in_adt(DTEntry entry, const char *name, const void **value, unsigned *bytes)
+{
+    if (SecureDTGetProperty(entry, name, value, bytes) != kSuccess || !*value || !*bytes)
+        return false;
+    uintptr_t start = (uintptr_t)PE_state.deviceTreeHead;
+    uintptr_t at = (uintptr_t)*value;
+    return at >= start && at - start < PE_state.deviceTreeSize &&
+        *bytes <= PE_state.deviceTreeSize - (at - start);
+}
+
+static bool boot_context(struct gh_live *live)
+{
+    const boot_args *args = PE_state.bootArgs;
+    vm_offset_t dt = (vm_offset_t)PE_state.deviceTreeHead;
+    vm_size_t size = PE_state.deviceTreeSize;
+    if (!args || args->Version != kBootArgsVersion2 || !dt || !size || size > (1u << 20) ||
+        args->deviceTreeLength != size || dt > UINTPTR_MAX - (size - 1) ||
+        args->topOfKernelData < 0x4000 ||
+        !args->Video.v_height || !args->Video.v_rowBytes ||
+        args->Video.v_rowBytes > UINT64_MAX / args->Video.v_height)
+        return false;
+    vm_offset_t adt_pa = ml_vtophys(dt);
+    if (!adt_pa || adt_pa > UINTPTR_MAX - (size - 1) ||
+        ml_vtophys(dt + size - 1) != adt_pa + size - 1)
+        return false;
+    *live = (struct gh_live){
+        .managed = {args->physBase, args->memSize},
+        .adt = {adt_pa, size},
+        .framebuffer = {args->Video.v_baseAddr, args->Video.v_rowBytes * args->Video.v_height},
+        // PE_state refers to XNU's immutable copy. The original boot_args
+        // occupies the loader's last 16 KiB page below topOfKernelData.
+        .args = args->topOfKernelData - 0x4000,
+        .top = args->topOfKernelData,
+    };
+    return true;
+}
+
+static void record_range(const char *kind, unsigned index, const char *name, struct gh_range range)
+{
+    printf("SWEET HANDOFF: %s index=%u name=%s base=%016llx bytes=%llx\n",
+        kind, index, name, (unsigned long long)range.base, (unsigned long long)range.size);
+}
+
+static void safe_name(const uint8_t *fdt, uint32_t offset, char name[64])
+{
+    const uint8_t *source = fdt + offset;
+    unsigned i = 0;
+    for (; i < 63 && source[i]; ++i) {
+        uint8_t c = source[i];
+        name[i] = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+            c == ',' || c == '.' || c == '_' || c == '+' || c == '@' || c == '-' ? (char)c : '_';
+    }
+    name[i] = 0;
+}
+
+static void report_inventory(const uint8_t *fdt, const struct gh_live *live,
+                             const struct gh_inventory *m)
+{
+    uint8_t digest[32];
+    char hex[65], name[64];
+    SHA256_CTX ctx;
+    SHA256_Init(&ctx);
+    SHA256_Update(&ctx, fdt, (size_t)m->original_fdt.size);
+    SHA256_Final(digest, &ctx);
+    for (unsigned i = 0; i < sizeof(digest); ++i) {
+        hex[2 * i] = "0123456789abcdef"[digest[i] >> 4];
+        hex[2 * i + 1] = "0123456789abcdef"[digest[i] & 15];
+    }
+    hex[64] = 0;
+    printf("SWEET HANDOFF: begin version=1 fdt_sha256=%s banks=%u header_reserves=%u fixed=%u pools=%u windows=%u\n",
+        hex, m->bank_count, m->header_reserve_count, m->fixed_count, m->pool_count, m->alloc_count);
+    record_range("owner", 0, "original-fdt", m->original_fdt);
+    record_range("owner", 1, "input-payload", m->input);
+    record_range("owner", 2, "shim", m->shim);
+    record_range("owner", 3, "pas", m->pas);
+    record_range("owner", 4, "framebuffer", live->framebuffer);
+    record_range("owner", 5, "loaded-prefix", (struct gh_range){live->managed.base, live->top - live->managed.base});
+    record_range("domain", 0, "managed", live->managed);
+    for (uint32_t i = 0; i < m->bank_count; ++i)
+        record_range("bank", i, "-", m->banks[i]);
+    for (uint32_t i = 0; i < m->header_reserve_count; ++i)
+        record_range("header-reserve", i, "-", m->header_reserves[i]);
+    for (uint32_t i = 0; i < m->fixed_count; ++i) {
+        safe_name(fdt, m->fixed[i].name, name);
+        record_range("fixed", i, name, m->fixed[i].range);
+    }
+    for (uint32_t i = 0; i < m->pool_count; ++i) {
+        const struct gh_pool *p = &m->pools[i];
+        safe_name(fdt, p->name, name);
+        printf("SWEET HANDOFF: pool index=%u name=%s bytes=%llx windows=%u\n",
+            i, name, (unsigned long long)p->size, p->alloc_count);
+        for (uint32_t j = 0; j < p->alloc_count; ++j)
+            record_range("pool-window", i, name, m->allocations[p->first_alloc + j]);
+    }
+    printf("SWEET HANDOFF: end fdt_sha256=%s\n", hex);
+}
+
+void sweet_handoff_memory_init(void)
+{
+    unsigned enabled = 0;
+    if (!PE_parse_boot_argn("sweethandoff", &enabled, sizeof(enabled)) || !enabled)
+        return;
+    if (enabled != 1) {
+        printf("SWEET HANDOFF: invalid selector\n");
+        return;
+    }
+    DTEntry chosen, defaults;
+    const void *capture, *pas, *io, *pending;
+    unsigned capture_bytes, pas_bytes, io_bytes, pending_bytes;
+    struct gh_live live;
+    if (!boot_context(&live) ||
+        SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTLookupEntry(NULL, "/defaults", &defaults) != kSuccess ||
+        SecureDTGetProperty(chosen, "GauguinHandoffPending", &pending, &pending_bytes) == kSuccess ||
+        SecureDTGetProperty(chosen, "LowPASRequest", &pending, &pending_bytes) == kSuccess ||
+        SecureDTGetProperty(defaults, "LowPASIOPending", &pending, &pending_bytes) == kSuccess ||
+        !property_in_adt(chosen, "GauguinHandoffFDT", &capture, &capture_bytes) ||
+        !property_in_adt(chosen, "LowPASReservation", &pas, &pas_bytes) ||
+        !property_in_adt(defaults, "pmap-io-ranges", &io, &io_bytes)) {
+        printf("SWEET HANDOFF: unavailable or unpublished\n");
+        return;
+    }
+    struct gh_inventory *inventory = kalloc_data(sizeof(*inventory), Z_WAITOK);
+    if (!inventory) {
+        printf("SWEET HANDOFF: inventory allocation unavailable\n");
+        return;
+    }
+    enum gh_status status = gh_read_memory(capture, capture_bytes, pas, pas_bytes, io, io_bytes, &live, inventory);
+    if (status == GH_OK)
+        report_inventory((const uint8_t *)capture + GH_HEADER, &live, inventory);
+    else
+        printf("SWEET HANDOFF: rejected status=%u\n", status);
+    kfree_data(inventory, sizeof(*inventory));
+}
+#endif
