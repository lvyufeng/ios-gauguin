+static enum ggk_result wait_idle(struct ggk_context *c)
+{
+    for(unsigned i=0;i<GGQ_IDLE_LIMIT;i++){
+        TRY(faults(c));TRY(barrier(c));TRY(mr(c,GGK_SCRATCH,0,&c->work.rptr));++c->work.idle_polls;
+        if(c->work.rptr>=GGQ_RING_WORDS)return sample(c,true,0x10000,GGK_END_DWORD,c->work.rptr);
+        if(c->work.rptr!=GGK_END_DWORD)continue;
+        TRY(rd(c,0x23b0c,&c->work.busy));
+        if(c->work.busy==UINT32_MAX)return GGK_FAULT;
+        if(!(c->work.busy&(1u<<23)))return GGK_OK;
+    }
+    return GGK_TIMEOUT;
