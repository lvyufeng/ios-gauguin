+    struct ggc_receipt work;
+    struct ggc_diagnostic diagnostic;
+    uint32_t reglist[GGC_REGLIST_WORDS];
+};
+/* Register arguments are native DWORD offsets, never byte offsets. Board
+ * callbacks retain private aliases, require authenticated cold SQE staging,
+ * validate live clocks/routes/faults/IRQ/WDT/ownership and enforce deadlines.
+ * BUS must reject stale GPU ACK before its only GBIF store. start_gpu runs
+ * the existing native MMU/OOB engine once; open_registers occurs AFTER OOB.
+ * Runtime preemption is explicitly not enabled; target capability unchanged.
+ * Native fixed core writes have no invented readback-equality requirements.
+ * RMW/register-list reads retain raw values, including legitimate all-ones.
+ * No SQE halt release, RB/CP command, ZAP, unsecured-mode or Metal operation.
+ * A started failure is permanent: board quarantines shared owners before
+ * logging cached diagnostics, with no retry, HOST release or rollback.
+ * Outputs change only after complete success; callbacks may have side effects.
+ */
+enum ggc_result ggc_core_once(struct ggc_context *,const struct ggc_ops *,
+    const struct ggp_plan *,const struct ggs_receipt *,struct ggc_receipt *);
+bool ggc_register_allowed(uint32_t,bool);
+size_t ggc_register_page_count(void);
+bool ggc_register_page(size_t,uint32_t *);
