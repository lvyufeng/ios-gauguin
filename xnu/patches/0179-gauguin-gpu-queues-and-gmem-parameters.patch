 size_t ggc_register_page_count(void){return COUNT(pages);}
 bool ggc_register_page(size_t n,uint32_t *out)
 {if(n>=COUNT(pages)||!out)return false;*out=pages[n];return true;}
+bool ggc_gmem_layout(uint64_t *base,uint64_t *size)
+{
+    if(!base||!size||base==size)return false;
+    uint32_t words[4]={0},seen=0;
+    for(size_t i=0;i<COUNT(config);i++) {
+        if(config[i].reg<0xe0bu||config[i].reg>0xe0eu)continue;
+        unsigned at=config[i].reg-0xe0bu;
+        if(config[i].mask||(seen&(1u<<at)))return false;
+        seen|=1u<<at;words[at]=config[i].value;
+    }
+    uint64_t first=((uint64_t)words[1]<<32)|words[0];
+    uint64_t last=((uint64_t)words[3]<<32)|words[2];
+    if(seen!=15||last<first||last==UINT64_MAX||
+       (first&4095)||((last+1)&4095))return false;
+    *base=first;*size=last-first+1;return true;
+}
 #define TRY(x) do{rc=(x);if(rc)goto done;}while(0)
