+}
+static enum gge_result commands(struct gge_context *c)
+{
+    for(unsigned i=0;i<GGE_IB_WORDS;i++){
+        if(!guard(c))return GGE_GUARD;
+        ++c->work.ib_written;
+        if(!c->ops.write_memory(c->ops.cookie,GGE_IB,4*i,c->command.ib[i]))return GGE_IO;
+        if(!guard(c))return GGE_GUARD;
+    }
+    TRY(barrier(c));
+    for(unsigned i=0;i<GGE_IB_WORDS;i++){
+        uint32_t v;TRY(mr(c,GGE_IB,4*i,&v));
+        if(v!=c->command.ib[i])return sample(c,true,0x30000u+4*i,c->command.ib[i],v);
+        ++c->work.ib_checked;
+    }
+    TRY(barrier(c));
+    for(unsigned i=0;i<GGE_COMMAND_WORDS;i++){
+        if(!guard(c))return GGE_GUARD;
+        ++c->work.commands_written;
+        if(!c->ops.write_memory(c->ops.cookie,GGE_RING,4*(GGE_START_DWORD+i),c->command.word[i]))return GGE_IO;
+        if(!guard(c))return GGE_GUARD;
+    }
+    TRY(barrier(c));
+    for(unsigned i=0;i<GGE_COMMAND_WORDS;i++){
+        uint32_t v;TRY(mr(c,GGE_RING,4*(GGE_START_DWORD+i),&v));
+        if(v!=c->command.word[i])return sample(c,true,4*(GGE_START_DWORD+i),c->command.word[i],v);
+        ++c->work.commands_checked;
+    }
+    return barrier(c);
+}
+static enum gge_result submit(struct gge_context *c)
+{
+    TRY(wr(c,0x1f8c3,1));TRY(wr(c,0x807,GGE_END_DWORD));
+    TRY(counter(c,&c->work.counter_before));c->work.counter_before_valid=1;
+    unsigned i;
+    for(i=0;i<GGQ_FENCE_LIMIT;i++){
+        TRY(barrier(c));TRY(rd(c,0x23b13,&c->work.fence_status));++c->work.fence_checks;
+        if(!(c->work.fence_status&1u))break;
+        TRY(delay(c));TRY(wr(c,0x807,GGE_END_DWORD));
+    }
+    if(i>=100){c->work.fence_slow=1;TRY(counter(c,&c->work.counter_after));c->work.counter_after_valid=1;}
+    if(i==GGQ_FENCE_LIMIT)return GGE_TIMEOUT;
+    return wr(c,0x1f8c3,0);
+}
+static enum gge_result wait_idle(struct gge_context *c)
+{
+    for(unsigned i=0;i<GGQ_IDLE_LIMIT;i++){
+        TRY(faults(c));TRY(barrier(c));TRY(mr(c,GGE_SCRATCH,0,&c->work.rptr));++c->work.idle_polls;
+        if(c->work.rptr>=GGQ_RING_WORDS)return sample(c,true,0x10000,GGE_END_DWORD,c->work.rptr);
+        if(c->work.rptr!=GGE_END_DWORD)continue;
+        TRY(rd(c,0x23b0c,&c->work.busy));
+        if(c->work.busy==UINT32_MAX)return GGE_FAULT;
+        if(!(c->work.busy&(1u<<23)))return GGE_OK;
+    }
+    return GGE_TIMEOUT;
+}
+/* Device ring progress/idle alone is not the EOP timestamp observation.
+ * No delay callback is needed here: each NC read is barrier-ordered and
+ * bracketed by the provider's monotonic2s phase/4s total/WDT guards. */
+static enum gge_result wait_eop(struct gge_context *c)
+{
+    for(unsigned i=0;i<GGE_EOP_LIMIT;i++){
+        TRY(barrier(c));TRY(mr(c,GGE_DATA,GGE_EOP_OFFSET,&c->work.eop_value));
+        ++c->work.eop_polls;
+        if(c->work.eop_value==GGE_EOP_VALUE){c->work.eop_complete=1;return GGE_OK;}
+        if(c->work.eop_value)return sample(c,true,0x20000u+GGE_EOP_OFFSET,GGE_EOP_VALUE,c->work.eop_value);
+    }
+    return GGE_TIMEOUT;
+}
+static enum gge_result verify_data(struct gge_context *c,const struct gge_prefix *prefix)
+{
+    TRY(barrier(c));
+    for(unsigned i=0;i<GGD_DATA_BYTES/4;i++){
+        uint32_t v,expected=i==0?GGE_FIRST_VALUE:i==GGD_DATA_BYTES/4-1?GGE_LAST_VALUE:4*i==GGE_EOP_OFFSET?GGE_EOP_VALUE:GGE_DATA_SEED;
