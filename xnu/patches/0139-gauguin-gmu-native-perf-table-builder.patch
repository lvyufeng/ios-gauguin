 bool gmf_plan_build(const struct ndb_entry *,struct gmf_plan *);
 bool gmf_plan_valid(const struct gmf_plan *);
+/* Fixed gauguin active800MHz bin, native legacy v1 PERF layout: header,
+ * GPU/GMU counts,16 GX and4 CX pairs (ARC vote,kHz), unused pairs zero.
+ * The captured six active frequencies plus native off entry give7 GX rows.
+ * Caller supplies the already validated same-boot ARC plan; this function
+ * only constructs ordinary RAM bytes. No send/MMIO/clock/voltage action.
+ * Native MIN_SVS=48 rounds up to the first captured CX level64 and MX64.
+ * Sequence must be1..4095. Output/plan must be private ordinary RAM and
+ * cannot overlap; all failure paths preserve output. A constructed table
+ * is NOT proof of a firmware ACK, a changed frequency or normal HFI_ON.
+ */
+#define GMF_PERF_WORDS 43u
+struct gmf_perf_table {uint32_t word[GMF_PERF_WORDS];};
+bool gmf_perf_table_build(const struct gmf_plan *,uint32_t sequence,
+    struct gmf_perf_table *);
 /* Byte offsets from the fixed private board mappings, NOT native word
  * offsets: CSR03d7c000, AO/RSC03d8c000, PDCcfg0b294000, PDCseq0b490000,
  * TCM03d6c000. Native GPU-relative register names are converted in this TU. */
