+
+static void
+sweet_eagl_gpu_record_proxy(struct image_params *imgp, proc_t p)
+{
+	proc_t launchd = current_proc();
+	if (launchd == NULL || !proc_isinitproc(launchd) || p == NULL || p == launchd ||
+	    !(imgp->ip_flags & IMGPF_SPAWN) || (imgp->ip_flags & IMGPF_EXEC) ||
+	    imgp->ip_new_thread == THREAD_NULL ||
+	    p != (proc_t)get_bsdthreadtask_info(imgp->ip_new_thread) ||
+	    proc_original_ppid(p) != proc_pid(launchd)) {
+		return;
+	}
+	vfs_context_t context = imgp->ip_vfs_context;
+	kauth_cred_t cred = vfs_context_ucred(context);
+	if (!IS_VALID_CRED(cred)) {
+		return;
+	}
+	vnode_t proxy = NULLVP;
+	if (vnode_lookup("/usr/libexec/xpcproxy",
+	    VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT, &proxy,
+	    vfs_context_kernel()) != 0) {
+		return;
+	}
+	bool protected_proxy = proxy == imgp->ip_vp &&
+	    sweet_eagl_protected_node(proxy, context, kauth_cred_getuid(cred));
+	vnode_put(proxy);
+	uint64_t uniqueid = proc_uniqueid(p);
+	if (protected_proxy && uniqueid != 0) {
+		__atomic_store_n(&sweet_eagl_launch_uniqueid, uniqueid, __ATOMIC_RELEASE);
+		printf("SWEET GPU AUTH: recorded launchd compositor proxy pid=%d\n", proc_pid(p));
+	}
+}
+
+bool
+sweet_eagl_gpu_pilot_caller(proc_t p)
+{
+	if (!sweet_eagl_gpu_pilot_enabled() || p == NULL || p != current_proc()) {
+		return false;
+	}
+	uint64_t uniqueid = __atomic_load_n(&sweet_eagl_launch_uniqueid, __ATOMIC_ACQUIRE);
+	return uniqueid != 0 && proc_uniqueid(p) == uniqueid && sweet_eagl_diagnostic_caller(p);
+}
+/* SWEET_EAGL_GPU_PILOT_END */
 #endif
 
