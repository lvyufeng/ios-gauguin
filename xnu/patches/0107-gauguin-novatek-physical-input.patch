+    }
+    return false;
+}
+static bool nv_clock(void)
+{
+    uint32_t dfs = nv_read(nv_maps.clock, 0x15c);
+    if (!(dfs & 1) || ((dfs >> 1) & 15) != 0) return false;
+    uint32_t cfg = nv_read(nv_maps.clock, 0x164);
+    return cfg == 1 && nv_read(nv_maps.clock, 0x15c) == dfs &&
+        nv_read(nv_maps.clock, 0x164) == cfg;
