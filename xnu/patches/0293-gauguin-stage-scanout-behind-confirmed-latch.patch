+} scan382;
+
+static bool scan382_route(const struct scan381_state *s)
+{
+    if (s->id0 != 0x4c017e47 || s->id1 != 0x6000003f || s->id2 != 0x5111 ||
+        s->control != 0x00200406 || s->secure != 0)
+        return false;
+    for (unsigned i = 0; i < 2; ++i) {
+        const struct scan381_stream *r = &s->streams[i];
+        if (r->matches != 1 || r->index != 3 || r->smr != 0x80020800 || r->s2cr != 2 ||
+            r->cbar != 0x0001f000 || r->sctlr != 0x000000e0)
+            return false;
+    }
+    return true;
+}
+
+static bool scan382_live_route(void)
+{
+    const volatile uint32_t *global = (const volatile uint32_t *)scan381.global;
+    const volatile uint32_t *cbar = scan381_word(F381_APPS + 0x1008);
+    const volatile uint32_t *sctlr = scan381_word(F381_APPS + 0x82000);
+    const volatile uint32_t *pipe = (const volatile uint32_t *)(scan367.pages[0] + 0x1000);
+    return cbar && sctlr && global[0] == 0x00200406 &&
+        global[0x80c / 4] == 0x80020800 && global[0xc0c / 4] == 2 &&
+        *cbar == 0x0001f000 && *sctlr == 0x000000e0 &&
+        pipe[0x70 / 4] == 0 && pipe[0x24 / 4] == 4320 &&
+        pipe[0x00 / 4] == 0x09600438 && pipe[0x30 / 4] == 0x000237ff &&
+        scan_mdp[0x2014 / 4] == 0 && scan_mdp[0x20f4 / 4] == 2 &&
+        scan_mdp[0x2000 / 4] == 0x01000005;
+}
+
+static vm_offset_t scan382_map(uint32_t pa, uint32_t size, bool pixels)
+{
+    const vm_offset_t va = pixels ? ml_io_map_wcomb(pa, size) :
+        ml_io_map_with_prot(pa, size, VM_PROT_READ | VM_PROT_WRITE);
+    if (!va || ml_vtophys(va) != pa || ml_vtophys(va + size - 1) != (uint64_t)pa + size - 1)
+        return 0;
+    return va;
+}
+
+static bool scan382_prepare(const struct scan381_state *s)
+{
+    DTEntry chosen = NULL;
+    const void *property = NULL;
+    unsigned size = 0;
+    uint64_t owner[4], pas[16];
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTGetProperty(chosen, "DPUPrivateBuffers", &property, &size) != kSuccess ||
+        size != sizeof(owner))
+        return false;
+    memcpy(owner, property, sizeof(owner));
+    if (!scan382_route(s) || !scan382_live_route() ||
+        SecureDTGetProperty(chosen, "LowPASReservation", &property, &size) != kSuccess ||
+        size != sizeof(pas))
+        return false;
+    memcpy(pas, property, sizeof(pas));
+    const uint64_t start = owner[0], slot = owner[1], payload = owner[2], length = owner[3];
+    if (memcmp(pas, "LPASOWN1", 8) || payload != pas[10] || length != pas[11] || pas[2] > length ||
+        !payload || !length || payload >= UINT64_C(0x100000000) ||
+        length > UINT64_C(0x100000000) - payload ||
+        slot != F382_SLOT_BYTES || (start & (F344_PAGE - 1)) || start < payload ||
+        start > payload + length || 2 * slot > payload + length - start ||
+        start + 2 * slot > pas[2] + payload || start + 2 * slot > pas[8] ||
+        (start < 0xa2400000 && start + 2 * slot > 0xa0000000))
+        return false;
+    for (uint64_t pa = start; pa < start + 2 * slot; pa += F344_PAGE)
+        if (pmap_valid_address(pa))
+            return false;
+    scan382.address[F382_FRONT] = 0xa0000000;
+    for (unsigned i = F382_FIRST; i <= F382_SECOND; ++i) {
+        scan382.address[i] = (uint32_t)(start + (i - 1) * slot);
+        scan382.map[i] = scan382_map(scan382.address[i], (uint32_t)slot, true);
+        if (!scan382.map[i])
+            return false;
+    }
+    const vm_offset_t vig = scan382_map(0x0ae04000, F344_PAGE, false);
+    const vm_offset_t ctl = scan382_map(0x0ae00000, F344_PAGE, false);
+    if (!vig || !ctl)
+        return false;
+    scan382.source = (volatile uint32_t *)(vig + 0x1014);
+    scan382.flush = (volatile uint32_t *)(ctl + 0x2018);
+    if (*scan382.source != scan382.address[F382_FRONT] || *scan382.flush)
+        return false;
+    printf("SWEET F382 BACKING: first=%08x second=%08x bytes=%d\n",
+        scan382.address[1], scan382.address[2], F382_SLOT_BYTES);
+    __atomic_store_n(&scan382.enabled, true, __ATOMIC_RELEASE);
+    return true;
+}
+
+bool sweet_frame382_active(void)
+{
+    return __atomic_load_n(&scan382.enabled, __ATOMIC_ACQUIRE);
+}
+
+bool sweet_frame382_ending(void)
+{
+    uint64_t ticks;
+    nanoseconds_to_absolutetime(NSEC_PER_MSEC * 180, &ticks);
+    const uint64_t now = mach_absolute_time();
+    return now >= frames.end || frames.end - now <= ticks;
+}
+
+uintptr_t sweet_frame382_buffer(unsigned slot)
+{
+    return sweet_frame382_active() && slot >= F382_FIRST && slot <= F382_SECOND ? scan382.map[slot] : 0;
+}
+
+unsigned sweet_frame382_issue(unsigned front, unsigned next, uint32_t *frame)
+{
+    struct scan351_position before, after;
+    if (!sweet_frame382_active() || front > F382_SECOND || next > F382_SECOND || front == next ||
+        scan382.requests >= F382_MAX_FLIPS + (next == F382_FRONT))
+        return F382_UNCERTAIN;
+    if (!sweet_frame351_position(&before) || before.line < SCAN351_OPEN ||
+        before.end < before.line + 192)
+        return F382_WAIT;
+    if (!scan382_live_route() || *scan382.source != scan382.address[front] || *scan382.flush)
+        return F382_UNCERTAIN;
+    const boolean_t interrupts = ml_set_interrupts_enabled(FALSE);
+    const uint32_t checked_frame = scan_intf[F344_FRAME_COUNT / 4];
+    const uint32_t checked_line = scan_intf[F344_LINE_COUNT / 4];
+    if (checked_frame != before.frame || checked_line < before.line || before.end < checked_line + 192) {
+        ml_set_interrupts_enabled(interrupts);
+        return F382_WAIT;
+    }
+    ++scan382.requests;
+    *scan382.source = scan382.address[next];
+    __asm__ volatile("dsb oshst" ::: "memory");
+    *scan382.flush = 1;
+    __asm__ volatile("dsb sy" ::: "memory");
+    const uint32_t flush = *scan382.flush;
+    const uint32_t source = *scan382.source;
+    ml_set_interrupts_enabled(interrupts);
+    if (flush != 1 || source != scan382.address[next] ||
+        !sweet_frame351_position(&after) || after.frame != before.frame || after.line >= before.end)
+        return F382_UNCERTAIN;
+    *frame = before.frame;
+    return F382_TOUCHED;
+}
+
+unsigned sweet_frame382_latch(unsigned next, uint32_t requested_scan)
+{
+    struct scan351_position a, b;
+    if (!sweet_frame382_active() || next > F382_SECOND)
+        return F382_UNCERTAIN;
+    if (!sweet_frame351_position(&a))
+        return F382_WAIT;
+    const uint32_t delta = a.frame - requested_scan;
+    if (delta > 1)
+        return F382_UNCERTAIN;
+    if (!delta)
+        return F382_WAIT;
+    const uint32_t flush = *scan382.flush;
+    const uint32_t source = *scan382.source;
+    if (!sweet_frame351_position(&b) || a.frame != b.frame || a.line > b.line)
+        return F382_WAIT;
+    if (source != scan382.address[next] || flush & ~1u || !scan382_live_route())
+        return F382_UNCERTAIN;
+    return flush ? F382_WAIT : F382_CONFIRMED;
 }
 
