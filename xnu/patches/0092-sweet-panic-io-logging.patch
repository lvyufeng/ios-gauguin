+extern void sweet_log_append(const char *, int);
+
+static void sweet_ufs_log(const char *, ...) __printflike(1, 2);
+
+/* Polled panic I/O can run before the normal console is suspended. Its
+ * diagnostics must enter the lock-free log directly when IRQs are disabled. */
+static void
+sweet_ufs_log(const char *format, ...)
+{
+	char line[256];
+	va_list args;
+	va_start(args, format);
+	int length = vsnprintf(line, sizeof(line), format, args);
+	va_end(args);
+	if (length <= 0) {
+		return;
+	}
+	if (ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	} else {
+		sweet_log_append(line, MIN(length, (int)sizeof(line) - 1));
+	}
+}
+
