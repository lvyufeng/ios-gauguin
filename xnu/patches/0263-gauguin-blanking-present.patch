+static bool scan351_position(struct scan351_position *out)
+{
+    struct scan345_status status = {0};
+    struct scan345_geometry geometry = {0};
+    if (scan_route(&status, &geometry) != SCAN345_OK || !scan349_timing(&geometry))
+        return false;
+    const uint64_t begin = mach_absolute_time();
+    const uint32_t frame = scan_intf[F344_FRAME_COUNT / 4];
+    const uint32_t line = scan_intf[F344_LINE_COUNT / 4];
+    const uint32_t config = scan_intf[F351_INTF_CONFIG / 4];
+    const uint32_t fetch = scan_intf[F351_FETCH_START / 4];
+    const uint32_t last = scan_intf[F344_FRAME_COUNT / 4];
+    const uint32_t count = scan_intf[F345_COUNT_EN / 4];
+    const uint64_t end = mach_absolute_time();
+    uint64_t ns;
+    absolutetime_to_nanoseconds(end - begin, &ns);
+    if (frame != last || count != 0 || line >= geometry.vtotal || ns > SCAN349_READ_US * NSEC_PER_USEC)
+        return false;
+    *out = (struct scan351_position){end, frame, line, scan351_end(config, fetch, geometry.htotal)};
+    return true;
+}
+
+bool sweet_frame351_position(struct scan351_position *out)
+{
+    /* The acquire pairs with publication after the read-only route and
+     * immutable geometry have been qualified in the scan work item. */
+    return sweet_frame351_window() && scan351_position(out);
+}
