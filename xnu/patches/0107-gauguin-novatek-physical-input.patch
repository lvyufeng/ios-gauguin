+        rd(s, GSS_SE, S_IRQ_STATUS, &s->report.irq_after_s)) return fail(s, GSS_OWNERSHIP);
+    if (s->report.irq_after_m || s->report.irq_after_s) return fail(s, GSS_READBACK);
+    if ((result = idle(s)) || (result = source_clock(s))) return fail(s, result);
+    s->state = GSS_CONFIGURED;
+    return GSS_OK;
+}
