diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 1981490..3316dd8 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -80,16 +80,43 @@ sweet_spmi_init(void)
 	sp_ready = true;
 	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
 	    arb_version, sp_count);
+	/*
+	 * Which peripherals does EE0 own? The battery blocks (0x10-0x13) are
+	 * known to work; the PON (0x08) and PBS (0x0a) blocks are only readable
+	 * if EE0 has a channel for them, and the arbiter's map register is the
+	 * authoritative answer. Print the owned PPIDs once - it is the first
+	 * thing to look at when a PMIC read fails.
+	 */
+	{
+		unsigned shown = 0;
+		for (unsigned i = 0; i < sp_count && shown < 24; ++i) {
+			uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+			unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+			if (map && owner == 0) {
+				printf("SWEET BATTERY: SPMI ee0 apid=%u ppid=%#x\n",
+				    i, (map >> 8) & 0xfffu);
+				shown++;
+			}
+		}
+	}
 	return 0;
 }
 
