+ * Publishing a service with the property costs nothing and needs no hardware:
+ * brightness is applied by AppleCLCD, we only have to be findable.
+ */
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+
+public:
+	bool start(IOService *provider) override;
+	void stop(IOService *provider) override;
+};
