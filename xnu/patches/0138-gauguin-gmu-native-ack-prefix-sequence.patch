diff --git a/bsd/dev/gauguin_gmu_firmware.c b/bsd/dev/gauguin_gmu_firmware.c
--- a/bsd/dev/gauguin_gmu_firmware.c
+++ b/bsd/dev/gauguin_gmu_firmware.c
@@ -305,8 +305,12 @@
         uint32_t reply[19];size_t n=0;enum ggh_result r=ggh_receive(&c->hfi,1,reply,19,&n);
         if(r!=GGH_OK)return GMF_TRANSPORT;
         if(((reply[0]>>16)&15)==2){
-            if(n!=ack_words)return reply_refuse(c,GMFR_REQUEST,GMFR_SIZE,1,packet[0],ack_words,reply,n);
-            if(reply[1]!=packet[0])return reply_refuse(c,GMFR_REQUEST,GMFR_ECHO,1,packet[0],ack_words,reply,n);
+            /* Native copies the header-reported length and correlates only
+             * sequence. GGH bounds the complete packet to19 words; require
+             * the status/version prefix before reading/copying it. Extra
+             * payload and other echoed bits stay unqualified. */
+            if(n<ack_words||n>GMF_REPLY_WORDS)return reply_refuse(c,GMFR_REQUEST,GMFR_SIZE,1,packet[0],ack_words,reply,n);
+            if((reply[1]&GMF_ACK_SEQUENCE_MASK)!=(packet[0]&GMF_ACK_SEQUENCE_MASK))return reply_refuse(c,GMFR_REQUEST,GMFR_ECHO,1,packet[0],ack_words,reply,n);
             if(reply[2]==UINT32_MAX)return reply_refuse(c,GMFR_REQUEST,GMFR_STATUS,1,packet[0],ack_words,reply,n);
             if(ack_words==4&&reply[2]!=0)return reply_refuse(c,GMFR_REQUEST,GMFR_VERSION_STATUS,1,packet[0],ack_words,reply,n);
             memcpy(ack,reply,ack_words*4);return GMF_OK;
diff --git a/bsd/dev/gauguin_gmu_firmware.h b/bsd/dev/gauguin_gmu_firmware.h
--- a/bsd/dev/gauguin_gmu_firmware.h
+++ b/bsd/dev/gauguin_gmu_firmware.h
@@ -44,6 +44,8 @@
  * from an absent sample. Does not alter the public success receipt. */
 struct gmf_diagnostic {uint32_t valid,phase,check,window,offset,mask,expected,actual;};
 #define GMF_REPLY_WORDS 19u
+/* Native HDR_CMP_SEQNUM; all other echoed request bits are unqualified. */
+#define GMF_ACK_SEQUENCE_MASK 0xfff00000u
 enum gmf_reply_site {GMFR_DRAIN=1,GMFR_REQUEST=2};
 enum gmf_reply_reason {GMFR_UNEXPECTED_ACK=1,GMFR_UNEXPECTED_MESSAGE,
     GMFR_SIZE,GMFR_ECHO,GMFR_STATUS,GMFR_VERSION_STATUS,GMFR_LIMIT};
