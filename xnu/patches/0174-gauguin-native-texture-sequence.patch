+struct run {struct ggf_context *c;const struct ggf_ops *ops;const struct ggf_command *command;unsigned job;enum ggf_phase phase;uint32_t pixels[GGF_OUTPUT_WORDS];};
+static struct ggf_job_receipt *work(struct run *r)
+{return &r->c->work.job[r->job];}
+static bool stable(struct run *r)
+{
