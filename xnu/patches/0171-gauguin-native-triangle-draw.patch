+    TRY(mr(c,GGT_SCRATCH,0,&c->work.initial_shadow));
+    if(c->work.initial_shadow!=GGT_START_DWORD)return sample(c,true,0x10000u,GGT_START_DWORD,c->work.initial_shadow);
+    TRY(rd(c,0x23b0c,&c->work.initial_busy));if(c->work.initial_busy&(1u<<23))return GGT_FAULT;
