+uintptr_t
+AppleCLCD::flip382Begin(const struct sweet_fb_frame *frame, uint64_t attempt,
+    uint64_t blankFrame, bool *blocked)
+{
+    if (!sweet_frame382_active() || !get32(frame->record,0x104)) return 0;
+    bool haveLayer = false;
+    for (const auto *surface : frame->surfaces) haveLayer |= surface != nullptr;
+    if (!haveLayer) return 0; /* Empty layers retain the inherited path. */
+    IOLockLock(fLock);
+    auto &flip = fFlip382;
+    uintptr_t dst = 0;
+    if (!flip.closed) {
+        if (flip.stage != sweet_fb_flip382::Idle || sweet_frame382_ending()) {
+            *blocked = true;
+        } else if (blankFrame == UINT64_MAX || !attempt || !frame->ready.observed ||
+            !frame->surfaces[0] || get32(frame->record,0x104) != 1) {
+            if (flip.front) {
+                flip.stage = sweet_fb_flip382::Quarantined;
+                IOLog("SWEET F382 STOP: unsupported-update front=%u\n",flip.front);
+                *blocked = true;
+            }
+        } else {
+            flip.next = flip.front == F382_FIRST ? F382_SECOND : F382_FIRST;
+            dst = sweet_frame382_buffer(flip.next);
+            if (dst) {
+                flip.stage = sweet_fb_flip382::Copying;
+                flip.attempt = attempt;
+            } else {
+                *blocked = true;
+            }
+        }
+    }
+    IOLockUnlock(fLock);
+    return dst;
+}
