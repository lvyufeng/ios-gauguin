diff --git a/bsd/dev/gauguin_cx_power.c b/bsd/dev/gauguin_cx_power.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_cx_power.c
@@ -0,0 +1,207 @@
+/* Native19b63c8192b1c9b7c4d931d7d3be92024bc2d778 gdsc-regulator.c and
+ * gpucc-lagoon.c; actual gauguin DT CX GDSCR106c/wait8/timeout500us.
+ * The DT says hw-ctl-addr, while the pinned parser accepts hw-ctrl-addr;
+ * this exact native combination polls GDSCR106c, not syscon1540.
+ * No CX sw-reset/domain-addr/retention-clock branch exists in this DT.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <mach/mach_time.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+#include "gauguin_cx_power.h"
+#include "gauguin_cx_rail.h"
+#include "gauguin_wdt_lease.h"
+extern vm_offset_t ml_io_map_with_prot(vm_offset_t, vm_size_t, vm_prot_t);
+extern vm_offset_t ml_vtophys(vm_offset_t);
+extern boolean_t pmap_valid_page(ppnum_t);
+extern unsigned int pmap_cache_attributes(ppnum_t);
+extern int get_preemption_level(void);
+extern void sweet_log_mark_sync(const char *);
+extern void sweet_log_flush_now(void);
+
+#define GCX_GCC_PAGE UINT64_C(0x00144000)
+#define GCX_GCC_CFG 0x1004u /* absolute00145004, not a16KiB-aligned map base */
+#define GCX_GPUCC_PAGE UINT64_C(0x03d90000)
+#define GCX_PAGE 0x4000u
+#define GCX_GDSCR 0x106cu
+#define GCX_AHB 0x1078u
+#define GCX_ON (1u << 31)
+#define GCX_COLLAPSE 1u
+#define GCX_MODE_MASK 6u
+#define GCX_WAIT_MASK 0xf000u
+#define GCX_WAIT8 0x8000u
+#define GCX_CONTROL_MASK (GCX_WAIT_MASK | GCX_MODE_MASK | GCX_COLLAPSE)
+#define GCX_ENTRY_TICKS (5u * 32765u)
+#define GCX_STEP_TICKS (3u * 32765u)
+_Static_assert(PAGE_SHIFT == 14, "CX mappings are exactly16KiB pages");
+static unsigned gcx_lifecycle;
+static vm_offset_t gcx_gcc, gcx_gpucc;
+static uint64_t gcx_deadline;
+static struct gcx_receipt gcx_work;
+
+static bool gcx_context(void)
+{ return ml_get_interrupts_enabled() && !ml_at_interrupt_context() && get_preemption_level() == 0; }
+static void gcx_record(const char *line)
+{
+    printf("%s\n", line);
+    if (gcx_context()) { sweet_log_mark_sync(line); sweet_log_flush_now(); }
+}
+bool sweet_cx_power_requested(void)
+{
+    int flag = 0; (void)PE_parse_boot_argn("sweetcxpower", &flag, sizeof(flag));
+    return flag == 1;
+}
+enum gcx_state sweet_cx_power_state(void)
+{ return (enum gcx_state)__atomic_load_n(&gcx_lifecycle, __ATOMIC_ACQUIRE); }
+static bool gcx_flags(void)
+{
+    int vote = 0; (void)PE_parse_boot_argn("sweetbusvote", &vote, sizeof(vote));
+    if (vote != 1) return false;
+    static const char *const off[] = {"sweetpasinit", "sweetpasmem", "sweettouchmode",
+        "sweetwdtpet", "sweetreboot", "sweetbusprobe", "sweetgpuprobe", "sweetscmprobe", "sweetwdttest"};
+    for (unsigned i = 0; i < sizeof(off) / sizeof(off[0]); ++i) {
+        int value = 0; (void)PE_parse_boot_argn(off[i], &value, sizeof(value));
+        if (value != 0) return false;
+    }
+    return true;
+}
+static enum gcx_rc gcx_guard(uint32_t minimum)
+{
+    if (!gcx_context()) return GCX_CONTEXT;
+    if (sweet_cx_rail_state() != GCR_COMPLETE) return GCX_PARENT;
+    if (mach_absolute_time() >= gcx_deadline) return GCX_TIMEOUT;
+    if (!gauguin_wdt_lease_check_budget(minimum)) return GCX_BUDGET;
+    return GCX_OK;
+}
+static uint32_t gcx_read(vm_offset_t mapping, uint32_t offset)
+{
+    uint32_t value = *(volatile uint32_t *)(mapping + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+static void gcx_write(uint32_t value)
+{
+    ++gcx_work.writes; /* uncertain before actual store; never retry */
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(gcx_gpucc + GCX_GDSCR) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static enum gcx_rc gcx_fail(enum gcx_rc rc, const char *reason)
+{
+    gauguin_wdt_lease_quarantine();
+    __atomic_store_n(&gcx_lifecycle, GCX_QUARANTINED, __ATOMIC_RELEASE);
+    char line[192];
+    snprintf(line, sizeof(line), "SWEET CX POWER: stopped rc=%u writes=%u polls=%u reason=%s; retained, no retry/cleanup",
+        (unsigned)rc, gcx_work.writes, gcx_work.polls, reason);
+    gcx_record(line); return rc;
+}
+static enum gcx_rc gcx_map(uint64_t pa, vm_prot_t prot, vm_offset_t *out, uint32_t minimum)
+{
+    ppnum_t pn = (ppnum_t)(pa >> PAGE_SHIFT);
+    if (pmap_valid_page(pn) || (pmap_cache_attributes(pn) & 255u) != 7u) return GCX_MAPPING;
+    char line[160];
+    snprintf(line, sizeof(line), "SWEET CX POWER: before map pa=%08llx bytes=4000 prot=%u", (unsigned long long)pa, (unsigned)prot);
+    gcx_record(line);
+    enum gcx_rc rc = gcx_guard(minimum); /* synchronous persistence consumed time */
+    if (rc != GCX_OK) return rc;
+    vm_offset_t va = ml_io_map_with_prot((vm_offset_t)pa, GCX_PAGE, prot);
+    if (!va || ml_vtophys(va) != pa || ml_vtophys(va + GCX_PAGE - 1u) != pa + GCX_PAGE - 1u) return GCX_MAPPING;
+    *out = va; return GCX_OK;
+}
+static enum gcx_rc gcx_step(uint32_t mask, uint32_t value, bool wait_required, const char *marker, uint32_t *result)
+{
+    gcx_record(marker);
+    enum gcx_rc rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return rc;
+    uint32_t before = gcx_read(gcx_gpucc, GCX_GDSCR);
+    if (before & GCX_MODE_MASK) return GCX_MODE;
+    if (wait_required && (before & GCX_WAIT_MASK) != GCX_WAIT8) return GCX_READBACK;
+    uint32_t wanted = (before & ~mask) | value;
+    if (wanted != before) {
+        /* The fresh register read itself may have consumed time. */
+        rc = gcx_guard(GCX_STEP_TICKS);
+        if (rc != GCX_OK) return rc;
+        gcx_write(wanted); /* preserve every unrelated bit */
+    }
+    rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return rc;
+    uint32_t after = gcx_read(gcx_gpucc, GCX_GDSCR);
+    *result = after;
+    /* PWR_ON is dynamic status. Verify our control bits, not a guessed whole
+     * register constant; no hardware-mode takeover is allowed. */
+    if ((after & GCX_CONTROL_MASK) != (wanted & GCX_CONTROL_MASK)) return GCX_READBACK;
+    return GCX_OK;
+}
+enum gcx_rc
+sweet_cx_power_once(struct gcx_receipt *out)
+{
+    unsigned expected = GCX_IDLE;
+    if (!sweet_cx_power_requested()) return GCX_OFF;
+    if (out == NULL) return GCX_ARGUMENT;
+    if (!__atomic_compare_exchange_n(&gcx_lifecycle, &expected, GCX_RUNNING, false,
+        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return GCX_ALREADY;
+    if (!gcx_context()) return gcx_fail(GCX_CONTEXT, "invalid context");
+    if (!gcx_flags()) return gcx_fail(GCX_CONFIG, "conflicting flags");
+    clock_interval_to_deadline(5, NSEC_PER_SEC, &gcx_deadline);
+    enum gcx_rc rc = gcx_guard(GCX_ENTRY_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "parent/initial budget");
+    rc = gcx_map(GCX_GCC_PAGE, VM_PROT_READ, &gcx_gcc, GCX_ENTRY_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "GCC map/guard");
+    gcx_record("SWEET CX POWER: before GCC CFG_AHB read pa=00145004; no GCC write");
+    rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "GCC gate guard");
+    gcx_work.gcc_cfg_ahb = gcx_read(gcx_gcc, GCX_GCC_CFG);
+    char line[192];
+    snprintf(line, sizeof(line), "SWEET CX POWER: GCC CFG_AHB raw=%08x", gcx_work.gcc_cfg_ahb); gcx_record(line);
+    if (!(gcx_work.gcc_cfg_ahb & 1u) || (gcx_work.gcc_cfg_ahb & GCX_ON)) return gcx_fail(GCX_ACCESS_GATE, "GCC config AHB not enabled/on");
+    rc = gcx_map(GCX_GPUCC_PAGE, VM_PROT_READ | VM_PROT_WRITE, &gcx_gpucc, GCX_STEP_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "GPUCC map/guard");
+    gcx_record("SWEET CX POWER: before first GDSCR read pa=03d9106c; parent ARC completion required");
+    rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "first GDSCR guard");
+    gcx_work.gdsc_before = gcx_read(gcx_gpucc, GCX_GDSCR);
+    snprintf(line, sizeof(line), "SWEET CX POWER: GDSCR before=%08x", gcx_work.gdsc_before); gcx_record(line);
+    if (gcx_work.gdsc_before & GCX_MODE_MASK) return gcx_fail(GCX_MODE, "HW_CONTROL/SW_OVERRIDE owned elsewhere");
+    rc = gcx_step(GCX_WAIT_MASK, GCX_WAIT8, false,
+        "SWEET CX POWER: before masked CLK_DIS_WAIT=8; no mode takeover", &gcx_work.gdsc_config);
+    if (rc != GCX_OK) return gcx_fail(rc, "wait configuration");
+    snprintf(line, sizeof(line), "SWEET CX POWER: GDSCR configured=%08x writes=%u", gcx_work.gdsc_config, gcx_work.writes); gcx_record(line);
+    rc = gcx_step(GCX_COLLAPSE, 0, true,
+        "SWEET CX POWER: before clearing HLOS SW_COLLAPSE only; no reset/clamp write", &gcx_work.gdsc_enable);
+    if (rc != GCX_OK) return gcx_fail(rc, "software enable");
+    /* Native gdsc_mb readback above, then at least8 XO cycles. */
+    delay(1);
+    bool on = false;
+    for (unsigned i = 0; i < 500; ++i) {
+        rc = gcx_guard(GCX_STEP_TICKS);
+        if (rc != GCX_OK) return gcx_fail(rc, "power-on poll guard");
+        uint32_t value = gcx_read(gcx_gpucc, GCX_GDSCR); ++gcx_work.polls;
+        if ((value & GCX_CONTROL_MASK) != GCX_WAIT8) return gcx_fail(GCX_READBACK, "controls changed during power-on");
+        if (value & GCX_ON) { on = true; break; }
+        delay(1);
+    }
+    if (!on) return gcx_fail(GCX_TIMEOUT, "PWR_ON not observed in500 polls");
+    delay(1); delay(1); /* native clock/memory then staggered-memory settle */
+    rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "settle guard");
+    gcx_work.gdsc_final = gcx_read(gcx_gpucc, GCX_GDSCR);
+    if ((gcx_work.gdsc_final & (GCX_ON | GCX_CONTROL_MASK)) != (GCX_ON | GCX_WAIT8)) return gcx_fail(GCX_READBACK, "final power/control mismatch");
+    gcx_record("SWEET CX POWER: before final GPUCC AHB raw read pa=03d91078; CX on only");
+    rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "AHB observation guard");
+    gcx_work.ahb_final = gcx_read(gcx_gpucc, GCX_AHB);
+    if (gcx_work.ahb_final == UINT32_MAX) return gcx_fail(GCX_READBACK, "AHB observation all ones");
+    snprintf(line, sizeof(line), "SWEET CX POWER: final gdsc=%08x ahb=%08x writes=%u polls=%u", gcx_work.gdsc_final, gcx_work.ahb_final, gcx_work.writes, gcx_work.polls); gcx_record(line);
+    rc = gcx_guard(GCX_STEP_TICKS);
+    if (rc != GCX_OK) return gcx_fail(rc, "post-log budget");
+    *out = gcx_work;
+    __atomic_store_n(&gcx_lifecycle, GCX_COMPLETE, __ATOMIC_RELEASE);
+    gcx_record("SWEET CX POWER: complete CX PWR_ON and HLOS request verified; GMU/GX/GPU execution untested");
+    return GCX_OK;
+}
+#endif /* GAUGUIN */
diff --git a/bsd/dev/gauguin_cx_power.h b/bsd/dev/gauguin_cx_power.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_cx_power.h
@@ -0,0 +1,29 @@
+#ifndef GAUGUIN_CX_POWER_H
+#define GAUGUIN_CX_POWER_H
+#include <stdbool.h>
+#include <stdint.h>
+enum gcx_state { GCX_IDLE, GCX_RUNNING, GCX_COMPLETE, GCX_QUARANTINED };
+enum gcx_rc { GCX_OK, GCX_OFF, GCX_ARGUMENT, GCX_ALREADY, GCX_CONTEXT,
+    GCX_CONFIG, GCX_PARENT, GCX_BUDGET, GCX_TIMEOUT, GCX_MAPPING,
+    GCX_ACCESS_GATE, GCX_MODE, GCX_READBACK };
+struct gcx_receipt {
+    uint32_t gcc_cfg_ahb, gdsc_before, gdsc_config, gdsc_enable, gdsc_final;
+    uint32_t ahb_final, writes, polls;
+};
+/* One fixed CX power transaction after successful same-boot ARC parent request.
+ * Parent completion depends on the reviewed native legal-selector envelope;
+ * it is not measured voltage or secure-owner proof. No GPUCC access precedes
+ * that parent and a live already-enabled GCC config-AHB gate. No GCC writes.
+ *
+ * Only GDSCR wait8 and HLOS SW_COLLAPSE0 may be written. Reject inherited
+ * HW_CONTROL/SW_OVERRIDE rather than taking over an unknown hardware owner.
+ * Mapping/request remain held until reset; every started failure quarantines
+ * state and WDT authorization, with no rollback/retry/disable/PET operation.
+ * Output is written only on complete success, before terminal release state.
+ * Raw AHB is a final observation; COMPLETE is CX-on, not GMU/GX/GPU execution.
+ * Software deadlines cannot cancel a blocked MMIO access.
+ */
+bool sweet_cx_power_requested(void);
+enum gcx_rc sweet_cx_power_once(struct gcx_receipt *out);
+enum gcx_state sweet_cx_power_state(void);
+#endif
diff --git a/bsd/dev/gauguin_cx_rail.h b/bsd/dev/gauguin_cx_rail.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_cx_rail.h
@@ -0,0 +1,27 @@
+#ifndef GAUGUIN_CX_RAIL_H
+#define GAUGUIN_CX_RAIL_H
+#include <stdbool.h>
+#include <stdint.h>
+#include "gauguin_bcm_transport.h"
+struct ndb_entry;
+/* Fixed gauguin diagnostic policy, not a general regulator or current-vote API.
+ * Exact current CMDDB CX table and captured DT max65535 bound selector6/384.
+ * This dominates legal requests in that table, not undocumented out-of-domain
+ * votes. Known HLOS writers are excluded; secure ownership/solver behavior is
+ * not established by idle TCS. Hold the request until the qualified WDT reset;
+ * never lower/release a vote or claim a measured voltage from completion. */
+struct gcr_plan {
+    uint32_t address, selector, level, count, max_level;
+    uint16_t levels[16];
+};
+bool gcr_plan_build(const struct ndb_entry *, struct gcr_plan *);
+bool gcr_plan_valid(const struct gcr_plan *);
+enum gcr_state { GCR_IDLE, GCR_RUNNING, GCR_COMPLETE, GCR_REJECTED, GCR_QUARANTINED };
+/* Exactly one additional fixed CX command after the successful BCM cleanup,
+ * through the same private RSC mapping/owner. Global response required even
+ * with WAIT0: ADDR30000 DATA6 MSGID10108 ENABLE1, ISSUED+COMPL and fresh IRQ.
+ * Preserve BCM's completed receipt/state; any uncertain ARC write quarantines
+ * further controller use and WDT authorization, without retry or cleanup. */
+enum gbcmt_rc sweet_cx_rail_submit_once(const struct gcr_plan *, struct gbcmt_receipt *);
+enum gcr_state sweet_cx_rail_state(void);
+#endif
diff --git a/bsd/dev/gauguin_cx_rail_plan.c b/bsd/dev/gauguin_cx_rail_plan.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_cx_rail_plan.c
@@ -0,0 +1,37 @@
+/* Pure fixed-board CX diagnostic policy. No MMIO or voltage measurements.
+ * The current gauguin CMDDB table and captured native DT max65535 define an
+ * upper envelope for legal native DRV2 requests, not an observed live floor.
+ * Do not silently adapt to a different table, board maximum or resource. */
+#include <string.h>
+#include "cmd_db_snapshot.h"
+#include "gauguin_cx_rail.h"
+static const uint16_t gcr_cx_levels[7] = {0,16,64,128,192,256,384};
+bool gcr_plan_valid(const struct gcr_plan *p)
+{
+    if (!p || p->address != 0x30000u || p->selector != 6u ||
+        p->level != 384u || p->count != 7u || p->max_level != 65535u) return false;
+    for (unsigned i = 0; i < 16; ++i)
+        if (p->levels[i] != (i < 7 ? gcr_cx_levels[i] : 0)) return false;
+    return true;
+}
+bool gcr_plan_build(const struct ndb_entry *entry, struct gcr_plan *out)
+{
+    struct ndb_arc_levels arc;
+    struct gcr_plan plan = {0};
+    if (!entry || !out || memcmp(entry->name, "cx.lvl", 7) ||
+        entry->name[7] || entry->name[8] || entry->address != 0x30000u ||
+        entry->owner_slave != 3u || entry->bank_version != 0x1000u ||
+        entry->aux_length != 32u || ndb_decode_arc(entry, &arc) != NDB_OK ||
+        arc.count != 7u) return false;
+    for (unsigned i = 0; i < arc.count; ++i)
+        if (arc.value[i] != gcr_cx_levels[i]) return false;
+    plan.address = entry->address;
+    plan.count = arc.count;
+    plan.selector = arc.count - 1u;
+    plan.level = arc.value[plan.selector];
+    plan.max_level = 65535u;
+    memcpy(plan.levels, arc.value, arc.count * sizeof(arc.value[0]));
+    if (!gcr_plan_valid(&plan)) return false;
+    *out = plan;
+    return true;
+}
