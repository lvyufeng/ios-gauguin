+IOReturn GauguinGPUUserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *a,
+    IOExternalMethodDispatch *,OSObject *,void *)
+{
+    union { struct ggr_param param;struct ggr_new make;struct ggr_info info;
+        struct ggr_cpu_prep prep;struct ggr_cpu_fini fini;struct ggr_close close;
+        struct ggr_submit submit;struct ggr_wait wait;struct ggr_madvise madvise;
+        struct ggr_queue queue;struct ggr_queue_query query;struct ggr_surface surface;uint32_t queueId;
+    } r;
+    size_t size=ggr_request_size(selector);
+    if(!size)return kIOReturnUnsupported;
+    if(!a||!a->structureInput||!a->structureOutput||a->structureInputSize!=size||a->structureOutputSize!=size||
+       a->scalarInputCount||a->scalarOutputCount||a->structureInputDescriptor||a->structureOutputDescriptor||!gLock)
+        return kIOReturnBadArgument;
+    bzero(&r,sizeof(r));memcpy(&r,a->structureInput,size);
+    IOLockLock(gLock);IOReturn result=kIOReturnBadArgument;
+    if(fClosed||!fBuffers||gOwner!=this||!sweet_gpu_runtime_ready()){result=kIOReturnNotReady;goto out;}
+    switch(selector) {
+    case 0x40:
+        if(r.param.pipe!=0x10||r.param.len||r.param.pad)break;
+        result=sweet_gpu_runtime_parameter(r.param.param,&r.param.value)?kIOReturnSuccess:kIOReturnUnsupported;break;
+    case 0x42: {
+        if(!r.make.size||r.make.size>GGR_MAX_BO_BYTES||r.make.handle||(r.make.flags&~(GGR_BO_READONLY|GGR_BO_WC)))break;
+        uint64_t n=(r.make.size+PAGE_MASK)&~(uint64_t)PAGE_MASK;
+        auto m=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+            kIODirectionInOut|kIOMemoryKernelUserShared|kIOMapWriteCombineCache,(vm_size_t)n,PAGE_SIZE);
+        if(!m){result=kIOReturnNoMemory;break;}
+        bzero(m->getBytesNoCopy(),(size_t)n);memoryBarrier();
+        result=add(m,nullptr,n,r.make.flags,&r.make.handle);m->release();break;
+    }
+    case 0x43: {
+        gpu_buffer *b=find(r.info.handle);if(!b||r.info.pad||r.info.len)break;
+        if(r.info.info==0)r.info.value=(uint64_t)b->handle<<32;
+        else if(r.info.info==1)r.info.value=b->address;
+        else if(r.info.info==5)r.info.value=b->flags|GGR_BO_WC;
+        else {result=kIOReturnUnsupported;break;}
+        result=kIOReturnSuccess;break;
+    }
+    case 0x09: {gpu_buffer *b=find(r.close.handle);if(b&&!r.close.pad)result=drop(b)?kIOReturnSuccess:kIOReturnNotReady;break;}
+    case 0x44:
+        if(find(r.prep.handle)&&!(r.prep.op&~7u)&&ggr_timeout_valid(&r.prep.timeout)) {
+            memoryBarrier();result=kIOReturnSuccess;
+        }break;
+    case 0x45:if(find(r.fini.handle)){memoryBarrier();result=kIOReturnSuccess;}break;
+    case 0x46:result=submit(&r.submit);break;
+    case 0x47:
+        if(r.wait.fence&&r.wait.fence<=fLastFence&&!r.wait.flags&&ggr_timeout_valid(&r.wait.timeout)&&
+           (!r.wait.queueid||r.wait.queueid==fQueue))result=sweet_gpu_runtime_done(r.wait.fence)?kIOReturnSuccess:kIOReturnTimeout;
+        break;
+    case 0x48:
+        if(find(r.madvise.handle)&&r.madvise.madv<=1){r.madvise.retained=1;result=kIOReturnSuccess;}break;
+    case 0x4a:
+        if(!fQueue&&!r.queue.flags&&!r.queue.prio&&!r.queue.id&&fNextQueue) {
+            fQueue=fNextQueue++;r.queue.id=fQueue;result=kIOReturnSuccess;
+        }break;
+    case 0x4b:if(fQueue&&r.queueId==fQueue){fQueue=0;result=kIOReturnSuccess;}break;
+    case 0x4c:result=kIOReturnUnsupported;break;
+    case 0x7e:result=surface(&r.surface);break;
+    default:result=kIOReturnUnsupported;break;
+    }
+out:
+    if(result==kIOReturnSuccess){memcpy(a->structureOutput,&r,size);a->structureOutputSize=(uint32_t)size;}
+    IOLockUnlock(gLock);return result;
+}
