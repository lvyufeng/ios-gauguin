+static void ggrb_guard_time(unsigned group,uint64_t begin,uint64_t end)
+{
+    if(group>=GGRB_GUARD_GROUPS||end<begin)return;
+    struct ggrb_guard_perf *g=&ggrb_perf.groups[group];
+    __atomic_fetch_add(&g->calls,1,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&g->ticks,end-begin,__ATOMIC_RELAXED);
+    if(__atomic_load_n(&ggrb_perf.pending,__ATOMIC_ACQUIRE)) {
+        __atomic_fetch_add(&g->overlap_calls,1,__ATOMIC_RELAXED);
+        __atomic_fetch_add(&g->overlap_ticks,end-begin,__ATOMIC_RELAXED);
+    }
+}
