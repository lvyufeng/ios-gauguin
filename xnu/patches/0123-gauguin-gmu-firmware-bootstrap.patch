+/* Byte offsets from the fixed private board mappings, NOT native word
+ * offsets: CSR03d7c000, AO/RSC03d8c000, PDCcfg0b294000, PDCseq0b490000,
+ * TCM03d6c000. Native GPU-relative register names are converted in this TU. */
+enum gmf_window {GMF_CSR,GMF_AO,GMF_PDC,GMF_SEQ,GMF_TCM,GMF_GBIF,GMF_WINDOWS};
+enum gmf_phase {GMF_RESET,GMF_RELEASING,GMF_BOOTING,GMF_GX_REQUEST,GMF_HFI_START,GMF_HANDSHAKE,GMF_DONE};
+enum gmf_result {GMF_OK,GMF_ARGUMENT,GMF_ALREADY,GMF_IO,GMF_INHERITED,GMF_ASSET,
+    GMF_READBACK,GMF_TIMEOUT,GMF_VERSION,GMF_TRANSPORT,GMF_ACK,GMF_FAULT};
+struct gmf_copy {uint32_t written,checked;};
+struct gmf_ops {void *cookie;
+    bool (*guard)(void *,enum gmf_phase);
+    bool (*read)(void *,enum gmf_window,uint32_t,uint32_t *);
+    bool (*write)(void *,enum gmf_window,uint32_t,uint32_t);
+    bool (*barrier)(void *);bool (*delay_us)(void *,unsigned);
+    /* asset verifies exact size/SHA and retained same-boot ADT/direct map.
+     * copy writes/compares exactly8192 native AHB words under reset, with
+     * guards around bounded chunks. No executing caller-supplied bytes. */
+    bool (*asset)(void *,const uint8_t **,size_t *);
+    bool (*copy)(void *,const uint8_t *,size_t,struct gmf_copy *);
+    bool (*shared_read)(void *,uint32_t,uint32_t *);
+    bool (*shared_write)(void *,uint32_t,uint32_t);
+};
+struct gmf_receipt {uint32_t phase,versions[5],fw_result,oob_before,oob_after;
+    uint32_t hfi_before,hfi_after,init_ack[3],version_ack[4],reported_version;
+    uint32_t tcm_written,tcm_checked,writes,polls,debug_messages;};
+struct gmf_context {uint32_t state;enum gmf_phase phase;struct gmf_ops ops;
+    struct gmf_plan plan;struct ggh_channel hfi;struct gmf_receipt work;};
+/* One cold native bootstrap: PDC/RSC/TCM/power/version -> reset release and
+ * fresh FW result -> A619 boot-slumber OOB -> HFI init and INIT/version ACKs.
+ * Exact pinned legacy asset + native family rules select v1 transport; the
+ * two actual replies then qualify it. Zero version words alone are not proof.
+ * Does NOT send DCVS/BW tables/TEST or claim normal HFI_ON, GPU commands,
+ * secure ZAP authentication or Metal. Those remain required later stages.
+ * Caller has already completed the actual SMMU/NC image and all board guards.
+ * Started failures quarantine forever; no retry/rollback/reset assertion.
+ */
+enum gmf_result gmf_bootstrap_once(struct gmf_context *,const struct gmf_ops *,
+    const struct gmf_plan *,struct gmf_receipt *);
