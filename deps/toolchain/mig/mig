#!/bin/bash
# Minimal `mig` for a Linux kernel-only build.
#
# * *_header.h files are the preprocessed .defs (as xnu's generate_extra_hdrs
#   does with MIGCC).
# * The kernel does not include mig-generated *_user.h/*_server.h; the calls
#   that would create them are answered with empty files (no migcom here).
set -euo pipefail
cc=${MIGCC:-clang}
header=/dev/null user=/dev/null server=/dev/null sheader=/dev/null iheader=/dev/null
dheader=
defs=
ppflags=()
while [ $# -gt 0 ]; do
	case "$1" in
	-header) header=$2; shift 2;;
	-user) user=$2; shift 2;;
	-server) server=$2; shift 2;;
	-sheader) sheader=$2; shift 2;;
	-iheader) iheader=$2; shift 2;;
	-dheader) dheader=$2; shift 2;;
	-com|-novouchers) shift;;
	-isysroot|-arch) ppflags+=("$1" "$2"); shift 2;;
	-*) ppflags+=("$1"); shift;;
	*) defs=$1; shift;;
	esac
done
[ -n "$defs" ] || { echo "mig: no .defs input" >&2; exit 1; }
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
"$cc" -E -x c -D__MIG__=1 "${ppflags[@]}" "$defs" -o "$tmp" 2>/dev/null ||
	"$cc" -E -x c -D__MIG__=1 "$defs" -o "$tmp"
if [ "$header" != /dev/null ]; then cp "$tmp" "$header"; fi
if [ -n "$dheader" ]; then
	cp "$tmp" "$dheader/$(basename "$defs" .defs).h" 2>/dev/null || true
fi
for f in "$user" "$server" "$sheader" "$iheader"; do
	[ "$f" = /dev/null ] || printf '/* generated by the mig stand-in: see deps/toolchain/mig/mig */\n' > "$f"
done
