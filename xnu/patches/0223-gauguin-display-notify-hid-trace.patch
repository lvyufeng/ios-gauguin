+}
+
+/* Called with the framebuffer lock held. A successful send still does not
+ * prove that userland consumed the message or that the panel scanned a frame. */
+void
+IOMobileFramebufferUserClient::logNotificationStats(unsigned index) const
+{
+	uint32_t callbacks = 0;
+	uint64_t sent = 0, failed = 0;
+	for (uint32_t t = 0; t < SWEET_FB_NOTIFY_TYPES; ++t) {
+		if (fFunc[t]) callbacks |= 1u << t;
+		sent += fNotifySent[t];
+		failed += fNotifyFailed[t];
+	}
+	IOLog("SWEET FB NOTIFY: client=%u port=%u registrations=%llu callbacks=%x sent=%llu failed=%llu type3=%llu/%llu type5=%llu/%llu\n",
+	    index, fPort != MACH_PORT_NULL, (unsigned long long)fPortRegistrations,
+	    callbacks, (unsigned long long)sent, (unsigned long long)failed,
+	    (unsigned long long)fNotifySent[3], (unsigned long long)fNotifyFailed[3],
+	    (unsigned long long)fNotifySent[5], (unsigned long long)fNotifyFailed[5]);
 }
 
 /* Called with the framebuffer lock held. */
@@ -1566,8 +1602,10 @@
 	}
 	bzero(ref, sizeof(ref));
 	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
-	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
-	    kIOUserNotifyOptionCanDrop);
+	IOReturn result = sendAsyncResult64WithOptions(ref, kIOReturnSuccess,
+	    (io_user_reference_t *)values, count, kIOUserNotifyOptionCanDrop);
+	if (result == kIOReturnSuccess) fNotifySent[type]++;
+	else fNotifyFailed[type]++;
 }
 
