+	if (!self->fAcceptInput) return kIOReturnNotReady;
+	/* The work-loop gate is recursive. Refuse callback reentry rather than
+	 * deliver a newer frame in the middle of this frame's client callbacks. */
+	if (self->fDispatching) return kIOReturnBusy;
+	return self->touchLocked(*(const TouchRequest *)argument);
