+/* Observe readiness outside the framebuffer lock. This is not a read
+ * permission. The presenter takes the normal read guard when it copies. */
+extern "C" bool GauguinGPUSurfaceIsReady(SweetSurface *s)
+{
+    IOLock *lock = __atomic_load_n(&gLock, __ATOMIC_ACQUIRE);
+    if (!lock) return true;
+    if (!IOLockTryLock(lock)) return false;
+    if (s->gpuState == 1) completePendingOwnerLocked(false, false);
+    const bool ready = s->gpuState == 0;
+    IOLockUnlock(lock);
+    return ready;
+}
