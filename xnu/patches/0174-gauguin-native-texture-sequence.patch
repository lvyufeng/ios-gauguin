+    struct ggt_command base;
+    if(!ggt_command_build(p,&base))return false;
+    for(unsigned job=0;job<GGF_JOBS;job++){
+        unsigned count=0,words=0,payload=0;
+        if(texture174_eop[job]!=16*job+6)return false;
+        for(unsigned id=0;id<GGF_BLOBS;id++){
+            struct ggf_blob b,first;
+            if(!ggf_blob_get(job,id,&b)||!ggf_blob_get(0,id,&first)||memcmp(&b,&first,sizeof(b)))return false;
+            if(!b.words)continue;
+            if(b.offset<4*GGF_END_DWORD||b.offset>TEXTURE174_RING_BYTES||4*b.words>TEXTURE174_RING_BYTES-b.offset)return false;
+            for(unsigned before=0;before<id;before++){
+                struct ggf_blob other;if(!ggf_blob_get(job,before,&other))return false;
+                if(other.words&&b.offset<other.offset+4*other.words&&other.offset<b.offset+4*b.words)return false;
+            }
+            if(id==0&&(b.offset!=GGF_IB_OFFSET||b.payload_words!=GGF_IB_WORDS))return false;
+            count++;words+=b.words;payload+=b.payload_words;
+        }
+        if(count!=GGF_ACTIVE_BLOBS||words!=GGF_ARTIFACT_WORDS||payload!=GGF_NATIVE_WORDS)return false;
+    }
+    struct ggf_command c;memcpy(c.word,base.word,sizeof(c.word));*out=c;return true;
+}
