+/* SWEET_METAL_PUBLICATION_BEGIN: host tests use this complete body. */
+static IOService *sweet_metal_publisher;
+static bool
+sweet_metal_publish(IOService *service)
+{
+    IOService *expected = nullptr;
+    if (!__atomic_compare_exchange_n(&sweet_metal_publisher, &expected, service, false,
+        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return false;
+    if (!service->setProperty("MetalPluginName", "GauguinMetalDesktop") ||
+        !service->setProperty("MetalPluginClassName", "GauguinDesktopMetalDevice")) {
+        service->removeProperty("MetalPluginName");
+        service->removeProperty("MetalPluginClassName");
+        expected = service;
+        (void)__atomic_compare_exchange_n(&sweet_metal_publisher, &expected, (IOService *)nullptr,
+            false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+        IOLog("SWEET METAL246: plugin publication failed\n");
+        return false;
+    }
+    IOLog("SWEET METAL246: single system plugin published name=GauguinMetalDesktop\n");
+    return true;
+}
+static void
+sweet_metal_unpublish(IOService *service)
+{
+    if (__atomic_load_n(&sweet_metal_publisher, __ATOMIC_ACQUIRE) != service) return;
+    service->removeProperty("MetalPluginName");
+    service->removeProperty("MetalPluginClassName");
+    IOService *expected = service;
+    (void)__atomic_compare_exchange_n(&sweet_metal_publisher, &expected, (IOService *)nullptr,
+        false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+/* SWEET_METAL_PUBLICATION_END */
