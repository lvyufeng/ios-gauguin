+    return (c->work.rbbm_status&GGQ_RBBM_ERRORS)||(c->work.cp_status&GGQ_CP_ERRORS)?GGT_FAULT:GGT_OK;
+}
+static uint32_t expected_data(unsigned index)
+{return index==GGT_EOP_OFFSET/4?GGT_EOP_VALUE:index<GGT_OUTPUT_WORDS?GGT_FOREGROUND:GGT_DATA_SEED;}
+/* Each NC pass is bracketed by full live guards; all per-word callbacks must
+ * independently admit the exact memory/phase/range. No callback can write DATA. */
+static enum ggt_result compare_nc(struct ggt_context *c,enum ggt_memory mem,
+    unsigned off,unsigned words,const uint32_t *expected,uint32_t seed,
+    unsigned blob,bool native,uint32_t *count)
+{
+    for(unsigned base=0;base<words;base+=GGT_BATCH_WORDS){
+        unsigned n=words-base;if(n>GGT_BATCH_WORDS)n=GGT_BATCH_WORDS;
+        if(!guard(c))return GGT_GUARD;
+        for(unsigned i=0;i<n;i++){
+            unsigned index=base+i,offset=off+4*index;uint32_t want=expected?expected[index]:seed,value;
+            if(native&&!ggt_blob_word(blob,index,&want))return GGT_ARGUMENT;
+            if(mem==GGT_DATA&&c->phase==GGT_VERIFY)want=expected_data(index);
+            if(!c->ops.read_memory(c->ops.cookie,mem,offset,&value))return GGT_IO;
+            if(value!=want)return sample(c,true,(mem==GGT_DATA?0x20000u:0u)+offset,want,value);
+            ++*count;
+            if(mem==GGT_DATA&&c->phase==GGT_VERIFY){
