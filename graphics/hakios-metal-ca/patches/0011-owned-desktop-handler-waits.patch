+/* Caller holds _stateCondition. Count admission before publishing the stage.
+ * A callback waiting on its own buffer cannot wait for its own return; only
+ * that same-buffer callback scope skips the handler drain, not GPU progress. */
+- (void)hakiosQueueHandler:(MTLCommandBufferHandler)handler scheduled:(BOOL)scheduled
+{
+    if (scheduled) ++_scheduledPending;
+    else ++_completedPending;
+    [self hakiosDeliver:^(id<MTLCommandBuffer> buffer) {
+        @try { handler(buffer); }
+        @finally {
+            [_stateCondition lock];
+            if (scheduled) --_scheduledPending;
+            else --_completedPending;
+            [_stateCondition broadcast];
+            [_stateCondition unlock];
+        }
+    }];
+}
