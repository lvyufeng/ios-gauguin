+static bool ggrb_ring_span(void *cookie,uint32_t off,const uint32_t *words,uint32_t count,bool verify)
+{
+    (void)cookie;uint32_t op=verify?8:7,last=0;
+    if(!words||!count||count>GGR_RING_PACKET_WORDS||(off&3)||off>=32768||!gmb_ram)
+        return ggrb_note(op,0,off,0,false);
+    /* ggr_submit already proves hardware idle/shadow/EOP before preparing
+     * this ring. These are CPU-owned NC RAM accesses ONLY: no register,
+     * doorbell or page-table update. Full hardware guards surround EACH
+     * span in the engine, including one after the complete readback. */
+    for(uint32_t i=0;i<count;i++){
+        uint32_t at=(off+4*i)%32768;
+        if(ggrb_context.state!=GGR_BUSY||sweet_gmu_board_state()!=GMB_READY||
+           ggrb_ns(NULL)>=ggrb_context.operation_end_ns||
+           (ggrb_end!=UINT64_MAX&&mach_absolute_time()>=ggrb_end))
+            return ggrb_note(op,0,at,last,false);
+        vm_offset_t va=gmb_ram+ggb_plan.region[GGP_RING].offset-GMB_PAGE+at;
+        if(verify){last=gfw_load32(va);if(last!=words[i])return ggrb_note(op,0,at,last,false);}
+        else {last=words[i];gfw_store32(va,last);}
+    }
+    return ggrb_note(op,0,(off+4*(count-1))%32768,last,true);
+}
