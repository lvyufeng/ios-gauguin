diff --git a/bsd/dev/gauguin_scan_log_guard.h b/bsd/dev/gauguin_scan_log_guard.h
new file mode 100644
index 0000000000000000000000000000000000000000..e09e7873365b0c18cd246379dc763794e28c748f
--- /dev/null
+++ b/bsd/dev/gauguin_scan_log_guard.h
@@ -0,0 +1,38 @@
+#ifndef GAUGUIN_SCAN_LOG_GUARD_H
+#define GAUGUIN_SCAN_LOG_GUARD_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Gauguin userdata layout confirmed in recovery. All units are 4096 bytes. */
+#define GSCAN_LOG_FIRST UINT64_C(2887680)
+#define GSCAN_LOG_PART_BLOCKS UINT64_C(28056571)
+#define GSCAN_LOG_RESERVED UINT64_C(1089)
+#define GSCAN_LOG_BLOCKS UINT64_C(1025)
+
+static inline bool
+gscan_log_profile(unsigned requested, unsigned scan, unsigned ufs_write,
+                  unsigned root_write, uint32_t run_id)
+{
+    return requested == 1 && scan >= 1 && scan <= 3 &&
+           ufs_write == 0 && root_write == 0 && run_id != 0;
+}
+
+static inline bool
+gscan_log_geometry(uint64_t first, uint64_t physical, uint64_t exposed)
+{
+    return first == GSCAN_LOG_FIRST && physical == GSCAN_LOG_PART_BLOCKS &&
+           exposed == GSCAN_LOG_PART_BLOCKS - GSCAN_LOG_RESERVED;
+}
+
+/* The last existing mark slot, directly before the ordinary ring header. */
+static inline bool
+gscan_log_record_lba(uint64_t first, uint64_t physical, uint64_t exposed, uint64_t *lba)
+{
+    if (!gscan_log_geometry(first, physical, exposed))
+        return false;
+    *lba = first + physical - GSCAN_LOG_BLOCKS - 1;
+    return true;
+}
+
+#endif
