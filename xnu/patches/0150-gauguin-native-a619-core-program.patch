+        rc=write32(c,a[i].reg,v);if(rc)return rc;
+    }
+    return GGC_OK;
+}
+static enum ggc_result reglist(struct ggc_context *c)
+{
+    for(unsigned i=0;i<GGC_REGLIST_VALUES;i++){
