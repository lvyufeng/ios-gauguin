+void
+AppleCLCD::attachStage384Worker()
+{
+    auto *loop = IOWorkLoop::workLoop();
+    if (!loop) return;
+    auto *event = IOInterruptEventSource::interruptEventSource(this, &AppleCLCD::stage384Fired);
+    if (!event || loop->addEventSource(event) != kIOReturnSuccess) {
+        OSSafeReleaseNULL(event);
+        loop->release();
+        return;
+    }
+    IOLockLock(fLock);
+    fStage384Loop = loop;
+    fStage384Event = event;
+    event->enable();
+    IOLockUnlock(fLock);
+    IOLog("SWEET F384 WORKER: separate=1 copies=%u\n", F382_MAX_FLIPS);
+}
+
+bool
+AppleCLCD::stage384EnabledLocked() const
+{
+    return fStage384Event && sweet_frame382_active() && !fFlip382.closed;
+}
+
+bool
+AppleCLCD::stage384CanTakeLocked() const
+{
+    return stage384EnabledLocked() && fHeldReady.owner && fHeldReady.ready.observed &&
+        blankEnabledLocked() &&
+        !fHeldActive && !fCalibrating && fFlip382.stage == sweet_fb_flip382::Idle &&
+        fFlip382.copies < F382_MAX_FLIPS && mach_absolute_time() >= fStage384PauseUntil &&
+        !sweet_frame382_ending();
+}
+
+void
+AppleCLCD::signalStage384Locked()
+{
+    if (stage384CanTakeLocked()) fStage384Event->interruptOccurred(nullptr, nullptr, 0);
 }
 
 void
+AppleCLCD::stage384Fired(OSObject *owner, IOInterruptEventSource *sender, int)
+{
+    auto *fb = static_cast<AppleCLCD *>(owner);
+    struct sweet_fb_frame frame = {};
+    IOLockLock(fb->fLock);
+    const bool taken = fb->fStage384Event == sender && fb->stage384CanTakeLocked() &&
+        fb->takeHeldFrameLocked(&frame, &fb->fHeldReady);
+    const uint64_t attempt = fb->fHeldConsumed;
+    const uint64_t generation = frame.generation;
+    IOLockUnlock(fb->fLock);
+    if (!taken) return;
+    fb->presentTimed(frame.record, &frame, attempt, UINT64_MAX, true);
+    IOLockLock(fb->fLock);
+    if (fb->fHeldReady.generation > generation) fb->signalStage384Locked();
+    IOLockUnlock(fb->fLock);
+}
