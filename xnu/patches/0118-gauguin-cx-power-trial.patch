+enum gbcmt_rc
+sweet_bcm_submit_once(const struct gbcm_plan *input, struct gbcmt_receipt *out)
+{
+    if (!sweet_bcm_vote_requested()) return GBCMT_OFF;
+    if (!input || !out) return GBCMT_ARGUMENT;
+    if (sweet_bcm_transport_state() != GBCMT_IDLE) return GBCMT_ALREADY;
+    /* A non-owner cannot alter the active transaction, its state or lease. */
+    if (!gt_acquire()) return GBCMT_BUSY;
+    unsigned expected = GBCMT_IDLE;
+    if (!__atomic_compare_exchange_n(&gt_state, &expected, GBCMT_RUNNING, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        gt_release(); return GBCMT_ALREADY;
+    }
+    gt_arc = false; gt_wrote = false;
+    memset(&gt_receipt, 0, sizeof(gt_receipt));
+    struct gbcm_plan plan = *input;
+    struct gt_wire wire = {0};
+    enum gbcmt_rc rc;
+    if (__atomic_load_n(&gt_controller_quarantined, __ATOMIC_ACQUIRE)) rc = gt_fail(GBCMT_CONFIG, "controller quarantined");
+    else if (!gt_context()) rc = gt_fail(GBCMT_CONTEXT, "invalid thread context");
+    else if (!gt_plan_valid(&plan) || gt_conflicts()) rc = gt_fail(GBCMT_CONFIG, "plan/boot flags rejected");
+    else {
+        wire.count = GBCM_COUNT; wire.wait_mask = wire.response_mask = 0x3bu;
+        memcpy(wire.cmd, plan.cmd, sizeof(wire.cmd));
+        rc = gt_transaction(&wire);
+    }
+    if (rc == GBCMT_OK) {
+        *out = gt_receipt;
+        __atomic_store_n(&gt_state, GBCMT_COMPLETE, __ATOMIC_RELEASE);
+        gt_record("SWEET BCM TX: native completion verified, ACTIVE1 reclaimed; BCM requests held until reset; bandwidth/GPU execution not measured");
+    }
+    gt_release(); return rc;
+}
