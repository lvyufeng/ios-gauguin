+void
+sweet_block_trace(thread_t th)
+{
+	/*
+	 * One store per field, no locks, no printing. If two threads race the
+	 * record is merely overwritten - this is a debug ring, not a journal.
+	 */
+	uint32_t i = __atomic_fetch_add(&sweet_block_head, 1, __ATOMIC_RELAXED);
+	struct sweet_block_rec *r = &sweet_block_ring[i % SWEET_BLOCK_RING];
+	r->tid = th->thread_id;
+	r->cont = (uint64_t)(uintptr_t)th->continuation;
+	r->ev = th->wait_event;
+	r->wqt = (th->waitq.wq_q != NULL) ?
+	    (uint32_t)th->waitq.wq_q->waitq_type : 0;
+	r->seq = i;
