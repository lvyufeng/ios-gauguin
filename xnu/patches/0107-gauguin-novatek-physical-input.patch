--- /dev/null
+++ b/bsd/dev/gauguin_nvt/nvt_protocol.c
@@ -0,0 +1,200 @@
+/* SPDX-License-Identifier: MIT */
+#include "nvt_protocol.h"
+#include <string.h>
+
+static bool geometry_ok(uint16_t x, uint16_t y)
+{
+    return x != 0 && y != 0 && x <= NVT_MAX_X && y <= NVT_MAX_Y;
+}
+
+static void page_for(uint32_t address, uint8_t page[3])
+{
+    page[0] = 0xff;
+    page[1] = (uint8_t)(address >> 15);
+    page[2] = (uint8_t)(address >> 7);
+}
+
+int nvt_check_observed_chip(const uint8_t *trim, size_t length)
+{
+    static const uint8_t observed[6] = {0x0c, 0, 0, 0x72, 0x66, 3};
+    if (!trim) return NVT_ERR_ARGUMENT;
+    if (length != sizeof(observed)) return NVT_ERR_LENGTH;
+    return memcmp(trim, observed, sizeof(observed)) == 0 ? NVT_OK : NVT_ERR_IDENTITY;
+}
+
+int nvt_make_request(enum nvt_read_kind kind, struct nvt_request *out)
+{
+    struct nvt_request request = {0};
+    unsigned offset;
+    if (!out) return NVT_ERR_ARGUMENT;
+    switch (kind) {
+    case NVT_READ_FWINFO: offset = 0x78; request.payload_length = 16; break;
+    case NVT_READ_RESET: offset = 0x60; request.payload_length = 5; break;
+    case NVT_READ_PID: offset = 0x9a; request.payload_length = 2; break;
+    case NVT_READ_POINTS: offset = 0; request.payload_length = NVT_POINT_PAYLOAD; break;
+    default: return NVT_ERR_ARGUMENT;
+    }
+    request.address = NVT_EVENT_BASE + offset;
+    page_for(request.address, request.page);
+    page_for(NVT_EVENT_BASE, request.restore_page);
+    request.tx[0] = (uint8_t)(offset & 0x7f); /* Native SPI_READ_MASK. */
+    request.wire_length = request.payload_length + 2;
+    *out = request;
+    return NVT_OK;
+}
+
+static int payload(const uint8_t *rx, size_t length, size_t expected,
+                   const uint8_t **out)
+{
+    if (!rx || !out) return NVT_ERR_ARGUMENT;
+    if (length != expected + 2) return NVT_ERR_LENGTH;
+    *out = rx + 2; /* Native rbuf+2 -> logical buf+1. */
+    return NVT_OK;
+}
+
+int nvt_decode_fwinfo(const uint8_t *rx, size_t length, struct nvt_fw_info *out)
+{
+    const uint8_t *p;
+    struct nvt_fw_info info = {0};
+    int result;
+    if (!out) return NVT_ERR_ARGUMENT;
+    result = payload(rx, length, 16, &p);
+    if (result != NVT_OK) return result;
+    if ((unsigned)p[0] + p[1] != 255) return NVT_ERR_FW_CHECKSUM;
+    info.version = p[0];
+    info.x_channels = p[2]; info.y_channels = p[3];
+    info.max_x = (uint16_t)((unsigned)p[4] << 8 | p[5]);
+    info.max_y = (uint16_t)((unsigned)p[6] << 8 | p[7]);
+    info.buttons = p[10]; info.firmware_type = p[13];
+    if (!geometry_ok(info.max_x, info.max_y) || !info.x_channels || !info.y_channels)
+        return NVT_ERR_GEOMETRY;
+    *out = info;
+    return NVT_OK;
+}
+
+int nvt_decode_reset(const uint8_t *rx, size_t length, struct nvt_reset_info *out)
+{
+    const uint8_t *p;
+    struct nvt_reset_info info;
+    int result;
+    if (!out) return NVT_ERR_ARGUMENT;
+    result = payload(rx, length, 5, &p);
+    if (result != NVT_OK) return result;
+    info.state = p[0];
+    memcpy(info.detail, p + 1, sizeof(info.detail));
+    *out = info;
+    return NVT_OK;
+}
+
+bool nvt_reset_ready(const struct nvt_reset_info *info, uint8_t minimum)
+{
+    return info && minimum >= 0xa0 && minimum <= 0xa3 &&
+           info->state >= minimum && info->state <= 0xaf;
+}
+
+int nvt_decode_pid(const uint8_t *rx, size_t length, uint16_t *out)
+{
+    const uint8_t *p;
+    int result;
+    if (!out) return NVT_ERR_ARGUMENT;
+    result = payload(rx, length, 2, &p);
+    if (result != NVT_OK) return result;
+    *out = (uint16_t)((unsigned)p[1] << 8 | p[0]);
+    return NVT_OK;
+}
+
+int nvt_state_init(struct nvt_state *state, const struct nvt_fw_info *info)
+{
+    struct nvt_state next = {0};
+    if (!state || !info) return NVT_ERR_ARGUMENT;
+    if (!geometry_ok(info->max_x, info->max_y)) return NVT_ERR_GEOMETRY;
+    next.max_x = info->max_x; next.max_y = info->max_y;
+    next.initialized = true;
+    *state = next;
+    return NVT_OK;
+}
+
+int nvt_decode_points(struct nvt_state *state, const uint8_t *rx, size_t length,
+                      struct nvt_frame *out)
+{
+    const uint8_t *p;
+    struct nvt_contact next[NVT_MAX_CONTACTS] = {{0}};
+    struct nvt_frame frame = {0};
+    bool seen[NVT_MAX_CONTACTS] = {false};
+    uint8_t inactive_status[NVT_MAX_CONTACTS] = {0};
+    bool esd = true, wdt = true;
+    int result;
+    if (!state || !out || !state->initialized) return NVT_ERR_ARGUMENT;
+    if (!geometry_ok(state->max_x, state->max_y)) return NVT_ERR_GEOMETRY;
+    result = payload(rx, length, NVT_POINT_PAYLOAD, &p);
+    if (result != NVT_OK) return result;
+    memcpy(frame.native_tail, p + 60, sizeof(frame.native_tail));
+    for (unsigned i = 0; i < 6; ++i) {
+        esd = esd && p[i] == 0x77;
+        wdt = wdt && (p[i] == 0xfd || p[i] == 0xfe);
+    }
+    if (esd || wdt) {
+        frame.kind = esd ? NVT_PACKET_ESD : NVT_PACKET_WDT;
+        frame.wdt_streak = esd ? 0 : (state->wdt_streak < 11 ? state->wdt_streak + 1 : 11);
+        frame.recovery_required = wdt && frame.wdt_streak >= 11;
+        for (unsigned i = 0; i < NVT_MAX_CONTACTS; ++i)
+            frame.active_count += state->contacts[i].active ? 1 : 0;
+        state->wdt_streak = frame.recovery_required ? 0 : frame.wdt_streak;
+        *out = frame;
+        return NVT_OK;
+    }
+    /* Ten six-byte records. Bytes62/63 extend pressure of record0/1,
+     * NOT controller IDs1/2. Native does not validate point byte64 as checksum. */
+    for (unsigned record = 0; record < NVT_MAX_CONTACTS; ++record) {
+        const uint8_t *r = p + 6 * record;
+        unsigned id = r[0] >> 3, status = r[0] & 7;
+        bool active = status == 1 || status == 2;
+        if (id == 0 || id > NVT_MAX_CONTACTS) {
+            if (active) return NVT_ERR_CONTACT_ID;
+            continue; /* Native unused slots include all00/allff. */
+        }
+        if (seen[id - 1]) return NVT_ERR_DUPLICATE_ID;
+        seen[id - 1] = true;
+        inactive_status[id - 1] = (uint8_t)status;
+        if (!active) continue;
+        struct nvt_contact *c = &next[id - 1];
+        c->x = (uint16_t)((unsigned)r[1] << 4 | r[3] >> 4);
+        c->y = (uint16_t)((unsigned)r[2] << 4 | (r[3] & 15));
+        if (c->x > state->max_x || c->y > state->max_y) return NVT_ERR_COORDINATE;
+        c->width = r[4] ? r[4] : 1;
+        c->pressure = r[5];
+        if (record < 2) {
+            c->pressure = (uint16_t)(c->pressure | (unsigned)p[62 + record] << 8);
+            if (c->pressure > 1000) c->pressure = 1000;
+        }
+        if (!c->pressure) c->pressure = 1;
+        c->wire_status = (uint8_t)status;
+        c->active = true;
+    }
+    frame.kind = NVT_PACKET_CONTACTS;
+    for (unsigned i = 0; i < NVT_MAX_CONTACTS; ++i) {
+        if (next[i].active || state->contacts[i].active) {
+            struct nvt_event *e = &frame.events[frame.event_count++];
+            e->id = (uint8_t)(i + 1);
+            if (next[i].active) {
+                e->kind = state->contacts[i].active ? NVT_MOVE : NVT_DOWN;
+                e->contact = next[i];
+            } else {
+                e->kind = NVT_UP; e->contact = state->contacts[i];
+                e->contact.active = false; e->contact.pressure = 0;
+                e->contact.wire_status = inactive_status[i];
+            }
+        }
+        frame.active_count += next[i].active ? 1 : 0;
+    }
+    memcpy(state->contacts, next, sizeof(next));
+    state->wdt_streak = 0;
+    *out = frame;
+    return NVT_OK;
+}
+
+int nvt_cancel_contacts(struct nvt_state *state, struct nvt_frame *out)
+{
+    uint8_t empty[NVT_MAX_WIRE] = {0};
+    return nvt_decode_points(state, empty, sizeof(empty), out);
+}
