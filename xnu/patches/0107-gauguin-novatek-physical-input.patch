+#define GSS_SAVED_MAX 28u
+struct gss_saved { uint32_t offset, mask, value; bool touched; };
+struct gss_report {
+    int failure, restore_failure, transport_status;
+    uint32_t effects, acknowledged_m, acknowledged_s;
+    uint32_t irq_before_m, irq_before_s, irq_after_m, irq_after_s;
+    uint32_t wrapper, fw, sfw, dfs, cfg, source_hz, divider, sck_hz;
+    bool config_restored, ownership_lost;
+};
+struct gss_session {
+    /* Caller zero-initializes and otherwise treats these fields as private. */
+    const struct gss_owner *owner;
+    uint64_t generation;
+    enum gss_state state;
+    struct gss_saved saved[GSS_SAVED_MAX];
+    unsigned saved_count;
+    struct gss_report report;
+};
