+static bool ggrb_micro_settle(bool gpu_probe,uint32_t expected,uint32_t mask,uint32_t current)
+{
+    /* An experiment in bounded waiting, NOT a relaxed SMMU invariant. Never
+     * wait during firmware/probe/setup/idle checks, for a HALT request, for
+     * all-ones/unreadable MMIO, or for any other control-word difference. */
+    if(gpu_probe||!ggrb_started||ggrb_context.state!=GGR_BUSY||
+       !gmb_thread()||sweet_gmu_board_state()!=GMB_READY||
+       mask!=~8u||(expected&mask)!=0x2370u||(current&mask)!=0x2270u)return false;
+    uint64_t start=ggrb_ns(NULL),end;
+    if(start>UINT64_MAX-UINT64_C(20000000))return false;
+    end=start+UINT64_C(20000000);
+    if(end>ggrb_context.operation_end_ns)end=ggrb_context.operation_end_ns;
+    ++gfw_micro_sample.attempts;
+    gfw_micro_sample.initial=current;gfw_micro_sample.current=current;
+    gfw_micro_sample.expected=expected;gfw_micro_sample.mask=mask;
+    gfw_micro_sample.elapsed_us=0;
+    bool recovered=false;
+    for(unsigned i=0;i<2000;i++){
+        if(ggrb_ns(NULL)>=end||mach_absolute_time()>=ggrb_end||
