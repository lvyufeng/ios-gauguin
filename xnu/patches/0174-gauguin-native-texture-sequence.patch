+        r->c->work.completed_jobs==(r->phase==GGF_FINAL?GGF_JOBS:r->job)&&
+        !memcmp(&r->c->ops,r->ops,sizeof(*r->ops))&&
+        !memcmp(&r->c->command,r->command,sizeof(*r->command));
