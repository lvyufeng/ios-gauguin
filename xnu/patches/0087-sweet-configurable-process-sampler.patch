 		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
 	}
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
+	PE_parse_boot_argn("sweetsampledelay", &first, sizeof(first));
+	PE_parse_boot_argn("sweetsampleinterval", &interval, sizeof(interval));
+	PE_parse_boot_argn("sweetsamplecount", &count, sizeof(count));
+	if (first < 1 || first > 3600) {
+		first = 90;
+	}
+	if (interval < 1 || interval > 3600) {
+		interval = 120;
+	}
+	if (count < 1 || count > 40) {
+		count = 40;
+	}
+	printf("SMP armed: %s delay=%d interval=%d count=%d\n",
+	    sweet_sample_names, first, interval, count);
+	(void)tsleep(&chan, PZERO, "sweetsmp", first * hz);
+	for (int i = 0; i < count; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		if (i + 1 < count) {
+			(void)tsleep(&chan, PZERO, "sweetsmp", interval * hz);
+		}
 	}
 }
 
