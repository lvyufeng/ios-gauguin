diff --git a/bsd/dev/gauguin_scan_timing.c b/bsd/dev/gauguin_scan_timing.c
index cb5b809bc1d80ce729f7e50b833c095ed7206f09..0a24202113722d341087b5a722e9009359735b07 100644
--- a/bsd/dev/gauguin_scan_timing.c
+++ b/bsd/dev/gauguin_scan_timing.c
@@ -138,17 +138,190 @@ static void capture(const struct gscan_ops *ops, struct gscan_result *r)
     r->status = GSCAN_MEASURED;
 }
 
+/* Lagoon SSPP and CTL register layouts from the captured handset FDT and
+ * the Xiaomi SDE driver. Regions identify 16 KiB pages, not block bases. */
+struct pipe_block { enum gscan_region region; uint32_t offset; };
+static const struct pipe_block pipe_blocks[GSCAN_PIPES] = {
+    { GSCAN_VIG, 0x1000 }, { GSCAN_DMA01, 0x1000 },
+    { GSCAN_DMA01, 0x3000 }, { GSCAN_DMA2, 0x1000 },
+};
+static const uint32_t ctl_offsets[GSCAN_CTLS] = { 0x2000, 0x2200, 0x2400, 0x2600 };
+static const uint32_t layer_offsets[] = { 0, 0x40, 0x70, 0xa0 };
+enum { ROUTE_TOP, ROUTE_FLUSH, ROUTE_INTF, ROUTE_LAYER0, ROUTE_CTL_WORDS = 11 };
+enum { ROUTE_SIZE, ROUTE_XY, ROUTE_ADDR, ROUTE_STRIDE, ROUTE_FORMAT, ROUTE_OP, ROUTE_PIPE_WORDS };
+
+struct route_sample {
+    uint32_t ctl[GSCAN_CTLS][ROUTE_CTL_WORDS];
+    uint32_t pipe[GSCAN_PIPES][ROUTE_PIPE_WORDS];
+};
+
+static void read_route(const struct gscan_ops *ops, struct route_sample *sample)
+{
+    static const uint32_t pipe_offsets[] = { 0, 8, 0x14, 0x24, 0x30, 0x38 };
+    for (unsigned i = 0; i < GSCAN_CTLS; ++i) {
+        uint32_t base = ctl_offsets[i];
+        sample->ctl[i][ROUTE_TOP] = ops->read(ops->context, GSCAN_CTL, base + 0x14);
+        sample->ctl[i][ROUTE_FLUSH] = ops->read(ops->context, GSCAN_CTL, base + 0x18);
+        sample->ctl[i][ROUTE_INTF] = ops->read(ops->context, GSCAN_CTL, base + 0xf4);
+        for (unsigned mixer = 0; mixer < 2; ++mixer) {
+            for (unsigned field = 0; field < 4; ++field)
+                sample->ctl[i][ROUTE_LAYER0 + mixer * 4 + field] =
+                    ops->read(ops->context, GSCAN_CTL, base + mixer * 4 + layer_offsets[field]);
+        }
+    }
+    for (unsigned i = 0; i < GSCAN_PIPES; ++i) {
+        for (unsigned field = 0; field < ROUTE_PIPE_WORDS; ++field)
+            sample->pipe[i][field] = ops->read(ops->context, pipe_blocks[i].region,
+                pipe_blocks[i].offset + pipe_offsets[field]);
+    }
+}
+
+static bool same_route(const struct route_sample *a, const struct route_sample *b)
+{
+    for (unsigned i = 0; i < GSCAN_CTLS; ++i) {
+        for (unsigned j = 0; j < ROUTE_CTL_WORDS; ++j) {
+            if (a->ctl[i][j] != b->ctl[i][j])
+                return false;
+        }
+    }
+    for (unsigned i = 0; i < GSCAN_PIPES; ++i) {
+        for (unsigned j = 0; j < ROUTE_PIPE_WORDS; ++j) {
+            if (a->pipe[i][j] != b->pipe[i][j])
+                return false;
+        }
+    }
+    return true;
+}
+
+static enum gscan_route_status classify_route(const struct route_sample *sample, struct gscan_route *r)
+{
+    unsigned source = 0, control = 0;
+    for (unsigned i = 0; i < GSCAN_PIPES; ++i) {
+        r->source[i] = sample->pipe[i][ROUTE_ADDR];
+        if (r->source[i] == r->framebuffer.address) {
+            r->pipe_mask |= 1U << i;
+            source = i;
+        }
+    }
+    for (unsigned i = 0; i < GSCAN_CTLS; ++i) {
+        const uint32_t *ctl = sample->ctl[i];
+        r->interface[i] = ctl[ROUTE_INTF];
+        if (r->interface[i] & 2) {
+            r->ctl_mask |= 1U << i;
+            control = i;
+        }
+        for (unsigned mixer = 0; mixer < 2; ++mixer) {
+            const uint32_t *layer = ctl + ROUTE_LAYER0 + mixer * 4;
+            // VIG0, DMA0, DMA1, DMA2, in catalog order. A second rect is
+            // recorded independently and disqualifies this single-source path.
+            if ((layer[0] & 7) || (layer[1] & 1)) r->stages[i] |= 1;
+            if ((layer[0] & (7U << 18)) || (layer[1] & (1U << 16))) r->stages[i] |= 2;
+            if ((layer[0] & (7U << 21)) || (layer[1] & (1U << 18))) r->stages[i] |= 4;
+            if (layer[2] & 15) r->stages[i] |= 8;
+            if (layer[3] & 15) r->virtual_stages[i] |= 1;
+            if (layer[2] & (15U << 8)) r->virtual_stages[i] |= 2;
+            if (layer[2] & (15U << 12)) r->virtual_stages[i] |= 4;
+            if (layer[2] & (15U << 16)) r->virtual_stages[i] |= 8;
+        }
+    }
+    if (!r->pipe_mask || !r->ctl_mask)
+        return GSCAN_ROUTE_NO_MATCH;
+    if (r->pipe_mask != (1U << source) || r->ctl_mask != (1U << control) ||
+        r->interface[control] != 2)
+        return GSCAN_ROUTE_AMBIGUOUS;
+    if (r->stages[control] != r->pipe_mask || r->virtual_stages[control])
+        return GSCAN_ROUTE_NOT_STAGED;
+    const uint32_t *pipe = sample->pipe[source];
+    const uint32_t *ctl = sample->ctl[control];
+    r->size = pipe[ROUTE_SIZE];
+    r->stride = pipe[ROUTE_STRIDE];
+    r->format = pipe[ROUTE_FORMAT];
+    r->op_mode = pipe[ROUTE_OP];
+    // Linear, interleaved, 4-byte, unrotated full-screen source, video CTL
+    // with no pending flush. Preserve the raw format for later qualification.
+    const uint32_t unsupported_format = (3U << 30) | (1U << 22) | (3U << 19) | (1U << 11);
+    if (r->size != ((r->framebuffer.height << 16) | r->framebuffer.width) ||
+        r->stride != r->framebuffer.stride || pipe[ROUTE_XY] ||
+        (r->format & unsupported_format) || ((r->format >> 9) & 3) != 3 ||
+        (r->op_mode & 1) || (ctl[ROUTE_TOP] & (1U << 17)) || ctl[ROUTE_FLUSH])
+        return GSCAN_ROUTE_LAYOUT;
+    return GSCAN_ROUTE_MATCHED;
+}
+
+static void capture_route(const struct gscan_ops *ops, struct gscan_result *r)
+{
+    struct gscan_route *route = &r->route;
+    route->framebuffer = ops->framebuffer;
+    const struct gscan_framebuffer *fb = &route->framebuffer;
+    if (fb->width != 1080 || fb->height != 2400 || fb->stride != 4320 ||
+        !fb->address || (fb->address & 0x3fff) ||
+        fb->address > UINT64_C(0x100000000) - UINT64_C(10368000)) {
+        route->status = GSCAN_ROUTE_BAD_FRAMEBUFFER;
+        return;
+    }
+
+    unsigned mapped = GSCAN_CTL;
+    for (; mapped < GSCAN_REGION_COUNT; ++mapped) {
+        if (!ops->map(ops->context, (enum gscan_region)mapped)) {
+            route->status = GSCAN_ROUTE_MAP_FAILED;
+            goto out;
+        }
+    }
+
+    struct route_sample previous;
+    uint64_t start = ops->now_ns(ops->context), last = start;
+    route->status = GSCAN_ROUTE_UNSTABLE;
+    for (unsigned attempt = 0; attempt < 16; ++attempt) {
+        uint64_t now = ops->now_ns(ops->context);
+        if (now < last || now - start > 150 * MS)
+            break;
+        if (!clocks_running(ops, GSCAN_GCC, gcc_offsets, r->gcc, 3) ||
+            !clocks_running(ops, GSCAN_DISP_CC, disp_offsets, r->disp, 4) ||
+            ops->read(ops->context, GSCAN_INTF, INTF_TIMING_ENABLE) != 1 ||
+            ops->read(ops->context, GSCAN_INTF, INTF_COUNTER_ENABLE) != 3) {
+            route->status = GSCAN_ROUTE_SCAN_LOST;
+            break;
+        }
+        uint32_t frame = ops->read(ops->context, GSCAN_INTF, INTF_FRAME);
+        if (!route->samples || frame != route->last_frame) {
+            struct route_sample sample;
+            read_route(ops, &sample);
+            uint32_t after = ops->read(ops->context, GSCAN_INTF, INTF_FRAME);
+            last = ops->now_ns(ops->context);
+            if (last < now || last - now > MS)
+                break;
+            if (after == frame) {
+                if (!route->samples) {
+                    previous = sample;
+                    route->first_frame = frame;
+                } else if (frame - route->first_frame > 24 || !same_route(&previous, &sample)) {
+                    break;
+                }
+                route->last_frame = frame;
+                if (++route->samples == 3) {
+                    route->status = classify_route(&sample, route);
+                    break;
+                }
+            }
+        }
+        ops->sleep_ms(ops->context, GSCAN_PERIOD_MS);
+    }
+out:
+    while (mapped > GSCAN_CTL)
+        ops->unmap(ops->context, (enum gscan_region)--mapped);
+}
+
 void gauguin_scan_run(unsigned mode, const struct gscan_ops *ops, struct gscan_result *r)
 {
     *r = (struct gscan_result){0};
     if (!mode)
         return;
-    if (mode > 3) {
+    if (mode > GSCAN_ROUTE_MODE) {
         r->status = GSCAN_BAD_MODE;
         return;
     }
     unsigned mapped = 0;
-    for (unsigned stage = GSCAN_GCC; stage < mode; ++stage) {
+    for (unsigned stage = GSCAN_GCC; stage < mode && stage < GSCAN_CTL; ++stage) {
         enum gscan_region region = (enum gscan_region)stage;
         r->stage = region;
         if (!ops->map(ops->context, region)) {
@@ -172,6 +345,8 @@ void gauguin_scan_run(unsigned mode, const struct gscan_ops *ops, struct gscan_r
             capture(ops, r);
         }
     }
+    if (mode == GSCAN_ROUTE_MODE && r->status == GSCAN_MEASURED)
+        capture_route(ops, r);
     while (mapped)
         ops->unmap(ops->context, (enum gscan_region)--mapped);
 }
