+{
+    if (!gt_cx_requested()) return GBCMT_OFF;
+    if (!input || !out) return GBCMT_ARGUMENT;
+    if (sweet_cx_rail_state() != GCR_IDLE) return GBCMT_ALREADY;
+    if (!gt_acquire()) return GBCMT_BUSY;
+    unsigned expected = GCR_IDLE;
+    if (!__atomic_compare_exchange_n(&gcr_lifecycle, &expected, GCR_RUNNING, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        gt_release(); return GBCMT_ALREADY;
+    }
+    gt_arc = true; gt_wrote = false;
+    memset(&gcr_receipt, 0, sizeof(gcr_receipt));
+    struct gcr_plan plan = *input;
+    struct gt_wire wire = {0};
+    enum gbcmt_rc rc;
+    if (__atomic_load_n(&gt_controller_quarantined, __ATOMIC_ACQUIRE)) rc = gt_fail(GBCMT_CONFIG, "controller quarantined");
+    else if (!gt_context()) rc = gt_fail(GBCMT_CONTEXT, "invalid thread context");
+    else if (!gt_cx_flags() || !gcr_plan_valid(&plan)) rc = gt_fail(GBCMT_CONFIG, "CX plan/flags rejected");
+    else if (sweet_bcm_transport_state() != GBCMT_COMPLETE || !gt_map) rc = gt_fail(GBCMT_CONFIG, "BCM completion/mapping prerequisite");
+    else {
+        wire.count = 1; wire.wait_mask = 0; wire.response_mask = 1;
+        wire.cmd[0].address = plan.address; wire.cmd[0].data = plan.selector;
+        wire.cmd[0].wait = 0;
+        rc = gt_transaction(&wire);
+    }
+    if (rc == GBCMT_OK) {
+        *out = gcr_receipt;
+        __atomic_store_n(&gcr_lifecycle, GCR_COMPLETE, __ATOMIC_RELEASE);
+        gt_record("SWEET CX RAIL: synchronous completion verified, ACTIVE1 reclaimed; CX selector6 held until reset; voltage not measured");
+    }
+    gt_release(); return rc;
+}
 #endif /* GAUGUIN */
