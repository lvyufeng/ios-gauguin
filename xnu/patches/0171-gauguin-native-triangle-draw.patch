+    TRY(compare_nc(c,GGT_RING,4*GGT_START_DWORD,GGT_COMMAND_WORDS,NULL,0xaaaaaaaau,0,false,&c->work.clean_checked));
+    for(unsigned id=0;id<GGT_BLOBS;id++){
