+ * receipt. Populated before returning READBACK; phase also identifies an IO
+ * failure's broad stage. CONFIG offset is field index0..8 (four TTBRs,TCR,
+ * MAIR0/1,IAS,OAS); every other offset is an actual byte register offset. */
+enum gsm_phase {GSP_IDLE,GSP_CAPTURE,GSP_RESOLVE,GSP_PREPARE,GSP_GLOBAL,
+    GSP_USER,GSP_KERNEL,GSP_ATOS,GSP_FINAL,GSP_DONE};
+enum gsm_check {GSD_NONE,GSD_STORE32,GSD_STORE64,GSD_POLL32,GSD_CONFIG,
+    GSD_FINAL32,GSD_FAULT32,GSD_MICRO32};
+struct gsm_diagnostics {uint32_t phase,check,offset;uint64_t mask,expected,actual;};
