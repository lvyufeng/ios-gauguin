+static void gfw_reply_record(void)
+{
+    const struct gmf_reply_diagnostic *d=&gfw_context.reply_diagnostic;
+    if(d->valid){
+        char line[192];
+        snprintf(line,sizeof(line),"SWEET GMU HFI REPLY: phase=%u site=%u reason=%u queue=%u request=%08x expected=%u words=%u captured=%u",d->phase,d->site,d->reason,d->queue,d->request_header,d->expected_words,d->words,d->captured);
+        gmb_record(line);
+        for(unsigned i=0;i<d->captured&&i<GMF_REPLY_WORDS;i++){
+            snprintf(line,sizeof(line),"SWEET GMU HFI WORD: index=%u value=%08x",i,d->data[i]);
+            gmb_record(line);
+        }
+    }
+}
