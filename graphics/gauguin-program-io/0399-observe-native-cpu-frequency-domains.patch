+/* Read-only CPUFreq-HW sampling for the two Lagoon frequency domains.
+ * The caller maps only the stock DT resources and supplies ordered reads. */
+#ifndef GAUGUIN_CPUFREQ399_H
+#define GAUGUIN_CPUFREQ399_H
+
+#include <stdint.h>
+
+enum {
+    CPU399_DOMAIN_COUNT = 2,
+    CPU399_DOMAIN_BYTES = 0x1000,
+    CPU399_LUT = 0x110,
+    CPU399_LUT_STRIDE = 32,
+    CPU399_LUT_ENTRIES = 40,
+    CPU399_PERF_STATE = 0x920,
+    CPU399_CYCLES = 0x9c0,
+};
+
+struct cpu399_domain_sample {
+    uint32_t index, frequency_row, cycles;
+};
+
+static inline bool
+cpu399_sample_domain(uint32_t (*read)(void *, unsigned), void *cookie,
+    struct cpu399_domain_sample *out)
+{
+    const uint32_t enable = read(cookie, 0);
+    if (enable == UINT32_MAX || !(enable & 1u)) {
+        return false;
+    }
+
+    const uint32_t index = read(cookie, CPU399_PERF_STATE);
+    if (index >= CPU399_LUT_ENTRIES) {
+        return false;
+    }
+
+    const uint32_t row = read(cookie, CPU399_LUT + index * CPU399_LUT_STRIDE);
+    const uint32_t cycles = read(cookie, CPU399_CYCLES);
+    if (row == UINT32_MAX || ((row >> 30) && !(row & 0xffu)) ||
+        read(cookie, CPU399_PERF_STATE) != index || read(cookie, 0) != enable) {
+        return false;
+    }
+
+    *out = {index, row, cycles};
+    return true;
+}
+
+#endif
