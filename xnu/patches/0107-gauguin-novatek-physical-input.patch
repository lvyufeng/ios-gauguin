+    return ns / 1000u;
+}
+static bool nv_context(void)
+{
+    return current_thread() != THREAD_NULL && ml_get_interrupts_enabled() &&
+        !ml_at_interrupt_context() && get_preemption_level() == 0;
+}
+static bool nv_owned(struct nvt_bus *b)
+{
