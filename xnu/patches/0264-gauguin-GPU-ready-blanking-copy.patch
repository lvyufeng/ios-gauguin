+#ifndef GAUGUIN_BLANK352_H
+#define GAUGUIN_BLANK352_H
+
+#include "gauguin_blank351.h"
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    SCAN352_COPY_NS = 5500000,
+    SCAN352_FAST_COPY = 4,
+    SCAN352_WIDTH = 1080, SCAN352_HEIGHT = 2400,
+    SCAN352_PANEL_STRIDE = 4320, SCAN352_SOURCE_STRIDE = 4608
+};
+
+static inline bool
+scan352_can_copy(uint32_t line, uint32_t end)
+{
+    return line >= SCAN351_OPEN && end <= SCAN351_TOTAL && end > line &&
+        (uint64_t)(end - line) * SCAN351_MIN_LINE_NS >= SCAN352_COPY_NS;
+}
+
+static inline bool
+scan352_can_take(const struct scan351_slot *slot, const struct scan351_position *pos, bool from_ready)
+{
+    if (!scan352_can_copy(pos->line, pos->end)) return false;
+    const bool same_slot = slot->attempts && slot->frame == pos->frame;
+    return from_ready ? same_slot && slot->attempts == 1 && !slot->done : !same_slot;
+}
+
+static inline uint32_t
+scan352_delay_lines(const struct scan351_slot *slot, const struct scan351_position *pos)
+{
+    if ((slot->attempts && slot->frame == pos->frame) ||
+        !scan352_can_copy(SCAN351_OPEN, pos->end) ||
+        (pos->line >= SCAN351_OPEN && !scan352_can_copy(pos->line, pos->end)))
+        return SCAN351_TOTAL - pos->line + SCAN351_OPEN;
+    return pos->line < SCAN351_OPEN ? SCAN351_OPEN - pos->line : 0;
+}
+
+/* A distinct ticket for each timed take, even when it reuses the surface ID. */
+static inline uint64_t
+scan352_ticket(uint64_t attempt, uint32_t surface)
+{
+    if (!surface || !attempt || attempt > UINT32_MAX) return 0;
+    return (attempt << 32) | surface;
+}
+
+static inline bool
+scan352_matches(uint64_t delivered, uint64_t waiting, uint64_t waiting_generation,
+    uint64_t pending_generation, uint32_t surface)
+{
+    return delivered && delivered == waiting && waiting_generation == pending_generation &&
+        (uint32_t)delivered == surface;
+}
+
+/* Only the observed full-panel geometry uses the paired integer copy path. */
+static inline bool
+scan352_copy_supported(uintptr_t dst, uintptr_t src, uint32_t width, uint32_t height,
+    uint32_t dst_stride, uint32_t src_stride)
+{
+    if (!dst || !src || (dst & 15) || (src & 7) ||
+        width != SCAN352_WIDTH || height != SCAN352_HEIGHT ||
+        dst_stride != SCAN352_PANEL_STRIDE || src_stride != SCAN352_SOURCE_STRIDE)
+        return false;
+    const size_t source_bytes = (SCAN352_HEIGHT - 1) * SCAN352_SOURCE_STRIDE + SCAN352_PANEL_STRIDE;
+    const size_t panel_bytes = SCAN352_HEIGHT * SCAN352_PANEL_STRIDE;
+    return dst >= src ? dst - src >= source_bytes : src - dst >= panel_bytes;
+}
+
+static inline void
+scan352_copy_row(void *dst, const void *src)
+{
+    const size_t row_bytes = SCAN352_PANEL_STRIDE;
+#if defined(__aarch64__)
+    size_t remaining = row_bytes & ~(size_t)127;
+    /* The panel mapping is write-combined. Use the same integer store
+     * instructions as the kernel copy with four times the bytes per branch. */
+    __asm__ volatile(
+        "1:\n"
+        "ldp x8, x9, [%[s]]\n"
+        "ldp x10, x11, [%[s], #16]\n"
+        "ldp x12, x13, [%[s], #32]\n"
+        "ldp x14, x15, [%[s], #48]\n"
+        "stnp x8, x9, [%[d]]\n"
+        "stnp x10, x11, [%[d], #16]\n"
+        "stnp x12, x13, [%[d], #32]\n"
+        "stnp x14, x15, [%[d], #48]\n"
+        "ldp x8, x9, [%[s], #64]\n"
+        "ldp x10, x11, [%[s], #80]\n"
+        "ldp x12, x13, [%[s], #96]\n"
+        "ldp x14, x15, [%[s], #112]\n"
+        "stnp x8, x9, [%[d], #64]\n"
+        "stnp x10, x11, [%[d], #80]\n"
+        "stnp x12, x13, [%[d], #96]\n"
+        "stnp x14, x15, [%[d], #112]\n"
+        "add %[s], %[s], #128\n"
+        "add %[d], %[d], #128\n"
+        "subs %[n], %[n], #128\n"
+        "b.ne 1b\n"
+        : [d] "+&r"(dst), [s] "+&r"(src), [n] "+&r"(remaining)
+        :
+        : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "cc", "memory");
+    __builtin_memcpy(dst, src, row_bytes & 127);
+#else
+    __builtin_memcpy(dst, src, row_bytes);
+#endif
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+uint64_t sweet_fb352_waiting_ticket(void);
+void sweet_fb352_signal_ready(uint64_t ticket, uint32_t fence);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
