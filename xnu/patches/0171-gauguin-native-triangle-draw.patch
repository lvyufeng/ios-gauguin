+}
+bool ggt_blob_word(unsigned id,unsigned index,uint32_t *out)
+{
+    struct ggt_blob b;
+    if(!span(out,sizeof(*out))||!ggt_blob_get(id,&b)||index>=b.words)return false;
+    const struct draw171_native_blob *n=native_blob(id);
+    *out=index<b.payload_words?n->data[index]:0;return true;
+}
+bool ggt_artifact_allowed(uint32_t off)
+{
+    if(off&3)return false;
+    for(unsigned id=0;id<GGT_BLOBS;id++){
+        struct ggt_blob b;if(!ggt_blob_get(id,&b))return false;
+        if(b.words&&off>=b.offset&&off-b.offset<4*b.words)return true;
+    }
+    return false;
+}
+bool ggt_command_build(const struct ggd_plan *p,struct ggt_command *out)
+{
