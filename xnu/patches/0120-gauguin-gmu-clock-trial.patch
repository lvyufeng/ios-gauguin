--- /dev/null
+++ b/bsd/dev/gauguin_gmu_clock.h
@@ -0,0 +1,20 @@
+#ifndef GAUGUIN_GMU_CLOCK_H
+#define GAUGUIN_GMU_CLOCK_H
+#include "gauguin_cx_power.h"
+enum gmc_register {GMC_MODE,GMC_L,GMC_FRAC,GMC_DIV,GMC_CFG_AHB,GMC_PLL_VOTE,
+    GMC_DIV_VOTE,GMC_AHB,GMC_GDSC,GMC_CMD,GMC_CFG,GMC_CX,GMC_GX,GMC_CXO,
+    GMC_AXI,GMC_MEM,GMC_COUNT};
+/* direct_writes counts only private-map stores; hold_requests counts calls
+ * to the shared GCC owner, which may skip an already-held vote. */
+struct gmc_receipt {uint32_t before[GMC_COUNT],after[GMC_COUNT];
+    uint32_t direct_writes,hold_requests,polls,configured_hz;};
+/* Fixed GPLL0 600MHz /2 /1.5 profile,200MHz configured rate (not measured).
+ * Reuses CX's private maps and shared GCC vote page. Only after same-boot
+ * BCM/ARC/CX COMPLETE and a fresh WDT budget; no old receipt authorizes this.
+ * Retains requests, no frequency retune/rollback/PET or GMU firmware/reset
+ * release/PAS/SMMU/GX operation. Inherited CM3 state is not thereby proven.
