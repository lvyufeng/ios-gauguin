+++ b/bsd/dev/cmd_db_snapshot.c
@@ -0,0 +1,79 @@
+#include "cmd_db_snapshot.h"
+#include <string.h>
+/* Fixed native19b63c8192b1c9b7c4d931d7d3be92024bc2d778
+ * drivers/soc/qcom/cmd-db.c:24–75,112–128,147–177,204–230;
+ * drivers/regulator/rpmh-regulator.c:1266–1335.
+ * Native header checksum is unused; do not invent checksum verification. */
+static uint16_t u16(const uint8_t *p)
+{ return (uint16_t)((uint16_t)p[0]|(uint16_t)p[1]<<8); }
+static uint32_t u32(const uint8_t *p)
+{ return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24; }
+static int range(size_t start,size_t bytes,size_t end)
+{ return start<=end && bytes<=end-start; }
+
+enum ndb_result ndb_lookup(const uint8_t *blob,size_t bytes,const char *name,
+    size_t name_bytes,struct ndb_entry *out)
+{
+    uint8_t key[8]={0};
+    struct ndb_entry candidate;
+    size_t total=0;
+    unsigned matches=0;
+    if(!blob||!name||!out||!name_bytes||name_bytes>8) return NDB_ARGUMENT;
+    if(bytes<NDB_HEADER_BYTES||bytes>NDB_MAX_BYTES) return NDB_LENGTH;
+    for(size_t i=0;i<name_bytes;++i) {
+        if((uint8_t)name[i]<0x21||(uint8_t)name[i]>0x7e) return NDB_ARGUMENT;
+        key[i]=(uint8_t)name[i];
+    }
+    if(u32(blob+4)!=UINT32_C(0x0c0330db)) return NDB_FORMAT;
+    if(u32(blob)!=1||(u32(blob+140)&1)) return NDB_UNSUPPORTED;
+    memset(&candidate,0,sizeof(candidate));
+    for(unsigned bank=0;bank<8;++bank) {
+        const uint8_t *h=blob+8+16*bank;
+        uint16_t slave=u16(h),count=u16(h+6);
+        if(!slave) break; /* Same termination rule as native get_header. */
+        if(slave<3||slave>5) return NDB_UNSUPPORTED;
+        if(count>NDB_MAX_ENTRIES-total) return NDB_CAPACITY;
+        total+=count;
+        size_t entries=NDB_HEADER_BYTES+(size_t)u16(h+2);
+        size_t aux_base=NDB_HEADER_BYTES+(size_t)u16(h+4);
+        if(!range(entries,(size_t)count*24,bytes)||!range(aux_base,0,bytes)) return NDB_LENGTH;
+        for(unsigned i=0;i<count;++i) {
+            const uint8_t *e=blob+entries+(size_t)i*24;
+            uint16_t length=u16(e+20);
+            size_t aux=aux_base+(size_t)u16(e+22);
+            if(!range(aux,length,bytes)) return NDB_LENGTH;
+            if(memcmp(e,key,8)) continue;
+            if(++matches>1) return NDB_AMBIGUOUS;
+            if(length>NDB_MAX_AUX) return NDB_CAPACITY;
+            memcpy(candidate.name,e,8);
+            candidate.address=u32(e+16);
+            candidate.priority[0]=u32(e+8); candidate.priority[1]=u32(e+12);
+            candidate.owner_slave=slave; candidate.bank_version=u16(h+8);
+            candidate.aux_length=length;
+            /* Do NOT rediscover the bank from address>>16 (debugfs .mol bug). */
+            memcpy(candidate.aux,blob+aux,length);
+        }
+    }
+    if(!matches) return NDB_NOT_FOUND;
+    *out=candidate;
+    return NDB_OK;
+}
+
+enum ndb_result ndb_decode_arc(const struct ndb_entry *entry,struct ndb_arc_levels *out)
+{
+    struct ndb_arc_levels parsed={{0},0};
+    int padding=0;
+    if(!entry||!out) return NDB_ARGUMENT;
+    if(entry->owner_slave!=3||!entry->address||((entry->address>>16)&7)!=3||
+        (entry->address&15)) return NDB_NOT_ARC;
+    if(!entry->aux_length||entry->aux_length>NDB_MAX_AUX||(entry->aux_length&1)) return NDB_LENGTH;
+    for(unsigned i=0;i<entry->aux_length/2;++i) {
+        uint16_t level=u16(entry->aux+2*i);
+        if(i && !level) padding=1;
+        if(padding) {if(level) return NDB_FORMAT;continue;}
+        if(parsed.count && level<=parsed.value[parsed.count-1]) return NDB_FORMAT;
+        parsed.value[parsed.count++]=level;
+    }
+    *out=parsed;
+    return NDB_OK;
+}
