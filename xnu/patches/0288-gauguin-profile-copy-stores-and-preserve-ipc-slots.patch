+#ifndef GAUGUIN_FRAME377_SLOTS_H
+#define GAUGUIN_FRAME377_SLOTS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum { F377_IPC_WAYS = 4 };
+#define F377_RESERVED ((uintptr_t)1)
+
+struct f377_keys {
+    uintptr_t key[F377_IPC_WAYS];
+};
+
+static inline int
+f377_lookup(const struct f377_keys *bucket, uintptr_t key)
+{
+    for (unsigned way = 0; way < F377_IPC_WAYS; ++way) {
+        if (__atomic_load_n(&bucket->key[way], __ATOMIC_ACQUIRE) == key) return (int)way;
+    }
+    return -1;
+}
+
+static inline int
+f377_reserve(struct f377_keys *bucket)
+{
+    for (unsigned way = 0; way < F377_IPC_WAYS; ++way) {
+        uintptr_t free = 0;
+        if (__atomic_compare_exchange_n(&bucket->key[way], &free, F377_RESERVED, false,
+            __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return (int)way;
+    }
+    return -1;
+}
+
+static inline void
+f377_publish(struct f377_keys *bucket, unsigned way, uintptr_t key)
+{
+    __atomic_store_n(&bucket->key[way], key, __ATOMIC_RELEASE);
+}
+
+static inline bool
+f377_release(struct f377_keys *bucket, unsigned way, uintptr_t key)
+{
+    return __atomic_compare_exchange_n(&bucket->key[way], &key, 0, false,
+        __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+}
+
+#endif
