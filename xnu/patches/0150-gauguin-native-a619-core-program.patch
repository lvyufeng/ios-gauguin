+    bool (*read_reglist)(void *,uint32_t,uint32_t *);
+    bool (*write_reglist)(void *,uint32_t,uint32_t);
+};
+#define GGC_REGLIST_VALUES 66u
+#define GGC_REGLIST_WORDS (4u+2u*GGC_REGLIST_VALUES)
+#define GGC_REGLIST_OFFSET 72u
+struct ggc_receipt {
+    struct ggx_receipt start;
+    uint32_t reads,writes,mem_written,mem_compared,hwcg_skipped;
