+    uint32_t bin_offset, sram;
+    uint16_t payload_bytes, wire_bytes;
+    uint8_t page[3];   /* raw write: FF, address[22:15], address[14:7] */
+    uint8_t command;   /* raw write command: 0x80 | address[6:0]; no read dummy */
