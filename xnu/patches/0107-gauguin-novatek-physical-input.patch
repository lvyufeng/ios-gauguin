+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_terminate_self(void);
+extern int get_preemption_level(void);
+extern void sweet_log_mark_sync(const char *);
+extern void sweet_log_flush_now(void);
+extern void sweet_log_append(const char *, int);
+/* arm64/arm_vm_init.c establishes these from the real boot memory map. */
+extern unsigned long gPhysBase, real_phys_size;
+extern vm_offset_t arm_vm_kernelcache_phys_end;
+
+#define NRT_PAGE 0x4000u
+#define NRT_ASSET_RESERVED ((NBS_FIRMWARE_BYTES + NRT_PAGE - 1) & ~(NRT_PAGE - 1))
+#define NRT_POLL_MS 8u
+#define NRT_BAD_LIMIT 3u
+#define NRT_HID_LIMIT 8u
+#define NRT_STALE_US 250000u
+#define NRT_RELEASE_ATTEMPTS 3u
+_Static_assert(NBS_FIRMWARE_BYTES == 139264u, "pinned image size");
+_Static_assert(SWEET_HID_TOUCH_CONTACTS == NVT_MAX_CONTACTS, "full snapshot slots");
+
+static unsigned nrt_started;
+enum nrt_phase { NRT_DELAY, NRT_ASSET, NRT_OPEN, NRT_CONFIGURE, NRT_PINS,
+                 NRT_BOOTSTRAP, NRT_POLL, NRT_RELEASING, NRT_STOPPED };
+struct nrt_session {
+    struct nvt_bus *bus;
+    struct nbs_session bootstrap;
+    struct nvt_state points;
+    uint32_t last_hid_mask, packets, accepted, rejected;
+    unsigned bad_frames, hid_failures;
+    int last_bootstrap_phase;
+    uint64_t last_good_us, last_summary_us;
+};
+
+static void nrt_phase(enum nrt_phase phase, int error)
+{
+    char line[112];
+    snprintf(line, sizeof(line), "SWEET NVT: phase=%u error=%d", (unsigned)phase, error);
+    printf("%s\n", line);
+    sweet_log_mark_sync(line);
+    sweet_log_flush_now();
+}
+
+static uint64_t nrt_now_us(void *unused)
+{
+    uint64_t ns;
+    (void)unused;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns / 1000u;
+}
+
+static int nrt_asset(const uint8_t **image)
+{
+    static const uint8_t expected[SHA256_DIGEST_LENGTH] = {
+        0x00,0x71,0x43,0xe7,0xd0,0xa8,0x16,0xe4,0xef,0x22,0x8b,0x5a,0x08,0xbf,0x31,0x32,
+        0x28,0x52,0x30,0xa5,0xcd,0x16,0x16,0x4e,0x80,0x86,0x69,0x61,0x15,0xd6,0x0f,0x88
+    };
+    DTEntry node;
+    const void *property = NULL;
+    unsigned length = 0;
+    uint64_t range[2];
+    *image = NULL;
+    if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+        SecureDTGetProperty(node, "NovatekFirmware", &property, &length) != kSuccess ||
+        !property || length != sizeof(range)) return ENOENT;
+    memcpy(range, property, sizeof(range));
+    const boot_args *args = PE_state.bootArgs;
+    if (!args || args->Version != kBootArgsVersion2 ||
+        range[1] != NBS_FIRMWARE_BYTES || (range[0] & (NRT_PAGE - 1)) ||
+        (args->topOfKernelData & (NRT_PAGE - 1))) return EINVAL;
+    uint64_t pa = range[0], base = args->physBase, bytes = args->memSize;
+    uint64_t top = args->topOfKernelData;
+    /* Include the complete reserved pages, not just the hash's raw file bytes.
+     * Kernel data end..top is RWNX in arm_vm_init; use its existing RAM alias,
+     * never create a Device-memory alias of RAM or an executable mapping. */
+    if (base != gPhysBase || !bytes || !real_phys_size || bytes > UINT64_MAX - base ||
+        real_phys_size > UINT64_MAX - base || top < base || top > base + bytes ||
+        top > base + real_phys_size || arm_vm_kernelcache_phys_end < base ||
+        arm_vm_kernelcache_phys_end > top || pa < arm_vm_kernelcache_phys_end ||
+        pa >= top || NRT_ASSET_RESERVED > top - pa) return EINVAL;
+    vm_offset_t first = ml_static_ptovirt((vm_offset_t)pa);
+    vm_offset_t last = ml_static_ptovirt((vm_offset_t)(pa + NBS_FIRMWARE_BYTES - 1));
+    if (!first || first > UINTPTR_MAX - (NBS_FIRMWARE_BYTES - 1) ||
+        last != first + NBS_FIRMWARE_BYTES - 1) return EFAULT;
+    const uint8_t *data = (const uint8_t *)first;
+    SHA256_CTX ctx;
+    uint8_t digest[SHA256_DIGEST_LENGTH];
+    SHA256_Init(&ctx);
+    SHA256_Update(&ctx, data, NBS_FIRMWARE_BYTES);
+    SHA256_Final(digest, &ctx);
+    if (memcmp(digest, expected, sizeof(expected))) return EAUTH;
+    *image = data;
+    printf("SWEET NVT: reserved firmware SHA256 verified size=%u\n", NBS_FIRMWARE_BYTES);
+    return 0;
+}
+
+static int nrt_xfer(void *cookie, const uint8_t *tx, uint8_t *rx, size_t length)
+{
+    struct nrt_session *s = cookie;
+    return nvt_bus_xfer(s->bus, tx, rx, length);
+}
+static int nrt_reset(void *cookie, bool high)
+{
+    struct nrt_session *s = cookie;
+    return nvt_bus_set_reset(s->bus, high);
+}
+static void nrt_delay(void *cookie, unsigned ms)
+{
+    (void)cookie;
+    IOSleep(ms);
+}
+static void nrt_progress(void *cookie, enum nbs_phase phase, uint32_t done, uint32_t goal_bytes)
+{
+    struct nrt_session *s = cookie;
+    /* Upload/readback chunk callbacks do not flush once per SPI transaction. */
+    if (s->last_bootstrap_phase == (int)phase) return;
+    s->last_bootstrap_phase = (int)phase;
+    char line[112];
+    snprintf(line, sizeof(line), "SWEET NVT: bootstrap phase=%u done=%u total=%u",
+        (unsigned)phase, done, goal_bytes);
+    printf("%s\n", line);
+    sweet_log_mark_sync(line);
+    sweet_log_flush_now();
+}
+
+/* Each field is the last successful observation recorded by bootstrap.
+ * A later failed read does not turn an old value into a current observation. */
+static const char *nrt_hex(char out[12], bool valid, uint32_t value)
+{
+    if (valid) snprintf(out, 12, "%08x", value);
+    else snprintf(out, 12, "unread");
+    return out;
+}
+static void nrt_bootstrap_report(const struct nbs_report *r, int result)
+{
+    char trim[24], elapsed[24], fw[48];
+    char before[12], status[12], ilm[12], dlm[12], igolden[12], dgolden[12], reset[12], pid[12];
+    if (r->valid & NBS_VALID_TRIM)
+        snprintf(trim, sizeof(trim), "%02x%02x%02x%02x%02x%02x",
+            r->trim[0], r->trim[1], r->trim[2], r->trim[3], r->trim[4], r->trim[5]);
+    else snprintf(trim, sizeof(trim), "unread");
+    if (r->valid & NBS_VALID_ELAPSED)
+        snprintf(elapsed, sizeof(elapsed), "%llu", (unsigned long long)r->elapsed_us);
+    else snprintf(elapsed, sizeof(elapsed), "unread");
+    if (r->valid & NBS_VALID_FWINFO)
+        snprintf(fw, sizeof(fw), "%ux%u/ver%u/type%u", r->fwinfo.max_x, r->fwinfo.max_y,
+            r->fwinfo.version, r->fwinfo.firmware_type);
+    else snprintf(fw, sizeof(fw), "unread");
+    printf("SWEET NVT: bootstrap summary phase=%u result=%d reported=%d callback=%d touched=%u ready=%u valid=%x written=%u verified=%u transfers=%u\n",
+        (unsigned)r->phase, result, r->result, r->callback_error, (unsigned)r->hardware_touched,
+        (unsigned)r->ready, r->valid, r->bytes_written, r->bytes_verified, r->transfers);
+    printf("SWEET NVT: bootstrap last_verified trim=%s reset_pin=%s elapsed_us=%s\n", trim,
+        (r->valid & NBS_VALID_RESET_PIN) ? (r->reset_raised ? "high" : "low") : "unread", elapsed);
+    printf("SWEET NVT: bootstrap CRC last_verified before=%s status=%s ILM=%s DLM=%s golden_ILM=%s golden_DLM=%s\n",
+        nrt_hex(before, r->valid & NBS_VALID_CRC_BEFORE, r->crc_before),
+        nrt_hex(status, r->valid & NBS_VALID_CRC_STATUS, r->crc_status),
+        nrt_hex(ilm, r->valid & NBS_VALID_ILM_CRC, r->ilm_crc),
+        nrt_hex(dlm, r->valid & NBS_VALID_DLM_CRC, r->dlm_crc),
+        nrt_hex(igolden, r->valid & NBS_VALID_ILM_GOLDEN, r->ilm_golden),
+        nrt_hex(dgolden, r->valid & NBS_VALID_DLM_GOLDEN, r->dlm_golden));
+    printf("SWEET NVT: bootstrap last_verified reset_state=%s PID=%s FWINFO=%s\n",
+        nrt_hex(reset, r->valid & NBS_VALID_RESET_STATE, r->reset_state.state),
+        nrt_hex(pid, r->valid & NBS_VALID_PID, r->pid), fw);
+}
+static void nrt_bus_report(const struct nvt_bus_status *r, uint32_t release_mask)
+{
+    const struct gs_diag *d = &r->pio;
+    char irq[12], tx[12], rx[12];
+    printf("SWEET NVT: final bus state=%u error=%d pio=%d release_mask=%x masked=%u clocks_restored=%u pins_restored=%u setup=%d primary=%d restore=%d effects=%x\n",
+        (unsigned)r->state, r->error, r->pio_result, release_mask, (unsigned)r->mask_confirmed,
+        (unsigned)r->clocks_restored, (unsigned)r->pins_restored, r->setup_result,
+        r->setup.failure, r->setup.restore_failure, r->setup.effects);
+    /* Snapshot can precede a later bus preflight refusal. irq_seen is an OR,
+     * not the last IRQ value. Validity follows PIO poll/drain/recover ordering. */
+    printf("SWEET NVT: last PIO snapshot irq_seen=%s tx_status=%s rx_status=%s queued=%lu received=%lu polls=%u recovery=%u\n",
+        nrt_hex(irq, d->polls != 0, d->irq_seen),
+        nrt_hex(tx, d->tx_queued != 0 || d->last_tx_status != 0, d->last_tx_status),
+        nrt_hex(rx, d->polls != 0 || d->recovery != GS_REC_NONE, d->last_rx_status),
+        (unsigned long)d->tx_queued, (unsigned long)d->rx_received, d->polls, (unsigned)d->recovery);
+}
+
+static void nrt_snapshot(const struct nvt_state *points, struct sweet_hid_touch_snapshot *out)
+{
+    memset(out, 0, sizeof(*out));
+    for (unsigned i = 0; i < NVT_MAX_CONTACTS; i++) {
+        const struct nvt_contact *p = &points->contacts[i];
+        if (!p->active) continue;
+        uint32_t xmax = points->max_x - 1u, ymax = points->max_y - 1u;
+        uint32_t x = p->x > xmax ? xmax : p->x, y = p->y > ymax ? ymax : p->y;
+        out->active_mask |= 1u << i;
+        out->x[i] = (int32_t)((x * 1079u) / xmax);
+        out->y[i] = (int32_t)((y * 2399u) / ymax);
+    }
+}
+
+static bool nrt_release_contacts(struct nrt_session *s)
+{
+    if (!s->last_hid_mask) return true;
+    printf("SWEET NVT: releasing submitted mask=%x\n", s->last_hid_mask);
+    struct sweet_hid_touch_snapshot up = {0};
+    for (unsigned i = 0; i < NRT_RELEASE_ATTEMPTS; i++) {
+        int result = sweet_hid_touch_frame(&up);
+        if (result == 0) {
+            printf("SWEET NVT: HID release accepted mask=%x\n", s->last_hid_mask);
+            s->last_hid_mask = 0;
+            return true;
+        }
+        printf("SWEET NVT: contact release refused=%x attempt=%u\n", (unsigned)result, i + 1);
+        if (i + 1 < NRT_RELEASE_ATTEMPTS) IOSleep(NRT_POLL_MS);
+    }
+    printf("SWEET NVT: contact release unconfirmed mask=%x\n", s->last_hid_mask);
+    return false;
+}
+
+static int nrt_poll(struct nrt_session *s)
+{
+    struct nvt_request request;
+    uint8_t rx[NVT_MAX_WIRE];
+    if (nvt_make_request(NVT_READ_POINTS, &request) != NVT_OK || request.wire_length != 67) return EINVAL;
+    s->last_good_us = s->last_summary_us = nrt_now_us(NULL);
+    for (;;) {
+        int result = nrt_xfer(s, request.page, NULL, sizeof(request.page));
+        if (!result) result = nrt_xfer(s, request.tx, rx, request.wire_length);
+        if (!result) result = nrt_xfer(s, request.restore_page, NULL, sizeof(request.restore_page));
+        if (result) return result;
+        s->packets++;
+        struct nvt_frame frame;
+        result = nvt_decode_points(&s->points, rx, sizeof(rx), &frame);
+        uint64_t now = nrt_now_us(NULL);
+        if (now < s->last_good_us) return EIO;
+        if (result != NVT_OK) {
+            s->rejected++;
+            printf("SWEET NVT: malformed frame rc=%d streak=%u\n", result, s->bad_frames + 1);
+            if (++s->bad_frames >= NRT_BAD_LIMIT) return EPROTO;
+        } else if (frame.kind == NVT_PACKET_ESD) {
+            printf("SWEET NVT: controller ESD signature; stopping\n");
+            return EIO;
+        } else if (frame.kind == NVT_PACKET_WDT) {
+            if (frame.recovery_required) {
+                printf("SWEET NVT: controller WDT streak=%u; stopping\n", frame.wdt_streak);
+                return EIO;
+            }
+        } else {
+            s->bad_frames = 0;
+            s->last_good_us = now;
+            struct sweet_hid_touch_snapshot snapshot;
+            nrt_snapshot(&s->points, &snapshot);
+            int hid = sweet_hid_touch_frame(&snapshot);
+            if (hid != 0) {
+                if (++s->hid_failures >= NRT_HID_LIMIT) {
+                    printf("SWEET NVT: HID failure=%x count=%u; stopping\n", (unsigned)hid, s->hid_failures);
+                    return EIO;
+                }
+            } else {
+                s->hid_failures = 0;
+                s->accepted++;
+                if (s->last_hid_mask != snapshot.active_mask)
+                    printf("SWEET NVT: observed contact mask=%x packets=%u\n", snapshot.active_mask, s->packets);
+                s->last_hid_mask = snapshot.active_mask;
+            }
+        }
+        if (now - s->last_good_us >= NRT_STALE_US) return ETIMEDOUT;
+        if (now - s->last_summary_us >= 10000000u) {
+            printf("SWEET NVT: packets=%u accepted=%u rejected=%u mask=%x\n",
+                s->packets, s->accepted, s->rejected, s->last_hid_mask);
+            s->last_summary_us = now;
+        }
+        IOSleep(NRT_POLL_MS);
+    }
+}
+
+static void nrt_run(void)
+{
+    struct nrt_session s = {0};
+    const uint8_t *image = NULL;
+    struct nvt_bus_status bus_status = {0};
+    int error;
+    s.last_bootstrap_phase = -1;
+    if (!ml_get_interrupts_enabled() || ml_at_interrupt_context() || get_preemption_level()) {
+        static const char text[] = "SWEET NVT: invalid worker context; stopped\n";
+        sweet_log_append(text, (int)sizeof(text) - 1);
+        return;
+    }
+    nrt_phase(NRT_ASSET, 0);
+    error = nrt_asset(&image);
+    if (error) { nrt_phase(NRT_STOPPED, error); return; }
+    nrt_phase(NRT_OPEN, 0);
+    error = nvt_bus_open(&s.bus);
+    if (error || !s.bus) { nrt_phase(NRT_STOPPED, error ? error : EIO); return; }
+    nrt_phase(NRT_CONFIGURE, 0);
+    error = nvt_bus_configure(s.bus, 1000000);
+    if (error) goto stop;
+    error = nvt_bus_get_status(s.bus, &bus_status);
+    if (error || bus_status.state != NVT_BUS_CONFIGURED || bus_status.sck_hz != 960000) {
+        error = error ? error : EPROTO;
+        goto stop;
+    }
+    nrt_phase(NRT_PINS, 0);
+    error = nvt_bus_activate_native_pins(s.bus);
+    if (error) goto stop;
+    nrt_phase(NRT_BOOTSTRAP, 0);
+    const struct nbs_io io = { .cookie = &s, .xfer = nrt_xfer, .reset = nrt_reset,
+        .delay_ms = nrt_delay, .now_us = nrt_now_us, .progress = nrt_progress };
+    error = nbs_bootstrap(&s.bootstrap, &io, image, NBS_FIRMWARE_BYTES);
+    nrt_bootstrap_report(&s.bootstrap.report, error);
+    if (error || !s.bootstrap.report.ready || !s.bootstrap.report.trim_verified ||
+        s.bootstrap.report.event_base != NVT_EVENT_BASE || s.bootstrap.report.hw_crc != 2 ||
+        !s.bootstrap.report.bytes_written || s.bootstrap.report.bytes_verified != s.bootstrap.report.bytes_written) {
+        error = EIO;
+        goto stop;
+    }
+    const struct nvt_fw_info *fw = &s.bootstrap.report.fwinfo;
+    if (fw->max_x < 2 || fw->max_y < 2 || nvt_state_init(&s.points, fw) != NVT_OK) {
+        error = EINVAL;
+        goto stop;
+    }
+    printf("SWEET NVT: observed geometry=%ux%u PID=%x; starting physical reports\n",
+        fw->max_x, fw->max_y, s.bootstrap.report.pid);
+    nrt_phase(NRT_POLL, 0);
+    error = nrt_poll(&s);
+stop:
+    /* No disk flush delays UP, and no SPI follows any failed transaction. */
+    (void)nrt_release_contacts(&s);
+    nvt_bus_abort(s.bus, error ? error : EIO, &bus_status);
+    nrt_bus_report(&bus_status, s.last_hid_mask);
+    nrt_phase(NRT_STOPPED, error);
+}
+
+static void nrt_worker(void *argument, wait_result_t result)
+{
+    (void)argument; (void)result;
+    nrt_phase(NRT_DELAY, 0);
+    for (unsigned i = 0; i < 30; i++) IOSleep(1000);
+    nrt_run();
+    thread_terminate_self();
+}
+
+void sweet_nvt_start(void)
+{
+    int enabled = 0, diagnostic = 0, legacy = 0;
+    (void)PE_parse_boot_argn("sweetnvt", &enabled, sizeof(enabled));
+    if (enabled != 1) return;
+    if (__atomic_exchange_n(&nrt_started, 1, __ATOMIC_ACQ_REL)) return;
+    (void)PE_parse_boot_argn("sweetnvtprobe", &diagnostic, sizeof(diagnostic));
+    (void)PE_parse_boot_argn("sweettouchmode", &legacy, sizeof(legacy));
+    if (diagnostic || legacy) {
+        printf("SWEET NVT: conflicting probe/legacy mode; no worker\n");
+        return;
+    }
+    thread_t thread;
+    kern_return_t result = kernel_thread_start(nrt_worker, NULL, &thread);
+    if (result == KERN_SUCCESS) thread_deallocate(thread);
+    else printf("SWEET NVT: worker creation failed=%d; no inline fallback\n", result);
+}
