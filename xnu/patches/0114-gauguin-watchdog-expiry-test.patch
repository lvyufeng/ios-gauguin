 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 
+
+#if defined(GAUGUIN)
+extern "C" bool sweet_wdt_test_requested(void);
+#endif
 
 void sweet_wdt_thread_start(void);
 void sweet_pon_dump(void);
@@ -529,6 +533,16 @@
 void
 sweet_wdt_thread_start(void)
 {
+#if defined(GAUGUIN)
+	/* The reset experiment owns APSS WDT exclusively. Exclude both legacy
+	 * aliases/callouts before scheduling, even when test flags conflict.
+	 * The userland IOWatchdog service and read-only secure diagnostics stay. */
+	if (sweet_wdt_test_requested()) {
+		IOLog("SWEET WDT TEST: legacy sampler/PET excluded before scheduling\n");
+		sweet_secure_diag_start();
+		return;
+	}
+#endif
 	if (sweet_wdt_call != NULL) {
 		return;
 	}
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -49,6 +49,28 @@
 #define gicr_read32(offset) (_gic_read32(gicr_pe_base + (offset)))
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
+
+/* Gauguin APSS watchdog experiment: read-only interrupt precondition.
+ * Architected GICD_ISENABLER1=0x104 (SPI32..63); DT watchdog SPI0/1=INTID32/33.
+ * Reuse the initialized PE mapping; read-only, no SPI/GIC configuration change.
+ * A zero bit in this NS view does not disclose or claim secure ownership. */
+#if defined(GAUGUIN)
+extern vm_offset_t ml_vtophys(vm_offset_t);
+bool sweet_wdt_irq_quiet(uint32_t *enabled);
+bool
+sweet_wdt_irq_quiet(uint32_t *enabled)
+{
+    if (enabled == NULL || !gicd_base ||
+        ml_vtophys(gicd_base) != UINT64_C(0x17a00000) ||
+        ml_vtophys(gicd_base + 0x104u) != UINT64_C(0x17a00104)) {
+        return false;
+    }
+    uint32_t value = gicd_read32(0x104u);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    *enabled = value;
+    return (value & 3u) == 0;
+}
+#endif
 
 static vm_offset_t
 find_gicr_pe_base()
