+enum gpm_state { GPM_IDLE, GPM_RUNNING, GPM_COMPLETE, GPM_QUARANTINED };
+struct gpm_receipt {
+    uint64_t stage_pa, region_bytes;
+    struct gpi_registers returned;
+    uint32_t has_returned, smc_calls, fresh_attempts, continuations;
+};
+/* Separately exact1 opted-in PAS13 MEM_SETUP, fixed native ELF span4096 and
+ * extra_size0. PA comes solely from this boot's successful INIT publication;
+ * there is deliberately no PA/size/caller-receipt input. GPI_COMPLETE remains
+ * historical INIT success even if MEM fails; MEM/WDT authorization then stays
+ * quarantined. No buffer access/remap/restage/free, b02 load or AUTH_RESET.
+ * OFF/NULL/ALREADY preserve out. Started terminal paths publish the complete
+ * receipt before release terminal state. Each transaction retains the same
+ * software/SMC bounds and cannot cancel a secure call that never returns. */
+bool sweet_pas_mem_requested(void);
+enum gpi_rc sweet_pas_mem_setup_once(struct gpm_receipt *out);
+enum gpm_state sweet_pas_mem_state(void);
