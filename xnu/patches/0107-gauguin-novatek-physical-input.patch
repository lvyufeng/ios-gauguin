+        rd(s, GSS_SE, S_IRQ_STATUS, &s->report.irq_after_s)) result = GSS_RESTORE_FAILED;
+    if ((s->report.irq_after_m & ~s->report.irq_before_m) ||
+        (s->report.irq_after_s & ~s->report.irq_before_s)) result = GSS_UNSAFE_RESTORE;
