+       !gpu->asid||gpu->asid>255||gpu->stream_match>1||gpu->s2cr!=gpu->bank||
+       (!gpu->stream_match&&gpu->slot!=0)||gpu->smr!=(gpu->stream_match?0x80000000u:0u)||gpu->sctlr!=0xc01167||
+       gpu->gpu_pages!=18||gpu->gmu_pages!=131||gpu->translations!=168||
+       gpu->ttbr0!=((plan->owner_pa+GGP_TABLE_OFFSET)|((uint64_t)gpu->asid<<48))||
+       gpu->ttbr1!=((plan->owner_pa+GGP_TABLE_OFFSET+0x3000)|((uint64_t)gpu->asid<<48))||
+       !ops->guard||!ops->read32||!ops->write32||!ops->barrier||!ops->start_gpu||
+       !ops->open_registers||!ops->read_reglist||!ops->write_reglist)return GGC_ARGUMENT;
