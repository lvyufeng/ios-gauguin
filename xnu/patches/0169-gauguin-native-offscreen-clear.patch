+static enum ggl_result copy_nc(struct ggl_context *c,enum ggl_memory mem,
+    unsigned off,unsigned words,const uint32_t *values,uint32_t *count)
+{
+    for(unsigned base=0;base<words;base+=GGL_BATCH_WORDS){
+        unsigned n=words-base;if(n>GGL_BATCH_WORDS)n=GGL_BATCH_WORDS;
+        if(!guard(c))return GGL_GUARD;
+        for(unsigned i=0;i<n;i++){
