+{
+    if(token==2)IOLockUnlock(gLock);
+}
+extern "C" uint32_t GauguinGPUSurfaceBorrow(SweetSurface *s)
+{
+    /* Caller owns a ready frame token2. No runtime transition can run while
+     * it holds gLock; retain the existing per-layer read-span observation. */
+    if(!s||s->gpuState)return 0;
+    sweet_ui_trace_record(GUT_READ_LOCK,s->id,0,0,sweet_ui_trace_clock(),0,0);
+    gTraceReader=s->id;return 3;
+}

