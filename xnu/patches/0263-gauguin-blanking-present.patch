@@ -0,0 +1,83 @@
+#ifndef GAUGUIN_BLANK351_H
+#define GAUGUIN_BLANK351_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+    SCAN351_TOTAL = 4910, SCAN351_OPEN = 2480, SCAN351_END_GUARD = 32,
+    SCAN351_MIN_LINE_NS = 3000, SCAN351_NOMINAL_LINE_NS = 3380,
+    SCAN351_COPY_NS = 6000000, SCAN351_POLL_NS = 250000,
+    SCAN351_RETRY_NS = 450000, SCAN351_ATTEMPTS = 2
+};
+
+struct scan351_position {
+    uint64_t tick;
+    uint32_t frame, line, end;
+};
+
+struct scan351_slot {
+    uint64_t attempted_at;
+    uint32_t frame, attempts;
+    bool done;
+};
+
+static inline bool
+scan351_can_copy(uint32_t line, uint32_t end)
+{
+    return line >= SCAN351_OPEN && end <= SCAN351_TOTAL && end > line &&
+        (uint64_t)(end - line) * SCAN351_MIN_LINE_NS >= SCAN351_COPY_NS;
+}
+
+static inline bool
+scan351_can_take(const struct scan351_slot *slot, const struct scan351_position *pos)
+{
+    return scan351_can_copy(pos->line, pos->end) &&
+        (!slot->attempts || slot->frame != pos->frame ||
+         (!slot->done && slot->attempts < SCAN351_ATTEMPTS));
+}
+
+static inline uint32_t
+scan351_delay_lines(const struct scan351_slot *slot, const struct scan351_position *pos)
+{
+    if (pos->line < SCAN351_OPEN)
+        return SCAN351_OPEN - pos->line;
+    return scan351_can_take(slot, pos) ? 0 : SCAN351_TOTAL - pos->line + SCAN351_OPEN;
+}
+
+static inline void
+scan351_take(struct scan351_slot *slot, const struct scan351_position *pos)
+{
+    if (!slot->attempts || slot->frame != pos->frame) {
+        slot->frame = pos->frame;
+        slot->attempts = 0;
+        slot->done = false;
+    }
+    slot->attempted_at = pos->tick;
+    ++slot->attempts;
+}
+
+/* The next frame's earliest programmed fetch can cut the blanking interval. */
+static inline uint32_t
+scan351_end(uint32_t config, uint32_t fetch, uint32_t htotal)
+{
+    uint32_t first_fetch = SCAN351_TOTAL;
+    if (config & UINT32_C(0x80000000)) {
+        if (!htotal || !fetch) return 0;
+        first_fetch = fetch / htotal;
+        if (first_fetch >= SCAN351_TOTAL) return 0;
+    }
+    if (first_fetch <= SCAN351_END_GUARD) return 0;
+    return first_fetch - SCAN351_END_GUARD;
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+bool sweet_frame351_window(void);
+bool sweet_frame351_position(struct scan351_position *out);
+#ifdef __cplusplus
+}
+#endif
+
+#endif
