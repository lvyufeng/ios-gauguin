+#ifndef GAUGUIN_GPU_SQE_ASSET_H
+#define GAUGUIN_GPU_SQE_ASSET_H
+#include <stdbool.h>
+#include <stdint.h>
+#define GSA_ASSET_BYTES 32304u
+#define GSA_HEADER_BYTES 4u
+#define GSA_CODE_BYTES (GSA_ASSET_BYTES-GSA_HEADER_BYTES)
+#define GSA_RESERVED_BYTES 32768u
+struct gsa_view {const uint8_t *data;uint64_t pa;uint32_t bytes;};
+/* Exact pinned a630_sqe.fw raw asset, including its native four-byte header.
+ * Full reserved extent, zero padding, contiguous direct-map endpoints and
+ * disjoint NVT/MDT/GMU descriptors are checked before native SHA256.
+ * Caller later copies data+4/code32300 to its owned SQE region; this view
+ * never allocates/maps, writes memory, touches GPU or authorizes execution.
+ * Output unchanged on failure. Requires the coherent boot's three old assets. */
+bool sweet_gpu_sqe_asset_view(struct gsa_view *);
+#endif
