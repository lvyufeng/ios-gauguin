@@ -0,0 +1,73 @@
+#ifndef GAUGUIN_GPU_ZAP_H
+#define GAUGUIN_GPU_ZAP_H
+#include <stdbool.h>
+#include <stdint.h>
+enum gpz_phase {GPZ_IDLE,GPZ_SEAL,GPZ_INIT,GPZ_MEM,GPZ_COPY,GPZ_AUTH,GPZ_FINAL,GPZ_DONE};
+enum gpz_result {GPZ_OK,GPZ_ARGUMENT,GPZ_ALREADY,GPZ_GUARD,GPZ_DEADLINE,
+    GPZ_OWNER,GPZ_IO,GPZ_CONTINUATION_LIMIT,GPZ_BUSY_LIMIT,GPZ_TRANSPORT,GPZ_SERVICE};
+/* LIVE permits the board's pre-transaction clock/route/GPU checks. SECURE
+ * is the tight normal-SCM path: CPU/context, time, WDT and owner metadata
+ * only, no GPU/secure-buffer access or diagnostic IO. LATE is after AUTH
+ * returned full64 success: no secure-buffer or GPU register access. */
+enum gpz_scope {GPZ_LIVE,GPZ_SECURE,GPZ_LATE};
+enum gpz_owner_action {GPZO_SEAL,GPZO_INIT_ENTER,GPZO_INIT_ACCEPT,GPZO_MEM_ACCEPT,GPZO_AUTH_ACCEPT};
+enum gpz_event {GPZE_BEFORE,GPZE_RAW,GPZE_TERMINAL};
+#define GPZ_CODE_BYTES 1984u
+#define GPZ_MEM_BYTES 4096u
+#define GPZ_CONTINUATIONS 8u
+#define GPZ_FRESH_ATTEMPTS 68u
+struct gpz_registers {uint64_t x[7];};
+struct gpz_transaction {
+    struct gpz_registers returned;
+    uint32_t has_returned,smc_calls,fresh_attempts,continuations;
+};
+struct gpz_copy {uint32_t written,checked;};
+struct gpz_receipt {
+    uint64_t owner_pa;
+    struct gpz_transaction transaction[3]; /* INIT, MEM, AUTH */
+    struct gpz_copy copy;
+    uint32_t phase,result,owner_sealed,complete,requests_retained;
+};
+struct gpz_plan {uint64_t owner_pa;};
+struct gpz_ops {
+    void *cookie;
+    uint64_t (*now)(void *);
+    bool (*deadline)(void *,unsigned,uint64_t *);
+    bool (*guard)(void *,enum gpz_phase,enum gpz_scope,unsigned);
+    /* PA is a comparison key only. The provider must derive destination and
+     * authority from its own sealed owner, never install a caller-chosen PA. */
+    bool (*owner)(void *,enum gpz_owner_action,uint64_t);
+    bool (*copy)(void *,struct gpz_copy *);
+    bool (*barrier)(void *);
+    void (*invoke)(void *,struct gpz_registers *);
+    bool (*delay_ms)(void *,unsigned);
+    void (*record)(void *,enum gpz_event,const struct gpz_receipt *);
+    void (*quarantine)(void *);
+};
+struct gpz_context {
+    uint32_t state,phase,pending_raw,last_transaction;
+    uint64_t entry,last_now,total_end,phase_end;
+    struct gpz_ops ops;
+    struct gpz_receipt work;
+};
+/* Fixed signed-PAS13 loader transaction engine; it has no SMC instruction,
+ * memory mapping or mutable destination pointer. The live provider must seal
+ * this boot's completed CP/core/FW plus actual claimed owner, immutable b02
+ * and retained resources. Owner callbacks enforce private phase authority.
+ * COPY performs exactly1984 bytes with readback under bounded live guards;
+ * it never clears a tail, reloads MDT or touches the region after AUTH.
+ *
+ * Native order: INIT6860 -> MEM_SETUP4096 -> b02 -> AUTH. This diagnostic uses
+ * 20s total,5s per SCM transaction,2s copy and1s seal/final. Fresh10s first-
+ * call/3s later watchdog budgets,68 BUSY attempts and8 total continuations per
+ * transaction are policy, not native promises or secure-hang containment.
+ * Continue only for FULL64 x0==1, preserving all seven returned registers;
+ * no log/sleep/fresh frame inside a continuation chain. BUSY is signed low32
+ * -12 and retries fresh after30ms. Success needs FULL64 x0/x1 zero.
+ * Failure is permanent, with shared quarantine before deferred failure raw/
+ * terminal records. No cleanup or restarted stage; output untouched on any
+ * refusal/failure. Success is signed-load acceptance only, not rendering/Metal.
+ * Linking alone never dispatches this engine; a live board adapter is needed. */
+enum gpz_result gpz_start_once(struct gpz_context *,const struct gpz_ops *,
+    const struct gpz_plan *,struct gpz_receipt *);
+#endif /* GAUGUIN_GPU_ZAP_H */
