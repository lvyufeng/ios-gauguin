diff --git a/bsd/dev/gauguin_completion_sample405.h b/bsd/dev/gauguin_completion_sample405.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_completion_sample405.h
@@ -0,0 +1,45 @@
+#ifndef GAUGUIN_COMPLETION_SAMPLE_405_H
+#define GAUGUIN_COMPLETION_SAMPLE_405_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct eop405_state {
+    uint64_t ticket, last_pending_begin, last_read_end;
+    uint32_t fence;
+    bool reported;
+};
+
+struct eop405_bracket {
+    uint64_t earliest_tick, latest_tick;
+};
+
+/* The word is a GPU end-of-pipe observation only. The caller must have
+ * checked the same issued token and permanent mapping on both sides. */
+static inline bool
+eop405_observe(struct eop405_state *s, uint64_t ticket, uint32_t fence,
+    uint32_t observed, uint64_t begin, uint64_t end, struct eop405_bracket *out)
+{
+    if (!(ticket>>32) || !(uint32_t)ticket || !fence || !begin || end < begin ||
+        (observed != fence && observed != fence - 1u)) return false;
+    if (ticket != s->ticket) {
+        if (fence <= s->fence) return false;
+        *s = (struct eop405_state){ticket, 0, 0, fence, false};
+    }
+    if (fence != s->fence || begin < s->last_read_end || s->reported) return false;
+    s->last_read_end = end;
+    if (observed != fence) {
+        s->last_pending_begin = begin;
+        // Keep the lower bound even when guarded completion clears the
+        // issued token before the first matching raw sample.
+        *out = (struct eop405_bracket){begin, 0};
+        return true;
+    }
+    // A pending load occurred somewhere in its interval. Its begin is
+    // the conservative lower bound, even if EOP changed before its end.
+    *out = (struct eop405_bracket){s->last_pending_begin, end};
+    s->reported = true;
+    return true;
+}
+
+#endif
diff --git a/bsd/dev/gauguin_cpufreq402.h b/bsd/dev/gauguin_cpufreq402.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_cpufreq402.h
@@ -0,0 +1,177 @@
+/* The Lagoon performance cluster uses firmware-owned voltage/frequency rows.
+ * The caller owns the device mapping and supplies ordered reads and writes. */
+#ifndef GAUGUIN_CPUFREQ402_H
+#define GAUGUIN_CPUFREQ402_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+    CPU402_ENABLE = 0x0,
+    CPU402_FREQ_LUT = 0x110,
+    CPU402_VOLT_LUT = 0x114,
+    CPU402_LUT_STRIDE = 32,
+    CPU402_LUT_ENTRIES = 40,
+    CPU402_PERF_STATE = 0x920,
+    CPU402_CYCLES = 0x9c0,
+    CPU402_TARGET_L = 73, /* 1,401,600 kHz at the stock 19.2 MHz XO. */
+    CPU402_TEMP_READY = 0xe4,
+    CPU402_TEMP_STATUS = 0xa0,
+    CPU402_TEMP_MIN = 50,
+    CPU402_TEMP_LIMIT = 650, /* Deci-Celsius. */
+    CPU402_LAST_CONTACT = 14,
+    CPU402_CONTACT_BITS = 4,
+};
+
+#define CPU402_FACTORY_ALTERNATE UINT32_C(0x0002000f)
+
+typedef uint32_t (*cpu402_read_t)(void *, unsigned);
+typedef void (*cpu402_write_t)(void *, unsigned, uint32_t);
+
+struct cpu402_point {
+    uint32_t enable, original, selected, original_row, target_row;
+    uint32_t original_volt, target_volt;
+};
+
+static inline uint32_t
+cpu402_row(cpu402_read_t read, void *cookie, unsigned table, unsigned row)
+{
+    return read(cookie, table + row * CPU402_LUT_STRIDE);
+}
+
+static inline bool
+cpu402_find_point(cpu402_read_t read, void *cookie, struct cpu402_point *out)
+{
+    /* Same-phone Android recovery policy6, excluding its alternate source.
+     * The special last row can differ in core count and marks the end. */
+    static const uint8_t stock[] = {41, 51, 54, 65, 73, 81, 92, 99, 108, 111, 115};
+    const uint32_t enable = read(cookie, CPU402_ENABLE);
+    const uint32_t index = read(cookie, CPU402_PERF_STATE);
+    const uint32_t first = cpu402_row(read, cookie, CPU402_FREQ_LUT, 0);
+    if (enable == UINT32_MAX || !(enable & 1u) || index != 0 ||
+        first != CPU402_FACTORY_ALTERNATE) {
+        return false;
+    }
+
+    uint32_t previous = 0, selected = 0, target = 0;
+    unsigned count = 0;
+    bool ended = false;
+    for (unsigned row = 1; row < CPU402_LUT_ENTRIES; ++row) {
+        const uint32_t raw = cpu402_row(read, cookie, CPU402_FREQ_LUT, row);
+        const uint32_t pll = raw >> 30, cores = (raw >> 16) & 7u, l = raw & 0xffu;
+        if (raw == UINT32_MAX || !pll || !l) {
+            return false;
+        }
+        if (l == previous) {
+            ended = true;
+            break;
+        }
+        previous = l;
+        if (cores < 1 || cores > 2 || count >= sizeof(stock) || l != stock[count++]) {
+            return false;
+        }
+        if (l == CPU402_TARGET_L && cores == 2) {
+            selected = row;
+            target = raw;
+        }
+    }
+    if (!ended || count != sizeof(stock) || !selected) {
+        return false;
+    }
+
+    const uint32_t old_volt = cpu402_row(read, cookie, CPU402_VOLT_LUT, index);
+    const uint32_t new_volt = cpu402_row(read, cookie, CPU402_VOLT_LUT, selected);
+    if (old_volt == UINT32_MAX || new_volt == UINT32_MAX ||
+        !(old_volt & 0xfffu) || !(new_volt & 0xfffu) ||
+        read(cookie, CPU402_ENABLE) != enable || read(cookie, CPU402_PERF_STATE) != index) {
+        return false;
+    }
+    *out = (struct cpu402_point){enable, index, selected, first, target, old_volt, new_volt};
+    return true;
+}
+
+static inline bool
+cpu402_matches(cpu402_read_t read, void *cookie, const struct cpu402_point *p)
+{
+    return read(cookie, CPU402_ENABLE) == p->enable &&
+        cpu402_row(read, cookie, CPU402_FREQ_LUT, p->original) == p->original_row &&
+        cpu402_row(read, cookie, CPU402_VOLT_LUT, p->original) == p->original_volt &&
+        cpu402_row(read, cookie, CPU402_FREQ_LUT, p->selected) == p->target_row &&
+        cpu402_row(read, cookie, CPU402_VOLT_LUT, p->selected) == p->target_volt;
+}
+
+static inline bool
+cpu402_select(cpu402_read_t read, cpu402_write_t write, void *cookie,
+    const struct cpu402_point *point, bool *restore_pending)
+{
+    if (*restore_pending || !cpu402_matches(read, cookie, point) ||
+        read(cookie, CPU402_PERF_STATE) != point->original) {
+        return false;
+    }
+    /* Retain the preimage before trying the ordered write. A failed readback
+     * can still represent a write that reached the controller. */
+    *restore_pending = true;
+    write(cookie, CPU402_PERF_STATE, point->selected);
+    return read(cookie, CPU402_PERF_STATE) == point->selected;
+}
+
+static inline bool
+cpu402_restore(cpu402_read_t read, cpu402_write_t write, void *cookie,
+    const struct cpu402_point *point, bool *restore_pending)
+{
+    if (!*restore_pending) {
+        return true;
+    }
+    if (!cpu402_matches(read, cookie, point)) {
+        return false;
+    }
+    const uint32_t current = read(cookie, CPU402_PERF_STATE);
+    if (current == point->selected) {
+        write(cookie, CPU402_PERF_STATE, point->original);
+    } else if (current != point->original) {
+        return false;
+    }
+    if (read(cookie, CPU402_PERF_STATE) != point->original) {
+        return false;
+    }
+    *restore_pending = false;
+    return true;
+}
+
+static inline bool
+cpu402_temperature(cpu402_read_t read, void *cookie, int *hottest)
+{
+    const uint32_t ready = read(cookie, CPU402_TEMP_READY);
+    if (ready == UINT32_MAX || !(ready & (1u << 3))) {
+        return false;
+    }
+    int high = -1;
+    for (unsigned id = 9; id <= 12; ++id) {
+        const unsigned offset = CPU402_TEMP_STATUS + id * 4;
+        uint32_t status = read(cookie, offset);
+        /* The Android TSENS 2.x driver checks validity on up to three
+         * reads. Every sensor here still requires a valid conversion. */
+        for (unsigned retry = 0; retry < 2 && status != UINT32_MAX && !(status & (1u << 21)); ++retry)
+            status = read(cookie, offset);
+        const int deci = status & 0x7ffu;
+        if (status == UINT32_MAX || !(status & (1u << 21)) ||
+            (status & ((1u << 19) | (1u << 11))) || deci < CPU402_TEMP_MIN) {
+            return false;
+        }
+        if (deci > high) high = deci;
+    }
+    *hottest = high;
+    const uint32_t last_ready = read(cookie, CPU402_TEMP_READY);
+    return high < CPU402_TEMP_LIMIT && last_ready != UINT32_MAX && (last_ready & (1u << 3));
+}
+
+static inline unsigned
+cpu402_contact(uint64_t packed, uint64_t now, uint64_t lease)
+{
+    const unsigned contact = packed & ((1u << CPU402_CONTACT_BITS) - 1u);
+    const uint64_t tick = packed >> CPU402_CONTACT_BITS;
+    return contact <= CPU402_LAST_CONTACT && tick && tick <= now && now - tick <= lease ?
+        contact : 0;
+}
+
+#endif
diff --git a/bsd/dev/gauguin_deadlines419.h b/bsd/dev/gauguin_deadlines419.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_deadlines419.h
@@ -0,0 +1,34 @@
+#ifndef GAUGUIN_DEADLINES419_H
+#define GAUGUIN_DEADLINES419_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+    F419_GPU = 64, F419_PROMOTE, F419_COPY, F419_DISPATCH, F425_RAW = 69,
+    F419_CAPACITY = 12288, F419_MAX_WIRE_BYTES = 786432
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+uint64_t sweet_frame419_clock(void);
+bool sweet_frame425_observing(void);
+void sweet_frame419_record(uint32_t kind, uint64_t id, uint32_t lane,
+    uint32_t version, uint64_t a, uint64_t b, uint64_t c);
+#ifdef __cplusplus
+}
+#endif
+
+/* Existing writer row field, without adding a per-submit record. The issue
+ * operation is bracketed around its native call. Its return is not the
+ * earliest possible time at which the GPU could have seen the submit. */
+static inline uint64_t
+f425_issue_bounds(uint64_t observed, uint64_t before, uint64_t after)
+{
+    if (!before || before > after || after > observed || observed - before > UINT32_MAX)
+        return 0;
+    return ((observed - before) << 32) | (after - before);
+}
+
+#endif
diff --git a/bsd/dev/gauguin_display_previous404.h b/bsd/dev/gauguin_display_previous404.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_display_previous404.h
@@ -0,0 +1,19 @@
+#ifndef GAUGUIN_DISPLAY_PREVIOUS_404_H
+#define GAUGUIN_DISPLAY_PREVIOUS_404_H
+
+/* Included beside the exact busy-producer record. The display publication
+ * lock serializes both paths. Only one generation can claim this version. */
+static inline bool
+display404_previous_allowed(const struct display401_writer *writer, uint32_t surface, uint32_t version)
+{
+    return !writer->ticket || writer->surface!=surface || writer->version!=version;
+}
+
+static inline void
+display404_previous_claimed(struct display401_writer *writer, uint32_t surface, uint32_t version)
+{
+    if (writer->cookie && !writer->ticket && writer->surface==surface && writer->version==version)
+        *writer = (struct display401_writer){0};
+}
+
+#endif
diff --git a/bsd/dev/gauguin_display_writer401.h b/bsd/dev/gauguin_display_writer401.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_display_writer401.h
@@ -0,0 +1,59 @@
+/* The existing display publication lock serializes these value-only receipts.
+ * The GPU retains every submitted BO through its normal completion path. */
+#ifndef GAUGUIN_DISPLAY_WRITER_401_H
+#define GAUGUIN_DISPLAY_WRITER_401_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct display401_writer {
+    uint32_t cookie, surface, version;
+    uint64_t ticket;
+};
+
+/* In the serialized GPU path, publication follows exact BO WRITE escrow.
+ * A submission already bound to a normal display generation stays there. */
+static inline bool
+display401_publish(struct display401_writer *writer, uint32_t cookie,
+    uint32_t surface, uint32_t version, uint64_t existing_ticket)
+{
+    if (writer->cookie || existing_ticket || !cookie || !surface || !version || (version & 3u))
+        return false;
+    *writer = (struct display401_writer){cookie, surface, version, 0};
+    return true;
+}
+
+static inline bool
+display401_matches(const struct display401_writer *writer, uint32_t cookie,
+    uint32_t surface, uint32_t version)
+{
+    return cookie && cookie==writer->cookie && surface==writer->surface &&
+        version==writer->version && !writer->ticket;
+}
+
+/* The caller independently checks the live busy state and that admitting
+ * the ticket cannot conflict with an already-retained display writer. */
+static inline bool
+display401_claim(struct display401_writer *writer, uint32_t cookie,
+    uint64_t ticket, uint32_t version)
+{
+    if (!(ticket>>32) || !display401_matches(writer,cookie,(uint32_t)ticket,version))
+        return false;
+    writer->ticket = ticket;
+    return true;
+}
+
+/* Seal under the publication lock immediately before native issue. After
+ * sealing, the ordinary ordered fence and cache path owns the returned ticket. */
+static inline uint64_t
+display401_seal(struct display401_writer *writer, uint32_t cookie,
+    uint32_t surface, uint32_t version)
+{
+    if (!cookie || cookie!=writer->cookie || surface!=writer->surface ||
+        version!=writer->version) return 0;
+    const uint64_t ticket = writer->ticket;
+    *writer = (struct display401_writer){0};
+    return ticket;
+}
+
+#endif
diff --git a/bsd/dev/gauguin_frame385.h b/bsd/dev/gauguin_frame385.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_frame385.h
@@ -0,0 +1,12 @@
+#ifndef GAUGUIN_FRAME385_H
+#define GAUGUIN_FRAME385_H
+
+#include <stdint.h>
+
+void sweet_ca385_arm(uint64_t source, uint64_t receiver);
+void sweet_ca385_swipe(unsigned number, uint64_t start);
+uint64_t sweet_ca385_send_frame(uint64_t tick, uint32_t id);
+void sweet_ca385_send(uint64_t tick, uint16_t serial, uint32_t id, uint64_t frame);
+void sweet_ca385_receive(uint64_t address, uint32_t size, uint32_t id, uint16_t serial);
+
+#endif
diff --git a/bsd/dev/gauguin_frame385_observer.h b/bsd/dev/gauguin_frame385_observer.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_frame385_observer.h
@@ -0,0 +1,331 @@
+/* Included by kdebug.c. Observe the two identified tasks' native tracepoints
+ * and transport. All reads use copyin from the current task. No user stores,
+ * debug-register changes, or changes to the original scheduling paths. */
+#include <mach/arm/thread_status.h>
+#include "gauguin_frame385.h"
+
+enum {
+	F385_SOURCE = 1, F385_ENCODED, F385_SEND, F385_RECEIVE, F385_COMMAND,
+	F385_APPLY, F385_BEFORE_INCLUDE, F385_AFTER_INCLUDE, F385_SWAP,
+	F385_GESTURE_CAP = 3072, F385_RECEIPTS = 256,
+	F385_MAX_STACK = 12, F385_MAX_MEMBERS = 24, F385_SWIPES = 13
+};
+
+struct f385_row {
+	uint64_t tick, thread, a, b, c, d;
+	uint16_t kind, stroke;
+};
+
+/* A later stroke cannot consume the earlier stroke's retention. */
+static struct f385_gesture {
+	uint64_t begin, until;
+	unsigned count;
+	struct f385_row rows[F385_GESTURE_CAP];
+} f385_gestures[F385_SWIPES];
+static unsigned f385_windows;
+static uint64_t f385_source, f385_receiver;
+static uint64_t f385_source_slide, f385_receiver_slide;
+/* Slot payload is value-only. The bounded table tracks the last put at an
+ * address for this stroke. A collision can remove a witness. */
+static struct f385_delivery {
+	uint64_t address, time, tid;
+	uint32_t size, id;
+	uint16_t serial, stroke;
+} f385_receipts[F385_RECEIPTS];
+static bool f385_receipts_busy;
+static unsigned f385_dropped_puts;
+
+extern struct arm_saved_state *get_user_regs(thread_t);
+
+static uint64_t
+f385_identity(task_t task)
+{
+	const audit_token_t *token = task_get_audit_token(task);
+	return ((uint64_t)token->val[7] << 32) | token->val[5];
+}
+
+void
+sweet_ca385_arm(uint64_t source, uint64_t receiver)
+{
+	if (f374_start && source && receiver && source != receiver && !f385_source) {
+		f385_source = source;
+		__atomic_store_n(&f385_receiver, receiver, __ATOMIC_RELEASE);
+	}
+}
+
+void
+sweet_ca385_swipe(unsigned number, uint64_t start)
+{
+	if (!__atomic_load_n(&f385_receiver, __ATOMIC_ACQUIRE) ||
+	    number != __atomic_load_n(&f385_windows, __ATOMIC_RELAXED) + 1 ||
+	    number > F385_SWIPES || start < f374_start || start >= f374_end) return;
+	uint64_t duration = 0;
+	nanoseconds_to_absolutetime(UINT64_C(650000000), &duration);
+	f385_gestures[number-1].begin = start;
+	f385_gestures[number-1].until = start + duration;
+	__atomic_store_n(&f385_windows, number, __ATOMIC_RELEASE);
+}
+
+static unsigned
+f385_stroke(uint64_t tick)
+{
+	const unsigned lane = __atomic_load_n(&f385_windows, __ATOMIC_ACQUIRE);
+	if (!lane) return 0;
+	const struct f385_gesture *g = &f385_gestures[lane-1];
+	if (tick < g->begin || tick >= g->until || tick >= f374_end) return 0;
+	return lane;
+}
+
+static bool
+f385_read(uint64_t base, unsigned offset, void *value, size_t count)
+{
+	return base && base <= UINT64_MAX - offset && copyin(base + offset, value, count) == 0;
+}
+
+static uint32_t
+f385_pid(uint64_t context)
+{
+	uint32_t pid = 0;
+	return f385_read(context, 0xbc, &pid, sizeof(pid)) ? pid : 0;
+}
+
+static void
+f385_record(unsigned stroke, unsigned kind, uint64_t tick, uint64_t tid,
+    uint64_t a, uint64_t b, uint64_t c, uint64_t d)
+{
+	if (stroke && tick >= f374_start && tick < f374_end) {
+		struct f385_gesture *g = &f385_gestures[stroke-1];
+		unsigned i = __atomic_fetch_add(&g->count, 1, __ATOMIC_RELAXED);
+		if (i < F385_GESTURE_CAP) {
+			g->rows[i] = (struct f385_row){tick, tid, a, b, c, d, kind, stroke};
+		}
+	}
+}
+
+static bool
+f385_cache(uint64_t raw_slide, uint64_t *published)
+{
+	const uint64_t prior = __atomic_load_n(published, __ATOMIC_ACQUIRE);
+	/* Store slide+1 so an unshifted cache can be qualified too. */
+	if (prior) return prior == raw_slide + 1;
+	if (raw_slide & 0x3fff || raw_slide >= UINT64_C(0x100000000)) return false;
+	const uint8_t uuid[16] = {0x9e,0x40,0xb2,0xeb,0x26,0x0c,0x3a,0xf1,
+		0xae,0x45,0xa1,0xa5,0x51,0xa8,0xc1,0xb9};
+	uint8_t actual[16];
+	if (!f385_read(UINT64_C(0x188284f30) + raw_slide, 0, actual, sizeof(actual)) ||
+	    memcmp(uuid, actual, sizeof(uuid))) return false;
+	uint64_t expected = 0;
+	return __atomic_compare_exchange_n(published, &expected, raw_slide + 1,
+	           false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE) || expected == raw_slide + 1;
+}
+
+static bool
+f385_native_code(uint32_t code)
+{
+	switch (code) {
+	case 0x31ca01dd: case 0x31ca01de:
+	case 0x31ca0009: case 0x31ca000a:
+	case 0x31ca027d: case 0x31ca027e: case 0x31ca0084:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool
+f385_packet(uint32_t id)
+{
+	return id >= 40002 && id <= 40005;
+}
+
+/* This stack read runs before the port lock. The QuartzCore return PC marks
+ * the direct send-message call in the selected context commit implementation. */
+uint64_t
+sweet_ca385_send_frame(uint64_t tick, uint32_t id)
+{
+	if (!tick || !f385_packet(id) || !f385_stroke(tick) ||
+	    f385_identity(current_task()) != f385_source) return 0;
+	uint64_t slide = __atomic_load_n(&f385_source_slide, __ATOMIC_ACQUIRE);
+	struct arm_saved_state *ss = get_user_regs(current_thread());
+	if (!slide || !ss || !is_saved_state64(ss)) return 0;
+	uint64_t fp = get_saved_state_fp(ss);
+	const uint64_t sp = get_saved_state_sp(ss);
+	for (unsigned i = 0; i < F385_MAX_STACK; ++i) {
+		uint64_t frame[2];
+		if (fp < sp || fp - sp > 0x20000 || (fp & 15) ||
+		    !f385_read(fp, 0, &frame, sizeof(frame)) ||
+		    frame[0] <= fp || frame[0] - sp > 0x20000 || (frame[0] & 15)) break;
+		if (frame[1] == UINT64_C(0x1882b29fc) + slide - 1) return frame[0];
+		fp = frame[0];
+	}
+	return 0;
+}
+
+void
+sweet_ca385_send(uint64_t tick, uint16_t serial, uint32_t id, uint64_t frame)
+{
+	const unsigned stroke = f385_stroke(tick);
+	if (!stroke || !frame || !serial || !f385_packet(id) || !f375_enter()) return;
+	f385_record(stroke, F385_SEND, tick, thread_tid(current_thread()), serial, frame, id, 0);
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+}
+
+static struct f385_delivery *
+f385_delivery_for(uint64_t address)
+{
+	return &f385_receipts[((address >> 4) ^ (address >> 12)) & (F385_RECEIPTS - 1)];
+}
+
+void
+sweet_ca385_receive(uint64_t address, uint32_t size, uint32_t id, uint16_t serial)
+{
+	const uint64_t receiver = __atomic_load_n(&f385_receiver, __ATOMIC_ACQUIRE);
+	if (!receiver || !address || f385_identity(current_task()) != receiver) return;
+	const uint64_t tick = mach_absolute_time();
+	const unsigned stroke = f385_stroke(tick);
+	if (!stroke || !f375_enter()) return;
+	if (__atomic_test_and_set(&f385_receipts_busy, __ATOMIC_ACQUIRE)) {
+		__atomic_fetch_add(&f385_dropped_puts, 1, __ATOMIC_RELAXED);
+	} else {
+		struct f385_delivery *slot = f385_delivery_for(address);
+		*slot = (struct f385_delivery){address, tick, thread_tid(current_thread()),
+			size, id, size >= 24 && f385_packet(id) ? serial : 0, stroke};
+		__atomic_clear(&f385_receipts_busy, __ATOMIC_RELEASE);
+	}
+	__atomic_fetch_sub(&f374_gate, 1, __ATOMIC_RELEASE);
+}
+
+static bool
+f385_find_receive(unsigned stroke, uint64_t address, struct f385_delivery *delivery)
+{
+	if (__atomic_test_and_set(&f385_receipts_busy, __ATOMIC_ACQUIRE)) return false;
+	const struct f385_delivery *slot = f385_delivery_for(address);
+	*delivery = *slot;
+	__atomic_clear(&f385_receipts_busy, __ATOMIC_RELEASE);
+	uint32_t actual_size, actual_id;
+	return delivery->address == address && delivery->stroke == stroke && delivery->serial &&
+	       f385_read(address, 4, &actual_size, sizeof(actual_size)) &&
+	       f385_read(address, 20, &actual_id, sizeof(actual_id)) &&
+	       actual_size >= 24 && actual_size <= delivery->size && actual_id == delivery->id;
+}
+
+static bool
+f385_member(uint64_t update, uint64_t context, uint64_t *found)
+{
+	uint64_t node;
+	*found = 0;
+	if (!f385_read(update, 0x128, &node, sizeof(node))) return false;
+	for (unsigned i = 0; node && i < F385_MAX_MEMBERS; ++i) {
+		struct {
+			uint64_t next, context, name;
+			uint32_t seed, flags;
+		} member;
+		if (!f385_read(node, 0, &member, sizeof(member)) || member.next == node) return false;
+		if (member.context == context) {
+			*found = (UINT64_C(1) << 32) | member.seed;
+			return true;
+		}
+		node = member.next;
+	}
+	return !node;
+}
+
+#include "gauguin_frame390_membership.h"
+#include "gauguin_frame390_transactions.h"
+
+static void
+f385_kdebug(uint64_t identity, const struct kdebug_trace64_args *uap, uint64_t tick)
+{
+	const unsigned stroke = f385_stroke(tick);
+	const uint64_t receiver = __atomic_load_n(&f385_receiver, __ATOMIC_ACQUIRE);
+	if (!stroke || !receiver || !f385_native_code(uap->code) ||
+	    (identity != receiver && identity != f385_source)) return;
+	const bool before = uap->code == 0x31ca027d, after_include = uap->code == 0x31ca027e;
+	struct f390_lane *lane = identity == receiver && (before || after_include) ? &f390_lanes[stroke-1] : NULL;
+	if (lane) __atomic_fetch_add(&lane->raw[after_include], 1, __ATOMIC_RELAXED);
+	struct arm_saved_state *ss = get_user_regs(current_thread());
+	if (!ss || !is_saved_state64(ss)) return;
+	const uint64_t base_pc = UINT64_C(0x1c261ec58);
+	const uint64_t pc = get_saved_state_pc(ss);
+	if (pc < base_pc) return;
+	const uint64_t slide = pc - base_pc;
+	const bool source = identity == f385_source;
+	if (!f385_cache(slide, source ? &f385_source_slide : &f385_receiver_slide)) return;
+	const uint64_t lr = get_saved_state_lr(ss);
+	if (lr < slide) return;
+	const uint64_t site = lr - slide;
+	const uint64_t tid = thread_tid(current_thread());
+	uint64_t address, member;
+	uint32_t context_id, seed;
+	if (source) {
+		const uint64_t fp = get_saved_state_fp(ss);
+		if (site == UINT64_C(0x1882b1c10) && uap->code == 0x31ca01dd && uap->arg1 <= UINT32_MAX) {
+			f385_record(stroke, F385_SOURCE, tick, tid, fp, uap->arg1, 0, 0);
+		} else if (site == UINT64_C(0x1882b27f4) && uap->code == 0x31ca01de &&
+		    f385_read(get_saved_state_reg(ss, 19), 0x1e0, &address, sizeof(address)) &&
+		    f385_read(address, 4, &context_id, sizeof(context_id))) {
+			f385_record(stroke, F385_ENCODED, tick, tid, fp, context_id, 0, 0);
+		}
+		return;
+	}
+	if ((site == UINT64_C(0x18846f440) && uap->code == 0x31ca0009) ||
+	    (site == UINT64_C(0x1884703a8) && uap->code == 0x31ca000a)) {
+		const bool apply = uap->code == 0x31ca000a;
+		const uint64_t command = get_saved_state_reg(ss, 27);
+		const uint64_t context = get_saved_state_reg(ss, 24);
+		struct f385_delivery receive;
+		if (!f385_read(command, 0x10, &address, sizeof(address)) ||
+		    !f385_find_receive(stroke, address, &receive) ||
+		    !f385_read(context, 0x10, &context_id, sizeof(context_id)) ||
+		    !context_id || context_id != (apply ? uap->arg2 : uap->arg1) ||
+		    !f385_read(context, 0x38, &seed, sizeof(seed))) return;
+		if (!apply) {
+			f385_record(stroke, F385_RECEIVE, receive.time, receive.tid,
+			    address, receive.serial, receive.id, receive.size);
+		} else if (uap->arg4 != (uint32_t)f385_source) {
+			return;
+		}
+		f385_record(stroke, apply ? F385_APPLY : F385_COMMAND, tick, tid, command,
+		    receive.serial, context, ((uint64_t)context_id << 32) | seed);
+		return;
+	}
+	if ((site == UINT64_C(0x1882fc5cc) && uap->code == 0x31ca027d) ||
+	    (site == UINT64_C(0x1882fc858) && uap->code == 0x31ca027e)) {
+		const bool after = uap->code == 0x31ca027e;
+		__atomic_fetch_add(&lane->site[after], 1, __ATOMIC_RELAXED);
+		const uint64_t context = get_saved_state_reg(ss, 21);
+		const uint64_t update = get_saved_state_reg(ss, 22);
+		if (f385_pid(context) != (uint32_t)f385_source ||
+		    !f385_read(context, 0x10, &context_id, sizeof(context_id)) ||
+		    !context_id || (!after && uap->arg1 != context_id) ||
+		    !f385_read(update, 0xe0, &seed, sizeof(seed)) ||
+		    !f385_member(update, context, &member)) return;
+		__atomic_fetch_add(&lane->read[after], 1, __ATOMIC_RELAXED);
+		f385_record(stroke, after ? F385_AFTER_INCLUDE : F385_BEFORE_INCLUDE, tick, tid,
+		    update, context, ((uint64_t)seed << 32) | context_id, member);
+		return;
+	}
+	if (uap->code != 0x31ca0084 || !uap->arg1 || uap->arg1 > UINT32_MAX || uap->arg4 > UINT32_MAX) return;
+	switch (site) {
+	case UINT64_C(0x1882d166c): address = get_saved_state_reg(ss, 25); break;
+	case UINT64_C(0x1882d2508):
+		if (!f385_read(get_saved_state_sp(ss), 0x60, &address, sizeof(address))) return;
+		break;
+	case UINT64_C(0x18852c79c): case UINT64_C(0x18852c7f0): case UINT64_C(0x18852c870):
+	case UINT64_C(0x18852c8c0): case UINT64_C(0x18852cba4): case UINT64_C(0x18852ccf4):
+		address = get_saved_state_reg(ss, 23);
+		break;
+	default: return;
+	}
+	if (f385_read(address, 0xe0, &seed, sizeof(seed)) && seed == uap->arg4) {
+		f390_swap(stroke, tick, tid, slide, address, (uint32_t)uap->arg1, seed);
+		f385_record(stroke, F385_SWAP, tick, tid, address, uap->arg1, seed, 0);
+	}
+}
+
+static void
+f385_drain(void)
+{
+	f390_drain();
+	f393_drain_transactions();
+}
diff --git a/bsd/dev/gauguin_frame390_membership.h b/bsd/dev/gauguin_frame390_membership.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_frame390_membership.h
@@ -0,0 +1,115 @@
+/* Included after the verified CA delivery and address helpers. */
+enum {
+	F390_CAP = 48, F390_WIRE = 40, F390_BLOCK = 16,
+	F390_ABSENT = 0, F390_PRESENT, F390_AMBIGUOUS, F390_INCOMPLETE
+};
+
+struct f390_snapshot {
+	uint64_t tick, thread, context, update;
+	uint32_t swap, seed, id, version;
+	uint8_t member, gate;
+};
+
+static struct f390_lane {
+	struct f390_snapshot rows[F390_CAP];
+	unsigned count;
+	unsigned raw[2], site[2], read[2];
+} f390_lanes[F385_SWIPES];
+
+struct f393_member {
+    uint64_t context;
+    uint32_t id, version;
+};
+
+struct f393_members {
+    struct f393_member entries[F385_MAX_MEMBERS];
+    unsigned count;
+};
+static struct f393_members f393_versions[F385_SWIPES][F390_CAP];
+
+static void
+f390_swap(unsigned stroke, uint64_t tick, uint64_t thread, uint64_t slide,
+    uint64_t update, uint32_t swap, uint32_t seed)
+{
+	struct f390_lane *lane = &f390_lanes[stroke-1];
+	const unsigned index = __atomic_fetch_add(&lane->count, 1, __ATOMIC_RELAXED);
+	if (index >= F390_CAP) return;
+	typeof(lane->rows[0]) *row = &lane->rows[index];
+	row->tick = tick;
+	row->thread = thread;
+	row->update = update;
+	row->swap = swap;
+	row->seed = seed;
+	uint8_t gate = 0;
+	row->gate = f385_read(UINT64_C(0x1e1df7755) + slide, 0, &gate, sizeof(gate)) ? !!gate : 2;
+	row->member = F390_INCOMPLETE;
+	uint64_t node;
+	if (!f385_read(update, 0x128, &node, sizeof(node))) return;
+	struct f393_members *versions = &f393_versions[stroke-1][index];
+	unsigned member_count = 0;
+	for (unsigned i = 0; node && i < F385_MAX_MEMBERS; ++i) {
+		struct {
+			uint64_t next, context, name;
+			uint32_t seed, flags;
+		} receipt;
+		uint32_t pid, next_id;
+		if (!f385_read(node, 0, &receipt, sizeof(receipt)) || receipt.next == node ||
+		    !f385_read(receipt.context, 0xbc, &pid, sizeof(pid))) return;
+		if (pid == (uint32_t)f385_source) {
+			if (!f385_read(receipt.context, 0x10, &next_id, sizeof(next_id)) || !next_id) return;
+			const struct f393_member value = {receipt.context, next_id, receipt.seed};
+			unsigned existing = 0;
+			while (existing < member_count) {
+				const struct f393_member *other = &versions->entries[existing];
+				if (other->context == value.context && other->id == value.id && other->version == value.version) break;
+				++existing;
+			}
+			if (existing == member_count) versions->entries[member_count++] = value;
+		}
+		node = receipt.next;
+	}
+	if (node) return;
+	versions->count = member_count;
+	if (member_count > 1) {
+		row->member = F390_AMBIGUOUS;
+	} else if (member_count == 1) {
+		row->member = F390_PRESENT;
+		row->context = versions->entries[0].context;
+		row->id = versions->entries[0].id;
+		row->version = versions->entries[0].version;
+	} else {
+		row->member = F390_ABSENT;
+	}
+}
+
+static void
+f390_drain(void)
+{
+	uint8_t packed[F390_BLOCK * F390_WIRE];
+	char encoded[4 * ((sizeof(packed) + 2) / 3) + 1];
+	char line[sizeof(encoded)+64];
+	for (unsigned i = 0; i < f385_windows; ++i) {
+		const struct f390_lane *lane = &f390_lanes[i];
+		const unsigned seen = lane->count, available = MIN(seen, F390_CAP);
+		printf("SWEET F390 Q %u %u %u %u %u %u %u %u %u\n", i+1, available, seen-available,
+		    lane->raw[0], lane->site[0], lane->read[0], lane->raw[1], lane->site[1], lane->read[1]);
+		for (unsigned at = 0; at < available; at += F390_BLOCK) {
+			const unsigned count = MIN(available-at, F390_BLOCK);
+			for (unsigned j = 0; j < count; ++j) {
+				const typeof(lane->rows[0]) *row = &lane->rows[at+j];
+				uint8_t *p = &packed[j*F390_WIRE];
+				f372_le32(p, (uint32_t)(row->tick - f374_start));
+				f372_le32(p+4, row->member | ((uint32_t)row->gate << 8));
+				f374_le64(p+8, row->thread);
+				f372_le32(p+16, row->swap);
+				f372_le32(p+20, row->seed);
+				f374_le64(p+24, row->context);
+				f372_le32(p+32, row->id);
+				f372_le32(p+36, row->version);
+			}
+			f372_base64(packed, count*F390_WIRE, encoded);
+			const int n = snprintf(line, sizeof(line), "\nSWEET F390 B %u %u %u %s\n", i+1, at, count, encoded);
+			if (n > 0 && (size_t)n < sizeof(line)) sweet_log_append(line, n);
+		}
+	}
+}
diff --git a/bsd/dev/gauguin_frame390_transactions.h b/bsd/dev/gauguin_frame390_transactions.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/gauguin_frame390_transactions.h
@@ -0,0 +1,200 @@
+/* Compact receipts from captured values. Run after the CA observer gate closes. */
+#ifndef GAUGUIN_TRANSACTION390_H
+#define GAUGUIN_TRANSACTION390_H
+
+struct f390_commit_receipt {
+	const struct f385_row *commit, *encoded, *send, *receive, *command, *apply;
+	uint64_t before, after;
+};
+
+/* The optional native markers prove a first inclusion only when the entry
+ * saw an empty membership and the exit saw the exact stored version. */
+static void
+f390_inclusion(const struct f385_row *rows, unsigned count, const struct f390_snapshot *snap,
+    struct f390_commit_receipt *receipt)
+{
+	const uint64_t key = ((uint64_t)snap->seed << 32) | snap->id;
+	const uint64_t version = (UINT64_C(1) << 32) | snap->version;
+	const struct f385_row *entry = NULL, *exit = NULL;
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->thread != snap->thread || row->a != snap->update || row->b != snap->context || row->c != key ||
+		    row->tick < receipt->apply->tick || row->tick >= snap->tick)
+			continue;
+		if (row->kind == F385_BEFORE_INCLUDE && row->d == 0) {
+			if (entry) return;
+			entry = row;
+		} else if (row->kind == F385_AFTER_INCLUDE && row->d == version) {
+			if (exit) return;
+			exit = row;
+		}
+	}
+	if (entry && exit && entry->tick < exit->tick) {
+		receipt->before = entry->tick;
+		receipt->after = exit->tick;
+	}
+}
+
+static bool
+f390_commit_for_snapshot(const struct f385_row *rows, unsigned count,
+    const struct f390_snapshot *snap, struct f390_commit_receipt *result)
+{
+	if (snap->member != F390_PRESENT) return false;
+	const uint64_t version = ((uint64_t)snap->id << 32) | snap->version;
+	struct f390_commit_receipt r = {0};
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->kind == F385_APPLY && row->c == snap->context && row->d == version && row->tick < snap->tick) {
+			if (r.apply) return false;
+			r.apply = row;
+		}
+	}
+	if (!r.apply) return false;
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->kind != F385_COMMAND || row->thread != r.apply->thread || row->a != r.apply->a ||
+		    row->tick >= r.apply->tick)
+			continue;
+		if (r.command && r.command->tick == row->tick) return false;
+		if (!r.command || r.command->tick < row->tick) r.command = row;
+	}
+	if (!r.command || r.command->b != r.apply->b || r.command->c != r.apply->c ||
+	    (r.command->d >> 32) != snap->id || (uint32_t)(r.command->d + 1) != snap->version ||
+	    !r.apply->b || r.apply->b > UINT16_MAX)
+		return false;
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->kind == F385_RECEIVE && row->b == r.apply->b) {
+			if (r.receive) return false;
+			r.receive = row;
+		} else if (row->kind == F385_SEND && row->a == r.apply->b) {
+			if (r.send) return false;
+			r.send = row;
+		}
+	}
+	if (!r.receive || !r.send || !r.send->b || r.receive->c != r.send->c || !f385_packet((uint32_t)r.send->c) ||
+	    r.send->tick > r.receive->tick || r.receive->tick >= r.command->tick)
+		return false;
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->thread == r.send->thread && row->a == r.send->b && row->tick < r.send->tick &&
+		    (row->kind == F385_SOURCE || row->kind == F385_ENCODED)) {
+			if (r.commit && r.commit->tick == row->tick) return false;
+			if (!r.commit || r.commit->tick < row->tick) r.commit = row;
+		}
+	}
+	if (!r.commit || r.commit->kind != F385_SOURCE || r.commit->b != snap->id) return false;
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->thread == r.send->thread && row->a == r.send->b && row->tick > r.send->tick &&
+		    (row->kind == F385_SOURCE || row->kind == F385_ENCODED)) {
+			if (r.encoded && r.encoded->tick == row->tick) return false;
+			if (!r.encoded || row->tick < r.encoded->tick) r.encoded = row;
+		} else if (row->kind == F385_SEND && row != r.send && row->thread == r.send->thread &&
+		    row->b == r.send->b && r.commit->tick < row->tick && row->tick < r.send->tick) {
+			return false;
+		}
+	}
+	if (!r.encoded || r.encoded->kind != F385_ENCODED || r.encoded->b != snap->id) return false;
+	for (unsigned i = 0; i < count; ++i) {
+		const struct f385_row *row = &rows[i];
+		if (row->kind == F385_SEND && row != r.send && row->thread == r.send->thread && row->b == r.send->b &&
+		    r.send->tick <= row->tick && row->tick <= r.encoded->tick)
+			return false;
+	}
+	f390_inclusion(rows, count, snap, &r);
+	*result = r;
+	return true;
+}
+
+enum { F390_TRANSACTION_WIRE = 56 };
+
+static void
+f390_pack_transaction(uint8_t *out, unsigned index, const struct f390_commit_receipt *r)
+{
+	const struct f385_row *parts[] = {r->commit, r->encoded, r->send, r->receive, r->command, r->apply};
+	f372_le32(out, index);
+	f372_le32(out+4, (uint32_t)(r->send->a | (r->send->c << 16)));
+	for (unsigned i = 0; i < sizeof(parts)/sizeof(parts[0]); ++i)
+		f372_le32(out+8+4*i, (uint32_t)(parts[i]->tick - f374_start));
+	f374_le64(out+32, r->send->thread);
+	f374_le64(out+40, r->receive->thread);
+	f372_le32(out+48, r->before ? (uint32_t)(r->before - f374_start) : 0);
+	f372_le32(out+52, r->after ? (uint32_t)(r->after - f374_start) : 0);
+}
+
+enum { F393_RECEIPTS = 32, F393_WIRE = 80 };
+_Static_assert(F390_CAP <= 64, "snapshot mask holds each retained swap");
+
+static bool
+f393_same_member(const struct f393_member *a, const struct f393_member *b)
+{
+    return a->context == b->context && a->id == b->id && a->version == b->version;
+}
+
+static bool
+f393_contains(const struct f393_members *members, const struct f393_member *key)
+{
+    for (unsigned i = 0; i < members->count; ++i) {
+        if (f393_same_member(&members->entries[i], key)) return true;
+    }
+    return false;
+}
+
+static void
+f393_drain_transactions(void)
+{
+    uint8_t packed[F393_RECEIPTS * F393_WIRE];
+    char encoded[4 * ((F390_BLOCK * F393_WIRE + 2) / 3) + 1];
+    char line[sizeof(encoded)+64];
+    for (unsigned lane = 0; lane < f385_windows; ++lane) {
+        const struct f385_gesture *g = &f385_gestures[lane];
+        const struct f390_lane *swaps = &f390_lanes[lane];
+        const unsigned retained = MIN(g->count, F385_GESTURE_CAP);
+        const unsigned available = MIN(swaps->count, F390_CAP);
+        unsigned count = 0, omitted = 0;
+        if (g->count == retained && swaps->count == available) {
+            for (unsigned i = 0; i < available; ++i) {
+                const struct f393_members *members = &f393_versions[lane][i];
+                for (unsigned m = 0; m < members->count; ++m) {
+                    const struct f393_member *key = &members->entries[m];
+                    unsigned first = i;
+                    uint64_t membership = 0;
+                    for (unsigned s = 0; s < available; ++s) {
+                        if (!f393_contains(&f393_versions[lane][s], key)) continue;
+                        membership |= UINT64_C(1) << s;
+                        if (swaps->rows[s].tick < swaps->rows[first].tick) first = s;
+                    }
+                    if (membership & ((UINT64_C(1) << i) - 1)) continue;
+                    struct f390_snapshot snap = swaps->rows[first];
+                    snap.context = key->context;
+                    snap.id = key->id;
+                    snap.version = key->version;
+                    snap.member = F390_PRESENT;
+                    struct f390_commit_receipt receipt;
+                    if (!f390_commit_for_snapshot(g->rows, retained, &snap, &receipt)) continue;
+                    if (count == F393_RECEIPTS) {
+                        ++omitted;
+                        continue;
+                    }
+                    uint8_t *dst = packed + count++ * F393_WIRE;
+                    f390_pack_transaction(dst, first, &receipt);
+                    f374_le64(dst+56, key->context);
+                    f372_le32(dst+64, key->id);
+                    f372_le32(dst+68, key->version);
+                    f374_le64(dst+72, membership);
+                }
+            }
+        }
+        printf("SWEET F393 Q %u %u %u %u %u\n", lane+1, retained, g->count-retained, count, omitted);
+        for (unsigned i = 0; i < count; i += F390_BLOCK) {
+            const unsigned n = MIN(count-i, F390_BLOCK);
+            f372_base64(packed+i*F393_WIRE, n*F393_WIRE, encoded);
