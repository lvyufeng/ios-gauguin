+	 * cheapest possible exit is the right one.
+	 */
+	if (__atomic_load_n(&sweet_msgsend_count, __ATOMIC_RELAXED) >= SWEET_MSGSEND_SLOTS) {
+		return;
+	}
+	uint32_t slot = __atomic_fetch_add(&sweet_msgsend_count, 1, __ATOMIC_RELAXED);
+	if (slot >= SWEET_MSGSEND_SLOTS) {
+		return;
+	}
+	sweet_msgsend_ports[slot] = port;
+	/*
+	 * proc_selfname is a plain read of the current task's name buffer; no
+	 * lock, no allocation. Keep it short and bounded.
+	 */
+	proc_selfname(sweet_msgsend_senders[slot], sizeof(sweet_msgsend_senders[slot]));
