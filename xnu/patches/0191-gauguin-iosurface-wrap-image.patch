+/*
+ * 20H392 IOSurfaceClientWrapClientImage sends selector6 and constructs a
+ * client on ANY successful return. Accepting it with zero output creates a
+ * client with no state page, crashing GetBulkAttachments at address0x30.
+ * Pin the caller's actual pixels; substituting a blank allocation would
+ * lose the application's image. Keep the exact byte extent and cache type.
+ */
+IOReturn
+IOSurfaceRootUserClient::wrapImage(IOExternalMethodArguments *args)
+{
+	struct {
+		uint64_t address;
+		uint32_t width, height, pixelFormat, bytesPerElement, bytesPerRow, size;
+	} input;
+	static_assert(sizeof(input) == 32, "20H392 wrapped image wire size");
+	IOByteCount outputSize = args->structureOutputDescriptor != NULL ?
+	    args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+	if (args->scalarInputCount != 0 || args->scalarOutputCount != 0 ||
+	    outputSize < SWEET_SURFACE_RESULT_SIZE ||
+	    (args->structureOutputDescriptor == NULL && args->structureOutput == NULL)) {
+		return kIOReturnBadArgument;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		if (args->structureInputDescriptor->getLength() != sizeof(input) ||
+		    args->structureInputDescriptor->readBytes(0, &input, sizeof(input)) != sizeof(input)) {
+			return kIOReturnBadArgument;
+		}
+	} else {
+		if (args->structureInput == NULL || args->structureInputSize != sizeof(input)) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(&input, args->structureInput, sizeof(input));
+	}
+	if (input.address == 0 || input.width == 0 || input.height == 0 ||
+	    input.width > SWEET_SURFACE_MAX_DIM || input.height > SWEET_SURFACE_MAX_DIM ||
+	    input.bytesPerElement == 0 || input.bytesPerElement > 64 ||
+	    input.bytesPerRow < (uint64_t)input.width * input.bytesPerElement ||
+	    input.size == 0 || input.size > SWEET_SURFACE_MAX_ALLOC ||
+	    (uint64_t)input.bytesPerRow * input.height > input.size ||
+	    input.address > UINT64_MAX - input.size) {
+		return kIOReturnBadArgument;
+	}
+
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return kIOReturnNoMemory;
+	}
+	s->width = input.width;
+	s->height = input.height;
+	s->pixelFormat = input.pixelFormat;
+	s->bytesPerElement = (uint16_t)input.bytesPerElement;
+	s->bytesPerRow = input.bytesPerRow;
+	s->elementWidth = s->elementHeight = 1;
+	s->allocSize = input.size;
+	s->mapCache = kIOMapDefaultCache;
+	uint32_t charge = (uint32_t)round_page((input.address & PAGE_MASK) + input.size);
+	IOReturn ret = kIOReturnNoMemory;
+	uint64_t previous = (uint64_t)OSAddAtomic64(charge, (volatile SInt64 *)&sweet_surface_wired);
+	if (previous > SWEET_SURFACE_WIRED_MAX - charge) {
+		OSAddAtomic64(-(SInt64)charge, (volatile SInt64 *)&sweet_surface_wired);
+	} else {
+		s->wiredSize = charge;
+		s->memory = IOMemoryDescriptor::withAddressRange(input.address, input.size,
+		    kIODirectionInOut | kIOMemoryThreadSafe, fTask);
+		if (s->memory != NULL) {
+			ret = s->memory->prepare();
+			if (ret == kIOReturnSuccess) {
+				s->memoryPrepared = true;
+				ret = sweet_surface_publish(s) ? returnSurface(s, args) : kIOReturnNoResources;
+			}
+		}
+	}
+	if (ret != kIOReturnSuccess || sweet_surface_creates_logged < 64) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		sweet_surface_creates_logged++;
+		IOLog("SWEET SURF: %s wrap id %u %ux%u fmt 0x%x bpe %u bpr %u size %u wired %u -> 0x%x\n",
+		    name, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
+		    s->bytesPerRow, s->allocSize, s->wiredSize, ret);
+	}
 	s->release();
 	return ret;
 }
