+        rd(s, GSS_SE, FW, &s->report.fw) || rd(s, GSS_SE, S_FW, &s->report.sfw) ||
+        rd(s, GSS_SE, PARAM0, &p0) || rd(s, GSS_SE, PARAM1, &p1) ||
+        rd(s, GSS_SE, FIFO_DISABLE, &fifo) || rd(s, GSS_SE, DMA_MODE, &dma))
+        return GSS_OWNERSHIP;
+    if (s->report.wrapper != 0x20070000 || s->report.fw != 0x101 ||
+        s->report.sfw != 0x101 || (fifo & 1) || (dma & 1) ||
+        ((p0 >> 24) & 63) != 32 || ((p1 >> 24) & 63) != 32 ||
+        ((p0 >> 16) & 63) != 16 || ((p1 >> 16) & 63) != 16) return GSS_PROFILE;
