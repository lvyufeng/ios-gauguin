+/* Opt-in first BCM submission trial. No PAS/SMC/GPU operation here.
+ * One preemptible coordinator serializes: CPU-stage claim -> same-boot CMDDB
+ * plan -> watchdog arm/advance -> native six-command transfer -> reset wait.
+ * Both staging memory and successful votes remain retained until reset.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(GAUGUIN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLib.h>
+#include "gauguin_pas_stage.h"
+#include "gauguin_bus_probe.h"
+#include "gauguin_bcm_transport.h"
+#include "gauguin_wdt_lease.h"
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_terminate_self(void);
+extern int get_preemption_level(void);
+extern void sweet_log_mark_sync(const char *);
+extern void sweet_log_flush_now(void);
+void sweet_bcm_vote_init(void);
+static unsigned bcm_started;
+static bool bcm_context(void)
+{ return ml_get_interrupts_enabled() && !ml_at_interrupt_context() && get_preemption_level() == 0; }
+static void bcm_record(const char *line)
+{
+    printf("%s\n", line);
+    if (bcm_context()) { sweet_log_mark_sync(line); sweet_log_flush_now(); }
+}
+static bool bcm_flags(void)
+{
+    static const char *const off[] = {"sweettouchmode", "sweetwdtpet", "sweetreboot",
+        "sweetbusprobe", "sweetgpuprobe", "sweetscmprobe", "sweetwdttest"};
+    for (unsigned i = 0; i < sizeof(off) / sizeof(off[0]); ++i) {
+        int value = 0; (void)PE_parse_boot_argn(off[i], &value, sizeof(value));
+        if (value != 0) return false;
+    }
+    int probe = 0, stage = 0;
+    (void)PE_parse_boot_argn("sweetpasprobe", &probe, sizeof(probe));
+    (void)PE_parse_boot_argn("sweetpasstage", &stage, sizeof(stage));
+    return probe == 1 && stage == 1;
+}
+static void bcm_run(void)
+{
+    struct sweet_pas_cpu_stage stage;
+    struct gbcm_plan plan;
+    struct gauguin_wdt_lease_record lease;
+    struct gbcmt_receipt receipt;
+    uint64_t deadline;
+    bool claimed = false;
+    char line[192];
+    clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+    for (unsigned i = 0; i < 500 && mach_absolute_time() < deadline; ++i) {
+        if (sweet_pas_cpu_stage_claim(&stage)) { claimed = true; break; }
+        IOSleep(10);
+    }
+    if (!claimed || stage.metadata_bytes != 6860 || stage.reserved_bytes != 16384 ||
+        !stage.pa || (stage.pa & UINT64_C(0xfffff)) || stage.pa > UINT64_C(0xfff00000)) {
+        bcm_record("SWEET BCM BOOT: CPU-stage READY unavailable/invalid; no watchdog/RSC write");
+        return;
+    }
+    snprintf(line, sizeof(line), "SWEET BCM BOOT: CPU-stage claimed pa=%016llx metadata=%u reserved=%u; no secure authentication", stage.pa, stage.metadata_bytes, stage.reserved_bytes);
+    bcm_record(line);
+    if (!sweet_bus_plan_prepare(&plan)) {
+        bcm_record("SWEET BCM BOOT: same-boot CMDDB preparation failed; no watchdog/RSC write");
+        return;
+    }
+    if (!bcm_context() || !gauguin_wdt_lease_arm(&lease)) {
+        bcm_record("SWEET BCM BOOT: watchdog arm/advance not ready; no RSC write");
+        return;
+    }
+    enum gbcmt_rc rc = sweet_bcm_submit_once(&plan, &receipt);
+    if (rc != GBCMT_OK) {
+        gauguin_wdt_lease_quarantine();
+        snprintf(line, sizeof(line), "SWEET BCM BOOT: transfer rejected rc=%u state=%u; no PAS/GPU call, no retry", (unsigned)rc, (unsigned)sweet_bcm_transport_state());
+        bcm_record(line);
+        return;
+    }
+    snprintf(line, sizeof(line), "SWEET BCM BOOT: native batch complete slot=%u config=%08x irq_before=%08x irq_after=%08x irq_completed=%08x", receipt.slot, receipt.config, receipt.irq_before, receipt.irq_after, receipt.irq_completed);
+    bcm_record(line);
+    for (unsigned i = 0; i < GBCM_COUNT; ++i) {
+        snprintf(line, sizeof(line), "SWEET BCM BOOT: cmd%u addr=%05x data=%08x wait=%u status=%08x", i, plan.cmd[i].address, plan.cmd[i].data, plan.cmd[i].wait, receipt.cmd_status[i]);
+        bcm_record(line);
+    }
+    bcm_record("SWEET BCM BOOT: requests held; awaiting watchdog reset; coordinator performed no PAS/SMC/GPU operation");
+    for (unsigned i = 0; i < 30; ++i) IOSleep(1000);
+    gauguin_wdt_lease_quarantine();
+    bcm_record("SWEET BCM BOOT: survived30 requested seconds after transfer; reset unqualified, no retry or vote release");
+}
+static void bcm_worker(void *argument, wait_result_t result)
+{
+    (void)argument; (void)result;
+    if (!bcm_context() || !bcm_flags()) {
+        printf("SWEET BCM BOOT: context/flags rejected; no experiment\n");
+        thread_terminate_self(); return;
+    }
+    bcm_record("SWEET BCM BOOT: worker delay45s; single coordinator, legacy RSC/PET excluded");
+    for (unsigned i = 0; i < 45; ++i) IOSleep(1000);
+    if (bcm_context()) bcm_run();
+    else printf("SWEET BCM BOOT: invalid context after delay; stopped\n");
+    thread_terminate_self();
+}
+void sweet_bcm_vote_init(void)
+{
+    thread_t thread;
+    if (!sweet_bcm_vote_requested() || __atomic_exchange_n(&bcm_started, 1u, __ATOMIC_ACQ_REL)) return;
+    kern_return_t result = kernel_thread_start(bcm_worker, NULL, &thread);
+    if (result == KERN_SUCCESS) thread_deallocate(thread);
+    else printf("SWEET BCM BOOT: worker creation failed=%d; no inline fallback\n", result);
+}
+#endif
