+        if(c->work.eop_value==GGK_EOP_VALUE){c->work.eop_complete=1;return GGK_OK;}
+        if(c->work.eop_value)return sample(c,true,0x20000u+GGK_EOP_OFFSET,GGK_EOP_VALUE,c->work.eop_value);
+    }
+    return GGK_TIMEOUT;
+}
+static enum ggk_result verify_data(struct ggk_context *c,const struct ggk_prefix *prefix)
