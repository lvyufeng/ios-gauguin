+#ifndef GAUGUIN_FRAME379_PROBE_H
+#define GAUGUIN_FRAME379_PROBE_H
+
+#include "gauguin_frame372_wire.h"
+
+enum {
+    F379_SEGMENTS = 8,
+    F379_SEGMENT_ROWS = 300,
+    F379_RECORD_BYTES = 99,
+    F379_BLOCK = 8,
+    F379_CAP = 64,
+    F379_CONTROL = 1,
+    F379_STROKE2 = 2,
+    F379_STROKE4 = 3,
+    F379_CONTROL_LIMIT = 12,
+    F379_SCENE_LIMIT = 26,
+    F379_WAIT_LIMIT = 12,
+    F379_PROBE_SLACK_NS = 5600000,
+    F379_MAX_ISSUE_AGE_TICKS = 1536000, /* 80 ms */
+};
+
+static inline unsigned
+f379_scene(uint64_t offset)
+{
+    if (offset >= UINT64_C(157056000) && offset < UINT64_C(166656000)) return F379_STROKE2;
+    if (offset >= UINT64_C(246720000) && offset < UINT64_C(256320000)) return F379_STROKE4;
+    return 0;
+}
+
+static inline unsigned
+f379_wait_scene(uint64_t offset)
+{
+    /* The two release-tail windows at 8.320–8.510 and 13.015–13.215 s. */
+    if (offset >= UINT64_C(159744000) && offset < UINT64_C(163392000)) return F379_STROKE2;
+    if (offset >= UINT64_C(249888000) && offset < UINT64_C(253728000)) return F379_STROKE4;
+    return 0;
+}
+
+struct f379_wait_state {
+    uint64_t generation, ticket;
+    uint32_t scan;
+};
+
+static inline bool
+f379_waiting(const struct f379_wait_state *wait, uint32_t scan, uint64_t ticket)
+{
+    return ticket && wait->scan == scan && wait->ticket == ticket;
+}
+
+static inline bool
+f379_new_wait(const struct f379_wait_state *wait, uint32_t scan, uint64_t generation)
+{
+    return generation && (!wait->ticket || (wait->scan != scan && wait->generation != generation));
+}
+
+struct f379_segments {
+    uint32_t end[F379_SEGMENTS];
+    uint32_t row[F379_SEGMENTS];
+    uint32_t read[F379_SEGMENTS];
+    uint32_t issue[F379_SEGMENTS];
+};
+
+static inline bool
+f379_le24(uint8_t *out, uint32_t value)
+{
+    if (value > 0xffffff) return false;
+    out[0] = (uint8_t)value;
+    out[1] = (uint8_t)(value >> 8);
+    out[2] = (uint8_t)(value >> 16);
+    return true;
+}
+
+static inline bool
+f379_pack(uint8_t out[F379_RECORD_BYTES], uint64_t attempt, unsigned lane,
+    const struct f379_segments *data)
+{
+    if (!attempt || attempt > UINT16_MAX || lane < F379_CONTROL || lane > F379_STROKE4) return false;
+    out[0] = (uint8_t)attempt;
+    out[1] = (uint8_t)(attempt >> 8);
+    out[2] = (uint8_t)lane;
+    uint32_t last = 0;
+    for (unsigned i = 0; i < F379_SEGMENTS; ++i) {
+        uint8_t *record = out + 3 + i * 12;
+        if (data->end[i] <= last || data->row[i] > data->end[i] - last ||
+            data->read[i] > data->row[i] || data->issue[i] > data->row[i] - data->read[i] ||
+            !f379_le24(record, data->end[i]) || !f379_le24(record + 3, data->row[i]) ||
+            !f379_le24(record + 6, data->read[i]) || !f379_le24(record + 9, data->issue[i])) return false;
+        last = data->end[i];
+    }
+    return true;
+}
+
+#endif
