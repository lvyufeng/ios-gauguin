+/* The existing scan worker is the sole writer. The notification workloop
+ * reads a versioned snapshot without introducing MMIO or a lock dependency. */
+static struct f380_fit phase380_fit;
+static uint32_t phase380_version;
+static struct f380_prediction phase380_prediction;
+
+static void phase380_publish(const struct f380_prediction *p)
+{
+    __atomic_fetch_add(&phase380_version, 1, __ATOMIC_ACQ_REL);
+    __atomic_store_n(&phase380_prediction.edge, p->edge, __ATOMIC_RELAXED);
+    __atomic_store_n(&phase380_prediction.observed, p->observed, __ATOMIC_RELAXED);
+    __atomic_store_n(&phase380_prediction.period, p->period, __ATOMIC_RELAXED);
+    __atomic_store_n(&phase380_prediction.frame, p->frame, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&phase380_version, 1, __ATOMIC_RELEASE);
+}
+
+bool sweet_frame380_prediction(uint64_t tick, struct f380_prediction *out)
+{
+    if (!sweet_frame351_window()) return false;
+    const uint32_t version = __atomic_load_n(&phase380_version, __ATOMIC_ACQUIRE);
+    if (!version || version & 1) return false;
+    struct f380_prediction p = {
+        .edge = __atomic_load_n(&phase380_prediction.edge, __ATOMIC_RELAXED),
+        .observed = __atomic_load_n(&phase380_prediction.observed, __ATOMIC_RELAXED),
+        .period = __atomic_load_n(&phase380_prediction.period, __ATOMIC_RELAXED),
+        .frame = __atomic_load_n(&phase380_prediction.frame, __ATOMIC_RELAXED)
+    };
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    if (__atomic_load_n(&phase380_version, __ATOMIC_RELAXED) != version || !f380_fresh(&p, tick))
+        return false;
+    *out = p;
+    return true;
+}
