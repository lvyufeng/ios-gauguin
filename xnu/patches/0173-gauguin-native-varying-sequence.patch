+#include "gauguin_gpu_varying.h"
+#include "gauguin_gpu_varying_native.h"
+_Static_assert(VARYING173_JOBS==GGV_JOBS&&VARYING173_BLOBS==GGV_BLOBS,"native profiles");
+_Static_assert(VARYING173_RING_BASE==0xfc008000u&&VARYING173_RING_BYTES==32768u,"native ring");
+_Static_assert(VARYING173_MAIN_IOVA==VARYING173_RING_BASE+GGV_IB_OFFSET,"native IB");
+_Static_assert(VARYING173_TARGET_IOVA==GGD_DATA_IOVA&&VARYING173_CONTROL_IOVA==GGD_DATA_IOVA+GGV_EOP_OFFSET,"native DATA");
+static bool span(const void *p,size_t n)
+{uintptr_t a=(uintptr_t)p;return a&&n&&a<=UINTPTR_MAX-n;}
+static bool overlap(const void *a,size_t an,const void *b,size_t bn)
+{return (uintptr_t)a<(uintptr_t)b+bn&&(uintptr_t)b<(uintptr_t)a+an;}
+static const struct varying173_native_blob *native_blob(unsigned job,unsigned id)
+{return job<GGV_JOBS&&id<GGV_BLOBS?&varying173_blobs[job][id]:NULL;}
+bool ggv_blob_get(unsigned job,unsigned id,struct ggv_blob *out)
+{
+    const struct varying173_native_blob *n=native_blob(job,id);
+    if(!n||!span(out,sizeof(*out)))return false;
+    struct ggv_blob b={0};
+    if(n->words){
+        if(!n->data||n->iova<VARYING173_RING_BASE+4096u||n->iova%128u||
+           !n->gpu_serialized_extent||n->gpu_serialized_extent%128u||
+           n->words>n->cpu_requested_capacity/4u||n->words>n->gpu_serialized_extent/4u||
+           n->iova-VARYING173_RING_BASE>VARYING173_RING_BYTES||
+           n->gpu_serialized_extent>VARYING173_RING_BYTES-(n->iova-VARYING173_RING_BASE))return false;
