+            // needs its own fresh and valid set of thermal readings.
+            scan402_record(CPU402_BEGIN, tick, mach_absolute_time(), 0, 0, hottest);
+            return;
+        }
+        const bool selected = cpu402_select(cpu402_read, cpu402_write, (void *)cpu402.perf,
+            &cpu402.point, &cpu402.restore_pending);
+        scan402_record(CPU402_BEGIN, tick, mach_absolute_time(), selected, 0, hottest);
+        if (!selected) {
