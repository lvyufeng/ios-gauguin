diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index fde499c..98bb5dd 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1791,6 +1791,23 @@ proc_handle_critical_exit(proc_t p, int rv)
 
 	char *exit_reason_desc = exit_reason_get_string_desc(p->p_exit_reason);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * Every process that dies is named here. The bring-up log otherwise shows
+	 * only "exec <name>" lines, so a daemon that starts and immediately exits
+	 * (SpringBoard did, silently) looks exactly like one that keeps running.
+	 * Only the first 200 exits are printed; this is a debug build.
+	 */
+	{
+		static unsigned sweet_exit_lines;
+		if (sweet_exit_lines < 200) {
+			sweet_exit_lines++;
+			printf("exit %s[%d] rv=0x%x\n", p->p_name,
+			    proc_getpid(p), rv);
+		}
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 	if (p->p_exit_reason == OS_REASON_NULL) {
 		printf("pid %d exited -- no exit reason available -- (signal %d, exit %d)\n",
 		    proc_getpid(p), WTERMSIG(rv), WEXITSTATUS(rv));
diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
index 67c5f79..5458192 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -2510,6 +2510,67 @@ task_clear_corpse(task_t task)
 	task_unlock(task);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET bring-up probe, minimal and safe: named processes are reported once at
+ * exec with their thread count. Walking the thread list from the exec path
+ * hung the boot twice (NOTES 15:28, 15:52) - the exec thread owns that queue
+ * while it runs, so only scalars are read here.
+ */
+static char sweet_dump_names[64];
+static bool sweet_dump_parsed;
+static unsigned sweet_dump_count;
+
+void
+sweet_dump_threads_soon(task_t task, const char *name)
+{
+	if (!sweet_dump_parsed) {
+		sweet_dump_parsed = true;
+		if (!PE_parse_boot_argn("sweetdump", sweet_dump_names,
+		    sizeof(sweet_dump_names))) {
+			sweet_dump_names[0] = '\0';
+		}
+	}
+	if (sweet_dump_names[0] == '\0' || task == TASK_NULL ||
+	    sweet_dump_count >= 16) {
+		return;
+	}
+	const char *t = sweet_dump_names;
+	bool match = false;
+	while (*t) {
+		const char *end = strchr(t, ',');
+		size_t len = end ? (size_t)(end - t) : strlen(t);
+		if (len == strlen(name) && strncmp(t, name, len) == 0) {
+			match = true;
+			break;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	if (!match) {
+		return;
+	}
+	sweet_dump_count++;
+	printf("SWEET THREADS: %s exec, threads=%d\n", name, task->thread_count);
+	{
+		thread_t th;
+		unsigned n = 0;
+		queue_iterate(&task->threads, th, thread_t, task_threads) {
+			if (n++ >= 64) {
+				break;
+			}
+			printf("SWEET THREADS:   tid=%llu run=%d state=%x ev=%llu\n",
+			    (unsigned long long)th->thread_id,
+			    (th->state & TH_RUN) ? 1 : 0, th->state,
+			    (unsigned long long)th->wait_event);
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
